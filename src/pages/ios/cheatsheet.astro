---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Vistas y layout', icon: '📐', items: [
      { k: 'VStack · HStack · ZStack', d: 'Contenedores básicos' },
      { k: '.frame(width:height:alignment:)', d: 'Proponer o fijar tamaño' },
      { k: '.padding() · .background() · .overlay()', d: 'Modificadores comunes' },
      { k: '.layoutPriority(1)', d: 'Prioridad al repartir espacio' },
      { k: 'GeometryReader', d: 'Leer el tamaño propuesto' },
      { k: 'Layout protocol', d: 'Contenedor propio' },
    ],
  },
  {
    cat: 'Estado', icon: '🔄', items: [
      { k: '@State', d: 'Estado propio de la vista' },
      { k: '@Binding', d: 'Referencia al estado del padre' },
      { k: '@Observable class', d: 'Modelo observable (Observation)' },
      { k: '@Bindable', d: 'Bindings a un @Observable' },
      { k: '@Environment(\\.dismiss)', d: 'Valores del entorno' },
      { k: '.id(valor)', d: 'Forzar nueva identidad de vista' },
    ],
  },
  {
    cat: 'Listas y navegación', icon: '🧭', items: [
      { k: 'List { } · ForEach(items) { }', d: 'Listas y repetición' },
      { k: 'Identifiable / id: \\.self', d: 'Identidad de cada fila' },
      { k: 'NavigationStack(path:)', d: 'Pila de navegación como estado' },
      { k: '.navigationDestination(for:)', d: 'Destino por tipo' },
      { k: '.sheet(isPresented:)', d: 'Presentar modal' },
      { k: 'NavigationSplitView', d: 'Dos o tres columnas (iPad/Mac)' },
      { k: '.swipeActions { }', d: 'Acciones al deslizar' },
    ],
  },
  {
    cat: 'Datos', icon: '🗄️', items: [
      { k: '@Model class', d: 'SwiftData: entidad persistida' },
      { k: '@Query var items: [T]', d: 'Consulta reactiva' },
      { k: 'modelContext.insert(x)', d: 'Insertar y guardar' },
      { k: '@Relationship(deleteRule:)', d: 'Relaciones entre modelos' },
      { k: 'UserDefaults · @AppStorage', d: 'Preferencias simples' },
      { k: 'Keychain', d: 'Secretos y credenciales' },
    ],
  },
  {
    cat: 'Async y red', icon: '🌐', items: [
      { k: '.task { await … }', d: 'Trabajo ligado a la vida de la vista' },
      { k: '.refreshable { await … }', d: 'Pull to refresh' },
      { k: 'URLSession.shared.data(from:)', d: 'Petición con async/await' },
      { k: 'JSONDecoder().decode(T.self, from:)', d: 'Decodificar respuesta' },
      { k: '@MainActor', d: 'Ejecutar en el hilo principal' },
      { k: 'AsyncImage(url:)', d: 'Imagen remota' },
    ],
  },
  {
    cat: 'Animaciones', icon: '✨', items: [
      { k: 'withAnimation { estado = x }', d: 'Animar un cambio de estado' },
      { k: '.animation(.spring, value: x)', d: 'Animar según un valor' },
      { k: '.transition(.slide)', d: 'Entrada y salida' },
      { k: 'matchedGeometryEffect(id:in:)', d: 'Efecto héroe entre vistas' },
      { k: 'PhaseAnimator · KeyframeAnimator', d: 'Secuencias complejas' },
    ],
  },
  {
    cat: 'Sistema', icon: '🧩', items: [
      { k: 'WidgetKit · TimelineProvider', d: 'Widgets' },
      { k: 'App Intents', d: 'Siri, Atajos y Spotlight' },
      { k: 'UNUserNotificationCenter', d: 'Notificaciones locales y push' },
      { k: 'StoreKit 2: Product · Transaction', d: 'Compras y suscripciones' },
      { k: 'CloudKit + SwiftData', d: 'Sincronizar entre dispositivos' },
      { k: 'MetricKit', d: 'Métricas de rendimiento del sistema' },
    ],
  },
  {
    cat: 'Calidad y envío', icon: '🚢', items: [
      { k: '.accessibilityLabel("…")', d: 'Etiqueta para VoiceOver' },
      { k: 'String Catalog', d: 'Localización moderna' },
      { k: '@Test · #expect', d: 'Swift Testing' },
      { k: 'XCUITest', d: 'Tests de interfaz' },
      { k: 'Instruments: Time Profiler', d: 'Perfilar la app' },
      { k: 'TestFlight → App Store', d: 'Distribución' },
      { k: 'UIViewRepresentable', d: 'Envolver una vista de UIKit' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · iOS" description="Referencia buscable de desarrollo iOS: SwiftUI, estado, navegación, SwiftData, async, animaciones, capacidades del sistema y distribución.">
  <header class="topbar">
    <span class="brand-mini">iOS <b>Apps Apple</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="ios" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--pink)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de iOS</h1>
          <p class="desc">El desarrollo de apps Apple en un sitio: SwiftUI, estado, datos, sistema y distribución. Busca por API o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: '@State', 'NavigationStack', '@Model', 'task'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
