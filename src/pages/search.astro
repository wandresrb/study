---
import LandingLayout from '../layouts/LandingLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
---
<LandingLayout
  search
  title="Buscar · wandres.dev"
  description="Búsqueda a texto completo sobre todas las lecciones: títulos, prosa y código."
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Buscar' }]}
>
  <section class="py-14">
    <h1 class="text-5xl/tight font-extrabold tracking-headline text-text text-balance">
      Buscar en todo el contenido
    </h1>
    <p class="mt-4 max-w-measure text-lg text-subtext1">
      Texto completo sobre las 5.078 lecciones. La paleta (⌘K) busca por título; esto busca dentro.
    </p>

    <div class="mt-8 pb-20">
      <Search className="pagefind-ui" searchboxOptions={{ showImages: false }} />
    </div>
  </section>
</LandingLayout>

<script>
  // The terminal's `/` prompt lands here as ?q=; pagefind-ui has no query-param
  // support of its own, so seed its input by hand.
  document.addEventListener('astro:page-load', () => {
    const q = new URLSearchParams(location.search).get('q');
    const input = document.querySelector<HTMLInputElement>('.pagefind-ui input');
    if (!q || !input || input.value) return;
    input.value = q;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  });
</script>
