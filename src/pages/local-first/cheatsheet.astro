      { k: 'IndexedDB', d: 'Transaccional, asíncrono, lento en volumen' },
      { k: 'OPFS', d: 'Sistema de archivos privado del origen' },
      { k: 'createSyncAccessHandle()', d: 'E/S síncrona: SOLO dentro de un Worker' },
      { k: 'Cache API', d: 'Respuestas HTTP, no datos de aplicación' },
      { k: 'navigator.storage.estimate()', d: 'Cuánto ocupas y cuánto queda' },
      { k: 'navigator.storage.persist()', d: 'Pedir que no te desalojen' },
    ],
  },
  {
    cat: 'Cuotas y desalojo', icon: '⚠️', items: [
