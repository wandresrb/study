      { k: 'ElectricSQL', d: 'Streaming de tablas Postgres; sin CRDT' },
      { k: 'PowerSync', d: 'SQLite local; el más maduro en móvil' },
      { k: 'Jazz', d: 'Descentralizado y cifrado' },
