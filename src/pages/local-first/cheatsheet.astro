      { k: 'Enlace tardío', d: 'Cadenas de certificados sin estado' },
      { k: 'MLS · RFC 9420', d: 'Grupos cifrados con rotación de clave' },
      { k: 'Keyhive', d: 'Control de acceso local-first (Ink & Switch)' },
      { k: 'Lo imposible', d: 'Revocar lo que alguien ya descifró' },
    ],
  },
  {
    cat: 'Producción', icon: '🚢', items: [
      { k: 'Compactar', d: 'Solo si TODAS las réplicas lo han visto' },
      { k: 'El que vuelve', d: 'Dispositivo dormido bajo el corte causal' },
      { k: 'Migrar', d: 'Compatibilidad en las dos direcciones' },
      { k: 'Seguro', d: 'Añadir campos opcionales' },
      { k: 'Peligroso', d: 'Renombrar, cambiar tipo, mover' },
      { k: 'Property testing', d: 'Para cualquier historia, convergen' },
      { k: 'Reducción de casos', d: 'De 200 operaciones a las 3 culpables' },
