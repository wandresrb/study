---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Worker básico', icon: '⚡', items: [
      { k: 'export default { fetch(req, env, ctx) }', d: 'El handler principal' },
      { k: 'new Response(body, { status, headers })', d: 'Devolver una respuesta' },
      { k: 'new URL(request.url).pathname', d: 'Enrutar a mano' },
      { k: 'await request.json()', d: 'Leer el body' },
      { k: 'ctx.waitUntil(promesa)', d: 'Trabajo tras responder' },
      { k: 'scheduled(event, env, ctx)', d: 'Handler de cron' },
      { k: 'queue(batch, env)', d: 'Handler de consumidor de cola' },
    ],
  },
  {
    cat: 'Wrangler', icon: '🛠️', items: [
      { k: 'npm create cloudflare@latest', d: 'Crear proyecto (C3)' },
      { k: 'wrangler dev', d: 'Local con el runtime real' },
      { k: 'wrangler deploy', d: 'Publicar a producción' },
      { k: 'wrangler tail', d: 'Logs en vivo' },
      { k: 'wrangler secret put NOMBRE', d: 'Guardar un secreto' },
      { k: 'wrangler types', d: 'Generar la interfaz Env' },
      { k: 'wrangler versions upload / deploy', d: 'Despliegue gradual' },
    ],
  },
  {
    cat: 'wrangler.jsonc', icon: '📄', items: [
      { k: 'compatibility_date', d: 'Fija el comportamiento del runtime' },
      { k: 'compatibility_flags: ["nodejs_compat"]', d: 'APIs de Node soportadas' },
      { k: 'assets: { directory, not_found_handling }', d: 'Servir estáticos y SPA' },
      { k: 'triggers: { crons: ["0 * * * *"] }', d: 'Cron triggers' },
      { k: 'vars / env.production', d: 'Variables y entornos' },
      { k: 'placement: { mode: "smart" }', d: 'Smart Placement' },
    ],
  },
  {
    cat: 'KV · R2', icon: '🗄️', items: [
      { k: 'env.KV.get(key, "json")', d: 'Leer (eventual, global)' },
      { k: 'env.KV.put(key, val, { expirationTtl })', d: 'Escribir con TTL' },
      { k: 'env.KV.list({ prefix })', d: 'Listar claves' },
      { k: 'env.BUCKET.put(key, stream)', d: 'R2: subir objeto' },
      { k: 'env.BUCKET.get(key)', d: 'R2: descargar objeto' },
      { k: 'R2 = sin cargos de egress', d: 'La ventaja económica clave' },
    ],
  },
  {
    cat: 'D1 · Hyperdrive', icon: '🗃️', items: [
      { k: 'env.DB.prepare(sql).bind(...)', d: 'Query parametrizada' },
      { k: '.first() / .all() / .run()', d: 'Un registro / todos / ejecutar' },
      { k: 'env.DB.batch([stmt1, stmt2])', d: 'Varias sentencias, una ida y vuelta' },
      { k: 'wrangler d1 migrations apply', d: 'Aplicar migraciones' },
      { k: 'withSession()', d: 'Read-your-writes en réplicas' },
      { k: 'Hyperdrive', d: 'Acelera tu Postgres existente' },
    ],
  },
  {
    cat: 'Durable Objects', icon: '🎯', items: [
      { k: 'env.DO.idFromName("sala-1")', d: 'Id determinista por nombre' },
      { k: 'env.DO.get(id)', d: 'Obtener el stub' },
      { k: 'this.ctx.storage.put(k, v)', d: 'Estado transaccional' },
      { k: 'this.ctx.storage.sql.exec(sql)', d: 'SQLite dentro del objeto' },
      { k: 'this.ctx.storage.setAlarm(t)', d: 'Despertarse en el futuro' },
      { k: 'new WebSocketPair()', d: 'Tiempo real en el DO' },
      { k: 'Hibernation API', d: 'Dormir sin cerrar sockets' },
    ],
  },
  {
    cat: 'IA', icon: '🧠', items: [
      { k: 'env.AI.run(modelo, inputs)', d: 'Inferencia en GPU serverless' },
      { k: 'env.VECTORIZE.query(vec, { topK })', d: 'Búsqueda por similitud' },
      { k: 'env.VECTORIZE.upsert(vectores)', d: 'Indexar embeddings' },
      { k: 'AI Gateway', d: 'Cache, rate limit y logs de LLMs' },
      { k: 'Agents SDK (sobre DO)', d: 'Agentes con estado y herramientas' },
      { k: 'Workflows: step.do / step.sleep', d: 'Procesos durables' },
    ],
  },
  {
    cat: 'Otros', icon: '🧰', items: [
      { k: 'env.QUEUE.send(msg)', d: 'Encolar trabajo asíncrono' },
      { k: 'caches.default.match(req)', d: 'Cache API del edge' },
      { k: 'env.SERVICIO.metodo()', d: 'RPC a otro Worker' },
      { k: 'new HTMLRewriter().on(sel, handler)', d: 'Transformar HTML en streaming' },
      { k: 'Turnstile', d: 'CAPTCHA sin fricción' },
      { k: 'Cloudflare Access', d: 'Auth antes de llegar al Worker' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Cloudflare" description="Referencia buscable de la plataforma Cloudflare: Workers, Wrangler, KV, R2, D1, Durable Objects, Queues, Workers AI y Vectorize.">
  <header class="topbar">
    <span class="brand-mini">Cloudflare <b>Edge</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="cloudflare" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--peach)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Cloudflare</h1>
          <p class="desc">La plataforma del edge en un sitio: Workers, Wrangler, almacenamiento e IA. Busca por API o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'env.DB', 'wrangler dev', 'Durable', 'AI'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
