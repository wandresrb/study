---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Compilación', icon: '⚙️', items: [
      { k: 'gcc -std=c23 a.c -o a', d: 'Compilar C23' },
      { k: '-Wall -Wextra -Wpedantic', d: 'Avisos (actívalos siempre)' },
      { k: '-Werror', d: 'Avisos → errores' },
      { k: '-g -O2', d: 'Símbolos de depuración + optimización' },
      { k: '-E / -S / -c', d: 'Parar tras preprocesar / compilar / ensamblar' },
      { k: '-save-temps', d: 'Guardar .i .s .o intermedios' },
    ],
  },
  {
    cat: 'Novedades C23', icon: '✨', items: [
      { k: 'auto x = 42;', d: 'Inferencia de tipo' },
      { k: 'constexpr int N = 256;', d: 'Constante de compilación con tipo' },
      { k: 'nullptr', d: 'Puntero nulo con tipo (mejor que NULL)' },
      { k: 'typeof(x)', d: 'Tipo de una expresión' },
      { k: '_BitInt(N)', d: 'Entero de N bits exactos' },
      { k: '#embed "archivo"', d: 'Incrustar binario en el código' },
      { k: '[[nodiscard]] [[fallthrough]]', d: 'Atributos estándar' },
    ],
  },
  {
    cat: 'Punteros y memoria', icon: '🧠', items: [
      { k: '&x  ·  *p', d: 'Dirección de / contenido en' },
      { k: 'malloc(n * sizeof *p)', d: 'Reservar en el heap' },
      { k: 'calloc(n, sz) / realloc', d: 'Reservar a cero / redimensionar' },
      { k: 'free(p); p = nullptr;', d: 'Liberar y evitar colgante' },
      { k: 'void *', d: 'Puntero genérico' },
      { k: 'int (*f)(int,int)', d: 'Puntero a función' },
    ],
  },
  {
    cat: 'Tipos', icon: '🔢', items: [
      { k: 'uint8_t int32_t (stdint.h)', d: 'Enteros de ancho fijo' },
      { k: 'sizeof x  ·  offsetof', d: 'Tamaño / posición de campo' },
      { k: 'const char *s', d: 'Puntero a const (solo lectura)' },
      { k: 'struct / union / enum', d: 'Tipos compuestos' },
      { k: 'enum E : uint8_t', d: 'Enum con tipo fijo (C23)' },
      { k: 'typedef struct X X;', d: 'Alias de tipo' },
    ],
  },
  {
    cat: 'Build: Meson y Make', icon: '🏗️', items: [
      { k: 'meson setup build', d: 'Configurar (una vez)' },
      { k: 'meson compile -C build', d: 'Compilar' },
      { k: '-Db_sanitize=address', d: 'Build con sanitizers (Meson)' },
      { k: 'make  ·  make clean', d: 'Construir / limpiar' },
      { k: '$@ $^ $<', d: 'Make: objetivo / prereqs / primer prereq' },
      { k: '.PHONY: clean', d: 'Objetivo que no produce archivo' },
    ],
  },
  {
    cat: 'Linking y bibliotecas', icon: '🔗', items: [
      { k: 'ar rcs lib.a *.o', d: 'Crear biblioteca estática' },
      { k: '-fPIC -shared', d: 'Crear biblioteca dinámica (.so)' },
      { k: '-L. -lmates', d: 'Enlazar libmates (ruta + nombre)' },
      { k: 'nm a.o', d: 'Símbolos (T=def, U=indef)' },
      { k: 'ldd prog', d: 'Dependencias dinámicas' },
      { k: 'readelf -S / -d', d: 'Secciones / sección dinámica ELF' },
      { k: '-flto', d: 'Link-Time Optimization' },
    ],
  },
  {
    cat: 'Sanitizers y análisis', icon: '🛡️', items: [
      { k: '-fsanitize=address', d: 'Errores de memoria (ASan)' },
      { k: '-fsanitize=undefined', d: 'Undefined Behavior (UBSan)' },
      { k: '-fsanitize=thread', d: 'Condiciones de carrera (TSan)' },
      { k: 'valgrind --leak-check=full', d: 'Memoria en runtime' },
      { k: 'gcc -fanalyzer', d: 'Análisis estático de GCC' },
      { k: 'clang-tidy / cppcheck', d: 'Analizadores estáticos' },
      { k: '-fsanitize=fuzzer', d: 'Fuzzing con libFuzzer' },
    ],
  },
  {
    cat: 'Seguridad (hardening)', icon: '🔒', items: [
      { k: '-fstack-protector-strong', d: 'Canarios de pila' },
      { k: '-D_FORTIFY_SOURCE=3', d: 'Comprobaciones en libc' },
      { k: '-fPIE -pie', d: 'ASLR (posición aleatoria)' },
      { k: '-Wl,-z,relro,-z,now', d: 'GOT de solo lectura' },
      { k: 'snprintf (no sprintf)', d: 'Funciones con límite de tamaño' },
    ],
  },
  {
    cat: 'Concurrencia', icon: '🧵', items: [
      { k: 'thrd_create / thrd_join', d: 'Hilos (threads.h)' },
      { k: 'mtx_lock / mtx_unlock', d: 'Exclusión mutua' },
      { k: 'atomic_int (stdatomic.h)', d: 'Variable atómica' },
      { k: 'atomic_fetch_add', d: 'Operación atómica' },
      { k: 'memory_order_acquire/release', d: 'Orden de memoria' },
    ],
  },
  {
    cat: 'Herramientas', icon: '🔧', items: [
      { k: 'gdb ./prog', d: 'Depurador' },
      { k: 'strace ./prog', d: 'Ver syscalls' },
      { k: 'perf stat / record', d: 'Perfilar rendimiento' },
      { k: 'objdump -d', d: 'Desensamblar' },
      { k: 'file prog', d: 'Tipo de binario (ELF, estático/dinámico)' },
      { k: 'clang -S -emit-llvm', d: 'Ver el LLVM IR' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · C23 Nivel Dios" description="Referencia buscable de C23, compilación, build, linking, sanitizers, seguridad y tooling de sistemas.">
  <header class="topbar">
    <span class="brand-mini">C23 <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="c23" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--blue)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de C23</h1>
          <p class="desc">El lenguaje, el toolchain y el tooling de sistemas en un solo sitio. Busca por sintaxis, flag o herramienta.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'sanitize', 'malloc', 'meson', 'nullptr'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
