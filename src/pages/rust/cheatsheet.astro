---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Sintaxis básica', icon: '🦀', items: [
      { k: 'let x = 5; · let mut y = 5;', d: 'Inmutable / mutable' },
      { k: 'fn f(x: i32) -> i32 { x }', d: 'Función' },
      { k: 'match x { 1 => …, _ => … }', d: 'Pattern matching exhaustivo' },
      { k: 'if let Some(v) = opt { … }', d: 'Desenvolver un patrón' },
      { k: 'struct P { x: i32 } · enum E { A, B }', d: 'Tipos compuestos' },
    ],
  },
  {
    cat: 'Ownership y borrowing', icon: '🔑', items: [
      { k: 'let b = a;', d: 'Move: a deja de ser válido (si no es Copy)' },
      { k: '&x · &mut x', d: 'Préstamo compartido / mutable' },
      { k: "fn f<'a>(x: &'a str)", d: 'Anotación de lifetime' },
      { k: 'x.clone()', d: 'Copia explícita (cuando el move no vale)' },
      { k: 'String vs &str', d: 'Dueño (heap) vs préstamo (vista)' },
    ],
  },
  {
    cat: 'Tipos y traits', icon: '🧩', items: [
      { k: 'trait T { fn m(&self); }', d: 'Definir un trait' },
      { k: 'impl T for Tipo { … }', d: 'Implementar un trait' },
      { k: 'fn f<T: Display>(x: T)', d: 'Genérico con bound' },
      { k: 'dyn Trait · Box<dyn T>', d: 'Trait object (dispatch dinámico)' },
      { k: '#[derive(Debug, Clone)]', d: 'Derivar traits del sistema' },
      { k: 'type Item; (associated)', d: 'Tipo asociado' },
    ],
  },
  {
    cat: 'Colecciones e iteradores', icon: '🔁', items: [
      { k: 'Vec<T> · HashMap<K,V>', d: 'Colecciones' },
      { k: 'map().filter().collect()', d: 'Cadena de iteradores (lazy)' },
      { k: 'fold(0, |a, x| a + x)', d: 'Reducir a un valor' },
      { k: '|x| x + 1', d: 'Closure' },
      { k: 'collect::<Vec<_>>()', d: 'Materializar con turbofish' },
    ],
  },
  {
    cat: 'Errores', icon: '⚠️', items: [
      { k: 'Result<T, E> · Option<T>', d: 'Fallo / ausencia como valor' },
      { k: 'let v = f()?;', d: 'Propagar el error hacia arriba' },
      { k: 'x.unwrap() / .expect("…")', d: 'Extraer o panic (¡cuidado!)' },
      { k: 'x.unwrap_or(default)', d: 'Valor por defecto' },
      { k: 'thiserror / anyhow', d: 'Errores de librería / de app' },
    ],
  },
  {
    cat: 'Concurrencia', icon: '🔐', items: [
      { k: 'thread::spawn(move || …)', d: 'Crear un hilo' },
      { k: 'Arc<Mutex<T>>', d: 'Estado compartido y mutable entre hilos' },
      { k: 'Send / Sync', d: 'Seguridad entre hilos (auto-traits)' },
      { k: 'mpsc::channel()', d: 'Paso de mensajes' },
      { k: 'thread::scope(|s| …)', d: 'Hilos que toman prestado del padre' },
    ],
  },
  {
    cat: 'Async', icon: '⚡', items: [
      { k: 'async fn f() -> T', d: 'Función asíncrona (devuelve Future)' },
      { k: 'x.await', d: 'Esperar sin bloquear' },
      { k: '#[tokio::main]', d: 'Arrancar el runtime Tokio' },
      { k: 'tokio::spawn(fut)', d: 'Lanzar una tarea async' },
      { k: 'join! · select!', d: 'Esperar varias / la primera' },
      { k: 'tokio-console · tracing', d: 'Depurar async' },
    ],
  },
  {
    cat: 'Punteros y memoria', icon: '📦', items: [
      { k: 'Box<T>', d: 'Valor en el heap' },
      { k: 'Rc<T> · Arc<T>', d: 'Propiedad compartida (un hilo / multi-hilo)' },
      { k: 'RefCell<T> · Cell<T>', d: 'Interior mutability' },
      { k: 'Pin<P>', d: 'Valor que no se puede mover' },
      { k: 'Weak<T>', d: 'Referencia débil (rompe ciclos)' },
    ],
  },
  {
    cat: 'Unsafe y FFI', icon: '🔓', items: [
      { k: 'unsafe { … }', d: 'Desbloquear los 5 superpoderes' },
      { k: '*const T · *mut T', d: 'Punteros crudos' },
      { k: 'unsafe extern "C" { … }', d: 'Declarar funciones C' },
      { k: '#[repr(C)]', d: 'Layout compatible con C' },
      { k: '#[unsafe(no_mangle)]', d: 'Exportar a C sin decorar el nombre' },
      { k: '// SAFETY: …', d: 'Justificar cada bloque unsafe' },
    ],
  },
  {
    cat: 'no_std y macros', icon: '🔩', items: [
      { k: '#![no_std]', d: 'Rust sin librería estándar (core)' },
      { k: 'extern crate alloc;', d: 'Recuperar Vec/Box con un allocator' },
      { k: '#[global_allocator]', d: 'Definir el allocator global' },
      { k: 'macro_rules! m { … }', d: 'Macro declarativa' },
      { k: '#[proc_macro_derive(X)]', d: 'Macro procedural (syn + quote)' },
      { k: 'PhantomData · typestate', d: 'Programación a nivel de tipos' },
    ],
  },
  {
    cat: 'Cargo y testing', icon: '🛠️', items: [
      { k: 'cargo new / build / run', d: 'Crear, compilar, ejecutar' },
      { k: 'cargo build --release', d: 'Build optimizado' },
      { k: 'cargo test', d: 'Unit, integration y doc tests' },
      { k: 'cargo clippy · fmt', d: 'Linter y formateo' },
      { k: '[features] · #[cfg(feature)]', d: 'Compilación condicional' },
      { k: 'cargo add / publish', d: 'Dependencias / publicar en crates.io' },
    ],
  },
  {
    cat: 'Herramientas', icon: '🔬', items: [
      { k: 'rust-analyzer', d: 'El LSP (autocompletado, análisis)' },
      { k: 'samply · criterion', d: 'Perfilar CPU / benchmarks' },
      { k: 'cargo expand', d: 'Ver el código que generan las macros' },
      { k: 'Miri', d: 'Detectar UB en código unsafe' },
      { k: 'cargo --emit=mir / llvm-ir', d: 'Ver los IR del compilador' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Rust Nivel Dios" description="Referencia buscable de Rust: ownership, traits, iteradores, errores, concurrencia, async, unsafe, no_std y cargo.">
  <header class="topbar">
    <span class="brand-mini">Rust <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="rust" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--peach)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Rust</h1>
          <p class="desc">El lenguaje entero en un sitio: ownership, traits, async, unsafe y el tooling. Busca por sintaxis o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'ownership', 'Arc', 'async', 'trait'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
