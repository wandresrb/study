      { k: 'i" / a"', d: 'Dentro de / con comillas' },
      { k: 'i( / a(', d: 'Dentro de / con paréntesis' },
      { k: 'i{ / a{', d: 'Dentro de / con llaves' },
      { k: 'it / at', d: 'Dentro de / con etiqueta HTML/JSX' },
      { k: 'ip / ap', d: 'Párrafo interior / con espacio' },
      { k: 'if / af', d: 'Función (Treesitter)' },
      { k: 'ic / ac', d: 'Clase (Treesitter)' },
      { k: 'ia / aa', d: 'Argumento/parámetro (Treesitter)' },
    ],
  },
  {
    cat: 'LSP', icon: '🧠', items: [
      { k: 'gd / gD', d: 'Ir a definición / declaración' },
      { k: 'gr', d: 'Referencias' },
      { k: 'gi', d: 'Implementaciones' },
      { k: 'K', d: 'Documentación flotante (hover)' },
      { k: '<leader>rn', d: 'Renombrar símbolo' },
      { k: '<leader>ca', d: 'Code action' },
      { k: '<leader>d', d: 'Ver diagnóstico flotante' },
      { k: '[d / ]d', d: 'Diagnóstico anterior / siguiente' },
      { k: '<leader>th', d: 'Toggle inlay hints' },
