    cat: 'Macros y registros', icon: '♻️', items: [
      { k: 'qa … q', d: 'Grabar macro en el registro a' },
      { k: '@a / @@', d: 'Reproducir macro a / la última' },
      { k: '10@a', d: 'Reproducir 10 veces' },
      { k: '"ayy / "ap', d: 'Copiar/pegar usando el registro a' },
      { k: '"0p', d: 'Pegar el último yank (no pisado por delete)' },
      { k: '"+y / "+p', d: 'Copiar/pegar del portapapeles del sistema' },
