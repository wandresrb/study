    cat: 'Completado (blink.cmp)', icon: '⚡', items: [
      { k: 'Ctrl-Space', d: 'Abrir/cerrar el menú' },
      { k: 'Ctrl-y', d: 'Aceptar candidato' },
      { k: 'Ctrl-n / Ctrl-p', d: 'Siguiente / anterior' },
      { k: 'Ctrl-e', d: 'Cancelar' },
      { k: 'Ctrl-k', d: 'Signature help' },
      { k: 'Tab / S-Tab', d: 'Saltar entre campos del snippet' },
    ],
  },
  {
    cat: 'Buscador (snacks)', icon: '🔎', items: [
      { k: '<leader>ff', d: 'Buscar archivos' },
      { k: '<leader>fg', d: 'Grep en el proyecto' },
      { k: '<leader>fb', d: 'Buffers abiertos' },
      { k: '<leader>fr', d: 'Archivos recientes' },
      { k: '<leader>fs', d: 'Símbolos del archivo' },
