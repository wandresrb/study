      { k: '0 / ^ / $', d: 'Inicio / primer no-blanco / fin de línea' },
      { k: 'gg / G', d: 'Inicio / final del archivo' },
      { k: '{ / }', d: 'Párrafo anterior / siguiente' },
      { k: 'Ctrl-d / Ctrl-u', d: 'Media pantalla abajo / arriba' },
      { k: 'f{c} / t{c}', d: 'Saltar a / justo antes de un carácter' },
      { k: '; / ,', d: 'Repetir f/t adelante / atrás' },
      { k: '% ', d: 'Saltar al paréntesis/llave que empareja' },
      { k: '/texto  ·  n / N', d: 'Buscar y navegar coincidencias' },
      { k: '*', d: 'Buscar la palabra bajo el cursor' },
    ],
  },
  {
    cat: 'Edición (verbos)', icon: '✏️', items: [
      { k: 'i a o / I A O', d: 'Entrar en modo Insertar (varios puntos)' },
      { k: 'd{moción}', d: 'Borrar hasta la moción' },
      { k: 'c{moción}', d: 'Cambiar (borrar + insertar)' },
      { k: 'y{moción}', d: 'Copiar (yank)' },
      { k: 'p / P', d: 'Pegar después / antes' },
      { k: 'dd / yy / cc', d: 'Borrar / copiar / cambiar línea entera' },
      { k: 'x / r{c}', d: 'Borrar / reemplazar un carácter' },
      { k: 'u / Ctrl-r', d: 'Deshacer / rehacer' },
      { k: '.', d: 'Repetir la última edición' },
      { k: '> / < / =', d: 'Indentar / desindentar / auto-indentar' },
      { k: 'gc{moción}', d: 'Comentar (nativo 0.11)' },
