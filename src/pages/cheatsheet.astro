      { k: ':Lazy / :Mason', d: 'Gestor de plugins / de herramientas' },
      { k: ':checkhealth', d: 'Diagnóstico de la instalación' },
    ],
  },
  {
    cat: 'Buffers, ventanas y tabs', icon: '🪟', items: [
      { k: ':ls  ·  :b {nombre}', d: 'Listar buffers / saltar a uno' },
      { k: ':bn  ·  :bp  ·  <C-^>', d: 'Buffer siguiente / anterior / alterno' },
      { k: '<C-w>s  ·  <C-w>v', d: 'Split horizontal / vertical' },
      { k: '<C-w>o  ·  <C-w>=', d: 'Solo esta ventana / igualar tamaños' },
      { k: '<C-w>H/J/K/L', d: 'Mover la ventana a un borde' },
      { k: ':tabnew  ·  gt / gT', d: 'Nueva pestaña / cambiar de pestaña' },
    ],
  },
  {
    cat: 'Folds (plegado)', icon: '🗂️', items: [
      { k: 'za', d: 'Alterna el fold bajo el cursor' },
      { k: 'zo / zc', d: 'Abrir / cerrar el fold' },
      { k: 'zR / zM', d: 'Abrir todos / cerrar todos' },
      { k: 'zj / zk', d: 'Saltar al siguiente / anterior fold' },
      { k: 'zv', d: 'Abrir lo justo para ver el cursor' },
    ],
  },
  {
    cat: 'Quickfix', icon: '🚑', items: [
      { k: ':grep patrón', d: 'Buscar en el proyecto → quickfix' },
      { k: ':copen / :cclose', d: 'Abrir / cerrar la lista' },
      { k: ']q / [q', d: 'Entrada siguiente / anterior' },
      { k: ':cdo cmd | update', d: 'Ejecutar en cada entrada y guardar' },
      { k: ':cfdo cmd', d: 'Ejecutar una vez por archivo' },
    ],
  },
  {
    cat: 'Saltos, marcas y deshacer', icon: '📍', items: [
      { k: 'm{x}  ·  `{x}', d: 'Poner marca / saltar a marca (exacta)' },
      { k: 'mA … `A', d: 'Marcas MAYÚSCULAS: cruzan archivos' },
      { k: '<C-o> / <C-i>', d: 'Jumplist: atrás / adelante' },
      { k: 'g; / g,', d: 'Changelist: cambio anterior / siguiente' },
      { k: 'g- / g+', d: 'Viajar por el árbol de deshacer' },
      { k: ':earlier 10m', d: 'Volver al estado de hace 10 min' },
    ],
  },
  {
    cat: 'Búsqueda avanzada', icon: '🔮', items: [
      { k: '/\\v …', d: 'Very magic: regex sin tanto escape' },
      { k: '\\zs  ·  \\ze', d: 'Marca inicio / fin real de la coincidencia' },
      { k: '* / #', d: 'Buscar la palabra bajo el cursor' },
      { k: 'cgn  →  .  /  n', d: 'Cambiar coincidencia, repetir o saltar' },
      { k: ':%s/\\v(a)(b)/\\2\\1/', d: 'Reemplazo con grupos de captura' },
      { k: ':%s/a/b/gc', d: 'Reemplazo con confirmación' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Neovim Nivel Dios" description="Referencia buscable de todos los atajos y comandos de Neovim de la guía.">
  <header class="topbar">
    <span class="brand-mini">Neovim <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="neovim" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--mauve)">⌘ REFERENCIA · {total} comandos</span>
          <h1>Cheatsheet</h1>
          <p class="desc">Toda la munición de la guía en un solo sitio. Busca por tecla o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'borrar palabra', 'gd', 'grep', 'macro'…" aria-label="Buscar comandos" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';

    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };

    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
