---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "Conceptos",
    "icon": "🔀",
    "items": [
      {
        "k": "FSM",
        "d": "Estados finitos, eventos, transiciones"
      },
      {
        "k": "statechart",
        "d": "FSM + jerarquía, paralelismo e historia"
      },
      {
        "k": "DFA / NFA",
        "d": "Determinista y no determinista"
      },
      {
        "k": "Mealy / Moore",
        "d": "Salida en la transición o en el estado"
      },
      {
        "k": "SCXML",
        "d": "El estándar W3C que sigue XState"
      }
    ]
  },
  {
    "cat": "XState: máquina",
    "icon": "⚙️",
    "items": [
      {
        "k": "setup({ types, actions, guards, actors })",
        "d": "Declarar antes de la máquina (v5)"
      },
      {
        "k": "createMachine({ initial, states })",
        "d": "Definir la máquina"
      },
      {
        "k": "on: { EVENTO: { target } }",
        "d": "Transición por evento"
      },
      {
        "k": "context",
        "d": "Estado extendido (datos)"
      },
      {
        "k": "assign({ … })",
        "d": "Actualizar el context"
      },
      {
        "k": "guard: \"puede\"",
        "d": "Transición condicional"
      },
      {
        "k": "entry / exit",
        "d": "Acciones al entrar y salir"
      }
    ]
  },
  {
    "cat": "Estructura",
    "icon": "🪆",
    "items": [
      {
        "k": "states anidados",
        "d": "Estado compuesto (jerarquía)"
      },
      {
        "k": "type: \"parallel\"",
        "d": "Regiones ortogonales activas a la vez"
      },
      {
        "k": "type: \"history\"",
        "d": "Volver al subestado anterior"
      },
      {
        "k": "type: \"final\" + onDone",
        "d": "Terminar y avisar al padre"
      },
      {
        "k": "state.matches(\"a.b\")",
        "d": "Comprobar estado anidado"
      }
    ]
  },
  {
    "cat": "Actores",
    "icon": "🎭",
    "items": [
      {
        "k": "createActor(machine).start()",
        "d": "Ejecutar la máquina"
      },
      {
        "k": "invoke: { src, onDone, onError }",
        "d": "Actor ligado a un estado"
      },
      {
        "k": "fromPromise / fromObservable",
        "d": "Envolver async como actor"
      },
      {
        "k": "spawnChild(...)",
        "d": "Crear un actor hijo"
      },
      {
        "k": "sendTo / sendParent",
        "d": "Mensajes entre actores"
      }
    ]
  },
  {
    "cat": "UI y herramientas",
    "icon": "👁️",
    "items": [
      {
        "k": "useMachine(machine)",
        "d": "Conectar a React"
      },
      {
        "k": "useSelector(actor, sel)",
        "d": "Suscribirse a una parte"
      },
      {
        "k": "createBrowserInspector()",
        "d": "Ver transiciones en vivo"
      },
      {
        "k": "Stately Studio",
        "d": "Diseñar y visualizar el statechart"
      },
      {
        "k": "getNextSnapshot(...)",
        "d": "Transición pura para testear"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Máquinas de Estado" description="FSM, statecharts y XState en un sitio: estados, transiciones, actores, testing y visualización.">
  <header class="topbar">
    <span class="brand-mini">Máquinas <b>de Estado</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="maquinas" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--sky)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Máquinas de Estado</h1>
          <p class="desc">FSM, statecharts y XState en un sitio: estados, transiciones, actores, testing y visualización.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'createMachine', 'guard', 'invoke', 'spawn'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
