---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import Categoria from '../components/Categoria.astro';
import { getTracks, getMapa, minutosDe } from '../data/contenido';

const lecciones = await getCollection('guia');
const totalLecciones = lecciones.length;
const totalHoras = Math.round(lecciones.reduce((a, l) => a + minutosDe(l.data.duracion), 0) / 60);
const disponibles = (await getTracks()).filter((t) => t.data.estado === 'disponible').length;
const mapa = await getMapa();

const planos = [
  {
    id: 'entorno',
    pestana: 'Entorno de desarrollo',
    kicker: 'Las herramientas',
    titulo: 'Entorno de desarrollo',
    sub: 'El editor, la shell y el sistema de construcción. Lo que usas todos los días, antes que cualquier lenguaje.',
    cats: mapa.entorno,
  },
  {
    id: 'nucleo',
    pestana: 'El núcleo',
    kicker: 'Los conceptos',
    titulo: 'Core Computer Science',
    sub: 'La matemática y la ciencia que sostienen todo lo demás. Es cierto independientemente de la tecnología que uses.',
    cats: mapa.nucleo,
  },
  {
    id: 'aplicaciones',
    pestana: 'Aplicaciones',
    kicker: 'Los dominios',
    titulo: 'Las aplicaciones',
    sub: 'Dónde se implementa el núcleo. Un mismo concepto reaparece aquí con la forma que le da cada plataforma.',
    cats: mapa.aplicaciones,
  },
] as const;

const ANCHO = 'mx-auto w-full max-w-[1500px] px-4 sm:px-10';

const PESTANA =
  'rounded-full px-4 py-2 font-mono text-[0.82rem] whitespace-nowrap text-subtext0 transition-colors hover:text-text aria-selected:bg-surface0/70 aria-selected:text-text';
const BOTON =
  'rounded-full border border-borde px-3 py-1.5 font-mono text-[0.72rem] text-overlay1 transition-colors hover:border-overlay0 hover:text-text';
---

<BaseLayout
  buscador
  title="Nivel Dios · Tu hub de estudio"
  description="Guías interactivas para dominar tecnología de cero a nivel dios: Neovim, Swift & iOS, y Systems Programming (C23, Kernel, Rust)."
>
  <section class={`${ANCHO} pt-16 pb-10 sm:pt-24`}>
    <p
      class="inline-flex items-center gap-2 rounded-full border border-borde bg-mantle/70 px-3.5 py-1.5 font-mono text-[0.76rem] text-subtext0"
    >
      {disponibles} temas · {totalLecciones} lecciones · {totalHoras} h de estudio
    </p>

    <h1 class="mt-6 text-[clamp(2.4rem,6vw,4.4rem)]/[1.02] font-extrabold tracking-[-0.035em] text-balance">
      Tu hub de estudio<br />
      <span class="bg-linear-to-r from-mauve via-lavender to-blue bg-clip-text text-transparent">
        nivel dios
      </span>
    </h1>

    <p class="mt-5 max-w-[58ch] text-[clamp(1rem,1.5vw,1.15rem)]/[1.65] text-subtext0 text-pretty">
      Guías interactivas y profundas para dominar tecnología de cero a experto. Elige un tema y
      recorre el camino, nivel a nivel.
    </p>
  </section>

  {/* Pegajosa justo debajo de la cabecera: --h-cabecera la mide global.css. */}
  <div class="sticky top-[var(--h-cabecera)] z-20 border-y border-borde bg-base/85 py-3 backdrop-blur-[10px]">
    <div class={`${ANCHO} flex flex-wrap items-center gap-x-4 gap-y-2`}>
      <div class="-mx-1 flex gap-1 overflow-x-auto" role="tablist" aria-label="Planos del mapa">
        {
          planos.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class={PESTANA}
            >
              {p.pestana}
              <span class="ml-1.5 text-overlay0">{p.cats.length}</span>
            </button>
          ))
        }
      </div>

      <div class="ml-auto flex gap-2">
        <button type="button" data-todo="abrir" class={BOTON}>Expandir todo</button>
        <button type="button" data-todo="cerrar" class={BOTON}>Colapsar todo</button>
      </div>
    </div>
  </div>

  {
    planos.map((plano, i) => (
      <section
        id={`panel-${plano.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${plano.id}`}
        hidden={i !== 0}
        class={`${ANCHO} pt-10 pb-16`}
      >
        <div class="max-w-[62ch]">
          <p class="m-0 font-mono text-[0.76rem] tracking-[0.16em] text-overlay1 uppercase">
            {plano.kicker}
          </p>
          <h2 class="mt-2 text-[clamp(1.7rem,3.4vw,2.5rem)]/[1.1] font-bold tracking-[-0.02em]">
            {plano.titulo}
          </h2>
          <p class="mt-3 text-[0.98rem]/[1.65] text-subtext0 text-pretty">{plano.sub}</p>
        </div>

        {plano.cats.map(({ cat, tracks, escritos, porEscribir, lecciones, minutos }) => (
          <Categoria
            id={cat.id}
            nombre={cat.data.nombre}
            descripcion={cat.data.descripcion}
            icono={cat.data.icono}
            color={cat.data.colorHex}
            gradFrom={cat.data.gradFrom}
            gradTo={cat.data.gradTo}
            resumen={
              escritos.length > 0
                ? `${escritos.length} ${escritos.length === 1 ? 'tema' : 'temas'} · ${lecciones} lecciones · ${Math.round(minutos / 60)} h`
                : `${porEscribir.length} temas por escribir`
            }
          >
            {tracks.map((t) => (
              <TrackCard track={t} />
            ))}
          </Categoria>
        ))}
      </section>
    ))
  }
</BaseLayout>

<script>
  // Con <ClientRouter /> los módulos no se reejecutan: todo cuelga de
  // `astro:page-load`, que dispara también en la carga inicial.
  function montarHub() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (tabs.length === 0) return;
    const paneles = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    const activar = (i: number, foco = true) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
        paneles[j].hidden = j !== i;
      });
      if (foco) tabs[i].focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activar(i, false));
      // Flechas dentro de la tira, que es lo que espera un tablist.
      t.addEventListener('keydown', (e) => {
        const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!paso) return;
        e.preventDefault();
        activar((i + paso + tabs.length) % tabs.length);
      });
    });

    // La paleta de ⌘K enlaza a /hub/#cat-<id>, y esa categoría puede estar en
    // una pestaña oculta: sin esto el salto no lleva a ningún sitio visible.
    const irAlAncla = () => {
      const id = location.hash.slice(1);
      if (!id.startsWith('cat-')) return;
      const cat = document.getElementById(id) as HTMLDetailsElement | null;
      if (!cat) return;
      const i = paneles.findIndex((p) => p.contains(cat));
      if (i >= 0) activar(i, false);
      cat.open = true;
      cat.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    addEventListener('hashchange', irAlAncla);
    irAlAncla();

    // Expandir / colapsar afecta solo a la pestaña visible: un botón que actúa
    // sobre lo que no se ve deja al usuario sin saber qué hizo.
    document.querySelectorAll<HTMLButtonElement>('[data-todo]').forEach((b) =>
      b.addEventListener('click', () => {
        const abrir = b.dataset.todo === 'abrir';
        paneles
          .find((p) => !p.hidden)
          ?.querySelectorAll('details')
          .forEach((d) => (d.open = abrir));
      }),
    );
  }

  document.addEventListener('astro:page-load', montarHub);
</script>
