---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tabline from '../components/terminal/Tabline.tsx';
import Statusline from '../components/terminal/Statusline.tsx';
import { getConcepts, getTotals } from '../data/content';

const totals = getTotals();
const concepts = getConcepts().length;
const hours = Math.round(totals.minutes / 60);

// One character grid: everything monospace, one size — you are IN the
// terminal, not looking at a picture of one. The buffer is ~/README.md as
// nvim would paint it: gutter numbers, markdown syntax colors, ~ after EOF.
const line = 'flex px-2';
const lnum = 'w-12 shrink-0 select-none pr-5 text-right text-overlay0';

const TREE = [
  { label: 'cs/', href: '/cs/', note: `${totals.tracks} temas · ${totals.lessons} lecciones · ${hours} h` },
  { label: 'concepts/', href: '/concepts/', note: `${concepts} conceptos medidos` },
  { label: '.config/nvim/', href: '/config/', note: 'mi editor, fichero a fichero' },
  { label: 'README.md', href: '/about/', note: 'quién escribe esto' },
];
---
<BaseLayout chrome="own" title="willy@wandres.dev — nvim" description="La máquina de un computer scientist: un centro de estudios de ciencias de la computación que se navega como Neovim.">
  <div class="grid h-svh grid-rows-[auto_minmax(0,1fr)_auto_auto] bg-base font-mono text-[15px]/7 text-text">
    <Tabline client:load active="~" />

    <main class="overflow-y-auto pt-1" aria-label="~/README.md">
      <div class={line}><span class={lnum}>1</span><span><span class="bg-subtext1 text-crust">#</span><b class="text-peach"> wandres.dev</b></span></div>
      <div class={line}><span class={lnum}>2</span><span></span></div>
      <div class={line}><span class={lnum}>3</span><span>Un centro de estudios de ciencias de la computación, escrito por un</span></div>
      <div class={line}><span class={lnum}>4</span><span>ingeniero de software sénior que trabaja en Rust, sistemas distribuidos</span></div>
      <div class={line}><span class={lnum}>5</span><span>y arquitecturas local-first.</span></div>
      <div class={line}><span class={lnum}>6</span><span></span></div>
      <div class={line}><span class={lnum}>7</span><span>Esto es mi máquina. Se navega con el ratón — o como Neovim, si sabes:</span></div>
      <div class={line}><span class={lnum}>8</span><span class="text-overlay1">j/k moverse · ⏎ abrir · gt / gT cambiar de tab</span></div>
      <div class={line}><span class={lnum}>9</span><span></span></div>
      <div class={line}><span class={lnum}>10</span><span class="text-yellow">## ~/</span></div>
      <div class={line}><span class={lnum}>11</span><span></span></div>
      {TREE.map((entry, i) => (
        <a href={entry.href} data-tree-row class={`${line} no-underline hover:bg-surface0/60 focus-visible:bg-surface0/60 focus-visible:outline-none`}>
          <span class={lnum}>{12 + i}</span>
          <span class="flex min-w-0 flex-1 gap-2">
            <span class="text-overlay0">-</span>
            <span><span class="text-teal">[{entry.label}]</span><span class="text-overlay0">({entry.href})</span></span>
            <span class="ml-auto hidden truncate pr-2 text-overlay0 md:inline">{entry.note}</span>
          </span>
        </a>
      ))}
      {Array.from({ length: 28 }).map(() => (
        <div class={line}><span class={`${lnum} opacity-60`}>~</span><span></span></div>
      ))}
    </main>

    <Statusline client:load path="~/README.md" hint="j/k moverse · ⏎ abrir" />

    <p class="m-0 flex justify-between px-2 py-0.5 text-sm text-subtext0">
      <span>"~/README.md" 15L, 731B</span>
      <span class="hidden text-overlay0 sm:inline">escribe : o / — o usa el ratón, como siempre</span>
    </p>
  </div>
</BaseLayout>

<script>
  // j/k move the cursorline across the tree rows; Enter opens (native link).
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'j' && e.key !== 'k') return;
    const target = e.target as HTMLElement | null;
    if (target?.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target?.tagName ?? '')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tree-row]'));
    if (!rows.length) return;
    e.preventDefault();
    const current = rows.indexOf(document.activeElement as HTMLAnchorElement);
    const next = e.key === 'j' ? Math.min(current + 1, rows.length - 1) : Math.max(current - 1, 0);
    rows[next]?.focus();
  });
</script>
