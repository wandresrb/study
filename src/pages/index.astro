---
import { codeToHtml } from 'shiki';

import BaseLayout from '../layouts/BaseLayout.astro';
import Layer from '../components/home/Layer.astro';
import Console from '../components/home/Console.tsx';
import Stack from '../components/home/Stack.tsx';
import { PROGRAM } from '../home/program';
import { SHIKI_THEMES } from '../lib/themes';

const CODE = await codeToHtml(PROGRAM, {
  lang: 'rust',
  themes: SHIKI_THEMES,
  defaultColor: false,
});
---

<BaseLayout
  chrome="floating"
  title="wandres.dev · Las capas de una máquina"
  description="La placa convirtiéndose en el primer piso: los niveles de abstracción de un computador real."
>
  <main id="content" class="overflow-visible">
    {/* The landing is a 3D scene with no headline of its own, and a page with no
        h1 has no outline for a screen reader or a search engine. */}
    <h1 class="sr-only">wandres.dev · Las capas de una máquina</h1>
    <div class="max-w-site">
      <Console client:load code={CODE} />
    </div>
    <Layer id="hardware" scene="hardware">
      <Stack client:load />
    </Layer>
  </main>
</BaseLayout>

<script>
  import '../home/scroll';
</script>
