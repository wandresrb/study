---
import { codeToHtml } from 'shiki';

import BaseLayout from '../layouts/BaseLayout.astro';
import Consola from '../components/Consola.tsx';
import Pila from '../components/Pila.tsx';

// El programa que arranca todo. Se resalta EN EL BUILD con Shiki —el mismo
// motor y el mismo tema que usa el resto del sitio para el código— así que
// llega HTML ya coloreado y no cuesta un byte de JavaScript en el navegador.
//
// Tree-sitter habría sido un WASM de uno o dos megas para colorear diez líneas
// que no cambian nunca, y encima con un tema distinto al de las lecciones.
const PROGRAMA = `fn main() {
    let mut maquina = Stack::new();

    // Una placa sola es una pieza.
    // Con lo que se ve y lo que se toca, es hardware.
    maquina.push(Hardware {
        placa:   Placa::micro_atx(),
        salidas: vec![Monitor, Teclado, Raton],
    });
}`;

// Se resalta AQUÍ, en el build, y el resultado viaja como HTML a la isla. Es
// el mismo motor y el mismo tema que usa el resto del sitio para el código.
const CODIGO = await codeToHtml(PROGRAMA, { lang: 'rust', theme: 'catppuccin-mocha' });

// La portada: la placa convirtiéndose en el primer piso de una pila.
//
// El avance sale del scroll: la capa mide más que la pantalla y su hijo va
// anclado, así que el trozo que sobra ES el recorrido. Subir deshace lo que
// bajar montó sin escribir una línea para ello.
//
// Y se puede recorrer con el teclado — `j` y `k`, como en el editor, o con las
// flechas. No es un guiño: es lo que el sitio enseña, y hay que anunciarlo,
// porque si no nadie lo descubre.

// En qué punto del scroll la CÁMARA ya ha terminado su recorrido.
//
// Todo lo que queda después es la transformación en pila, y necesita su propio
// trecho: es un cuarto del scroll de la página. Compartiéndolo con la cámara
// pasaban dos cosas a la vez y no daba tiempo a leer ninguna.
//
// Tiene que ser el mismo número que en el guion de abajo.
const FIN = 0.72;

// Los momentos del recorrido, EN EL ESPACIO DE LA ESCENA (de 0 a 1). Se
// reescalan al del scroll más abajo: si se escribieran ya reescalados, cambiar
// el respiro obligaría a recalcular ocho números a mano.
const MOMENTOS = [
  {
    a: 0,
    b: 0.32,
    kicker: 'El suelo',
    titulo: 'Todo descansa sobre una placa',
    linea: 'Silicio, pistas, instrucciones. El piso de toda plataforma y todo sistema.',
  },
  {
    a: 0.32,
    b: 0.56,
    kicker: 'Tiene volumen',
    titulo: 'Y no es un dibujo',
    linea:
      'Disipadores, ranuras, conectores. Cosas con altura y con sombra: por eso hay que verla de canto para creérsela.',
  },
  {
    a: 0.56,
    b: 0.76,
    kicker: 'Sale de ahí',
    titulo: 'La señal no se queda dentro',
    linea:
      'Cruza los puertos y sigue por los cables hasta lo que ves y lo que tocas. Una placa sola es una pieza; con esto es una máquina.',
  },
  {
    a: 0.76,
    b: 1,
    kicker: 'Se apila',
    titulo: 'Y toda esa máquina es una capa',
    linea:
      'Se queda el qué y se tira el cómo. Eso es una abstracción — y así entra en la pila: hardware, el primer elemento.',
    invita: { texto: 'Empieza por donde quieras', href: '/mapa/' },
  },
] as const;

/** Los mismos momentos, ya en el espacio del scroll. El último llega hasta 1. */
const TRAMOS_TEXTO = MOMENTOS.map((m, k) => ({
  ...m,
  a: m.a * FIN,
  b: k === MOMENTOS.length - 1 ? 1 : m.b * FIN,
}));
// El último momento cubre toda la transformación en pila, que es lo que se está
// contando mientras la máquina se va al suelo.

// El recorrido que consume la capa por encima de su pantalla anclada. Es el
// único mando para el largo de la página.
const TRAMOS = 7.5;
---

<BaseLayout
  title="Nivel Dios · Las capas de una máquina"
  description="La placa convirtiéndose en el primer piso: los niveles de abstracción de un computador real."
>
  <header class="portada-top">
    <a class="portada-marca" href="/">
      <span class="logo">∞</span>
      <span>wandres.dev</span>
    </a>
    <a class="portada-salta" href="/mapa/">Ver los temas <span aria-hidden="true">→</span></a>
  </header>

  <nav class="riel" aria-label="Recorrido">
    <ol>
      {
        TRAMOS_TEXTO.map((m, k) => (
          <li>
            <button class="riel-marca" type="button" data-ir={k}>
              <span class="riel-num">{String(k + 1).padStart(2, '0')}</span>
              <span class="riel-nombre">{m.kicker}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </nav>

  {/* Nadie adivina que se puede mover con el teclado si no se lo dicen. */}
  <p class="teclas" id="teclas">
    <kbd>j</kbd><kbd>k</kbd>
    <em>o</em>
    <kbd>↓</kbd><kbd>↑</kbd>
    <span>para moverte</span>
  </p>

  <main class="portada" id="portada">
    <section class="capa" id="hardware" data-capa="0" style={`--tramos:${TRAMOS}`}>
      <div class="capa-pin">
        <div class="capa-escena" data-escena="lienzo" data-capa-id="hardware" aria-hidden="true">
        </div>

        {/* La columna de la derecha. El editor es CÓMO entras; la pila es DÓNDE
            estás. Por eso el editor se pliega tras arrancar y la pila se queda:
            una herramienta no es un mapa. */}
        {/* La columna de la derecha. El editor es CÓMO entras; la pila es DÓNDE
            estás. Por eso el editor se pliega tras arrancar y la pila se queda:
            una herramienta no es un mapa.

            Son islas: lo único de la página con estado propio. El resto sigue
            siendo HTML estático. */}
        <aside class="lateral">
          <Consola client:load codigo={CODIGO} />
          <Pila client:load />
        </aside>

        <div class="capa-texto">
          {
            TRAMOS_TEXTO.map((m, k) => (
              <div
                class="momento"
                data-momento={k}
                style={`--a:${m.a};--b:${m.b}`}
                data-ultimo={k === TRAMOS_TEXTO.length - 1 ? '' : undefined}
              >
                <p class="capa-idx">
                  <span>{String(k + 1).padStart(2, '0')}</span> {m.kicker}
                </p>
                {k === 0 ? <h1>{m.titulo}</h1> : <h2>{m.titulo}</h2>}
                <p class="capa-linea">{m.linea}</p>
                {'invita' in m && m.invita && (
                  <a class="capa-invita" href={m.invita.href}>
                    {m.invita.texto} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* Solo en esta ruta. El sitio funcional desplaza las anclas 90 px por su
     cabecera fija; aquí ese desplazamiento dejaría la capa 90 px corta de su
     punto de anclaje y el avance nunca empezaría en 0. */
  html {
    scroll-padding-top: 0;
  }
  /* Hasta que no se pulsa Run no hay recorrido, así que no hay scroll. Rodar
     una página que todavía no ha arrancado solo enseña el final antes de
     tiempo. */
  html[data-fase='inicio'],
  html[data-fase='inicio'] body,
  html[data-fase='saliendo'],
  html[data-fase='saliendo'] body {
    overflow: hidden;
    height: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* ---------- La columna de la derecha ---------- */

  .lateral {
    position: absolute;
    z-index: 4;
    right: clamp(1.5rem, 4vw, 3rem);
    top: 50%;
    translate: 0 -50%;
    width: min(31rem, 42%);
    display: grid;
    gap: 1.1rem;
    align-content: center;
  }

  /* La consola se pliega tras arrancar, pero NO se va: la pestaña queda y se
     puede volver a abrir. Perder el camino de vuelta era el problema. */
  .consola-pestana {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--overlay0);
    border-radius: var(--radius-sm);
    background: var(--mantle);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--subtext0);
    cursor: pointer;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .consola-pestana:hover,
  .consola-pestana:focus-visible {
    color: var(--text);
  }
  .consola-flecha {
    display: inline-block;
    font-size: 0.6rem;
    transition: rotate 0.22s var(--ease);
  }
  .consola.plegada .consola-flecha {
    rotate: -90deg;
  }
  .consola.plegada .consola-cuerpo {
    display: none;
  }
  .consola-cuerpo {
    display: grid;
    gap: 0.8rem;
    margin-top: 0.7rem;
  }

  .editor {
    /* El borde es lo ÚNICO que separa el panel de la página: los rellenos de
       Catppuccin contiguos dan 1.07:1 entre sí, así que el peso lo tiene que
       llevar el contorno. `surface0` daba 1.40:1 — invisible. */
    border: 1px solid var(--overlay0);
    border-radius: var(--radius-sm);
    background: var(--mantle);
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.75);
    overflow: hidden;
  }
  .editor-barra {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--surface1);
    background: var(--crust);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--subtext0);
  }
  .editor-punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--surface1);
  }
  .editor-barra b {
    margin-left: 0.5rem;
    font-weight: 400;
  }

  /* Shiki ya trae el color; aquí van el canal de numeración y la línea activa.
     Los números salen de un contador de CSS: meter un `<span>` por línea para
     algo que la hoja de estilos cuenta sola no tiene sentido. */
  .editor pre.shiki {
    margin: 0;
    padding: 0.9rem 1.1rem 0.9rem 0;
    background: none !important;
    font-size: 0.79rem;
    line-height: 1.8;
    counter-reset: linea;
    overflow-x: auto;
  }
  /* ARREGLO del doble interlineado.
     Shiki emite `<span class="line">…</span>\n<span class="line">…</span>`, y
     dentro de un <pre> ese salto de línea SE RENDERIZA. Al poner las líneas en
     bloque, cada una traía su propio salto MÁS el del texto: doble espacio.
     Con el <code> en rejilla, cada línea es una celda y los nodos que solo
     tienen espacios no generan celda. */
  .editor pre.shiki code {
    display: grid;
  }
  .editor pre.shiki .line {
    padding-right: 1rem;
  }
  .editor pre.shiki .line::before {
    counter-increment: linea;
    content: counter(linea);
    display: inline-block;
    width: 3.1rem;
    padding-right: 0.9rem;
    margin-right: 0.9rem;
    border-right: 1px solid var(--surface1);
    background: var(--crust);
    text-align: right;
    color: var(--overlay0);
  }
  /* La línea del push, que es la que importa. */
  .editor pre.shiki .line:nth-child(6) {
    background: color-mix(in oklab, var(--surface0) 42%, transparent);
  }
  .editor pre.shiki .line:nth-child(6)::before {
    color: var(--peach);
    background: color-mix(in oklab, var(--peach) 12%, var(--crust));
  }
  .editor pre.shiki .line:nth-child(6)::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    translate: 0 0.2em;
    background: var(--peach);
    opacity: 0.85;
    animation: parpadeo 1.1s steps(1, end) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .editor-estado {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-top: 1px solid var(--surface1);
    background: var(--crust);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--overlay1);
  }
  .editor-estado b {
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    background: color-mix(in oklab, var(--blue) 78%, var(--crust));
    color: var(--crust);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .editor-estado span {
    color: var(--subtext0);
  }
  .editor-estado i {
    font-style: normal;
  }
  .editor-estado em {
    margin-left: auto;
    font-style: normal;
    color: var(--subtext0);
  }

  .terminal {
    border: 1px solid var(--overlay0);
    border-radius: var(--radius-sm);
    background: var(--crust);
    overflow: hidden;
  }
  .terminal-barra {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-bottom: 1px solid var(--surface1);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--overlay1);
  }
  .terminal-barra b {
    font-weight: 500;
    color: var(--subtext0);
  }
  .terminal pre {
    margin: 0;
    min-height: 4.6rem;
    padding: 0.7rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    line-height: 1.75;
    color: var(--subtext0);
    white-space: pre-wrap;
  }
  .terminal .orden {
    color: var(--text);
  }
  .terminal .tenue {
    color: var(--overlay1);
  }
  .terminal .ok {
    color: var(--green);
  }
  /* El prompt está desde el primer momento. Una caja vacía parece rota. */
  .terminal .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    translate: 0 0.15em;
    background: var(--subtext0);
    animation: parpadeo 1.1s steps(1, end) infinite;
  }

  .correr {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    padding: 0.62rem 1.1rem;
    border: 1px solid color-mix(in oklab, var(--green) 55%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--green) 12%, transparent);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--green);
    cursor: pointer;
    transition: background 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .correr:hover:not(:disabled),
  .correr:focus-visible {
    background: color-mix(in oklab, var(--green) 20%, transparent);
  }
  .correr:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .correr-icono {
    font-size: 0.7rem;
  }
  .correr kbd {
    border-color: color-mix(in oklab, var(--green) 35%, var(--surface1));
    color: color-mix(in oklab, var(--green) 70%, var(--subtext0));
  }

  /* ---------- La pila: estado Y navegación ---------- */

  .pila-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pila-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.4rem;
    padding: 0.9rem 1rem;
    /* Contorno de puntos: sitio reservado, no ocupado. `overlay0` es el primer
       tono de la paleta que llega al mínimo de 3:1 contra el fondo. */
    border: 1px dashed var(--overlay0);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }
  .pila-dir {
    font-size: 0.76rem;
    color: var(--overlay2);
  }
  .pila-libre {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--overlay2);
  }
  .pila-lleno {
    display: none;
    align-items: baseline;
    gap: 0.9rem;
    flex: 1;
  }
  .pila-lleno b {
    font-weight: 400;
    font-size: 0.76rem;
    color: var(--overlay2);
  }
  .pila-nombre {
    font-size: 1.05rem;
    letter-spacing: 0.18em;
    color: var(--text);
  }
  .pila-lleno i {
    margin-left: auto;
    font-style: normal;
    font-size: 0.72rem;
    color: var(--overlay2);
  }
  .pila-pop {
    display: none;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in oklab, var(--mauve) 55%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--mauve) 12%, transparent);
    font: inherit;
    font-size: 0.72rem;
    color: var(--mauve);
    cursor: pointer;
    transition: background 0.18s var(--ease);
  }
  .pila-pop:hover,
  .pila-pop:focus-visible {
    background: color-mix(in oklab, var(--mauve) 24%, transparent);
  }

  /* Llena: la ranura tiene cuerpo, aparece el nombre y aparece el pop. Solo el
     de arriba se puede sacar — es una pila, no una lista. */
  .pila-item[data-puesta] {
    border-style: solid;
    border-color: var(--overlay1);
    background: var(--mantle);
  }
  .pila-item[data-puesta] .pila-libre {
    display: none;
  }
  .pila-item[data-puesta] .pila-lleno,
  .pila-item[data-puesta] .pila-pop {
    display: flex;
  }

  /* El suelo. No hay techo: una pila que crece no tiene tapa, y ahí es donde
     irá software. */
  .pila-base {
    height: 1px;
    margin-top: 0.7rem;
    background: var(--overlay1);
  }
  .pila-sp {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--mauve);
  }
  .pila-sp b {
    font-weight: 600;
  }

</style>

<style>
  /* `--p` es el avance de la capa, de 0 a 1, y lo escribe el script leyendo el
     scroll. Registrarlo con @property lo convierte en un número de verdad, y
     con eso el cruce de textos se resuelve en CSS sin tocar el DOM. */
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .portada {
    overflow: visible;
  }

  /* ---------- Cabecera y salto ---------- */

  .portada-top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }
  .portada-top > * {
    pointer-events: auto;
  }
  .portada-marca {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }
  .portada-marca .logo {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--mauve), var(--blue));
    color: var(--crust);
    font-weight: 700;
  }
  /* Quien vuelve no paga peaje. */
  .portada-salta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--subtext0);
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--crust) 70%, transparent);
    backdrop-filter: blur(6px);
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .portada-salta:hover,
  .portada-salta:focus-visible {
    color: var(--text);
    border-color: var(--surface1);
  }

  /* ---------- El riel: dónde estás dentro del recorrido ---------- */

  .riel {
    position: fixed;
    z-index: 25;
    left: clamp(1rem, 4vw, 2.5rem);
    top: 50%;
    translate: 0 -50%;
  }
  .riel ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .riel-marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--overlay0);
    cursor: pointer;
    transition: color 0.18s var(--ease);
  }
  .riel-num {
    position: relative;
    width: 1.6rem;
    text-align: left;
  }
  .riel-num::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.7rem;
    height: 1px;
    background: currentColor;
    translate: 0 -50%;
    transition: width 0.24s var(--ease);
  }
  .riel-nombre {
    opacity: 0;
    translate: -4px 0;
    transition: opacity 0.2s var(--ease), translate 0.2s var(--ease);
  }
  .riel-marca:hover .riel-nombre,
  .riel-marca:focus-visible .riel-nombre,
  .riel-marca[aria-current='true'] .riel-nombre {
    opacity: 1;
    translate: 0 0;
  }
  .riel-marca[aria-current='true'] {
    color: var(--lavender);
  }
  .riel-marca[aria-current='true'] .riel-num::after {
    width: 1.4rem;
  }
  .riel-marca:hover,
  .riel-marca:focus-visible {
    color: var(--subtext1);
  }

  /* ---------- El aviso de las teclas ---------- */

  .teclas {
    position: fixed;
    z-index: 25;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.28rem;
    margin: 0;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--crust) 78%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--overlay1);
    /* Estorba menos según se avanza: al principio hace falta, luego ya no. */
    transition: opacity 0.5s var(--ease);
  }
  .teclas em {
    font-style: normal;
    margin: 0 0.22rem;
    color: var(--overlay0);
  }
  .teclas span {
    margin-left: 0.4rem;
    color: var(--overlay0);
  }
  .teclas[data-lejos] {
    opacity: 0.25;
  }
  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--surface1);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--mantle) 80%, transparent);
    color: var(--subtext0);
    font: inherit;
    font-size: 0.7rem;
  }

  /* ---------- La capa ---------- */

  .capa {
    /* Una pantalla anclada + los tramos que la capa pide para desarrollarse.
       Todo el largo de la página sale de aquí. */
    min-height: calc((1 + var(--tramos, 1)) * 100svh);
    position: relative;
  }

  .capa-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    padding: 6rem clamp(1.5rem, 8vw, 7rem) 4rem;
    box-sizing: border-box;
  }

  .capa-escena {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* LA TRANSICIÓN DE ENTRADA Y DE SALIDA.
       La máquina llegaba y se iba de golpe porque nada la desvanecía: el
       lienzo estaba a opacidad 1 desde el montaje y lo único que cambiaba era
       si se dibujaba o no. Con esto el `Run` la trae y el `pop` se la lleva, y
       la escala da la sensación de que se acerca y se retira en vez de
       aparecer y desaparecer. */
    opacity: 0;
    scale: 1.04;
    transition: opacity 0.62s var(--ease), scale 0.62s var(--ease);
  }
  :global(html[data-fase='corriendo']) .capa-escena {
    opacity: 1;
    scale: 1;
  }

  /* Encima de una placa iluminada el texto no se lee: necesita que la esquina
     de la que sale esté apagada. */
  .capa-pin::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Entre el lienzo (0) y el texto (2). */
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--crust) 88%, transparent) 0%,
      color-mix(in oklab, var(--crust) 62%, transparent) 26%,
      transparent 58%
    );
  }
  @media (max-width: 999px) {
    /* En vertical el texto cae sobre el centro de la escena, no sobre un lado:
       el velo tiene que venir de abajo. */
    .capa-pin::before {
      background: linear-gradient(
        to top,
        color-mix(in oklab, var(--crust) 92%, transparent) 0%,
        color-mix(in oklab, var(--crust) 70%, transparent) 38%,
        transparent 72%
      );
    }
  }

  /* Los tres momentos ocupan la MISMA celda: se cruzan en el sitio en vez de
     empujarse, que es lo que permite que la cámara no dé un salto entre uno y
     otro. */
  .capa-texto {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(46ch, 100%);
    margin-left: clamp(0rem, 6vw, 5rem);
  }
  /* Mientras la consola está en pantalla el texto se estrecha para no quedar
     debajo de ella. */
    .capa-texto {
    width: min(34ch, 100%);
  }
  .momento {
    grid-area: 1 / 1;
  }

  .capa-idx {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--overlay1);
  }
  .capa-idx span {
    color: var(--mauve);
  }

  .capa-texto h1,
  .capa-texto h2 {
    margin: 0 0 1rem;
    font-size: clamp(2.1rem, 6.2vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .capa-linea {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--subtext0);
    text-wrap: pretty;
  }

  .capa-invita {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.6rem 1.05rem;
    border: 1px solid color-mix(in oklab, var(--mauve) 45%, var(--border));
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
    text-decoration: none;
    justify-self: start;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .capa-invita span {
    transition: translate 0.18s var(--ease);
  }
  .capa-invita:hover,
  .capa-invita:focus-visible {
    border-color: color-mix(in oklab, var(--mauve) 60%, var(--border));
    background: color-mix(in oklab, var(--mauve) 8%, transparent);
  }
  .capa-invita:hover span {
    translate: 3px 0;
  }

  /* ---------- El cruce de los textos ----------
     Solo con JS: `.on` lo enciende. Sin él quedan los tres visibles y legibles
     uno tras otro, que es la degradación correcta. */

  .momento {
    opacity: 1;
  }
  .portada.on .momento {
    --e: clamp(0, calc((var(--p) - var(--a)) / 0.07), 1);
    --x: clamp(0, calc((var(--p) - var(--b)) / 0.07), 1);
    opacity: calc(var(--e) - var(--x));
    translate: 0 calc((1 - var(--e)) * 1.2rem + var(--x) * -1.2rem);
    /* Un texto invisible sigue capturando el ratón: sin esto el enlace del
       último momento se traga los clics durante todo el recorrido. */
    pointer-events: none;
  }
  .portada.on .momento[data-ultimo] {
    --x: 0;
    pointer-events: auto;
  }
  /* El primero ya está en pantalla al cargar: no tiene entrada que hacer. */
  .portada.on .momento[data-momento='0'] {
    --e: 1;
  }

  /* ---------- Degradación ---------- */

  @media (prefers-reduced-motion: reduce) {
    .capa {
      min-height: auto;
    }
    .capa-pin {
      position: static;
      height: auto;
      min-height: 100svh;
    }
    /* Sin recorrido no hay cruce: los tres momentos, uno tras otro. */
    .capa-texto {
      display: block;
    }
    .momento {
      margin-bottom: 3rem;
    }
    .portada.on .momento {
      opacity: 1;
      translate: none;
      pointer-events: auto;
    }
    .riel,
    .teclas {
      display: none;
    }
    .capa-invita {
      transition: none;
    }
  }

  @media (max-width: 999px) {
    .lateral {
      position: absolute;
      right: 1rem;
      left: 1rem;
      top: auto;
      bottom: 5vh;
      width: auto;
      translate: none;
    }
    /* Con la columna abajo, el texto sube para no solaparse. */
    .capa-pin {
      align-content: start;
      padding-top: 6rem;
    }
  }

  @media (max-width: 760px) {
    .riel {
      left: auto;
      right: 0.6rem;
    }
    .riel-nombre {
      display: none;
    }
    .capa-texto {
      margin-left: 0;
    }
    /* En táctil no hay teclado que anunciar. */
    .teclas {
      display: none;
    }
  }
</style>

<script>
  import { createEffect, createRoot } from 'solid-js';

  import { empujar, fase, irA, pila, plegarConsola } from '../portada/estado';

  // El avance sale del scroll nativo: la capa mide más que la pantalla y su
  // hijo va anclado, así que el trozo que sobra ES el recorrido. Subir deshace
  // lo que bajar montó sin escribir una línea para ello.
  //
  // El valor se cuantiza en 32 pasos para la CSS. La computación es discreta y
  // el movimiento del sitio también: no interpola, salta. La escena, en cambio,
  // recibe el valor continuo — una cámara que avanza a saltos de 1/32 no se
  // mueve, parpadea.
  const PASOS = 32;

  /**
   * El guion ya no MANEJA el estado: lo observa.
   *
   * Antes había trece variables sueltas y había que acordarse de tocarlas en
   * las tres funciones que las usaban. Ahora la consola y la pila declaran en
   * qué momento está la portada, y esto reacciona: bloquea o suelta el scroll,
   * enciende o apaga la máquina y devuelve el scroll arriba.
   */
  const seguirEstado = () => {
    sueltaEstado?.();
    sueltaEstado = createRoot((soltar) => {
      createEffect(() => {
        const f = fase();
        document.documentElement.dataset.fase = f;
        const esc = anfitrion && montadas.get(anfitrion);

        if (f === 'corriendo') {
          esc?.arrancar?.();
        } else if (f === 'inicio') {
          esc?.reiniciar?.();
          // Al volver a bloquear el scroll el navegador NO devuelve la
          // posición: hay que subirla a mano, o se vuelve al inicio mirando el
          // final del recorrido.
          window.scrollTo({ top: 0, behavior: 'auto' });
          avance = -1;
          crudo = -1;
          medir();
        }
      });
      return soltar;
    });
  };

  /**
   * En qué punto del scroll la escena ya ha terminado su recorrido. El resto
   * es respiro para poder quedarse mirando el resultado.
   */
  const FIN = 0.72;

  /** Dónde empieza cada momento. Tiene que coincidir con `MOMENTOS`. */
  const MARCAS = [0, 0.32, 0.56, 0.76].map((v) => v * FIN);

  interface Escena {
    avance(p: number): void;
    /** Enciende la máquina. Antes de esto el lienzo no dibuja nada. */
    arrancar?(): void;
    /** Vuelve al punto de partida. Lo llama el `pop`. */
    reiniciar?(): void;
    destruir(): void;
  }

  /** Lo que escupe la terminal, con su retardo. Debe casar con `SALIDA`. */
  const SALIDA_JS = [
    { t: 0, texto: '$ cargo run', clase: 'orden' },
    { t: 520, texto: '   Compiling maquina v0.1.0', clase: 'tenue' },
    { t: 1180, texto: '    Finished dev [unoptimized] in 0.61s', clase: 'tenue' },
    { t: 1500, texto: '     Running `target/debug/maquina`', clase: 'ok' },
  ];
  /** Cuánto se espera tras la última línea antes de soltar la máquina. */
  const TRAS_SALIDA = 420;

  const CARGA: Record<string, () => Promise<{ montar: (h: HTMLElement) => Escena | Promise<Escena> }>> = {
    hardware: () => import('../portada/board'),
  };

  let portada: HTMLElement | null = null;
  let capa: HTMLElement | null = null;
  let anfitrion: HTMLElement | null = null;
  let marcas: HTMLElement[] = [];
  let aviso: HTMLElement | null = null;
  let avance = -1;
  let crudo = -1;
  let pendiente = false;
  let activa = -1;

  const montadas = new Map<HTMLElement, Escena>();
  const montando = new Set<HTMLElement>();
  let vigia: IntersectionObserver | null = null;

  const reducido = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let sueltaEstado: (() => void) | null = null;


  const medir = () => {
    pendiente = false;
    if (!capa) return;
    const vh = window.innerHeight;
    const r = capa.getBoundingClientRect();
    const recorrido = r.height - vh;
    const bruto = recorrido > 0 ? -r.top / recorrido : r.top <= 0 ? 1 : 0;
    const ahora = Math.min(1, Math.max(0, bruto));

    const p = Math.round(ahora * PASOS) / PASOS;
    if (p !== avance) {
      avance = p;
      capa.style.setProperty('--p', String(p));
    }
    if (ahora !== crudo) {
      crudo = ahora;
      const esc = anfitrion && montadas.get(anfitrion);
      // El recorrido de la escena TERMINA antes que el de la capa. Ese último
      // trozo es respiro: el anclaje se suelta justo cuando el avance llega a
      // 1, así que sin reservarlo la escena alcanzaba su último fotograma y se
      // iba de pantalla en el mismo gesto — parecía que desaparecía todo.
      // Se manda el avance ENTERO. El reparto entre cámara y transformación en
      // pila lo hace la escena, que es quien sabe dónde acaba cada fase.
      if (esc) esc.avance(ahora);
      // El aviso de teclas estorba cuando ya te has movido: se apaga solo.
      if (aviso) {
        if (ahora > 0.06) aviso.dataset.lejos = '';
        else delete aviso.dataset.lejos;
      }
    }

    // El momento en curso es el último cuya marca ya se pasó.
    let k = 0;
    for (let i = 0; i < MARCAS.length; i++) if (ahora >= MARCAS[i]) k = i;
    if (k !== activa) {
      activa = k;
      for (let i = 0; i < marcas.length; i++) {
        if (i === activa) marcas[i].setAttribute('aria-current', 'true');
        else marcas[i].removeAttribute('aria-current');
      }
    }
  };

  const alScroll = () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(medir);
  };

  /**
   * Lleva el scroll a la fracción del recorrido donde empieza un momento.
   *
   * Se llama `irAMomento` y no `irA` porque `irA` ya es el cambio de fase del
   * estado. Tenerlas con el mismo nombre en el mismo módulo es un
   * `SyntaxError` que tumba el guion entero en silencio — y sin guion no se
   * monta la escena.
   *
   * La posición se saca del rectángulo más el scroll actual y NO de
   * `offsetTop`: `offsetTop` se mide contra el ancestro posicionado, y en
   * cuanto alguien envuelva esto en algo con `position: relative` deja de valer
   * cero y el salto se va a otra parte.
   */
  const irAMomento = (k: number) => {
    if (!capa) return;
    const f = MARCAS[Math.max(0, Math.min(MARCAS.length - 1, k))];
    const arriba = capa.getBoundingClientRect().top + window.scrollY;
    const recorrido = Math.max(0, capa.offsetHeight - window.innerHeight);
    window.scrollTo({
      top: arriba + recorrido * f,
      behavior: reducido() ? 'auto' : 'smooth',
    });
  };

  let ultimaG = -1e9;

  const alTeclado = (e: KeyboardEvent) => {
    if (!capa) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    // Antes de arrancar no hay recorrido que recorrer: las teclas de navegación
    // no pintan nada.
    if (fase() !== 'corriendo') return;

    switch (e.key) {
      // `j` y `k` son las de siempre. Las flechas van con ellas porque quien no
      // usa el editor no tiene por qué saberlo.
      case 'j':
      case 'ArrowDown':
      case 'PageDown':
        e.preventDefault();
        irAMomento(activa + 1);
        break;
      case 'k':
      case 'ArrowUp':
      case 'PageUp':
        e.preventDefault();
        irAMomento(activa - 1);
        break;
      case 'g':
        // `gg` de verdad: dos pulsaciones seguidas. Una sola no hace nada, que
        // es exactamente como se comporta en el editor.
        e.preventDefault();
        if (performance.now() - ultimaG < 500) irAMomento(0);
        ultimaG = performance.now();
        break;
      case 'G':
      case 'End':
        e.preventDefault();
        irAMomento(MARCAS.length - 1);
        break;
      case 'Home':
        e.preventDefault();
        irAMomento(0);
        break;
    }
  };

  const soltarTodas = () => {
    for (const esc of montadas.values()) esc.destruir();
    montadas.clear();
    montando.clear();
    vigia?.disconnect();
    vigia = null;
  };

  const vigilar = () => {
    // Un margen del 60% de la ventana: la escena está lista antes de que la
    // capa entre, y se suelta cuando ya queda lejos.
    vigia = new IntersectionObserver(
      (entradas) => {
        for (const ent of entradas) {
          const host = ent.target as HTMLElement;
          const carga = CARGA[host.dataset.capaId ?? ''];
          if (!carga) continue;

          if (ent.isIntersecting) {
            if (montadas.has(host) || montando.has(host)) continue;
            montando.add(host);
            carga()
              .then((m) => m.montar(host))
              .then((esc) => {
                // Pudo salir de pantalla mientras cargaba.
                if (!montando.has(host)) {
                  esc.destruir();
                  return;
                }
                montadas.set(host, esc);
                esc.avance(crudo < 0 ? 0 : crudo);
              })
              .catch((err) => {
                if (import.meta.env.DEV) console.warn('[portada] escena no montada:', err);
              })
              .finally(() => montando.delete(host));
          } else {
            montando.delete(host);
            const esc = montadas.get(host);
            if (esc) {
              esc.destruir();
              montadas.delete(host);
            }
          }
        }
      },
      { rootMargin: '60% 0px 60% 0px' },
    );
    if (anfitrion) vigia.observe(anfitrion);
  };

  // Los oyentes se cuelgan una sola vez de objetos que sobreviven a
  // ClientRouter; lo que se renueva en cada navegación son las referencias.
  document.addEventListener('scroll', alScroll, { passive: true });
  window.addEventListener('resize', alScroll);
  document.addEventListener('keydown', alTeclado);
  document.addEventListener('astro:before-swap', soltarTodas);

  document.addEventListener('astro:before-swap', () => {
    sueltaEstado?.();
    sueltaEstado = null;
    delete document.documentElement.dataset.fase;
  });

  document.addEventListener('astro:page-load', () => {
    portada = document.getElementById('portada');
    capa = portada?.querySelector<HTMLElement>('.capa') ?? null;
    anfitrion = capa?.querySelector<HTMLElement>('.capa-escena') ?? null;
    marcas = Array.from(document.querySelectorAll<HTMLElement>('.riel-marca'));
    aviso = document.getElementById('teclas');
    avance = -1;
    crudo = -1;
    activa = -1;
    if (!portada) return;

    for (const m of marcas) {
      m.addEventListener('click', () => irAMomento(Number(m.dataset.ir ?? 0)));
    }

    portada.classList.add('on');
    // Con movimiento reducido no hay pantalla de arranque: se empuja la capa de
    // entrada y la página se lee de arriba abajo.
    if (reducido() && pila().length === 0) {
      empujar('HARDWARE');
      plegarConsola(true);
      irA('corriendo');
    }
    seguirEstado();
    medir();
    // Con movimiento reducido no hay simulación: un solo fotograma compuesto,
    // que es lo que pide esa preferencia.
    if (!reducido()) vigilar();
  });
</script>
