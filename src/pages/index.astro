---
import { codeToHtml } from 'shiki';

import BaseLayout from '../layouts/BaseLayout.astro';
import Layer from '../components/home/Layer.astro';
import Console from '../components/home/Console.tsx';
import Stack from '../components/home/Stack.tsx';
import { PROGRAM } from '../home/program';

const CODE = await codeToHtml(PROGRAM, {
  lang: 'rust',
  themes: { kanagawa: 'kanagawa-wave', catppuccin: 'catppuccin-mocha', everforest: 'everforest-dark' },
  defaultColor: false,
});
---
<BaseLayout
  chrome="floating"
  title="wandres.dev · Las capas de una máquina"
  description="La placa convirtiéndose en el primer piso: los niveles de abstracción de un computador real."
>
  <main id="home" class="overflow-visible">
    <Layer id="hardware" scene="hardware">
      <Console client:load code={CODE} />
      <Stack client:load />
    </Layer>
  </main>
</BaseLayout>

<script>
  import '../home/scroll';
</script>
