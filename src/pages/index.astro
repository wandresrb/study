---
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../components/home/Board.astro';
import BeatSection from '../components/home/Beat.astro';
import Chrome from '../components/home/Chrome.astro';
import Bars from '../components/home/figures/Bars.astro';
import Defs from '../components/home/figures/Defs.astro';
import Parts from '../components/home/figures/parts.astro';
import Cycle from '../components/home/figures/Cycle.astro';
import Datapath from '../components/home/figures/Datapath.astro';
import Flow from '../components/home/figures/Flow.astro';
import Graph from '../components/home/figures/Graph.astro';
import Hierarchy from '../components/home/figures/Hierarchy.astro';
import Log from '../components/home/figures/Log.astro';
import Morph from '../components/home/figures/Morph.astro';
import Reveal from '../components/home/figures/Reveal.astro';
import Timing from '../components/home/figures/Timing.astro';
import Tree from '../components/home/figures/Tree.astro';
import { BEATS } from '../home/journey/beats';

// The board beats open the journey and share one sticky scene.
const boardCount = BEATS.filter((b) => b.figure.kind === 'board').length;
const onBoard = BEATS.slice(0, boardCount);
const rest = BEATS.slice(boardCount);
---

<BaseLayout
  chrome="floating"
  title="wandres.dev · De la placa al navegador"
  description="Ciencias de la Computación contadas de abajo arriba: del transistor al kernel, de la syscall al navegador que pinta esta página."
>
  <main id="content" data-journey class="overflow-visible">
    <h1 class="sr-only">Centro de Estudios · Ciencias de la Computación</h1>

    <Defs />
    <Parts />
    <Chrome />

    <Board beats={onBoard} from={0} />

    {
      rest.map((beat, i) => (
        <BeatSection beat={beat} index={boardCount + i}>
          {beat.figure.kind === 'flow' && <Flow spec={beat.figure} />}
          {beat.figure.kind === 'tree' && <Tree spec={beat.figure} />}
          {beat.figure.kind === 'bars' && <Bars spec={beat.figure} />}
          {beat.figure.kind === 'cycle' && <Cycle spec={beat.figure} />}
          {beat.figure.kind === 'datapath' && <Datapath />}
          {beat.figure.kind === 'hierarchy' && <Hierarchy />}
          {beat.figure.kind === 'morph' && <Morph spec={beat.figure} />}
          {beat.figure.kind === 'log' && <Log spec={beat.figure} />}
          {beat.figure.kind === 'timing' && <Timing />}
          {beat.figure.kind === 'reveal' && <Reveal />}
          {beat.figure.kind === 'graph' && <Graph />}
        </BeatSection>
      ))
    }
  </main>
</BaseLayout>

<script>
  import '../home/journey';
</script>
