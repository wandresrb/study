---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tabline from '../components/terminal/Tabline.tsx';
import Statusline from '../components/terminal/Statusline.tsx';
import { getConcepts, getTotals } from '../data/content';

const totals = getTotals();
const concepts = getConcepts().length;
const hours = Math.round(totals.minutes / 60);

const TREE = [
  {
    name: 'cs/',
    href: '/cs/',
    note: `${totals.tracks} temas · ${totals.lessons} lecciones · ${hours} h`,
    dir: true,
  },
  { name: 'concepts/', href: '/concepts/', note: `${concepts} conceptos medidos`, dir: true },
  { name: '.config/nvim/', href: '/config/', note: 'mi editor, fichero a fichero', dir: true },
  { name: 'README.md', href: '/about/', note: 'quién escribe esto', dir: false },
];
---
<BaseLayout chrome="own" title="willy@wandres.dev" description="La máquina de un computer scientist: un centro de estudios de ciencias de la computación que se navega como Neovim.">
  <div class="flex min-h-svh flex-col bg-crust p-2 sm:p-5">
    <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-border bg-base shadow-modal">
      <!-- Barra del terminal -->
      <div class="flex items-center gap-2 border-b border-border bg-mantle px-3 py-2">
        <span class="flex gap-1.5" aria-hidden="true">
          <i class="size-2.5 rounded-full bg-red/80"></i>
          <i class="size-2.5 rounded-full bg-yellow/80"></i>
          <i class="size-2.5 rounded-full bg-green/80"></i>
        </span>
        <span class="mx-auto font-mono text-xs text-overlay1">willy@wandres.dev — nvim</span>
      </div>

      <Tabline client:load active="~" />

      <!-- El buffer: ~ (nvim ocupa el terminal entero; aquí no hay prompt) -->
      <main class="flex-1 overflow-y-auto px-5 py-6 sm:px-10">
        <div class="max-w-medida">
          <p class="m-0 font-mono text-2xs tracking-versalita text-overlay0 uppercase"># ~/README.md</p>
          <h1 class="mt-3 font-mono text-3xl font-bold text-text">wandres.dev</h1>
          <p class="mt-4 text-lg text-subtext1">
            Un centro de estudios de ciencias de la computación, escrito por un ingeniero de
            software sénior que trabaja en Rust, sistemas distribuidos y arquitecturas
            local-first.
          </p>
          <p class="mt-3 text-md text-overlay1">
            Esto es mi máquina: las guías viven en <code class="text-subtext0">cs/</code>, los
            conceptos medidos en <code class="text-subtext0">concepts/</code>, y mi editor en
            <code class="text-subtext0">.config/nvim/</code>. Se navega con el ratón — o como
            Neovim, si sabes.
          </p>
        </div>

        <div class="mt-10 max-w-medida font-mono text-sm">
          <p class="m-0 text-overlay0">~/</p>
          <ul class="m-0 mt-2 list-none space-y-1 p-0">
            {TREE.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  data-tree-row
                  class="group flex items-baseline gap-3 rounded px-2 py-1.5 no-underline hover:bg-surface0/50 focus-visible:bg-surface0/60 focus-visible:outline-none"
                >
                  <span class={entry.dir ? 'text-blue' : 'text-subtext1'}>
                    {entry.dir ? '' : ''} {entry.name}
                  </span>
                  <span class="ml-auto hidden text-2xs text-overlay0 group-hover:text-overlay1 sm:inline">
                    {entry.note}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-2xs text-overlay0">
            j/k moverse · ⏎ abrir · gt/gT cambiar de tab — o el ratón, como siempre
          </p>
        </div>
      </main>

      <Statusline client:load path="~/README.md" hint="j/k moverse · ⏎ abrir" />
    </div>
  </div>
</BaseLayout>

<script>
  // j/k move focus across the tree rows; Enter opens (native link behavior).
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'j' && e.key !== 'k') return;
    const target = e.target as HTMLElement | null;
    if (target?.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target?.tagName ?? '')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tree-row]'));
    if (!rows.length) return;
    e.preventDefault();
    const current = rows.indexOf(document.activeElement as HTMLAnchorElement);
    const next = e.key === 'j' ? Math.min(current + 1, rows.length - 1) : Math.max(current - 1, 0);
    rows[next]?.focus();
  });
</script>
