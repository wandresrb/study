---
import { codeToHtml } from 'shiki';

import BaseLayout from '../layouts/BaseLayout.astro';
import Capa from '../components/home/Layer.astro';
import Console from '../components/home/Console.tsx';
import Stack from '../components/home/Stack.tsx';
import { PROGRAMA } from '../portada/programa';

const CODIGO = await codeToHtml(PROGRAMA, { lang: 'rust', theme: 'catppuccin-mocha' });
---
<BaseLayout
  chrome="floating"
  title="wandres.dev · Las capas de una máquina"
  description="La placa convirtiéndose en el primer piso: los niveles de abstracción de un computador real."
>
  <p
    id="teclas"
    class="fixed bottom-4 left-1/2 z-25 m-0 flex -translate-x-1/2 items-center gap-1 rounded-full border border-borde bg-crust/78 px-3 py-1.5 font-mono text-2xs text-overlay1 backdrop-blur-[6px] transition-opacity duration-500 data-lejos:opacity-25"
  >
    <kbd class="inline-grid min-w-5 place-items-center rounded border border-b-2 border-surface1 bg-mantle/80 px-1.5 py-px text-2xs text-subtext0">j</kbd>
    <kbd class="inline-grid min-w-5 place-items-center rounded border border-b-2 border-surface1 bg-mantle/80 px-1.5 py-px text-2xs text-subtext0">k</kbd>
    <em class="mx-1 not-italic text-overlay0">o</em>
    <kbd class="inline-grid min-w-5 place-items-center rounded border border-b-2 border-surface1 bg-mantle/80 px-1.5 py-px text-2xs text-subtext0">↓</kbd>
    <kbd class="inline-grid min-w-5 place-items-center rounded border border-b-2 border-surface1 bg-mantle/80 px-1.5 py-px text-2xs text-subtext0">↑</kbd>
    <span class="ml-1.5 text-overlay0">para moverte</span>
  </p>

  <main id="portada" class="overflow-visible">
    <Capa id="hardware" escena="hardware">
      <Console client:load codigo={CODIGO} />
      <Stack client:load />
    </Capa>
  </main>
</BaseLayout>

<script>
  import '../portada/scroll';
</script>
