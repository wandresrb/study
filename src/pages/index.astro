---
import BaseLayout from '../layouts/BaseLayout.astro';

// La portada: la composición progresiva de las capas de abstracción de una
// máquina real. Se baja, y se puede volver a subir.
//
// REGLA: aquí no entra contenido del sitio. Ni categorías, ni tracks, ni
// cuentas de lecciones. Solo la máquina y cuatro invitaciones.
//
// `tramos` = cuánto scroll consume la capa por encima de su pantalla anclada.
// Las que llevan simulación piden más reposo. Es el único mando para ajustar
// el largo total de la página.
const capas = [
  {
    id: 'hardware',
    escena: 'lienzo',
    kicker: 'El suelo',
    titulo: 'Todo descansa sobre una placa',
    linea: 'Silicio, pistas, instrucciones. El piso de toda plataforma y todo sistema.',
    // El giro de lámina a losa necesita recorrido largo: con menos, la cámara
    // cabecea de golpe y se pierde el momento en que la placa deja de ser una
    // superficie y pasa a ser un objeto con canto.
    tramos: 2.9,
  },
  {
    id: 'dos-cosas',
    escena: 'losas',
    kicker: 'La vista mínima',
    titulo: 'Un computador son dos cosas',
    linea: 'Reducido al máximo: hardware y software. Todo lo demás es una capa entre esos dos.',
    tramos: 0.8,
  },
  {
    id: 'memoria',
    escena: 'lienzo',
    kicker: 'Se amplía',
    titulo: 'El software es memoria y algoritmos',
    linea: 'Celdas, direcciones, y procedimientos que las transforman. Aquí empieza la abstracción.',
    tramos: 1.6,
  },
  {
    id: 'kernel',
    escena: 'anillos',
    kicker: 'En el medio',
    titulo: 'El kernel y el sistema operativo',
    linea: 'Lo que media entre los algoritmos y la placa: reparte el tiempo, la memoria y los dispositivos.',
    tramos: 0.9,
    invita: { texto: 'Sistemas Operativos · Programación de Sistemas', href: '/mapa/#nucleo' },
  },
  {
    id: 'userspace',
    escena: 'ventanas',
    kicker: 'Encima',
    titulo: 'El espacio de usuario',
    linea: 'Aplicaciones, el navegador, y el entorno del desarrollador. Su máquina, la que tiene delante.',
    cierre: 'Hasta aquí, una máquina.',
    tramos: 0.9,
    invita: { texto: 'Frontend · Entorno de Desarrollo', href: '/mapa/#aplicaciones' },
  },
  {
    id: 'distribuido',
    escena: 'lienzo',
    kicker: 'Se multiplica',
    titulo: 'Una máquina se vuelve miles',
    linea: 'El mismo código en mil máquinas que tienen que ponerse de acuerdo sin verse. El problema es ese, no la cantidad.',
    tramos: 1.8,
    invita: { texto: 'System Design · Cloud', href: '/mapa/#aplicaciones' },
  },
  {
    id: 'arranque',
    escena: 'arranque',
    kicker: 'La recapitulación',
    titulo: 'Ahora, de verdad',
    linea: 'Has visto las capas como concepto. Esto es una máquina montándolas en orden, con su ritmo real.',
    tramos: 1.6,
    invita: { texto: 'Empieza por donde quieras', href: '/mapa/', final: true },
  },
] as const;

// La capa 01 ya no se dibuja aquí: es una escena 3D (`../portada/board`) que se
// carga sola al acercarse. El SVG que había antes se ha ido con ella.

// --- Capa 04: lo que cruza la frontera -------------------------------------
const SYSCALLS = ['openat()', 'read()', 'mmap()', 'write()', 'ioctl()'];

// --- Capa 05: lo que se levanta encima -------------------------------------
const VENTANAS = [
  { n: 'navegador', c: 'a' },
  { n: 'editor', c: 'b' },
  { n: 'servidor', c: 'c' },
  { n: 'terminal', c: 'd' },
];

// --- Capa 07: el arranque --------------------------------------------------
// Formato real de un arranque de Linux. Ninguna línea menciona el sitio: lo que
// se ve es una máquina, no un catálogo.
const ARRANQUE = [
  '[    0.000000] Booting Linux on physical CPU 0x0000000000',
  '[    0.000000] Linux version 6.12.0-nivel-dios (aarch64)',
  '[    0.000000] Machine model: generic arm64 platform',
  '[    0.000000] efi: EFI v2.7 by EDK II',
  '[    0.014882] Memory: 16326144K/16777216K available',
  '[    0.031204] SMP: Total of 8 processors activated',
  '[    0.048917] CPU features: detected: Speculative Store Bypass',
  '[    0.102338] devtmpfs: initialized',
  '[    0.147902] clocksource: arch_sys_counter: mask 0xffffff',
  '[    0.219471] pinctrl core: initialized pinctrl subsystem',
  '[    0.284015] NET: Registered PF_INET protocol family',
  '[    0.351772] Unpacking initramfs...',
  '[    0.604318] Freeing initrd memory: 24576K',
  '[    0.712900] virtio_blk virtio0: [vda] 41943040 512-byte blocks',
  '[    0.849107] EXT4-fs (vda2): mounted filesystem with ordered data',
  '[    0.903774] VFS: Mounted root (ext4 filesystem) readonly',
  '[    0.981250] Freeing unused kernel memory: 4096K',
  '[    1.024663] Run /sbin/init as init process',
  '[    1.188205] systemd[1]: Detected architecture arm64',
  '[  OK  ] Reached target Local File Systems.',
  '[  OK  ] Started Journal Service.',
  '[  OK  ] Reached target Network.',
  '[  OK  ] Reached target Multi-User System.',
];
---

<BaseLayout
  title="Nivel Dios · Las capas de una máquina"
  description="De la placa al sistema distribuido: la composición de las capas de abstracción de un computador real."
>
  <header class="portada-top">
    <a class="portada-marca" href="/">
      <span class="logo">∞</span>
      <span>Nivel Dios</span>
    </a>
    <a class="portada-salta" href="/mapa/">Ver los temas <span aria-hidden="true">→</span></a>
  </header>

  <nav class="riel" aria-label="Capas">
    <ol>
      {capas.map((c, i) => (
        <li>
          <a class="riel-marca" href={`#${c.id}`}>
            <span class="riel-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="riel-nombre">{c.kicker}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <main class="portada" id="portada">
    {capas.map((c, i) => (
      <section class="capa" id={c.id} data-capa={i} style={`--tramos:${c.tramos}`}>
        <div class="capa-pin">
          <div class="capa-escena" data-escena={c.escena} data-capa-id={c.id} aria-hidden="true">
            {c.escena === 'losas' && (
              <div class="caja losas">
                <div class="losa sw">
                  <b>software</b>
                  <i>memoria · algoritmos</i>
                </div>
                <div class="frontera"><span>la frontera</span></div>
                <div class="losa hw">
                  <b>hardware</b>
                  <i>silicio · instrucciones</i>
                </div>
              </div>
            )}

            {c.escena === 'anillos' && (
              <div class="caja anillos">
                <div class="banda b3"><b>anillo 3</b><i>espacio de usuario</i></div>
                <div class="banda b0"><b>anillo 0</b><i>kernel</i></div>
                <div class="banda bh"><b>—</b><i>hardware</i></div>
                <div class="cruces">
                  {SYSCALLS.map((s, k) => (
                    <span class="cruce" style={`--t:${(k / SYSCALLS.length) * 0.6};--x:${8 + k * 19}%`}>{s}</span>
                  ))}
                </div>
              </div>
            )}

            {c.escena === 'ventanas' && (
              <div class="caja ventanas">
                {VENTANAS.map((v, k) => (
                  <div class={`vent v-${v.c}`} style={`--t:${(k / VENTANAS.length) * 0.55}`}>
                    <span class="vent-barra"><i></i><i></i><i></i></span>
                    <span class="vent-n">{v.n}</span>
                  </div>
                ))}
                <div class="vent term" style="--t:0.62">
                  <span class="vent-barra"><i></i><i></i><i></i></span>
                  <code>$ nvim .</code>
                </div>
              </div>
            )}

            {c.escena === 'arranque' && (
              <div class="caja arranque">
                <pre>{ARRANQUE.map((l, k) => (
                  <span
                    class={l.startsWith('[  OK  ]') ? 'ok' : ''}
                    style={`--t:${((k / ARRANQUE.length) * 0.88).toFixed(3)}`}
                  >{l}</span>
                ))}<span class="prompt" style="--t:0.9">nivel-dios login: <b></b></span></pre>
              </div>
            )}
          </div>

          <div class="capa-texto">
            <p class="capa-idx"><span>{String(i + 1).padStart(2, '0')}</span> {c.kicker}</p>
            <h2>{c.titulo}</h2>
            <p class="capa-linea">{c.linea}</p>
            {'cierre' in c && c.cierre && <p class="capa-cierre">{c.cierre}</p>}
            {'invita' in c && c.invita && (
              <a
                class:list={['capa-invita', { 'is-final': 'final' in c.invita && c.invita.final }]}
                href={c.invita.href}
              >
                {c.invita.texto} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style is:global>
  /* Solo en esta ruta. El sitio funcional desplaza las anclas 90 px por su
     cabecera fija; aquí ese desplazamiento dejaría cada capa 90 px corta de su
     punto de anclaje y el avance nunca empezaría en 0. */
  html {
    scroll-padding-top: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* El HUD de las escenas de lienzo lo crea JavaScript, así que no puede llevar
     el ámbito del componente. */
  .escena-hud {
    position: absolute;
    left: clamp(1.5rem, 8vw, 7rem);
    bottom: clamp(1.5rem, 6vh, 4rem);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.9;
    color: var(--overlay1);
    pointer-events: none;
  }
  .escena-hud b {
    display: block;
    color: var(--lavender);
    letter-spacing: 0.16em;
    font-weight: 500;
  }
  .escena-hud i {
    font-style: normal;
  }
  .escena-hud-ver {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.2rem;
  }
  .escena-hud u {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--subtext0);
  }
  .escena-hud u::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--t, currentColor);
  }
  @media (min-width: 1000px) {
    .escena-hud {
      left: auto;
      right: 4vw;
      max-width: 22rem;
    }
  }
</style>

<style>
  /* `--p` es el avance de la capa, de 0 a 1, y lo escribe el script leyendo el
     scroll. Registrarlo con @property lo convierte en un número de verdad, y
     con eso toda la animación se resuelve en CSS sin tocar el DOM. */
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .portada {
    overflow: visible;
  }

  /* ---------- Cabecera y salto ---------- */

  .portada-top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }
  .portada-top > * {
    pointer-events: auto;
  }
  .portada-marca {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }
  .portada-marca .logo {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--mauve), var(--blue));
    color: var(--crust);
    font-weight: 700;
  }
  /* Quien vuelve no paga peaje. */
  .portada-salta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--subtext0);
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--crust) 70%, transparent);
    backdrop-filter: blur(6px);
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
  }
  .portada-salta:hover,
  .portada-salta:focus-visible {
    color: var(--text);
    border-color: var(--surface1);
  }

  /* ---------- El riel: dónde estás y cómo te devuelves ---------- */

  .riel {
    position: fixed;
    z-index: 25;
    left: clamp(1rem, 4vw, 2.5rem);
    top: 50%;
    translate: 0 -50%;
  }
  .riel ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .riel-marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--overlay0);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }
  .riel-num {
    position: relative;
    width: 1.6rem;
  }
  .riel-num::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.7rem;
    height: 1px;
    background: currentColor;
    translate: 0 -50%;
    transition: width 0.24s var(--ease);
  }
  .riel-nombre {
    opacity: 0;
    translate: -4px 0;
    transition: opacity 0.2s var(--ease), translate 0.2s var(--ease);
  }
  .riel-marca:hover .riel-nombre,
  .riel-marca:focus-visible .riel-nombre,
  .riel-marca[aria-current='true'] .riel-nombre {
    opacity: 1;
    translate: 0 0;
  }
  .riel-marca[aria-current='true'] {
    color: var(--lavender);
  }
  .riel-marca[aria-current='true'] .riel-num::after {
    width: 1.4rem;
  }
  .riel-marca:hover,
  .riel-marca:focus-visible {
    color: var(--subtext1);
  }

  /* ---------- Las capas ---------- */

  .capa {
    /* Una pantalla anclada + los tramos que la capa pide para desarrollarse.
       Todo el largo de la página sale de aquí. */
    min-height: calc((1 + var(--tramos, 1)) * 100svh);
    position: relative;
  }

  .capa-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    padding: 6rem clamp(1.5rem, 8vw, 7rem) 4rem;
    box-sizing: border-box;
  }

  .capa-escena {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Las escenas de composición viven en una caja a la derecha del texto. Las de
     lienzo se colocan solas: el módulo sabe dónde está el texto. */
  .caja {
    position: absolute;
    inset: 12vh 6vw 12vh 50%;
    display: grid;
    align-content: center;
  }
  @media (max-width: 999px) {
    .caja {
      inset: auto 6vw 6vh;
      opacity: 0.3;
    }
  }

  .capa-texto {
    position: relative;
    z-index: 2;
    max-width: 46ch;
    margin-left: clamp(0rem, 6vw, 5rem);
  }

  .capa-idx {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--overlay1);
  }
  .capa-idx span {
    color: var(--mauve);
  }

  .capa-texto h2 {
    margin: 0 0 1rem;
    font-size: clamp(2.1rem, 6.2vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .capa-linea {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--subtext0);
    text-wrap: pretty;
  }

  .capa-cierre {
    margin: 1.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--overlay2);
  }

  .capa-invita {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.6rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--subtext1);
    text-decoration: none;
    justify-self: start;
    transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .capa-invita span {
    transition: translate 0.18s var(--ease);
  }
  .capa-invita:hover,
  .capa-invita:focus-visible {
    color: var(--text);
    border-color: color-mix(in oklab, var(--mauve) 55%, var(--border));
    background: color-mix(in oklab, var(--mauve) 8%, transparent);
  }
  .capa-invita:hover span {
    translate: 3px 0;
  }
  .capa-invita.is-final {
    border-color: color-mix(in oklab, var(--mauve) 45%, var(--border));
    color: var(--text);
  }

  /* ---------- El movimiento del texto ----------
     Solo con JS: `.on` lo enciende. Sin él todo queda legible y quieto, que es
     exactamente la degradación que queremos. */

  .portada.on .capa-texto {
    --e: clamp(0, calc(var(--p) / 0.18), 1);
    --s: clamp(0, calc((var(--p) - 0.8) / 0.2), 1);
    opacity: calc(var(--e) - var(--s));
    translate: 0 calc((1 - var(--e)) * 1.4rem + var(--s) * -1.4rem);
  }
  /* La primera capa ya está en pantalla cuando se carga: no tiene entrada que
     hacer. Sin esto arranca invisible, porque su avance es 0. */
  .portada.on .capa:first-child .capa-texto {
    --e: 1;
  }

  /* ================= Capa 01 · la placa =================
     La escena es 3D y ocupa el viewport entero — no la caja de media pantalla
     que usan las demás. El texto va encima, y encima de una placa iluminada el
     texto no se lee: necesita que la esquina de la que sale esté apagada. */

  #hardware .capa-pin::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Entre el lienzo (0) y el texto (2). */
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      color-mix(in oklab, var(--crust) 88%, transparent) 0%,
      color-mix(in oklab, var(--crust) 62%, transparent) 26%,
      transparent 58%
    );
  }
  @media (max-width: 999px) {
    /* En vertical el texto cae sobre el centro de la escena, no sobre un lado:
       el velo tiene que venir de abajo. */
    #hardware .capa-pin::before {
      background: linear-gradient(
        to top,
        color-mix(in oklab, var(--crust) 92%, transparent) 0%,
        color-mix(in oklab, var(--crust) 70%, transparent) 38%,
        transparent 72%
      );
    }
  }

  /* ================= Capa 02 · las dos cosas ================= */

  .losas {
    gap: 0;
    justify-items: stretch;
  }
  .losa {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.4rem 1.6rem;
    background: color-mix(in oklab, var(--mantle) 88%, transparent);
  }
  .losa b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .losa i {
    font-style: normal;
    font-size: 0.82rem;
    color: var(--overlay1);
  }
  .losa.sw b {
    color: var(--mauve);
  }
  .losa.hw b {
    color: var(--peach);
  }
  .frontera {
    position: relative;
    height: 0;
    display: grid;
    place-items: center;
  }
  .frontera span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--overlay0);
    background: var(--bg);
    padding: 0 0.6rem;
    opacity: 0;
  }
  .frontera::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px dashed var(--surface1);
    opacity: 0;
  }
  /* Las dos losas empiezan juntas y se separan: la frontera aparece cuando hay
     sitio para ella. */
  .portada.on .losas {
    --sep: calc(clamp(0, calc((var(--p) - 0.12) / 0.45), 1) * 2.6rem);
    --ab: clamp(0, calc((var(--p) - 0.45) / 0.25), 1);
  }
  .portada.on .losa.sw {
    translate: 0 calc(var(--sep) * -1);
  }
  .portada.on .losa.hw {
    translate: 0 var(--sep);
  }
  .portada.on .frontera span,
  .portada.on .frontera::before {
    opacity: var(--ab);
  }

  /* ================= Capa 04 · los anillos ================= */

  .anillos {
    position: relative;
    gap: 0.5rem;
  }
  .banda {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--mantle) 84%, transparent);
  }
  .banda b {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--overlay0);
    min-width: 5.4rem;
  }
  .banda i {
    font-style: normal;
    color: var(--subtext0);
  }
  /* El kernel es el que manda en esta capa, y se nota. */
  .banda.b0 {
    border-color: color-mix(in oklab, var(--mauve) 40%, var(--border));
    background: color-mix(in oklab, var(--mauve) 7%, var(--mantle));
  }
  .banda.b0 b,
  .banda.b0 i {
    color: var(--mauve);
  }
  .cruces {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cruce {
    position: absolute;
    left: var(--x);
    top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--yellow);
    opacity: 0;
  }
  /* Cada llamada baja del anillo 3 al hardware, atravesando el kernel. Eso es
     literalmente lo que hace una llamada al sistema. */
  .portada.on .cruce {
    --q: clamp(0, calc((var(--p) - var(--t)) / 0.55), 1);
    opacity: calc(min(var(--q), 1 - var(--q)) * 3.2);
    translate: 0 calc(var(--q) * 7.4rem);
  }

  /* ================= Capa 05 · las ventanas ================= */

  .ventanas {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    align-content: center;
  }
  .vent {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--mantle) 90%, transparent);
    padding: 0.7rem 0.9rem 1.4rem;
    min-height: 5.2rem;
  }
  .vent-barra {
    display: flex;
    gap: 0.32rem;
    margin-bottom: 0.7rem;
  }
  .vent-barra i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--surface1);
  }
  .vent-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--overlay1);
  }
  .vent.term {
    grid-column: 1 / -1;
    border-color: color-mix(in oklab, var(--green) 32%, var(--border));
  }
  .vent.term code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--green);
  }
  /* Aparecen a saltos, no deslizándose: la composición es discreta. */
  .portada.on .vent {
    --q: clamp(0, calc((var(--p) - var(--t)) * 9), 1);
    opacity: var(--q);
    scale: calc(0.94 + var(--q) * 0.06);
  }

  /* ================= Capa 07 · el arranque ================= */

  .arranque {
    inset: 8vh 4vw 8vh 46%;
  }
  .arranque pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 0.82vw, 0.74rem);
    line-height: 1.75;
    color: var(--subtext0);
    white-space: pre;
    overflow: hidden;
  }
  .arranque span {
    display: block;
  }
  .arranque .ok {
    color: var(--green);
  }
  .arranque .prompt {
    margin-top: 0.9rem;
    color: var(--text);
  }
  .arranque .prompt b {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    translate: 0 0.15em;
    background: var(--text);
    animation: cursor 1s steps(1, end) infinite;
  }
  @keyframes cursor {
    50% {
      opacity: 0;
    }
  }
  /* Cada línea aparece cuando el arranque llega a ella. El ritmo lo pone el
     scroll, pero el orden es el de una máquina de verdad. */
  .portada.on .arranque span {
    opacity: clamp(0, calc((var(--p) - var(--t)) * 26), 1);
  }

  /* ---------- Degradación ---------- */

  @media (prefers-reduced-motion: reduce) {
    .capa {
      min-height: auto;
    }
    .capa-pin {
      position: static;
      height: auto;
      min-height: 100svh;
    }
    .portada.on .capa-texto {
      opacity: 1;
      translate: none;
    }
    /* Las escenas se componen enteras, sin recorrido. La capa 01 se compone
       sola: su módulo dibuja un único fotograma y no arranca bucle. */
    .portada.on .arranque span,
    .portada.on .frontera span,
    .portada.on .frontera::before {
      opacity: 1;
    }
    .portada.on .vent {
      opacity: 1;
      scale: 1;
    }
    .portada.on .cruce {
      display: none;
    }
    .portada.on .losa.sw,
    .portada.on .losa.hw {
      translate: none;
    }
    .arranque .prompt b {
      animation: none;
    }
    .riel-nombre,
    .riel-num::after,
    .capa-invita,
    .capa-invita span {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .riel {
      left: auto;
      right: 0.6rem;
    }
    .riel-nombre {
      display: none;
    }
    .capa-texto {
      margin-left: 0;
    }
    .arranque {
      inset: auto 6vw 4vh;
    }
  }
</style>

<script>
  // El avance de cada capa sale del scroll nativo: la capa mide más que la
  // pantalla y su hijo va anclado, así que el trozo que sobra ES el recorrido.
  // Subir deshace lo que bajar montó sin escribir una línea para ello.
  //
  // El valor se cuantiza en 32 pasos. La computación es discreta y el
  // movimiento del sitio también: no interpola, salta.
  const PASOS = 32;

  interface Escena {
    avance(p: number): void;
    destruir(): void;
  }

  // Las dos escenas caras se cargan solo cuando se acercan, y se sueltan al
  // alejarse. Nada de esto entra en la carga inicial de la página.
  const CARGA: Record<string, () => Promise<{ montar: (h: HTMLElement) => Escena | Promise<Escena> }>> = {
    hardware: () => import('../portada/board'),
    memoria: () => import('../portada/memoria'),
    distribuido: () => import('../portada/distribuido'),
  };

  let portada: HTMLElement | null = null;
  let capas: HTMLElement[] = [];
  let anfitriones: (HTMLElement | null)[] = [];
  let marcas: HTMLElement[] = [];
  let avances: number[] = [];
  let crudos: number[] = [];
  let pendiente = false;
  let activa = -1;

  const montadas = new Map<HTMLElement, Escena>();
  const montando = new Set<HTMLElement>();
  let vigia: IntersectionObserver | null = null;

  const reducido = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const medir = () => {
    pendiente = false;
    if (!capas.length) return;
    const vh = window.innerHeight;
    const medio = vh / 2;
    let mandan = -1;

    for (let i = 0; i < capas.length; i++) {
      const capa = capas[i];
      const r = capa.getBoundingClientRect();
      const recorrido = r.height - vh;
      const bruto = recorrido > 0 ? -r.top / recorrido : r.top <= 0 ? 1 : 0;
      const crudo = Math.min(1, Math.max(0, bruto));

      // La cuantización se queda SOLO en la CSS, donde el salto es la estética
      // buscada. Las escenas reciben el valor continuo: una cámara que avanza a
      // saltos de 1/32 no se mueve, parpadea.
      const p = Math.round(crudo * PASOS) / PASOS;
      if (p !== avances[i]) {
        avances[i] = p;
        capa.style.setProperty('--p', String(p));
      }
      if (crudo !== crudos[i]) {
        crudos[i] = crudo;
        const host = anfitriones[i];
        const esc = host && montadas.get(host);
        if (esc) esc.avance(crudo);
      }
      if (r.top <= medio && r.bottom > medio) mandan = i;
    }

    if (mandan !== activa) {
      activa = mandan;
      for (let i = 0; i < marcas.length; i++) {
        if (i === activa) marcas[i].setAttribute('aria-current', 'true');
        else marcas[i].removeAttribute('aria-current');
      }
    }
  };

  const alScroll = () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(medir);
  };

  const irA = (i: number) => {
    if (!capas.length) return;
    const destino = capas[Math.max(0, Math.min(capas.length - 1, i))];
    destino.scrollIntoView({ behavior: reducido() ? 'auto' : 'smooth', block: 'start' });
  };

  const alTeclado = (e: KeyboardEvent) => {
    if (!capas.length) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;

    switch (e.key) {
      case 'ArrowDown':
      case 'PageDown':
        e.preventDefault();
        irA(activa + 1);
        break;
      case 'ArrowUp':
      case 'PageUp':
        e.preventDefault();
        irA(activa - 1);
        break;
      case 'Home':
        e.preventDefault();
        irA(0);
        break;
      case 'End':
        e.preventDefault();
        irA(capas.length - 1);
        break;
    }
  };

  const soltarTodas = () => {
    for (const esc of montadas.values()) esc.destruir();
    montadas.clear();
    montando.clear();
    vigia?.disconnect();
    vigia = null;
  };

  const vigilar = () => {
    // Un margen del 60% de la ventana: la escena está lista antes de que la
    // capa entre, y se suelta cuando ya queda lejos.
    vigia = new IntersectionObserver(
      (entradas) => {
        for (const ent of entradas) {
          const host = ent.target as HTMLElement;
          const tipo = host.dataset.capaId ?? '';
          const carga = CARGA[tipo];
          if (!carga) continue;

          if (ent.isIntersecting) {
            if (montadas.has(host) || montando.has(host)) continue;
            montando.add(host);
            carga()
              .then((m) => m.montar(host))
              .then((esc) => {
                // Pudo salir de pantalla mientras cargaba.
                if (!montando.has(host)) {
                  esc.destruir();
                  return;
                }
                montadas.set(host, esc);
                const capa = host.closest<HTMLElement>('.capa');
                const i = capa ? capas.indexOf(capa) : -1;
                esc.avance(i >= 0 ? crudos[i] ?? 0 : 0);
              })
              .catch((err) => {
                if (import.meta.env.DEV) console.warn('[portada] escena no montada:', err);
              })
              .finally(() => montando.delete(host));
          } else {
            montando.delete(host);
            const esc = montadas.get(host);
            if (esc) {
              esc.destruir();
              montadas.delete(host);
            }
          }
        }
      },
      { rootMargin: '60% 0px 60% 0px' },
    );
    for (const capa of capas) {
      const host = capa.querySelector<HTMLElement>('.capa-escena');
      if (host && host.dataset.escena === 'lienzo') vigia.observe(host);
    }
  };

  // Los oyentes se cuelgan una sola vez de objetos que sobreviven a
  // ClientRouter; lo que se renueva en cada navegación son las referencias.
  document.addEventListener('scroll', alScroll, { passive: true });
  window.addEventListener('resize', alScroll);
  document.addEventListener('keydown', alTeclado);
  document.addEventListener('astro:before-swap', soltarTodas);

  document.addEventListener('astro:page-load', () => {
    portada = document.getElementById('portada');
    capas = portada ? Array.from(portada.querySelectorAll<HTMLElement>('.capa')) : [];
    anfitriones = capas.map((c) => c.querySelector<HTMLElement>('.capa-escena'));
    marcas = Array.from(document.querySelectorAll<HTMLElement>('.riel-marca'));
    avances = capas.map(() => -1);
    crudos = capas.map(() => -1);
    activa = -1;
    if (!portada) return;
    portada.classList.add('on');
    medir();
    // Con movimiento reducido no hay simulación: las capas se quedan en su
    // composición estática, que es lo que pide esa preferencia.
    if (!reducido()) vigilar();
  });
</script>
