---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Sintaxis básica', icon: '🔤', items: [
      { k: 'let x = 5', d: 'Constante (no cambia)' },
      { k: 'var x = 5', d: 'Variable (mutable)' },
      { k: '"Hola \\(nombre)"', d: 'Interpolación de strings' },
      { k: 'let x: Double = 5', d: 'Anotación de tipo explícita' },
      { k: 'Double(entero)', d: 'Conversión de tipo (Swift no la hace sola)' },
    ],
  },
  {
    cat: 'Opcionales', icon: '❓', items: [
      { k: 'var x: String?', d: 'Opcional: String o nil' },
      { k: 'if let x { … }', d: 'Desenvolver seguro' },
      { k: 'guard let x else { return }', d: 'Desenvolver y salir temprano' },
      { k: 'x ?? "por defecto"', d: 'Nil-coalescing' },
      { k: 'x?.propiedad', d: 'Optional chaining' },
    ],
  },
  {
    cat: 'Tipos y modelo', icon: '🧱', items: [
      { k: 'struct (valor)', d: 'Se copia. Por defecto para datos' },
      { k: 'class (referencia)', d: 'Se comparte. Para identidad' },
      { k: 'enum { case a, b }', d: 'Conjunto cerrado de casos' },
      { k: 'case exito(String)', d: 'Enum con valor asociado' },
      { k: 'protocol P { … }', d: 'Contrato de capacidades' },
      { k: 'func f<T>(x: T)', d: 'Función genérica' },
    ],
  },
  {
    cat: 'Errores', icon: '⚠️', items: [
      { k: 'func f() throws', d: 'Puede lanzar errores' },
      { k: 'func f() throws(E)', d: 'Typed throws (Swift 6.3)' },
      { k: 'do { try f() } catch { }', d: 'Capturar errores' },
      { k: 'try? f()', d: 'Resultado opcional (nil si falla)' },
      { k: 'Result<Éxito, Error>', d: 'Error como valor' },
    ],
  },
  {
    cat: 'Concurrencia', icon: '⚡', items: [
      { k: 'func f() async', d: 'Función asíncrona' },
      { k: 'await f()', d: 'Esperar sin bloquear' },
      { k: 'Task { await … }', d: 'Lanzar trabajo async' },
      { k: 'async let a = f()', d: 'Correr en paralelo' },
      { k: 'actor Contador { }', d: 'Protege estado compartido' },
      { k: '@MainActor', d: 'Ejecuta en el hilo principal (UI)' },
      { k: 'for await x in stream', d: 'Recorrer un AsyncSequence' },
    ],
  },
  {
    cat: 'SwiftUI: vistas', icon: '🎨', items: [
      { k: 'struct V: View { var body }', d: 'Toda vista conforma a View' },
      { k: 'Text("Hola")', d: 'Texto' },
      { k: 'Image(systemName: "star")', d: 'Icono SF Symbol' },
      { k: 'Button("OK") { acción }', d: 'Botón con trailing closure' },
      { k: '#Preview { V() }', d: 'Vista previa en vivo' },
    ],
  },
  {
    cat: 'SwiftUI: layout', icon: '📐', items: [
      { k: 'VStack / HStack / ZStack', d: 'Apilar en V, H o profundidad' },
      { k: 'Spacer()', d: 'Empuja el espacio disponible' },
      { k: 'VStack(alignment: .leading)', d: 'Alineación' },
      { k: '.frame(maxWidth: .infinity)', d: 'Ocupar todo el ancho' },
      { k: '.padding()', d: 'Espacio alrededor (¡el orden importa!)' },
    ],
  },
  {
    cat: 'SwiftUI: estado', icon: '🔄', items: [
      { k: '@State private var x', d: 'Estado local de la vista' },
      { k: '@Binding var x', d: 'Conexión de dos vías' },
      { k: '$x', d: 'El binding de x (para TextField, Toggle…)' },
      { k: '@Observable class M', d: 'Modelo reactivo (Observation)' },
      { k: '@Bindable var m', d: 'Bindings a un modelo observable' },
      { k: '@Environment(M.self)', d: 'Leer del environment' },
    ],
  },
  {
    cat: 'SwiftUI: listas y nav', icon: '📋', items: [
      { k: 'List(items) { … }', d: 'Lista desplazable' },
      { k: 'ForEach(items) { … }', d: 'Repetir por elemento (Identifiable)' },
      { k: 'NavigationStack { }', d: 'Contenedor de navegación' },
      { k: 'NavigationLink(dest) { }', d: 'Ir a otra pantalla' },
      { k: '.sheet(isPresented: $x)', d: 'Presentar modal' },
      { k: '.task { await … }', d: 'Cargar datos al aparecer' },
    ],
  },
  {
    cat: 'SwiftData', icon: '🗄️', items: [
      { k: '@Model class Tarea', d: 'Modelo persistente' },
      { k: '.modelContainer(for:)', d: 'Configura el almacén en la app' },
      { k: '@Environment(\\.modelContext)', d: 'Acceso para insertar/borrar' },
      { k: 'context.insert(x)', d: 'Guardar (automático)' },
      { k: '@Query var items', d: 'Leer datos, reactivo' },
      { k: '#Predicate<T> { … }', d: 'Filtro seguro' },
      { k: '@Relationship(deleteRule:)', d: 'Relación entre modelos' },
    ],
  },
  {
    cat: 'Testing', icon: '🧪', items: [
      { k: '@Test func x() { }', d: 'Marca un test (Swift Testing)' },
      { k: '#expect(cond)', d: 'Verificar una condición' },
      { k: 'try #require(opcional)', d: 'Desenvolver o fallar' },
      { k: '@Test(arguments: […])', d: 'Test parametrizado' },
    ],
  },
  {
    cat: 'Atajos de Xcode', icon: '⌨️', items: [
      { k: 'Cmd R', d: 'Compilar y ejecutar' },
      { k: 'Cmd B', d: 'Compilar' },
      { k: 'Cmd .', d: 'Detener' },
      { k: 'Cmd Shift O', d: 'Abrir rápido' },
      { k: 'Cmd /', d: 'Comentar' },
      { k: 'Ctrl I', d: 'Reindentar' },
      { k: 'Product ▸ Archive', d: 'Compilación para distribución' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Swift & iOS Nivel Dios" description="Referencia buscable de Swift, SwiftUI, SwiftData y atajos de Xcode.">
  <header class="topbar">
    <span class="brand-mini">Swift &amp; iOS <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="swift" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--peach)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Swift</h1>
          <p class="desc">Swift, SwiftUI, SwiftData y Xcode en un solo sitio. Busca por sintaxis o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'opcional', '@State', 'async', 'List'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
