---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "Núcleo",
    "icon": "🔁",
    "items": [
      {
        "k": "action → reducer → store → view",
        "d": "El flujo unidireccional"
      },
      {
        "k": "(state, action) => newState",
        "d": "Reducer puro"
      },
      {
        "k": "store.dispatch(action)",
        "d": "Única forma de cambiar el estado"
      },
      {
        "k": "store.subscribe(fn)",
        "d": "Escuchar cambios"
      },
      {
        "k": "store.getState()",
        "d": "Leer el estado actual"
      }
    ]
  },
  {
    "cat": "Redux Toolkit",
    "icon": "🛠️",
    "items": [
      {
        "k": "createSlice({ name, initialState, reducers })",
        "d": "Reducer + actions con Immer"
      },
      {
        "k": "configureStore({ reducer })",
        "d": "Store con buenos defaults"
      },
      {
        "k": "createAsyncThunk",
        "d": "Async con pending/fulfilled/rejected"
      },
      {
        "k": "createEntityAdapter",
        "d": "Colecciones normalizadas"
      },
      {
        "k": "createSelector",
        "d": "Selector memoizado (reselect)"
      },
      {
        "k": "PayloadAction<T>",
        "d": "Tipar el payload"
      }
    ]
  },
  {
    "cat": "RTK Query",
    "icon": "🌐",
    "items": [
      {
        "k": "createApi({ endpoints })",
        "d": "Definir la API"
      },
      {
        "k": "providesTags / invalidatesTags",
        "d": "Cache e invalidación"
      },
      {
        "k": "useGetXQuery()",
        "d": "Hook generado de consulta"
      },
      {
        "k": "useAddXMutation()",
        "d": "Hook generado de mutación"
      },
      {
        "k": "transformResponse",
        "d": "Adaptar la respuesta"
      }
    ]
  },
  {
    "cat": "Efectos",
    "icon": "⚡",
    "items": [
      {
        "k": "thunk",
        "d": "Despachar una función (por defecto en RTK)"
      },
      {
        "k": "takeLatest / call / put",
        "d": "redux-saga con generadores"
      },
      {
        "k": "startListening({ matcher, effect })",
        "d": "Listener middleware"
      },
      {
        "k": "fork / race / all",
        "d": "Concurrencia en sagas"
      }
    ]
  },
  {
    "cat": "La ola ligera",
    "icon": "🪶",
    "items": [
      {
        "k": "create((set) => ({ … }))",
        "d": "Zustand: store como hook"
      },
      {
        "k": "useShallow(selector)",
        "d": "Zustand: comparación superficial"
      },
      {
        "k": "persist / immer / devtools",
        "d": "Middleware de Zustand"
      },
      {
        "k": "atom(valor)",
        "d": "Jotai: átomo primitivo"
      },
      {
        "k": "atomFamily / atomWithStorage",
        "d": "Jotai: familias y persistencia"
      },
      {
        "k": "proxy() + useSnapshot()",
        "d": "Valtio: proxy reactivo"
      },
      {
        "k": "nanostores",
        "d": "Store diminuto y agnóstico"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Flux y Redux" description="De Flux a Redux Toolkit y la ola ligera: store, reducers, middleware, selectores, RTK Query, Zustand y Jotai.">
  <header class="topbar">
    <span class="brand-mini">Flux <b>y Redux</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="flux" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--mauve)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Flux y Redux</h1>
          <p class="desc">De Flux a Redux Toolkit y la ola ligera: store, reducers, middleware, selectores, RTK Query, Zustand y Jotai.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'createSlice', 'thunk', 'selector', 'zustand'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
