---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import BookOpen from '@lucide/astro/icons/book-open';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import MessageSquare from '@lucide/astro/icons/message-square';
import Package from '@lucide/astro/icons/package';
import Puzzle from '@lucide/astro/icons/puzzle';
import Wrench from '@lucide/astro/icons/wrench';
import type { AstroComponent } from '@lucide/astro';

import DocLayout from '../layouts/DocLayout.astro';
import groups from '../data/resources-neovim.json';
import PageHeader from '../components/ui/PageHeader.astro';

// The data carries no icon (same rule as everywhere): the page decides.
const GROUP_ICON: Record<string, AstroComponent> = {
  docs: BookOpen,
  learn: GraduationCap,
  plugins: Puzzle,
  distros: Package,
  tools: Wrench,
  community: MessageSquare,
};
---

<DocLayout
  title="Recursos · Neovim · wandres.dev"
  description="Enlaces curados para seguir aprendiendo Neovim: documentación, plugins, distribuciones y comunidad."
  subject="neovim"
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Neovim', href: '/neovim/' }, { text: 'Recursos' }]}
>
  <PageHeader
    title="Recursos"
    lede="El temario no termina aquí. Estos son los sitios donde seguir afilando tu setup."
  />

  {
    groups.map((g) => {
      const Icon = GROUP_ICON[g.id];
      return (
        <section class="mt-10">
          <h2 class="mb-3.5 flex items-center gap-2.5 text-2xl font-extrabold text-text">
            {Icon && <Icon class="size-5 text-subtext0" aria-hidden="true" />}
            {g.title}
          </h2>
          <div class="cards">
            {g.items.map((it) => (
              <a class="card no-underline" href={it.url} target="_blank" rel="noopener">
                <h3 class="flex items-center gap-1 text-base font-bold text-text">
                  {it.name} <ArrowUpRight class="size-3.5 text-subtext0" aria-hidden="true" />
                </h3>
                <p>{it.desc}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }
</DocLayout>
