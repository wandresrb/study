---
import DocLayout from '../layouts/DocLayout.astro';
import groups from '../data/resources-neovim.json';
import PageHeader from '../components/ui/PageHeader.astro';
---
<DocLayout
  title="Recursos · Neovim · wandres.dev"
  description="Enlaces curados para seguir aprendiendo Neovim: documentación, plugins, distribuciones y comunidad."
  subject="neovim"
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Neovim', href: '/neovim/' }, { text: 'Recursos' }]}
>
  <PageHeader
    title="Recursos"
    lede="El temario no termina aquí. Estos son los sitios donde seguir afilando tu setup."
  />

        {groups.map((g) => (
          <section class="mt-10">
            <h2 class="mb-3.5 text-2xl font-extrabold text-text">{g.titulo}</h2>
            <div class="cards">
              {g.items.map((it) => (
                <a class="card no-underline" href={it.url} target="_blank" rel="noopener">
                  <h3 class="text-base font-bold text-text">{it.nombre} ↗</h3>
                  <p>{it.desc}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
</DocLayout>
