---
import { getCollection } from 'astro:content';
import Chip from '../../components/Chip.astro';

// Instrumento de medida, no página del sitio. En `astro build` getStaticPaths
// devuelve [], así que no se emite HTML, ni entra en el sitemap, ni ocupa una
// ruta en Cloudflare. `import.meta.env.PROD` se sustituye estáticamente, así que
// la rama se resuelve antes de generar nada.
export function getStaticPaths() {
  return import.meta.env.PROD ? [] : [{ params: { ruta: undefined } }];
}

// La misma aritmética que la guarda de contraste de contenido.ts. Aquí no
// decide nada: solo ordena y señala.
const canal = (v: number) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => canal(c / 255));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contraste = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const mezcla = (a: string, b: string, pesoA: number) => {
  const [x, y] = [parseInt(a.slice(1), 16), parseInt(b.slice(1), 16)];
  return (
    '#' +
    [16, 8, 0]
      .map((d) => Math.round((((x >> d) & 255) * pesoA + ((y >> d) & 255) * (1 - pesoA))).toString(16).padStart(2, '0'))
      .join('')
  );
};
const placa = (grad: string, tint = 0.12) => mezcla(grad, '#11111b', tint);
const tinta = (marca: string) => mezcla(marca, '#cdd6f4', 0.82);

const tracks = await getCollection('tracks');
const cats = await getCollection('categorias');

// Peor primero: los diez que más papeletas tienen de estar mal son los diez que
// se ven al abrir, en vez de estar escondidos en mitad de una rejilla de 71.
const fichas = [
  ...tracks.map((t) => ({
    id: t.id,
    tipo: 'track' as const,
    valor: t.data.logo,
    from: t.data.gradFrom,
    to: t.data.gradTo,
    marca: t.data.logoHexDark ?? t.data.logoHex,
    exacta: !!t.data.logoHexDark,
    ratio: contraste(
      t.data.logoHexDark ?? (t.data.logoHex ? tinta(t.data.logoHex) : t.data.gradFrom),
      placa(t.data.gradFrom),
    ),
  })),
  ...cats.map((c) => ({
    id: c.id,
    tipo: 'categoría' as const,
    valor: c.data.icono,
    from: c.data.gradFrom,
    to: c.data.gradTo,
    marca: undefined,
    exacta: false,
    // Sin marca la tinta es --chip-from, y la categoría usa un tinte del 8%.
    ratio: contraste(c.data.gradFrom, placa(c.data.gradFrom, 0.08)),
  })),
].sort((a, b) => a.ratio - b.ratio);

// Las cajas REALES, copiadas de los componentes que las declaran. Si allí
// cambian y aquí no, el instrumento miente: por eso van literales y no por
// clase, que era lo que ataba esta página a `global.css`.
const CAJAS = [
  'size-[26px] rounded-lg [--ico:13] [--ico-hair:1.3]',
  'size-[38px] rounded-[11px] [--ico:19] [--ico-hair:1.85] [--num-peso:600]',
  'size-16 rounded-2xl [--ico:32] [--ico-hair:2.5] [--num-peso:600]',
  'size-[60px] rounded-2xl [--ico:30] [--ico-hair:2.3] [--chip-tint:8%] [--num-peso:600]',
] as const;
const NOMBRES = ['barra lateral 26', 'ficha compacta 38', 'ficha ancha 64', 'categoría 60'] as const;
const MIXTA = ['0', '1', 'lucide:map', '12', 'lucide:crown', '58'];
const peores = fichas.filter((f) => f.ratio < 4.5);
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Iconos · contraste y escala</title>
  </head>
  <body>
    <div class="wrap">
      <h1>Iconos · instrumento de medida</h1>
      <p class="lead">
        {fichas.length} fichas, ordenadas por contraste calculado de la tinta contra su propia placa,
        <b>peor primero</b>. Rojo por debajo de 4,5:1. {peores.length === 0
          ? 'Ninguna baja del mínimo.'
          : `${peores.length} por debajo del mínimo: ${peores.map((p) => p.id).join(', ')}.`}
      </p>

      <div class="ctl">
        <label>Fondo:
          <select id="fondo">
            <option value="panel">--panel (fichas de /hub)</option>
            <option value="sidebar">degradado de la barra lateral</option>
            <option value="bg">--bg (/404 y /[track])</option>
          </select>
        </label>
        <label><input type="checkbox" id="bizco" /> Modo bizco</label>
        <span class="nota">
          El bizco quita tono y detalle y deja luminancia y peso, que es de lo que está hecho
          «un sistema» frente a «dos sistemas». Ve lo que la fórmula de contraste no puede.
        </span>
      </div>

      <h2>Cifra e icono en la misma caja</h2>
      <p class="lead">La disposición literal que produce la barra lateral. Si se leen como dos sistemas, se nota aquí en el primer segundo.</p>
      {[0, 1].map((i) => (
        <div class="fila mixta">
          <code>{NOMBRES[i]}</code>
          {MIXTA.map((v) => <Chip caja={CAJAS[i]} valor={v} from="var(--blue)" />)}
        </div>
      ))}

      <h2>Las {fichas.length} fichas, en las cinco cajas</h2>
      <div class="rejilla" id="rejilla">
        {fichas.map((f) => (
          <div class="celda" data-falla={f.ratio < 4.5 ? '' : undefined}>
            <div class="cajas">
              {CAJAS.map((caja) => (
                <Chip caja={caja} valor={f.valor} from={f.from} to={f.to} marca={f.marca} exacta={f.exacta} />
              ))}
            </div>
            <div class="pie">
              <b>{f.id}</b>
              <span class="ratio">{f.ratio.toFixed(2)}:1</span>
              <code>{f.valor}</code>
            </div>
          </div>
        ))}
      </div>

      <h2>Zoom 3× del punto de 26 px</h2>
      <p class="lead">La caja que falla primero. Aquí se ve si las contraformas se cierran a 13 px.</p>
      <div class="zoom">
        {fichas.slice(0, 14).map((f) => (
          <Chip caja="lvl-dot" valor={f.valor} from={f.from} to={f.to} marca={f.marca} exacta={f.exacta} />
        ))}
      </div>

      <h2>Tofu</h2>
      <p class="lead">Todo valor que aún se renderice como texto y no como icono. Debe estar vacío salvo por las cifras.</p>
      <div class="fila tofu">
        {[...tracks.map((t) => t.data.logo), ...cats.map((c) => c.data.icono)]
          .filter((v) => !v.includes(':'))
          .map((v) => (
            <span class="glifo">{v} <code>U+{v.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0')}</code></span>
          ))}
        <span class="ok">Sin valores en texto.</span>
      </div>
    </div>

    <style is:global>
      @import '../../styles/global.css';
    </style>
    <style>
      .wrap { max-width: 1400px; margin: 0 auto; padding: 32px 24px 120px; }
      h1 { font-size: 1.6rem; margin-bottom: 6px; }
      h2 { font-size: 1.1rem; margin: 42px 0 6px; color: var(--subtext1); }
      .lead { color: var(--subtext0); font-size: 0.9rem; max-width: 80ch; margin-bottom: 14px; }
      .ctl {
        position: sticky; top: 0; z-index: 5;
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
        padding: 12px 0; margin: 14px 0;
        background: var(--bg); border-bottom: 1px solid var(--border);
        font-family: var(--font-mono); font-size: 0.78rem;
      }
      .ctl .nota { color: var(--overlay1); font-family: var(--font-sans); max-width: 46ch; }
      .rejilla { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
      .celda { border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--panel); }
      .celda[data-falla] { border-color: var(--red); box-shadow: 0 0 0 1px var(--red); }
      .cajas { display: flex; align-items: center; gap: 10px; min-height: 68px; }
      .pie { display: flex; align-items: baseline; gap: 8px; margin-top: 8px; flex-wrap: wrap; font-size: 0.72rem; }
      .pie b { color: var(--text); }
      .pie .ratio { font-family: var(--font-mono); color: var(--subtext0); }
      .celda[data-falla] .ratio { color: var(--red); font-weight: 700; }
      .pie code { font-family: var(--font-mono); color: var(--overlay1); font-size: 0.68rem; }
      .fila { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; background: var(--panel); }
      .fila > code { font-family: var(--font-mono); font-size: 0.7rem; color: var(--overlay1); min-width: 7ch; }
      .zoom { display: flex; gap: 26px; flex-wrap: wrap; padding: 20px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel); }
      .zoom .chip { zoom: 3; image-rendering: pixelated; }
      .tofu .glifo { font-family: var(--font-mono); font-size: 1.3rem; display: inline-flex; align-items: center; gap: 6px; }
      .tofu .glifo ~ .ok, .tofu .glifo + .ok { display: none; }
      .tofu .ok { color: var(--green); font-size: 0.8rem; }
      /* Fondos y bizco: se conmutan sobre <body> desde el script. */
      body[data-fondo="sidebar"] { background: linear-gradient(180deg, rgba(17,17,27,0.6), rgba(24,24,37,0.2)), var(--bg); }
      body[data-fondo="bg"] { background: var(--bg); }
      body[data-fondo="panel"] .celda, body[data-fondo="panel"] .fila, body[data-fondo="panel"] .zoom { background: var(--panel); }
      body[data-fondo="bg"] .celda, body[data-fondo="bg"] .fila, body[data-fondo="bg"] .zoom { background: var(--bg); }
      body[data-fondo="sidebar"] .celda, body[data-fondo="sidebar"] .fila, body[data-fondo="sidebar"] .zoom { background: transparent; }
      body[data-bizco] .rejilla, body[data-bizco] .fila, body[data-bizco] .zoom { filter: grayscale(1) blur(0.7px); }
    </style>

    <script>
      const body = document.body;
      body.dataset.fondo = 'panel';
      document.getElementById('fondo')?.addEventListener('change', (e) => {
        body.dataset.fondo = (e.target as HTMLSelectElement).value;
      });
      document.getElementById('bizco')?.addEventListener('change', (e) => {
        if ((e.target as HTMLInputElement).checked) body.dataset.bizco = '';
        else delete body.dataset.bizco;
      });
    </script>
  </body>
</html>
