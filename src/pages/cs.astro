---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/site/TrackCard.astro';
import Tile from '../components/ui/Tile.astro';
import { getConcepts, getMap, getStrata, getTotals } from '../data/content';
import type { Stratum } from '../data/content';
import { iconoDe } from '../lib/iconos';

const totals = getTotals();
const totalHours = Math.round(totals.minutes / 60);
const map = getMap();
const conceptInfo = new Map(getConcepts().map((c) => [c.id, c]));

const COPY: Record<Stratum, { kicker: string; title: string; lede: string }> = {
  concept: {
    kicker: 'Los conceptos',
    title: 'El núcleo',
    lede: 'La matemática, la ciencia y las herramientas que sostienen todo lo demás. Es cierto independientemente de la tecnología que uses.',
  },
  implementation: {
    kicker: 'Los dominios',
    title: 'Las implementaciones',
    lede: 'El concepto con la forma que le da una tecnología concreta. Un mismo concepto reaparece aquí tantas veces como plataformas lo implementen.',
  },
  tool: {
    kicker: 'El día a día',
    title: 'Las herramientas',
    lede: 'Con lo que se trabaja, no lo que se estudia. Es lo único del sitio que se consulta a diario en vez de recorrerse una vez.',
  },
};

const groups = getStrata()
  .map((s) => ({ id: s.id, ...COPY[s.id], cats: map[s.id] }))
  .filter((g) => g.cats.length > 0);

const WIDTH = 'mx-auto w-full max-w-sitio px-4 sm:px-10';
---
<BaseLayout
  search
  title="Centro de Estudios · Ciencias de la Computación"
  description="Un centro de estudios de ciencias de la computación: matemática, sistemas operativos, system design, lenguajes y los dominios donde se aplican. De los fundamentos a saber usarlos."
>
  <section class={`${WIDTH} pt-16 pb-14 sm:pt-24`}>
    <p
      class="inline-flex items-center gap-2 rounded-full border border-borde bg-mantle/70 px-3.5 py-1.5 text-xs text-subtext0"
    >
      {totals.tracks} temas · {totals.lessons} lecciones · {totalHours} h de estudio
    </p>

    <h1 class="mt-6 text-display font-extrabold tracking-titular text-balance">
      Centro de Estudios<br />
      <span class="bg-linear-to-r from-mauve via-lavender to-blue bg-clip-text text-transparent">
        Ciencias de la Computación
      </span>
    </h1>

    <p class="mt-5 max-w-medida text-lg text-subtext0 text-pretty">
      Los fundamentos primero y los dominios donde se aplican después. Elige un tema y recorre el
      camino, nivel a nivel: el último de cada temario es el que se gana el nombre.
    </p>

    <div id="read-next" hidden class="mt-8 max-w-medida rounded-xl border border-borde bg-panel/60 p-5">
      <p class="m-0 font-mono text-2xs tracking-versalita text-overlay1 uppercase">Qué leo ahora</p>
      <ul data-continue class="m-0 mt-3 list-none space-y-1.5 p-0 text-sm text-subtext0"></ul>
      <p data-unlocked hidden class="mt-3 border-t border-borde pt-3 text-sm text-subtext0"></p>
    </div>
  </section>

  {
    groups.map((group) => (
      <section id={group.id} class={`${WIDTH} scroll-mt-24 pb-16`}>
        <div class="border-t border-borde pt-10">
          <div class="max-w-medida">
            <p class="m-0 text-xs tracking-versalita text-overlay1 uppercase">
              {group.kicker}
            </p>
            <h2 class="mt-2 text-subtitulo font-bold tracking-titular">
              {group.title}
            </h2>
            <p class="mt-3 text-base text-subtext0 text-pretty">{group.lede}</p>
          </div>
        </div>

        {group.cats.map(({ category, written, pending, lessons, minutes }) => (
          <div
            id={`cat-${category.id}`}
            class="relative mt-6 scroll-mt-24 overflow-hidden rounded-xl border border-dashed border-borde p-6
                   before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-(--cat-color) before:opacity-45 before:content-['']"
            style={`--cat-color:${category.colorHex}`}
          >
            <div class="min-w-0">
              <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xl font-semibold text-(--cat-color)">
                {category.name}
                {written.length > 0 && (
                  <span class="text-xs font-normal text-overlay1">
                    {written.length} {written.length === 1 ? 'tema' : 'temas'} · {lessons} lecciones · {Math.round(minutes / 60)} h
                  </span>
                )}
              </h3>
              <p class="mt-1 max-w-larga text-base text-overlay2 text-pretty">
                {category.description}
              </p>
            </div>

            {written.length > 0 && (
              <div class="mt-5 grid grid-cols-[repeat(auto-fill,minmax(min(14.5rem,100%),1fr))] gap-3.5">
                {written.map((t) => <TrackCard track={t} color={category.colorHex} />)}
              </div>
            )}

            {pending.filter((t) => t.status === 'indexed').length > 0 && (
              <div class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(min(14.5rem,100%),1fr))] gap-3.5">
                {pending
                  .filter((t) => t.status === 'indexed')
                  .map((t) => {
                    const info = conceptInfo.get(t.id);
                    const Icon = iconoDe(t.id);
                    return (
                      <Tile
                        shape="compact"
                        title={t.name}
                        tags={info ? [`${info.edges} niv`, `${info.tracksTeaching} tracks`] : []}
                        color={category.colorHex}
                        href={`/conceptos/${t.id}/`}
                        logo={{ from: t.gradFrom, to: t.gradTo }}
                      >
                        <Fragment slot="glyph"><Icon class="ico" aria-hidden="true" /></Fragment>
                      </Tile>
                    );
                  })}
              </div>
            )}

            {pending.filter((t) => t.status === 'planned').length > 0 && (
              <p class="mt-4 text-sm text-overlay1">
                <span class="text-overlay0">
                  {pending.filter((t) => t.status === 'planned').length} por escribir:
                </span>{' '}
                {pending.filter((t) => t.status === 'planned').map((t) => t.name).join(' · ')}
              </p>
            )}
          </div>
        ))}
      </section>
    ))
  }
</BaseLayout>

<script>
  import { onProgressChange, readSet } from '../lib/progress';

  interface Catalog { lessons: [string, string, string][] }
  interface Graph { teaches: [string, string, number, number][]; unlocks: [string, string][]; tracks: [string, string][] }

  const json = <T,>(url: string, fallback: T): Promise<T> =>
    fetch(url)
      .then((r) => (r.ok ? (r.json() as Promise<T>) : fallback))
      .catch(() => fallback);

  // «Qué leo ahora»: continue the tracks in progress, and let the unlocks
  // graph suggest what the covered concepts open next. Hidden until there is
  // any progress at all.
  const paint = async () => {
    const box = document.getElementById('read-next');
    if (!box) return;
    const read = await readSet();
    if (!read.size) { box.hidden = true; return; }

    const [catalog, graph] = await Promise.all([
      json<Catalog>('/idx/catalog.json', { lessons: [] }),
      json<Graph>('/idx/graph.json', { teaches: [], unlocks: [], tracks: [] }),
    ]);
    if (!catalog.lessons.length) return;

    const names = new Map(graph.tracks);
    const perTrack = new Map<string, { total: number; done: number; next?: [string, string] }>();
    const levelKey = new Map<string, string>();
    for (const [title, id, position] of catalog.lessons) {
      const track = id.split('/')[0];
      const acc = perTrack.get(track) ?? { total: 0, done: 0 };
      acc.total++;
      if (read.has(id)) acc.done++;
      else acc.next ??= [title, id];
      perTrack.set(track, acc);
      levelKey.set(id, `${track}:${position.split('.')[0]}`);
    }

    const started = [...perTrack]
      .filter(([, a]) => a.done > 0 && a.next)
      .sort((a, b) => b[1].done / b[1].total - a[1].done / a[1].total)
      .slice(0, 3);

    const list = box.querySelector<HTMLElement>('[data-continue]');
    if (!list) return;
    list.replaceChildren(
      ...started.map(([track, a]) => {
        const li = document.createElement('li');
        const pct = Math.round((a.done / a.total) * 100);
        li.append(`${names.get(track) ?? track} · ${pct} % → `);
        const link = document.createElement('a');
        link.href = `/guia/${a.next![1]}/`;
        link.textContent = a.next![0];
        link.className = 'text-subtext1 underline decoration-dotted underline-offset-4';
        li.append(link);
        return li;
      }),
    );

    // A concept counts as covered when half of its teaching levels were touched
    // (at least one lesson read in that level).
    const touched = new Set<string>();
    for (const id of read) {
      const key = levelKey.get(id);
      if (key) touched.add(key);
    }
    const coverage = new Map<string, { total: number; hit: number }>();
    for (const [concept, track, level] of graph.teaches) {
      const s = coverage.get(concept) ?? { total: 0, hit: 0 };
      s.total++;
      if (touched.has(`${track}:${level}`)) s.hit++;
      coverage.set(concept, s);
    }
    const covered = new Set([...coverage].filter(([, s]) => s.hit / s.total >= 0.5).map(([c]) => c));

    const votes = new Map<string, number>();
    for (const [source, target] of graph.unlocks) {
      if (!covered.has(source)) continue;
      if ((perTrack.get(target)?.done ?? 0) > 0) continue;
      votes.set(target, (votes.get(target) ?? 0) + 1);
    }
    const unlockedBox = box.querySelector<HTMLElement>('[data-unlocked]');
    const top = [...votes].sort((a, b) => b[1] - a[1]).slice(0, 3);
    if (unlockedBox) {
      if (top.length) {
        unlockedBox.replaceChildren('Lo que ya sabes te abre: ');
        top.forEach(([track], i) => {
          if (i) unlockedBox.append(' · ');
          const a = document.createElement('a');
          a.href = `/${track}/`;
          a.textContent = names.get(track) ?? track;
          a.className = 'text-subtext1 underline decoration-dotted underline-offset-4';
          unlockedBox.append(a);
        });
        unlockedBox.hidden = false;
      } else {
        unlockedBox.hidden = true;
      }
    }

    box.hidden = started.length === 0 && top.length === 0;
  };

  document.addEventListener('astro:page-load', () => void paint());
  onProgressChange(() => void paint());
</script>
