---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Primitivos', icon: '⚛️', items: [
      { k: 'Observer / pub-sub', d: 'El patrón base: sujeto y observadores' },
      { k: 'signal / computed / effect', d: 'Valor reactivo con tracking automático' },
      { k: 'Signal.State · Signal.Computed', d: 'El TC39 Signals proposal' },
      { k: 'Observable (RxJS)', d: 'Stream de valores en el tiempo (push)' },
      { k: 'selector / memo', d: 'Estado derivado y cacheado' },
      { k: 'Immer · produce()', d: 'Inmutabilidad con sintaxis mutable' },
    ],
  },
  {
    cat: 'Máquinas de estado', icon: '🔀', items: [
      { k: 'FSM', d: 'Estados, eventos, transiciones' },
      { k: 'statechart', d: 'Jerarquía, paralelismo, historia (Harel)' },
      { k: 'createMachine({ states })', d: 'XState v5: definir la máquina' },
      { k: 'context + assign', d: 'Estado extendido y su actualización' },
      { k: 'guard / actions', d: 'Transiciones condicionales / efectos' },
      { k: 'invoke · spawn · sendTo', d: 'Actores y mensajes (actor model)' },
      { k: 'useMachine / useSelector', d: 'Conectar a la UI (React)' },
    ],
  },
  {
    cat: 'Flux · Redux', icon: '🔁', items: [
      { k: 'action → reducer → store → view', d: 'Flujo unidireccional' },
      { k: 'createSlice', d: 'RTK: reducer + actions con Immer' },
      { k: 'createAsyncThunk', d: 'Lógica async (pending/fulfilled/rejected)' },
      { k: 'configureStore', d: 'Store con buenos defaults' },
      { k: 'RTK Query', d: 'Estado del servidor en Redux' },
      { k: 'createSelector (reselect)', d: 'Selectores memoizados' },
      { k: 'createEntityAdapter', d: 'Colecciones normalizadas' },
    ],
  },
  {
    cat: 'Ligeros', icon: '🪶', items: [
      { k: 'Zustand (~3KB)', d: 'Store como hook, sin boilerplate' },
      { k: 'Jotai (~4KB)', d: 'Átomos componibles (bottom-up)' },
      { k: 'Valtio', d: 'Proxy mutable reactivo' },
      { k: 'nanostores', d: 'Store agnóstico y diminuto' },
    ],
  },
  {
    cat: 'Arquitecturas', icon: '🔗', items: [
      { k: 'Elm (TEA)', d: 'Model · Msg · update · view (puro)' },
      { k: 'Cmd / Sub', d: 'Elm: efectos como datos' },
      { k: 'TCA (Swift)', d: 'State · Action · Reducer · Effect · Store' },
      { k: '@Dependency · TestStore', d: 'TCA: DI y testing exhaustivo' },
      { k: 'MVI', d: 'Model-View-Intent (Android)' },
      { k: 'Orbit: container + intent', d: 'MVI en Kotlin sobre coroutines' },
    ],
  },
  {
    cat: 'Servidor · URL · forms', icon: '🌐', items: [
      { k: 'useQuery / useMutation', d: 'TanStack Query: cache del servidor' },
      { k: 'staleTime · invalidateQueries', d: 'Frescura e invalidación' },
      { k: 'useOptimistic · onMutate', d: 'Actualizaciones optimistas + rollback' },
      { k: 'URLSearchParams · nuqs', d: 'Estado en la URL, tipado' },
      { k: 'React Hook Form · Zod', d: 'Formularios + validación por esquema' },
    ],
  },
  {
    cat: 'Persistencia · futuro', icon: '🛰️', items: [
      { k: 'localStorage · IndexedDB', d: 'Persistir estado (sync / async)' },
      { k: 'rehydrate', d: 'Hidratar el store al arrancar' },
      { k: 'hydration mismatch', d: 'El peligro del estado en SSR' },
      { k: 'CRDT (Yjs · Automerge)', d: 'Convergencia sin conflictos' },
      { k: 'Electric · Zero · Jazz', d: 'Motores de sync local-first' },
    ],
  },
  {
    cat: 'El criterio', icon: '🧭', items: [
      { k: 'Separar servidor / cliente / UI / URL', d: 'La decisión más importante' },
      { k: 'useState → store → máquina', d: 'Escalar cuando duela, no antes' },
      { k: 'reactividad + disciplina', d: 'Los dos ejes de todo estado' },
      { k: 'TanStack Query + Zustand', d: 'El stack pragmático de 2026' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Reactividad y Estado" description="Referencia buscable del estado: signals, observables, máquinas de estado (XState), Redux/RTK, Elm, TCA, MVI/Orbit, TanStack Query y CRDTs.">
  <header class="topbar">
    <span class="brand-mini">Reactividad <b>y Estado</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="estado" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--lavender)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Reactividad y Estado</h1>
          <p class="desc">Todo el estado en un sitio: primitivos, máquinas, Redux, las arquitecturas unidireccionales y el estado del servidor. Busca por API o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'createMachine', 'createSlice', 'TCA', 'useQuery'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
