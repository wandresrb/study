---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import Tile from '../../components/ui/Tile.astro';
import Chip from '../../components/ui/Chip.astro';
import { getCategories, getConcepts, teachingLevels } from '../../data/content';
import type { Concept } from '../../data/content';
import { iconOf } from '../../lib/icons';

export function getStaticPaths() {
  return getConcepts().map((c) => ({ params: { concept: c.id }, props: { concept: c } }));
}

interface Props {
  concept: Concept;
}
const { concept } = Astro.props;

const Icon = iconOf(concept.id);
const levels = teachingLevels(concept.id);
const trackCount = new Set(levels.map((l) => l.track)).size;
const category = getCategories().find((c) => c.id === concept.category);
---
<LandingLayout
  search
  title={`${concept.name} · Conceptos · wandres.dev`}
  description={concept.description}
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Conceptos', href: '/concepts/' }, { text: concept.name }]}
>
  <section class="py-14 text-center" style={`--acento:${concept.colorHex}`}>
    <div class="flex justify-center">
      <Chip box="size-16 rounded-2xl ico-lg" from={concept.gradFrom} to={concept.gradTo}>
        <Icon class="ico" aria-hidden="true" />
      </Chip>
    </div>

    <h1 class="mt-5 text-5xl/tight font-extrabold tracking-titular text-text text-balance">
      {concept.name}
    </h1>

    <p class="mx-auto mt-4 max-w-medida text-lg text-subtext1">{concept.description}</p>

    <p class="mt-4 font-mono text-sm text-subtext0">
      {levels.length} {levels.length === 1 ? 'nivel lo enseña' : 'niveles lo enseñan'} en {trackCount}
      {trackCount === 1 ? 'track' : 'tracks'}
      {category && <Fragment> · <a href={`/cs/#cat-${category.id}`} class="text-subtext0">{category.name}</a></Fragment>}
    </p>
  </section>

  <Section
    kicker="Dónde se enseña"
    color={concept.colorHex}
    title="La ruta por los tracks"
    lede="Esta página es un índice, no una lección: cada nivel te lleva al track donde el concepto se enseña de verdad."
  >
    <div class="grid gap-3">
      {levels.map((l) => (
        <Tile
          heading="h3"
          title={l.levelName}
          sr={`${l.trackName}, nivel ${l.level}`}
          subtitle={`${l.trackName} · Nivel ${l.level}`}
          description={l.levelSubtitle}
          color={l.colorHex}
          href={l.firstLesson ? `/guide/${l.firstLesson}/` : `/${l.track}/`}
          logo={{ from: l.gradFrom, to: l.gradTo }}
        >
          <Fragment slot="glyph">
            <span class="font-mono font-semibold tabular-nums text-[calc(var(--ico)*1px)]">{l.level}</span>
          </Fragment>
        </Tile>
      ))}
    </div>
  </Section>
</LandingLayout>
