---
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/ui/Button.astro';
---
<LandingLayout title="404 · No encontrado" description="Esta página no existe.">
  <section class="grid min-h-[60svh] place-items-center py-16 text-center">
    <div>
      <p class="m-0 text-sm tracking-smallcaps text-subtext0 uppercase">Error 404</p>

      <h1 class="mt-3 text-4xl font-extrabold tracking-headline text-text">Esta página no existe</h1>

      <p class="mx-auto mt-4 max-w-measure text-lg text-subtext1">
        Puede que el enlace esté mal o que la lección se haya movido.
      </p>

      <div class="mt-8">
        <Button href="/cs/">← Todos los temas</Button>
      </div>
    </div>
  </section>
</LandingLayout>
