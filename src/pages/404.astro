---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ficha from '../components/Ficha.astro';
import { getTracks } from '../data/contenido';

// La doc: "For a custom 404 error page, you can create a 404.astro file in
// src/pages. This will build to a 404.html page."
const tracks = (await getTracks()).filter((t) => t.data.estado === 'disponible');
---
<BaseLayout title="404 · No encontrado" description="Esta página no existe.">
  <div class="landing">
    <section class="hero">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="sub">Puede que el enlace esté mal o que la lección se haya movido. Desde aquí llegas a cualquier sitio.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/hub/">← Todos los temas</a>
      </div>
    </section>
    <section class="section">
      <div class="path">
        {tracks.map((t) => (
          <Ficha
            titulo={t.data.nombre}
            subtitulo={t.data.subtitulo}
            color={t.data.colorHex}
            href={`/${t.id}/`}
            logo={{
              valor: t.data.logo,
              from: t.data.gradFrom,
              to: t.data.gradTo,
              marca: t.data.logoHexDark ?? t.data.logoHex,
              exacta: !!t.data.logoHexDark,
            }}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
