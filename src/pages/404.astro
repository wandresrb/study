---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import { getTracks } from '../data/contenido';

// La doc: "For a custom 404 error page, you can create a 404.astro file in
// src/pages. This will build to a 404.html page."
const tracks = (await getTracks()).filter((t) => t.data.estado === 'disponible');
---
<BaseLayout title="404 · No encontrado" description="Esta página no existe.">
  <div class="landing">
    <section class="hero">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="sub">Puede que el enlace esté mal o que la lección se haya movido. Desde aquí llegas a cualquier sitio.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/hub/">← Todos los temas</a>
      </div>
    </section>
    <section class="section">
      <div class="path">
        {tracks.map((t) => (
          <a class="path-card" href={`/${t.id}/`} style={`--lvl-color:${t.data.colorHex}`}>
            <Chip caja="p-lvl" valor={t.data.logo} from={t.data.gradFrom} to={t.data.gradTo} marca={t.data.logoHexDark ?? t.data.logoHex} exacta={!!t.data.logoHexDark} />
            <div class="p-info"><h4>{t.data.nombre} <small>{t.data.subtitulo}</small></h4></div>
            <div class="p-go">→</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
