---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTracks } from '../data/contenido';

// La doc: "For a custom 404 error page, you can create a 404.astro file in
// src/pages. This will build to a 404.html page."
const tracks = (await getTracks()).filter((t) => t.data.estado === 'disponible');
---
<BaseLayout title="404 · No encontrado" description="Esta página no existe.">
  <div class="landing">
    <section class="hero">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="sub">Puede que el enlace esté mal o que la lección se haya movido. Desde aquí llegas a cualquier sitio.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/">← Todos los temas</a>
      </div>
    </section>
    <section class="section">
      <div class="path">
        {tracks.map((t) => (
          <a class="path-card" href={`/${t.id}/`} style={`--lvl-color:${t.data.colorHex}`}>
            <div class="p-lvl" style={`background:linear-gradient(135deg, ${t.data.gradFrom}, ${t.data.gradTo})`}>{t.data.logo}</div>
            <div class="p-info"><h3>{t.data.nombre} <small>{t.data.subtitulo}</small></h3></div>
            <div class="p-go">→</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
