---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Componente .astro', icon: '📄', items: [
      { k: '--- … ---', d: 'Frontmatter: script del componente (se ejecuta en servidor)' },
      { k: 'const { titulo } = Astro.props;', d: 'Recibir props' },
      { k: 'interface Props { titulo: string }', d: 'Tipar las props' },
      { k: '<slot /> · <slot name="pie" />', d: 'Contenido hijo por defecto / nombrado' },
      { k: 'Astro.url · Astro.site', d: 'URL de la petición / sitio configurado' },
      { k: 'import.meta.env.PUBLIC_X', d: 'Variable de entorno' },
    ],
  },
  {
    cat: 'Templating y directivas', icon: '🔧', items: [
      { k: '{expresion}', d: 'Interpolar una expresión JS' },
      { k: '{items.map((i) => <li>{i}</li>)}', d: 'Renderizar una lista' },
      { k: '{cond && <p>…</p>}', d: 'Renderizado condicional' },
      { k: '<Fragment> … </Fragment>', d: 'Agrupar sin nodo extra (no <>)' },
      { k: 'set:html={raw} · set:text', d: 'Insertar HTML/crudo o texto escapado' },
      { k: 'class:list={[…]}', d: 'Clases condicionales' },
      { k: 'define:vars={{ color }}', d: 'Pasar variables a <style>/<script>' },
    ],
  },
  {
    cat: 'Routing', icon: '🗺️', items: [
      { k: 'src/pages/index.astro', d: 'Ruta / (basado en archivos)' },
      { k: 'src/pages/[slug].astro', d: 'Ruta dinámica' },
      { k: 'src/pages/[...rest].astro', d: 'Catch-all (segmentos variables)' },
      { k: 'export function getStaticPaths()', d: 'Generar rutas en build (SSG)' },
      { k: 'const { slug } = Astro.params;', d: 'Leer el parámetro' },
      { k: 'return Astro.redirect("/login")', d: 'Redirección en SSR' },
      { k: 'paginate(items, { pageSize })', d: 'Paginación en getStaticPaths' },
    ],
  },
  {
    cat: 'Content collections', icon: '📚', items: [
      { k: 'src/content.config.ts', d: 'Definir colecciones y loaders' },
      { k: 'defineCollection({ loader, schema })', d: 'Declarar una colección' },
      { k: 'glob({ pattern, base })', d: 'Loader de archivos locales' },
      { k: 'schema: z.object({ … })', d: 'Validar frontmatter con Zod' },
      { k: 'await getCollection("blog")', d: 'Traer todas las entradas' },
      { k: 'const { Content } = await render(entry)', d: 'Renderizar una entrada' },
      { k: 'reference("autores")', d: 'Relación entre colecciones' },
    ],
  },
  {
    cat: 'Islands y client:*', icon: '🏝️', items: [
      { k: '<Comp client:load />', d: 'Hidratar de inmediato' },
      { k: 'client:idle', d: 'Hidratar cuando el hilo esté libre' },
      { k: 'client:visible', d: 'Hidratar al entrar en viewport' },
      { k: 'client:media="(max-width: 50em)"', d: 'Hidratar según media query' },
      { k: 'client:only="react"', d: 'Solo en cliente (sin SSR)' },
      { k: 'astro add react|solid|vue', d: 'Añadir un renderer de framework' },
      { k: 'nanostores', d: 'Estado compartido entre islas' },
    ],
  },
  {
    cat: 'Server: SSR, endpoints, actions', icon: '🛰️', items: [
      { k: 'export const prerender = false', d: 'Renderizar en servidor esta página' },
      { k: 'export function GET({ params })', d: 'Endpoint: devuelve un Response' },
      { k: 'return new Response(json, { headers })', d: 'Respuesta de un endpoint' },
      { k: 'src/middleware.ts → onRequest', d: 'Middleware de peticiones' },
      { k: 'context.locals', d: 'Pasar datos del middleware a la página' },
      { k: 'defineAction({ input, handler })', d: 'Action type-safe de servidor' },
      { k: '<Comp server:defer />', d: 'Server island (con slot fallback)' },
    ],
  },
  {
    cat: 'astro.config y features', icon: '⚙️', items: [
      { k: 'output: "static" | "server"', d: 'Modo de render por defecto' },
      { k: 'adapter: node()/cloudflare()', d: 'Adapter de despliegue (SSR)' },
      { k: 'integrations: [mdx(), sitemap()]', d: 'Integraciones' },
      { k: 'i18n: { locales, defaultLocale }', d: 'Internacionalización' },
      { k: 'image: { domains, remotePatterns }', d: 'Autorizar imágenes remotas' },
      { k: 'vite: { … }', d: 'Config de Vite (plugins, alias, ssr)' },
      { k: 'prefetch: { prefetchAll: true }', d: 'Prefetch de enlaces' },
    ],
  },
  {
    cat: 'Imágenes, fuentes, transiciones', icon: '🖼️', items: [
      { k: 'import { Image } from "astro:assets"', d: 'Componente de imagen optimizada' },
      { k: '<Image src={img} width height alt />', d: 'Imagen local (con dimensiones)' },
      { k: '<Picture formats={["avif","webp"]} />', d: 'Múltiples formatos / art direction' },
      { k: 'import { Font } from "astro:assets"', d: 'Fuente optimizada (Fonts API)' },
      { k: '<ClientRouter />', d: 'Navegación con View Transitions' },
      { k: 'transition:name / :animate / :persist', d: 'Emparejar/animar/persistir elementos' },
    ],
  },
  {
    cat: 'CLI y tooling', icon: '🛠️', items: [
      { k: 'npm create astro@latest', d: 'Crear un proyecto' },
      { k: 'astro dev', d: 'Servidor de desarrollo (HMR)' },
      { k: 'astro build', d: 'Build de producción → dist/' },
      { k: 'astro preview', d: 'Previsualizar el build' },
      { k: 'astro add <integración>', d: 'Instalar y configurar una integración' },
      { k: 'astro check', d: 'Comprobar tipos y errores' },
      { k: 'astro sync', d: 'Regenerar tipos de collections/env' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Astro 7" description="Referencia buscable de Astro 7: componente .astro, directivas, routing, content collections, islands, SSR, endpoints, actions y CLI.">
  <header class="topbar">
    <span class="brand-mini">Astro <b>7</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="astro" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--peach)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Astro 7</h1>
          <p class="desc">El framework entero en un sitio: componentes, directivas, routing, contenido, islands, servidor y CLI. Busca por sintaxis o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'getStaticPaths', 'client:visible', 'action'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
