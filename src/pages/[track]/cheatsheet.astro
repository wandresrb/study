---
// Una sola ruta para las 25 cheatsheets. Antes cada una era un .astro con el
// mismo marcado, los mismos estilos y el mismo <script> de filtrado copiado —
// 72 líneas idénticas por fichero. Los datos viven en la colección
// `cheatsheets` y el título, el color y la cabecera se derivan del track.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getTrack, getTracks } from '../../data/contenido';

export async function getStaticPaths() {
  // Se parte de los tracks disponibles, no de las hojas: si un track pasara a
  // `proximamente` se construiría su cheatsheet con un sidebar que enlaza a
  // una página que ya no existe.
  const [hojas, tracks] = await Promise.all([getCollection('cheatsheets'), getTracks()]);
  const vivos = new Set(tracks.filter((t) => t.data.estado === 'disponible').map((t) => t.id));
  return hojas
    .filter((h) => vivos.has(h.id))
    .map((h) => ({ params: { track: h.id }, props: { hoja: h } }));
}

const { hoja } = Astro.props;
const track = (await getTrack(hoja.id)).data;
const { meta, desc, placeholder, cats } = hoja.data;
const total = cats.reduce((a, c) => a + c.items.length, 0);
---
<BaseLayout title={`Cheatsheet · ${track.nombre}`} description={meta}>
  <header class="topbar">
    <span class="brand-mini">{track.nombre} <b>cheatsheet</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject={hoja.id} />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style={`color:${track.colorHex}`}>⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de {track.nombre}</h1>
          <p class="desc">{desc}</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder={placeholder} aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button type="button" class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button type="button" data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Recableado en cada navegación: con <ClientRouter /> el módulo solo se
    // ejecuta una vez, y los nodos de la página anterior ya no existen.
    document.addEventListener('astro:page-load', () => {
      const input = document.getElementById('cheat-input') as HTMLInputElement | null;
      if (!input) return; // esta página no es una cheatsheet
      const filters = document.getElementById('cheat-filters');
      const empty = document.getElementById('cheat-empty');
      let activeCat = 'all';
      // Normaliza para que buscar "animacion" encuentre "animación".
      const plano = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const apply = () => {
        const q = plano(input?.value ?? '').trim();
        let anyVisible = false;
        document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
          const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
          let rows = 0;
          sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
            const textOk = !q || plano(row.dataset.text ?? '').includes(q);
            const show = catOk && textOk;
            row.style.display = show ? '' : 'none';
            if (show) rows++;
          });
          sec.style.display = catOk && rows > 0 ? '' : 'none';
          if (catOk && rows > 0) anyVisible = true;
        });
        if (empty) empty.style.display = anyVisible ? 'none' : '';
      };
      input?.addEventListener('input', apply);
      filters?.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => {
          filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
          b.classList.add('active');
          activeCat = b.getAttribute('data-cat') ?? 'all';
          apply();
        });
      });
    });
  </script>
</BaseLayout>
