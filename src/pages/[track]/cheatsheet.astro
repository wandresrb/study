---
import DocLayout from '../../layouts/DocLayout.astro';
import Cheatsheet from '../../components/site/Cheatsheet.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { cheatsheetTracks, getCheatsheet, getTrack, getTracks } from '../../data/content';

export function getStaticPaths() {
  const live = new Set(getTracks().filter((t) => t.status === 'written').map((t) => t.id));
  return cheatsheetTracks()
    .filter((id) => live.has(id))
    .map((id) => ({ params: { track: id }, props: { trackId: id } }));
}

const { trackId } = Astro.props;
const track = getTrack(trackId);
const sheet = getCheatsheet(trackId);
const total = sheet.cats.reduce((a, c) => a + c.items.length, 0);
---
<DocLayout
  title={`Cheatsheet · ${track.name}`}
  description={sheet.meta}
  subject={trackId}
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: track.name, href: `/${trackId}/` }, { text: 'Cheatsheet' }]}
>
  <PageHeader class="mb-2" title={`Cheatsheet de ${track.name}`} lede={sheet.description}>
    <p slot="meta" class="mt-3 text-xs text-overlay1">{total} elementos</p>
  </PageHeader>

  <Cheatsheet sheet={sheet} />
</DocLayout>
