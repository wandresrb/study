---
import DocLayout from '../../layouts/DocLayout.astro';
import Cheatsheet from '../../components/site/Cheatsheet.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getCollection } from 'astro:content';
import { getTrack, getTracks } from '../../data/content';

export async function getStaticPaths() {
  const sheets = await getCollection('cheatsheets');
  const live = new Set(getTracks().filter((t) => t.status === 'written').map((t) => t.id));
  return sheets
    .filter((s) => live.has(s.id))
    .map((s) => ({ params: { track: s.id }, props: { sheet: s } }));
}

const { sheet } = Astro.props;
const track = getTrack(sheet.id);
const { meta, desc, cats } = sheet.data;
const total = cats.reduce((a, c) => a + c.items.length, 0);
---
<DocLayout
  title={`Cheatsheet · ${track.name}`}
  description={meta}
  subject={sheet.id}
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: track.name, href: `/${sheet.id}/` }, { text: 'Cheatsheet' }]}
>
  <PageHeader class="mb-2" title={`Cheatsheet de ${track.name}`} lede={desc}>
    <p slot="meta" class="mt-3 font-mono text-xs text-overlay1">{total} elementos</p>
  </PageHeader>

  <Cheatsheet sheet={sheet} />
</DocLayout>
