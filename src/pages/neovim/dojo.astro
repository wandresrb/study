---
// El dojo: repaso espaciado de los drills que YA practicaste en las lecciones.
// Todo es client-side sobre localStorage — al completar un drill se guardó su
// definición completa, así que aquí se reproduce sin visitar su lección.
// Fallar un repaso lo adelanta; acertarlo lo aleja (1 → 3 → 7 → 21 días).
import DocLayout from '../../layouts/DocLayout.astro';
---

<DocLayout
  title="El dojo · Neovim · wandres.dev"
  description="Repaso espaciado de los drills practicados: hoy toca lo que estás a punto de olvidar."
  subject="neovim"
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Neovim', href: '/neovim/' }, { text: 'Dojo' }]}
>
  <header class="mb-8">
    <h1 class="m-0 text-3xl font-bold text-text">El dojo</h1>
    <p class="mt-2 max-w-prose text-subtext1">
      Aquí no se aprende: se <b>retiene</b>. Cada drill que completas en una lección entra en una
      cola de repaso espaciado — 1, 3, 7 y 21 días—. Fallar lo adelanta, acertarlo lo aleja. Diez
      minutos al día aquí valen más que una tarde releyendo.
    </p>
  </header>

  <section class="mb-8 grid gap-3 sm:grid-cols-4" data-metricas>
    {
      [
        ['racha', 'días de práctica'],
        ['vencidos', 'repasos para hoy'],
        ['dominados', 'drills dominados'],
        ['fallos', 'fallos acumulados'],
      ].map(([id, etiqueta]) => (
        <div class="d-stat rounded-sm border border-borde bg-panel">
          <div class="d-stat-value font-mono text-2xl text-text" data-metrica={id}>—</div>
          <div class="d-stat-desc text-2xs text-overlay1">{etiqueta}</div>
        </div>
      ))
    }
  </section>

  <section class="mb-10">
    <h2 class="mb-1 font-mono text-sm tracking-versalita text-overlay1 uppercase">repasos de hoy</h2>
    <p class="mb-4 mt-0 text-sm text-subtext0" data-cola-vacia hidden>
      Nada vencido. O estás al día, o todavía no has completado ningún drill en las lecciones —
      empieza por <a href="/guia/neovim/gramatica-vim/" class="text-mauve">la gramática</a>.
    </p>
    <div data-cola class="grid gap-6"></div>
  </section>

  <section class="mb-10" data-seccion-debiles hidden>
    <h2 class="mb-3 font-mono text-sm tracking-versalita text-overlay1 uppercase">tus puntos débiles</h2>
    <ul data-debiles class="m-0 grid list-none gap-1.5 p-0"></ul>
  </section>

  <footer class="flex flex-wrap items-center gap-2 border-t border-borde pt-4">
    <span class="font-mono text-2xs text-overlay1">tu progreso vive en este navegador ·</span>
    <button data-exportar type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">⇩ exportar</button>
    <label class="d-btn d-btn-xs d-btn-ghost font-mono">
      ⇧ importar<input data-importar type="file" accept="application/json" class="hidden" />
    </label>
  </footer>

  <!-- el cascarón que se clona por cada repaso: mismo contrato que Drill.astro -->
  <template data-plantilla-drill>
    <figure class="drill m-0 overflow-hidden rounded-sm border border-teal/35 bg-teal/5" data-vim-drill>
      <figcaption class="flex items-start justify-between gap-3 p-4 pb-3">
        <p class="m-0 text-base text-text" data-t-reto></p>
        <span data-estado class="font-mono text-sm text-overlay0">○</span>
      </figcaption>
      <div class="relative mx-4 overflow-hidden rounded-sm border border-borde shadow-panel">
        <div class="flex items-center gap-1.5 border-b border-borde bg-mantle px-3 py-1.5">
          <span class="size-2.5 rounded-full bg-red/70"></span>
          <span class="size-2.5 rounded-full bg-yellow/70"></span>
          <span class="size-2.5 rounded-full bg-green/70"></span>
          <span class="ml-2 font-mono text-2xs text-overlay1">nvim · repaso</span>
        </div>
        <div data-term class="min-h-24 bg-crust font-mono text-sm"></div>
        <div class="flex items-center gap-2 border-t border-borde bg-mantle px-3 py-1">
          <span data-modo data-valor="normal" class="rounded-xs bg-mauve px-1.5 font-mono text-2xs font-bold text-crust uppercase">NORMAL</span>
          <span data-hud class="flex min-h-5 flex-1 flex-wrap items-center gap-1 overflow-hidden"></span>
        </div>
      </div>
      <div class="flex items-center gap-2 p-4 pt-3">
        <button data-accion="reiniciar" type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">↺ reiniciar</button>
        <button data-accion="solucion" type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">▶ ver solución</button>
        <button data-accion="fallo" type="button" class="d-btn d-btn-xs d-btn-ghost ml-auto font-mono text-red/80">no me sale — repásalo antes</button>
      </div>
      <p class="m-0 border-t border-teal/20 px-4 py-2 font-mono text-2xs text-overlay1" data-t-origen></p>
      <script type="application/json" data-t-def></script>
    </figure>
  </template>
</DocLayout>

<script>
  import { montarPendientes } from '../../lib/vim/drill-mount';
  import {
    estadisticas, exportar, fallarDrill, importar, racha, repasosVencidos,
  } from '../../lib/vim/progreso';

  const activar = () => {
    const cola = document.querySelector<HTMLElement>('[data-cola]');
    if (!cola || cola.dataset.vivo) return;
    cola.dataset.vivo = '1';

    const stats = estadisticas();
    const vencidos = repasosVencidos();
    const pintar = (id: string, v: string | number) => {
      const el = document.querySelector(`[data-metrica="${id}"]`);
      if (el) el.textContent = String(v);
    };
    pintar('racha', racha());
    pintar('vencidos', vencidos.length);
    pintar('dominados', `${stats.dominados}/${stats.total}`);
    pintar('fallos', stats.fallos);

    // la cola de hoy: se clona el cascarón por cada repaso vencido (máx. 12)
    const plantilla = document.querySelector<HTMLTemplateElement>('[data-plantilla-drill]')!;
    for (const r of vencidos.slice(0, 12)) {
      const nodo = plantilla.content.cloneNode(true) as DocumentFragment;
      const raiz = nodo.querySelector<HTMLElement>('[data-vim-drill]')!;
      raiz.dataset.id = r.id;
      raiz.dataset.reto = r.reto;
      nodo.querySelector('[data-t-reto]')!.textContent = r.reto;
      const origen = nodo.querySelector<HTMLElement>('[data-t-origen]')!;
      origen.innerHTML = `de <a href="${r.leccion}" class="text-teal">${r.leccion.replace('/guia/neovim/', '').replace(/\/$/, '')}</a>`;
      nodo.querySelector('[data-t-def]')!.textContent = JSON.stringify(r.def);
      raiz.querySelector('[data-accion="fallo"]')?.addEventListener('click', (ev) => {
        fallarDrill(r.id);
        (ev.currentTarget as HTMLElement).replaceWith(
          Object.assign(document.createElement('span'), {
            className: 'ml-auto font-mono text-2xs text-overlay1',
            textContent: 'programado antes ✓ — mira la solución y repítelo',
          }),
        );
      });
      cola.append(nodo);
    }
    document.querySelector('[data-cola-vacia]')?.toggleAttribute('hidden', vencidos.length > 0);
    montarPendientes();

    // puntos débiles
    const debiles = document.querySelector<HTMLElement>('[data-debiles]');
    if (debiles && stats.debiles.length > 0) {
      document.querySelector('[data-seccion-debiles]')?.removeAttribute('hidden');
      for (const d of stats.debiles) {
        const li = document.createElement('li');
        li.className = 'flex items-baseline gap-2 rounded-xs border border-borde bg-panel px-3 py-1.5 text-sm';
        li.innerHTML = `<span class="font-mono text-2xs text-red">×${d.fallos}</span>
          <span class="flex-1 text-subtext1">${d.reto}</span>
          <a href="${d.leccion}" class="font-mono text-2xs text-overlay1 hover:text-mauve">ver lección →</a>`;
        debiles.append(li);
      }
    }

    // exportar / importar
    document.querySelector('[data-exportar]')?.addEventListener('click', () => {
      const blob = new Blob([exportar()], { type: 'application/json' });
      const a = Object.assign(document.createElement('a'), {
        href: URL.createObjectURL(blob),
        download: 'nvim-dojo-progreso.json',
      });
      a.click();
      URL.revokeObjectURL(a.href);
    });
    document.querySelector<HTMLInputElement>('[data-importar]')?.addEventListener('change', async (ev) => {
      const f = (ev.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        importar(await f.text());
        location.reload();
      } catch {
        alert('Ese fichero no parece un progreso del dojo.');
      }
    });
  };

  document.addEventListener('astro:page-load', activar);
</script>
