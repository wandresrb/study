---
// Repaso espaciado de los drills que YA practicaste en las lecciones.
// Todo es client-side sobre localStorage — al completar un drill se guardó su
// definición completa, así que aquí se reproduce sin visitar su lección.
// Fallar un repaso lo adelanta; acertarlo lo aleja (1 → 3 → 7 → 21 días).
import DocLayout from '../../layouts/DocLayout.astro';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Play from '@lucide/astro/icons/play';
import Download from '@lucide/astro/icons/download';
import Upload from '@lucide/astro/icons/upload';
---

<DocLayout
  title="Repaso · Neovim · wandres.dev"
  description="Repaso espaciado de los drills practicados: hoy toca lo que estás a punto de olvidar."
  subject="neovim"
  full
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Neovim', href: '/neovim/' }, { text: 'Repaso' }]}
>
  <header class="mb-8">
    <h1 class="m-0 text-3xl font-bold text-text">Repaso</h1>
    <p class="mt-2 max-w-prose text-subtext1">
      Aquí no se aprende: se <b>retiene</b>. Cada drill que completas en una lección entra en una
      cola de repaso espaciado — 1, 3, 7 y 21 días—. Fallar lo adelanta, acertarlo lo aleja. Diez
      minutos al día aquí valen más que una tarde releyendo.
    </p>
  </header>

  <section class="mb-8 grid gap-3 sm:grid-cols-4" data-metrics>
    {
      [
        ['streak', 'días de práctica'],
        ['due', 'repasos para hoy'],
        ['mastered', 'ejercicios dominados'],
        ['misses', 'fallos acumulados'],
      ].map(([id, label]) => (
        <div class="d-stat rounded-sm border border-line bg-panel">
          <div class="d-stat-value font-mono text-2xl text-text" data-metric={id}>—</div>
          <div class="d-stat-desc text-2xs text-overlay1">{label}</div>
        </div>
      ))
    }
  </section>

  <section class="mb-10">
    <h2 class="mb-1 font-mono text-sm tracking-smallcaps text-overlay1 uppercase">repasos de hoy</h2>
    <p class="mb-4 mt-0 text-sm text-subtext0" data-queue-empty hidden>
      Nada vencido. O estás al día, o todavía no has completado ningún drill en las lecciones —
      empieza por <a href="/guide/neovim/gramatica-vim/" class="text-mauve">la gramática</a>.
    </p>
    <div data-queue class="grid gap-6"></div>
  </section>

  <section class="mb-10" data-weakest-section hidden>
    <h2 class="mb-3 font-mono text-sm tracking-smallcaps text-overlay1 uppercase">tus puntos débiles</h2>
    <ul data-weakest class="m-0 grid list-none gap-1.5 p-0"></ul>
  </section>

  <footer class="flex flex-wrap items-center gap-2 border-t border-line pt-4">
    <span class="font-mono text-2xs text-overlay1">tu progreso vive en este navegador ·</span>
    <button data-export type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono"><Download class="size-3.5" aria-hidden="true" />exportar</button>
    <label class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono">
      <Upload class="size-3.5" aria-hidden="true" />importar<input data-import type="file" accept="application/json" class="hidden" />
    </label>
  </footer>

  <!-- el cascarón que se clona por cada repaso: mismo contrato que Drill.astro -->
  <template data-tpl-exercise>
    <figure class="drill m-0 overflow-hidden rounded-sm border border-teal/35 bg-teal/5" data-vim-exercise>
      <figcaption class="flex items-start justify-between gap-3 p-4 pb-3">
        <p class="m-0 text-base text-text" data-tpl-challenge></p>
        <span data-state class="font-mono text-sm text-overlay0">○</span>
      </figcaption>
      <div class="relative mx-4 overflow-hidden rounded-sm border border-line shadow-panel">
        <div class="flex items-center gap-1.5 border-b border-line bg-mantle px-3 py-1.5">
          <span class="size-2.5 rounded-full bg-red/70"></span>
          <span class="size-2.5 rounded-full bg-yellow/70"></span>
          <span class="size-2.5 rounded-full bg-green/70"></span>
          <span class="ml-2 font-mono text-2xs text-overlay1">nvim · repaso</span>
        </div>
        <div data-term class="min-h-24 bg-crust font-mono text-sm"></div>
        <div class="flex items-center gap-2 border-t border-line bg-mantle px-3 py-1">
          <span data-mode data-value="normal" class="rounded-xs bg-mauve px-1.5 font-mono text-2xs font-bold text-crust uppercase">NORMAL</span>
          <span data-hud class="flex min-h-5 flex-1 flex-wrap items-center gap-1 overflow-hidden"></span>
        </div>
      </div>
      <div class="flex items-center gap-2 p-4 pt-3">
        <button data-action="reset" type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono"><RotateCcw class="size-3.5" aria-hidden="true" />reiniciar</button>
        <button data-action="solution" type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono"><Play class="size-3.5" aria-hidden="true" />ver solución</button>
        <button data-action="miss" type="button" class="d-btn d-btn-xs d-btn-ghost ml-auto font-mono text-red/80">no me sale — repásalo antes</button>
      </div>
      <p class="m-0 border-t border-teal/20 px-4 py-2 font-mono text-2xs text-overlay1" data-tpl-origin></p>
      <script is:inline type="application/json" data-tpl-def></script>
    </figure>
  </template>
</DocLayout>

<script>
  import { mountPending } from '../../lib/vim/mount';
  import { due, exportAll, importAll, miss, stats as learnerStats, streak } from '../../lib/learner';
  import type { ExerciseDef } from '../../lib/vim/engine';

  const activate = async () => {
    const queue = document.querySelector<HTMLElement>('[data-queue]');
    if (!queue || queue.dataset.live) return;
    queue.dataset.live = '1';

    const stats = await learnerStats();
    const dueItems = await due();
    const paint = (id: string, v: string | number) => {
      const el = document.querySelector(`[data-metric="${id}"]`);
      if (el) el.textContent = String(v);
    };
    paint('streak', await streak());
    paint('due', dueItems.length);
    paint('mastered', `${stats.mastered}/${stats.total}`);
    paint('misses', stats.misses);

    // today's queue: the shell is cloned once per due review (max 12)
    const template = document.querySelector<HTMLTemplateElement>('[data-tpl-exercise]')!;
    for (const r of dueItems.slice(0, 12)) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const root = node.querySelector<HTMLElement>('[data-vim-exercise]')!;
      // Replayed away from its lesson: the item keeps its own id and origin,
      // or the mount would file the practice under /neovim/recall/.
      root.dataset.id = r.id.split('#')[1] ?? r.id;
      root.dataset.itemId = r.id;
      root.dataset.lesson = r.lesson;
      root.dataset.challenge = r.label ?? '';
      node.querySelector('[data-tpl-challenge]')!.textContent = r.label ?? '';
      const origin = node.querySelector<HTMLElement>('[data-tpl-origin]')!;
      const short = r.lesson.replace(/^neovim\//, '');
      origin.innerHTML = `de <a href="/guide/${r.lesson}/" class="text-teal">${short}</a>`;
      node.querySelector('[data-tpl-def]')!.textContent = JSON.stringify(r.data as ExerciseDef);
      root.querySelector('[data-action="miss"]')?.addEventListener('click', (ev) => {
        void miss(r.id);
        (ev.currentTarget as HTMLElement).replaceWith(
          Object.assign(document.createElement('span'), {
            className: 'ml-auto font-mono text-2xs text-overlay1',
            textContent: 'programado antes — mira la solución y repítelo',
          }),
        );
      });
      queue.append(node);
    }
    document.querySelector('[data-queue-empty]')?.toggleAttribute('hidden', dueItems.length > 0);
    mountPending();

    // weakest points
    const weakest = document.querySelector<HTMLElement>('[data-weakest]');
    if (weakest && stats.weakest.length > 0) {
      document.querySelector('[data-weakest-section]')?.removeAttribute('hidden');
      for (const d of stats.weakest) {
        const li = document.createElement('li');
        li.className = 'flex items-baseline gap-2 rounded-xs border border-line bg-panel px-3 py-1.5 text-sm';
        li.innerHTML = `<span class="font-mono text-2xs text-red">×${d.misses}</span>
          <span class="flex-1 text-subtext1">${d.label ?? ''}</span>
          <a href="/guide/${d.lesson}/" class="font-mono text-2xs text-overlay1 hover:text-mauve">ver lección →</a>`;
        weakest.append(li);
      }
    }

    // export / import
    document.querySelector('[data-export]')?.addEventListener('click', async () => {
      const blob = new Blob([await exportAll()], { type: 'application/json' });
      const a = Object.assign(document.createElement('a'), {
        href: URL.createObjectURL(blob),
        download: 'nvim-repaso.json',
      });
      a.click();
      URL.revokeObjectURL(a.href);
    });
    document.querySelector<HTMLInputElement>('[data-import]')?.addEventListener('change', async (ev) => {
      const f = (ev.target as HTMLInputElement).files?.[0];
      if (!f) return;
      try {
        await importAll(await f.text());
        location.reload();
      } catch {
        alert('Ese fichero no parece un progreso de repaso.');
      }
    });
  };

  document.addEventListener('astro:page-load', () => void activate());
</script>
