---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Primitivos', icon: '🧬', items: [
      { k: 'const [x, setX] = createSignal(0)', d: 'Signal: el getter es una función' },
      { k: 'createEffect(() => …)', d: 'Efecto: reacciona a sus deps' },
      { k: 'const full = createMemo(() => …)', d: 'Derivación cacheada' },
      { k: 'const [data] = createResource(src, fetcher)', d: 'Async como primitivo' },
      { k: 'setX(v => v + 1)', d: 'Setter con función updater' },
      { k: 'createSignal(v, { equals: false })', d: 'Notificar siempre' },
    ],
  },
  {
    cat: 'Control del tracking', icon: '🔍', items: [
      { k: 'untrack(() => x())', d: 'Leer sin suscribirse' },
      { k: 'batch(() => { … })', d: 'Agrupar setters en una propagación' },
      { k: 'on(x, (v) => …, { defer: true })', d: 'Deps explícitas, opcional diferir' },
      { k: 'createRoot(dispose => …)', d: 'Scope reactivo manual' },
      { k: 'onCleanup(() => …)', d: 'Liberar al re-ejecutar o disponer' },
      { k: 'getOwner() · runWithOwner()', d: 'Capturar y restaurar el dueño' },
    ],
  },
  {
    cat: 'Componentes y props', icon: '🧩', items: [
      { k: 'props.value', d: 'Leer prop (¡NO destructurar!)' },
      { k: 'mergeProps(defaults, props)', d: 'Defaults reactivos' },
      { k: 'const [local, rest] = splitProps(props, ["a"])', d: 'Separar y hacer spread' },
      { k: 'const c = children(() => props.children)', d: 'Resolver hijos una vez' },
      { k: '<div {...rest} />', d: 'Spread de props al DOM' },
    ],
  },
  {
    cat: 'Control flow', icon: '🔀', items: [
      { k: '<Show when={x()} fallback={…}>', d: 'Condicional (no uses && crudo)' },
      { k: '<For each={items()}>{(it) => …}</For>', d: 'Lista keyed por referencia' },
      { k: '<Index each={items()}>{(it) => …}</Index>', d: 'Lista por posición (it es signal)' },
      { k: '<Switch><Match when={…}>…</Match></Switch>', d: 'Ramas exclusivas' },
      { k: '<Dynamic component={comp()} />', d: 'Componente en runtime' },
      { k: '<Portal>…</Portal>', d: 'Renderizar fuera del árbol' },
      { k: '<ErrorBoundary fallback={…}>', d: 'Capturar errores' },
      { k: '<Suspense fallback={…}>', d: 'Esperar resources' },
    ],
  },
  {
    cat: 'Stores', icon: '📦', items: [
      { k: 'const [s, setS] = createStore({…})', d: 'Proxy reactivo anidado' },
      { k: 'setS("user", "name", "Ana")', d: 'setStore por path' },
      { k: 'setS("count", c => c + 1)', d: 'Updater en path' },
      { k: 'setS(produce(d => { d.list.push(x) }))', d: 'Mutación estilo Immer' },
      { k: 'setS(reconcile(nuevosDatos))', d: 'Fusionar datos externos' },
      { k: 'unwrap(s)', d: 'Objeto crudo no reactivo' },
    ],
  },
  {
    cat: 'Context y lifecycle', icon: '🌳', items: [
      { k: 'const Ctx = createContext(default)', d: 'Crear contexto' },
      { k: '<Ctx.Provider value={…}>', d: 'Proveer al subárbol' },
      { k: 'const v = useContext(Ctx)', d: 'Consumir contexto' },
      { k: 'onMount(() => …)', d: 'Tras montar (DOM listo)' },
      { k: 'let el; <div ref={el} />', d: 'Ref al elemento' },
      { k: 'const c = lazy(() => import("./X"))', d: 'Componente diferido' },
    ],
  },
  {
    cat: 'SolidStart', icon: '🚀', items: [
      { k: 'routes/blog/[id].tsx', d: 'Ruta por archivo, param [id]' },
      { k: '"use server"', d: 'Función solo de servidor (RPC)' },
      { k: 'const getUser = query(fn, "user")', d: 'Cargar datos cacheado' },
      { k: 'const user = createAsync(() => getUser())', d: 'Derivación async como signal' },
      { k: 'const submit = action(fn)', d: 'Mutación de servidor' },
      { k: 'const s = useSubmission(submit)', d: 'Estado de la mutación' },
      { k: '<A href="/x">', d: 'Link con estado activo' },
    ],
  },
  {
    cat: 'CLI y tooling', icon: '🛠️', items: [
      { k: 'npm init solid@latest', d: 'Crear proyecto Solid/SolidStart' },
      { k: 'npm run dev', d: 'Servidor de desarrollo (Vite)' },
      { k: 'npm run build', d: 'Build de producción' },
      { k: 'solid-devtools', d: 'Inspeccionar el grafo reactivo' },
      { k: '@solid-primitives/*', d: 'Utilidades reactivas oficiales' },
      { k: 'app.config.ts', d: 'Config de SolidStart (preset, Vite)' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · SolidJS" description="Referencia buscable de SolidJS: signals, efectos, memos, stores, control flow, resources, context y SolidStart.">
  <header class="topbar">
    <span class="brand-mini">SolidJS <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="solid" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--blue)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de SolidJS</h1>
          <p class="desc">La reactividad fina entera en un sitio: primitivos, control flow, stores, async y SolidStart. Busca por API o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'createSignal', 'For', 'store', 'use server'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
