---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "Las piezas",
    "icon": "🍎",
    "items": [
      {
        "k": "@Reducer struct Feature",
        "d": "La macro que genera el andamiaje"
      },
      {
        "k": "@ObservableState struct State",
        "d": "El estado observado por SwiftUI"
      },
      {
        "k": "enum Action",
        "d": "Todo lo que puede ocurrir"
      },
      {
        "k": "var body: some ReducerOf<Self>",
        "d": "La lógica compuesta"
      },
      {
        "k": "Reduce { state, action in … }",
        "d": "El reducer propio"
      },
      {
        "k": "StoreOf<Feature>",
        "d": "El motor que une estado y reducer"
      }
    ]
  },
  {
    "cat": "Efectos",
    "icon": "⚡",
    "items": [
      {
        "k": ".none",
        "d": "Sin efecto"
      },
      {
        "k": ".run { send in await … }",
        "d": "Trabajo asíncrono"
      },
      {
        "k": ".send(.accion)",
        "d": "Enviar otra acción"
      },
      {
        "k": ".merge / .concatenate",
        "d": "Combinar efectos"
      },
      {
        "k": ".cancellable(id:) / .cancel(id:)",
        "d": "Cancelar por identificador"
      },
      {
        "k": "cancelInFlight: true",
        "d": "Cancelar la ejecución anterior"
      }
    ]
  },
  {
    "cat": "Dependencias",
    "icon": "💉",
    "items": [
      {
        "k": "@Dependency(\\.continuousClock) var clock",
        "d": "Reloj inyectado"
      },
      {
        "k": "@Dependency(\\.uuid) var uuid",
        "d": "Identificadores controlados"
      },
      {
        "k": "DependencyKey { liveValue }",
        "d": "Definir la tuya"
      },
      {
        "k": "@DependencyClient",
        "d": "Macro del cliente de closures"
      },
      {
        "k": "withDependencies { } operation:",
        "d": "Sobrescribir en un ámbito"
      }
    ]
  },
  {
    "cat": "Composición",
    "icon": "🧩",
    "items": [
      {
        "k": "Scope(state:action:) { Hija() }",
        "d": "Embeber un reducer hijo"
      },
      {
        "k": ".forEach(\\.items, action: \\.items)",
        "d": "Colección de features"
      },
      {
        "k": ".ifLet(\\.destino, action: \\.destino)",
        "d": "Feature opcional"
      },
      {
        "k": "IdentifiedArrayOf<T>",
        "d": "Colección con identidad"
      },
      {
        "k": "case delegate(Delegate)",
        "d": "Contrato del hijo hacia el padre"
      }
    ]
  },
  {
    "cat": "Navegación y UI",
    "icon": "🧭",
    "items": [
      {
        "k": "@Presents var destino: Destino.State?",
        "d": "Estado presentado"
      },
      {
        "k": ".sheet($store.scope(...))",
        "d": "Conectar un sheet"
      },
      {
        "k": "StackState / StackAction",
        "d": "Pila de navegación"
      },
      {
        "k": "@Bindable var store",
        "d": "Bindings en la vista"
      },
      {
        "k": "BindingReducer()",
        "d": "Formularios sin una acción por campo"
      }
    ]
  },
  {
    "cat": "Testing y estado",
    "icon": "🧪",
    "items": [
      {
        "k": "TestStore(initialState:) { Feature() }",
        "d": "Store de test exhaustivo"
      },
      {
        "k": "await store.send(.accion) { $0.x = 1 }",
        "d": "Afirmar la mutación"
      },
      {
        "k": "await store.receive(\\.respuesta)",
        "d": "Afirmar el efecto recibido"
      },
      {
        "k": "store.exhaustivity = .off",
        "d": "Testing no exhaustivo"
      },
      {
        "k": "@Shared(.appStorage(\"k\"))",
        "d": "Estado compartido y persistido"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · The Composable Architecture" description="TCA en un sitio: State, Action, Reducer, Effect y Store; composición, dependencias, navegación y testing.">
  <header class="topbar">
    <span class="brand-mini">TCA <b>Point-Free</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="tca" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--red)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de The Composable Architecture</h1>
          <p class="desc">TCA en un sitio: State, Action, Reducer, Effect y Store; composición, dependencias, navegación y testing.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: '@Reducer', 'Effect', '@Dependency', 'TestStore'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
