---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const groups = [
  {
    title: '📖 Documentación oficial',
    items: [
      { name: ':help', url: 'https://neovim.io/doc/', desc: 'La mejor doc de cualquier editor. Vive dentro de Neovim: :help ciw, :help lsp.' },
      { name: 'Neovim docs', url: 'https://neovim.io/doc/user/', desc: 'Manual de usuario completo en la web.' },
      { name: 'Lua guide (:h lua-guide)', url: 'https://neovim.io/doc/user/lua-guide.html', desc: 'Guía oficial de Lua para configurar Neovim.' },
    ],
  },
  {
    title: '🎓 Aprender',
    items: [
      { name: 'vimtutor', url: 'https://neovim.io/', desc: 'El tutorial interactivo. Ejecuta `nvim +Tutor`. Empieza aquí siempre.' },
      { name: 'Vim Adventures', url: 'https://vim-adventures.com/', desc: 'Aprende los movimientos jugando. Adictivo y efectivo.' },
      { name: 'kickstart.nvim', url: 'https://github.com/nvim-lua/kickstart.nvim', desc: 'Config mínima y bien comentada, ideal para leer y aprender.' },
    ],
  },
  {
    title: '🧩 Descubrir plugins',
    items: [
      { name: 'awesome-neovim', url: 'https://github.com/rockerBOO/awesome-neovim', desc: 'La lista curada de referencia de plugins por categoría.' },
      { name: 'dotfyle', url: 'https://dotfyle.com/', desc: 'Plugins con tendencias, configs de la comunidad y estadísticas de uso.' },
      { name: 'Neovimcraft', url: 'https://neovimcraft.com/', desc: 'Buscador de plugins con descripciones y tags.' },
    ],
  },
  {
    title: '📦 Distribuciones (para inspirarte)',
    items: [
      { name: 'LazyVim', url: 'https://www.lazyvim.org/', desc: 'La distro más popular sobre lazy.nvim. Roba ideas de su estructura.' },
      { name: 'NvChad', url: 'https://nvchad.com/', desc: 'Distro rápida y bonita, con un framework de UI propio.' },
      { name: 'AstroNvim', url: 'https://astronvim.com/', desc: 'Distro completa y muy configurable.' },
    ],
  },
  {
    title: '🛠️ Herramientas del ecosistema',
    items: [
      { name: 'Mason', url: 'https://github.com/mason-org/mason.nvim', desc: 'Instalador de LSP, formateadores, linters y debuggers.' },
      { name: 'lazy.nvim', url: 'https://github.com/folke/lazy.nvim', desc: 'El gestor de plugins estándar.' },
      { name: 'Nerd Fonts', url: 'https://www.nerdfonts.com/', desc: 'Fuentes con iconos para que todo se vea bien.' },
    ],
  },
  {
    title: '💬 Comunidad',
    items: [
      { name: 'r/neovim', url: 'https://www.reddit.com/r/neovim/', desc: 'Noticias, configs, plugins nuevos y ayuda.' },
      { name: 'Neovim en GitHub', url: 'https://github.com/neovim/neovim', desc: 'El repositorio, issues y discusiones del proyecto.' },
      { name: 'This Week in Neovim', url: 'https://dotfyle.com/this-week-in-neovim', desc: 'Boletín semanal con novedades del ecosistema.' },
    ],
  },
];
---
<BaseLayout title="Recursos · Neovim Nivel Dios" description="Enlaces curados para seguir aprendiendo Neovim: documentación, plugins, distribuciones y comunidad.">
  <header class="topbar">
    <span class="brand-mini">Neovim <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="neovim" />
    <main class="main">
      <div class="content">
        <div class="lesson-head">
          <span class="lvl-tag" style="color:var(--green)">📚 PARA SEGUIR CRECIENDO</span>
          <h1>Recursos</h1>
          <p class="desc">El nivel dios no termina aquí. Estos son los sitios donde seguir afilando tu setup.</p>
        </div>

        {groups.map((g) => (
          <section style="margin-top:2.4em">
            <h2 style="font-size:1.3rem;color:#fff;font-weight:800;margin-bottom:14px">{g.title}</h2>
            <div class="cards">
              {g.items.map((it) => (
                <a class="card" href={it.url} target="_blank" rel="noopener" style="text-decoration:none">
                  <h4>{it.name} ↗</h4>
                  <p>{it.desc}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
