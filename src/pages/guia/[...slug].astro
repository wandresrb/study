---
import { getCollection, render } from 'astro:content';
import { getLevels, getTrack } from '../../data/content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import Callout from '../../components/content/Callout.astro';
import KeyCap from '../../components/content/KeyCap.astro';
import Mermaid from '../../components/content/Mermaid.astro';
import Cards from '../../components/content/Cards.astro';
import Card from '../../components/content/Card.astro';
import PluginCard from '../../components/content/PluginCard.astro';
import Objetivos from '../../components/content/Goals.astro';
import Reto from '../../components/content/Challenge.astro';
import Lead from '../../components/content/Lead.astro';
import Drill from '../../components/content/Drill.astro';
import Paso from '../../components/content/Step.astro';
import Instalar from '../../components/content/Install.astro';

export async function getStaticPaths() {
  const hashOf = (text: string): string => {
    let h = 0x811c9dc5;
    for (let i = 0; i < text.length; i++) {
      h ^= text.charCodeAt(i);
      h = Math.imul(h, 0x01000193);
    }
    return (h >>> 0).toString(36);
  };

  const entries = await getCollection('guia');

  const trackSignature = new Map<string, string>();
  for (const trackId of new Set(entries.map((e) => e.data.subject))) {
    const siblings = entries
      .filter((e) => e.data.subject === trackId)
      .sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order)
      .map((e) => `${e.id}:${e.data.level}.${e.data.order}:${e.data.title}`);
    const track = getTrack(trackId);
    const shared = JSON.stringify([
      track.name, track.subtitle, track.colorHex, track.gradFrom, track.gradTo, track.ref,
      getLevels(trackId).map((l) => [l.idx, l.name, l.subtitle, l.color, l.digit, l.tags]),
    ]);
    trackSignature.set(trackId, `${siblings.length}:${hashOf(siblings.join('\0'))}:${hashOf(shared)}`);
  }

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
    cacheKey: `${entry.digest}:${trackSignature.get(entry.data.subject)}`,
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const components = {
  Callout,
  KeyCap,
  Kbd: KeyCap,
  Mermaid,
  Cards,
  Card,
  PluginCard,
  Objetivos,
  Reto,
  Lead,
  Drill,
  Paso,
  Instalar,
};
---
<GuideLayout entry={entry} headings={headings}>
  <Content components={components} />
</GuideLayout>
