---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import Callout from '../../components/Callout.astro';
import KeyCap from '../../components/KeyCap.astro';
import Mermaid from '../../components/Mermaid.astro';
import Cards from '../../components/Cards.astro';
import Card from '../../components/Card.astro';
import PluginCard from '../../components/PluginCard.astro';
import Objetivos from '../../components/Objetivos.astro';
import Reto from '../../components/Reto.astro';
import Lead from '../../components/Lead.astro';
import Drill from '../../components/Drill.astro';
import Paso from '../../components/Paso.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guia');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const components = {
  Callout,
  KeyCap,
  Kbd: KeyCap,
  Mermaid,
  Cards,
  Card,
  PluginCard,
  Objetivos,
  Reto,
  Lead,
  Drill,
  Paso,
};
---
<GuideLayout entry={entry} headings={headings}>
  <Content components={components} />
</GuideLayout>
