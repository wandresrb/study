---
import LandingLayout from '../layouts/LandingLayout.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';

const NOW = ['Rust', 'Tauri', 'WebAssembly', 'UniFFI', 'CRDTs', 'SQLite', 'Kotlin', 'Swift'];

const BEFORE = [
  {
    what: 'Plataforma de telesalud',
    where: 'EE. UU. · datos clínicos bajo HIPAA',
    detail:
      'Microservicios en NestJS y TypeScript para funciones de core, integración con historiales clínicos vía FHIR y control de acceso a datos personales que pasó auditorías externas.',
    stack: ['NestJS', 'FHIR', 'Kubernetes', 'DynamoDB', 'PostgreSQL', 'Redis', 'Elasticsearch'],
  },
  {
    what: 'Editorial educativa y software de diseño',
    where: 'Modernización de sistemas heredados',
    detail:
      'Migración de un monolito Java/Struts a microservicios sobre AWS ECS, rediseñando las APIs y cerrando el OWASP Top 10 en backend y frontend.',
    stack: ['Java', 'Spring Boot', 'AWS ECS', 'Oracle', 'Angular', 'Storybook'],
  },
  {
    what: 'Portal de empleo global',
    where: 'Fiabilidad y tiempo de respuesta',
    detail:
      'Frontend en React sobre servicios Java con GraphQL federado. El trabajo de diagnóstico y pruebas bajó un 40 % el tiempo de resolución de incidencias y un 30 % los defectos.',
    stack: ['React', 'Java', 'GraphQL', 'TDD'],
  },
  {
    what: 'Banca minorista',
    where: 'EE. UU. · consultoría técnica',
    detail:
      'Microservicios con Spring Boot —Data, Security, Cloud, MVC, AOP— entregados en contenedores, con mensajería por Kafka y CI/CD propio.',
    stack: ['Spring Boot', 'Kafka', 'Docker', 'Kubernetes', 'OpenShift'],
  },
  {
    what: 'Marketplace latinoamericano',
    where: 'Equipo de Data Science',
    detail:
      'Microservicios en Go para indexar un catálogo de recursos de almacenamiento, con las consultas y los tableros que el equipo usaba para decidir.',
    stack: ['Go', 'MySQL', 'Elasticsearch', 'BigQuery'],
  },
];
---
<LandingLayout
  title="Sobre wandres.dev"
  description="Centro de estudios de ciencias de la computación: por qué existe, quién lo escribe y con qué criterio."
  crumbs={[{ text: 'Sobre el sitio' }]}
>
  <canvas
    id="gossip-field"
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 -z-1 h-full w-full"></canvas>

  <header class="pt-10 pb-4">
    <p class="m-0 font-mono text-xs tracking-versalita text-mauve uppercase">Sobre el sitio</p>
    <h1
      class="mt-3 bg-(image:--gradiente-texto) bg-clip-text text-display font-extrabold tracking-titular text-transparent"
    >
      wandres.dev
    </h1>
    <p class="mt-5 max-w-medida text-lg text-subtext1">
      Un centro de estudios de ciencias de la computación, escrito por un ingeniero de software
      sénior que trabaja en <strong class="text-text">Rust</strong>, sistemas distribuidos y
      arquitecturas <strong class="text-text">local-first</strong>.
    </p>
    <p class="mt-3 max-w-medida text-md text-overlay1">
      El fondo de esta página es una red de réplicas. Muévete por ella y haz clic: cada clic es una
      escritura que se propaga a sus vecinos con latencia, y cuando dos frentes se cruzan gana la
      marca más reciente. Es, en pequeño, lo que hace un CRDT.
    </p>
  </header>

  <Section kicker="Ahora" title="Un core local-first en Rust" centered={false}>
    <p class="max-w-medida text-md text-subtext1">
      Un mismo núcleo en Rust para escritorio, sistemas embebidos y navegador: los bindings nativos
      se generan con UniFFI hacia Kotlin y Swift, y el navegador entra por WebAssembly con Tauri. La
      sincronización es offline-first con CRDTs —sin coordinador central, con resolución automática
      de conflictos— y la persistencia local va por SQLite, con la frontera IPC diseñada para que
      cruzarla cueste poco.
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      {NOW.map((t) => <Badge variant="outline" size="xs">{t}</Badge>)}
    </div>
  </Section>

  <Section kicker="Antes" title="Los sistemas que he construido" centered={false}>
    <ol class="m-0 grid list-none gap-4 p-0">
      {BEFORE.map((b) => (
        <li class="rounded-lg border border-borde bg-panel/70 p-5">
          <h3 class="m-0 text-lg font-bold text-text">{b.what}</h3>
          <p class="m-0 mt-1 font-mono text-xs text-overlay1">{b.where}</p>
          <p class="mt-3 max-w-medida text-md text-subtext1">{b.detail}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {b.stack.map((t) => <Badge variant="soft" size="xs">{t}</Badge>)}
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-4 font-mono text-xs text-overlay0">
      Descrito por tipo de sistema y no por empresa, a propósito.
    </p>
  </Section>

  <Section kicker="Criterio" title="Cómo trabajo" centered={false}>
    <p class="max-w-medida text-md text-subtext1">
      Prefiero entender los <em class="not-italic text-text">pocos principios</em> que generan muchos
      casos antes que coleccionar recetas sueltas. Un sistema que sabes por qué funciona lo puedes
      cambiar; uno que solo sabes usar, no. Ese sesgo está en todo lo que se publica aquí: cada tema
      empieza por el modelo mental y baja al detalle después, nunca al revés.
    </p>
  </Section>

  <Section kicker="El sitio" title="Por qué existe" centered={false}>
    <p class="max-w-medida text-md text-subtext1">
      Las guías nacieron como material escrito para estudiar a fondo lo que el trabajo iba
      exigiendo, y después pulido para que se sostuvieran solas. Hoy son 28 temarios y más de cinco
      mil lecciones: el mismo camino que necesita alguien que quiera construir sistemas, ordenado
      por niveles y sin saltarse los fundamentos.
    </p>
    <a
      href="/cs/"
      class="mt-6 inline-flex items-center gap-2 rounded-full border border-borde bg-panel px-5 py-2.5 font-mono text-sm text-text no-underline transition-colors hover:border-acento"
    >
      Ir al Centro de Estudios <span aria-hidden="true">→</span>
    </a>
  </Section>

  <Section kicker="Contacto" title="Escríbeme" centered={false} class="mb-24">
    <p class="max-w-medida text-md text-subtext1">
      ¿Algo que comentar, corregir o proponer? El correo es el camino corto.
    </p>
    <div class="mt-5 flex flex-wrap gap-3 font-mono text-sm">
      <a href="mailto:hola@wandres.dev" class="text-blue">hola@wandres.dev</a>
      <span class="text-surface1" aria-hidden="true">·</span>
      <a href="https://github.com/wandresrb" target="_blank" rel="noopener" class="text-blue">
        GitHub
      </a>
    </div>
  </Section>
</LandingLayout>

<script>
  import { mount } from '../lib/gossip';

  let field: { destroy(): void } | null = null;

  const start = () => {
    field?.destroy();
    const canvas = document.getElementById('gossip-field') as HTMLCanvasElement | null;
    field = canvas ? mount(canvas) : null;
  };

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    field?.destroy();
    field = null;
  });
</script>
