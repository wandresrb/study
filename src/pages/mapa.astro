---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import Chip from '../components/Chip.astro';
import { getTracks, getMapa, minutosDe } from '../data/contenido';

const lecciones = await getCollection('guia');
const totalLecciones = lecciones.length;
const totalHoras = Math.round(lecciones.reduce((a, l) => a + minutosDe(l.data.duracion), 0) / 60);
const disponibles = (await getTracks()).filter((t) => t.data.estado === 'disponible').length;
const mapa = await getMapa();

// Los dos planos del mapa. El núcleo son los conceptos; las aplicaciones, los
// dominios donde se implementan. Un mismo tema vive en los dos: sistemas
// distribuidos es concepto y Cloud su despliegue.
const planos = [
  {
    id: 'nucleo',
    titulo: 'El núcleo',
    kicker: 'Los conceptos',
    sub: 'La matemática, la ciencia y las herramientas que sostienen todo lo demás. Es cierto independientemente de la tecnología que uses.',
    cats: mapa.nucleo,
  },
  {
    id: 'aplicaciones',
    titulo: 'Las aplicaciones',
    kicker: 'Los dominios',
    sub: 'Dónde se implementa el núcleo. Un mismo concepto reaparece aquí con la forma que le da cada plataforma.',
    cats: mapa.aplicaciones,
  },
] as const;

// El mismo ancho y el mismo ritmo lateral que la cabecera. Antes esto era
// `.landing` a 1180 px mientras la cabecera iba a 1500: el contenido no se
// alineaba con la barra que tenía justo encima.
const ANCHO = 'mx-auto w-full max-w-[1500px] px-4 sm:px-10';
---

<BaseLayout
  buscador
  title="Nivel Dios · Tu hub de estudio"
  description="Guías interactivas para dominar tecnología de cero a nivel dios: Neovim, Swift & iOS, y Systems Programming (C23, Kernel, Rust)."
>
  <section class={`${ANCHO} pt-16 pb-14 sm:pt-24`}>
    <p
      class="inline-flex items-center gap-2 rounded-full border border-borde bg-mantle/70 px-3.5 py-1.5 font-mono text-[0.76rem] text-subtext0"
    >
      <span aria-hidden="true">📚</span>
      {disponibles} temas · {totalLecciones} lecciones · {totalHoras} h de estudio
    </p>

    <h1 class="mt-6 text-[clamp(2.4rem,6vw,4.4rem)]/[1.02] font-extrabold tracking-[-0.035em] text-balance">
      Tu hub de estudio<br />
      <span class="bg-linear-to-r from-mauve via-lavender to-blue bg-clip-text text-transparent">
        nivel dios
      </span>
    </h1>

    <p class="mt-5 max-w-[58ch] text-[clamp(1rem,1.5vw,1.15rem)]/[1.65] text-subtext0 text-pretty">
      Guías interactivas y profundas para dominar tecnología de cero a experto. Elige un tema y
      recorre el camino, nivel a nivel.
    </p>
  </section>

  {
    planos.map((plano) => (
      <section id={plano.id} class={`${ANCHO} scroll-mt-24 pb-16`}>
        <div class="max-w-[62ch] border-t border-borde pt-10">
          <p class="m-0 font-mono text-[0.76rem] tracking-[0.16em] text-overlay1 uppercase">
            {plano.kicker}
          </p>
          <h2 class="mt-2 text-[clamp(1.7rem,3.4vw,2.5rem)]/[1.1] font-bold tracking-[-0.02em]">
            {plano.titulo}
          </h2>
          <p class="mt-3 text-[0.98rem]/[1.65] text-subtext0 text-pretty">{plano.sub}</p>
        </div>

        {plano.cats.map(({ cat, tracks, escritos, porEscribir, lecciones, minutos }) => (
          <div
            id={`cat-${cat.id}`}
            /* El ancla la usa la paleta de ⌘K, y con cabecera pegajosa hay que
               dejarle sitio o el salto deja el título debajo de la barra. */
            class="scroll-mt-24 pt-12"
            style={`--cat-color:${cat.data.colorHex}`}
          >
            <div class="flex items-start gap-4">
              {/* La ficha, no un cuadrado con el valor dentro: `icono` ya NO es
                  un emoji, es un nombre como `lucide:sigma`. Pintarlo a pelo
                  imprimiría ese texto. Y la caja va por clase —no por
                  utilidades— porque `.cat-icon` es lo que le fija a la ficha el
                  lado, el radio y el grosor de trazo. */}
              <Chip
                caja="cat-icon"
                valor={cat.data.icono}
                from={cat.data.gradFrom}
                to={cat.data.gradTo}
              />

              <div class="min-w-0">
                <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[1.25rem] font-semibold">
                  {cat.data.nombre}
                  <span class="font-mono text-[0.72rem] font-normal text-overlay1">
                    {escritos.length > 0
                      ? `${escritos.length} ${escritos.length === 1 ? 'tema' : 'temas'} · ${lecciones} lecciones · ${Math.round(minutos / 60)} h`
                      : `${porEscribir.length} temas por escribir`}
                  </span>
                </h3>
                <p class="mt-1 max-w-[70ch] text-[0.92rem]/[1.6] text-overlay2 text-pretty">
                  {cat.data.descripcion}
                </p>
              </div>
            </div>

            {/* `cat-children` se queda: NO es solo la rejilla. Bajo esa clase
                viven las reglas que hacen COMPACTA la ficha dentro del mapa
                —oculta la descripción, encoge el logo, pone los chips a lo
                ancho— y `.path-card` la reutilizan el camino de niveles y el
                404, donde sigue siendo una fila ancha. Quitarla cambiaría las
                59 tarjetas. */}
            <div class="mt-6 cat-children">
              {tracks.map((t) => (
                <TrackCard track={t} />
              ))}
            </div>
          </div>
        ))}
      </section>
    ))
  }
</BaseLayout>
