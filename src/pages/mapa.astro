---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import { getCollection } from 'astro:content';
import { getTracks, getMapa, minutosDe } from '../data/contenido';

const lecciones = await getCollection('guia');
const totalLecciones = lecciones.length;
const totalHoras = Math.round(lecciones.reduce((a, l) => a + minutosDe(l.data.duracion), 0) / 60);
const disponibles = (await getTracks()).filter((t) => t.data.estado === 'disponible').length;
const mapa = await getMapa();

// Los dos planos del mapa. El núcleo son los conceptos; las aplicaciones, los
// dominios donde se implementan. Un mismo tema vive en los dos: sistemas
// distribuidos es concepto y Cloud su despliegue.
const planos = [
  { id: 'nucleo', titulo: 'El núcleo', kicker: 'Los conceptos',
    sub: 'La matemática, la ciencia y las herramientas que sostienen todo lo demás. Es cierto independientemente de la tecnología que uses.',
    cats: mapa.nucleo },
  { id: 'aplicaciones', titulo: 'Las aplicaciones', kicker: 'Los dominios',
    sub: 'Dónde se implementa el núcleo. Un mismo concepto reaparece aquí con la forma que le da cada plataforma.',
    cats: mapa.aplicaciones },
] as const;
---
<BaseLayout title="Nivel Dios · Tu hub de estudio" description="Guías interactivas para dominar tecnología de cero a nivel dios: Neovim, Swift & iOS, y Systems Programming (C23, Kernel, Rust).">
  <div class="landing">
    <div class="nav-top">
      <a class="brand" href="/mapa/">
        <span class="logo">∞</span>
        <span class="brand-text"><b>Nivel Dios</b><span>tu hub de estudio</span></span>
      </a>
      <span class="spacer"></span>
      <nav>
        <a href="/about/">Sobre mí</a>
      </nav>
    </div>

    <section class="hero">
      <span class="eyebrow">📚 {disponibles} temas · {totalLecciones} lecciones · {totalHoras} h de estudio</span>
      <h1>Tu hub de estudio<br /><span class="grad">nivel dios</span></h1>
      <p class="sub">
        Guías interactivas y profundas para dominar tecnología de cero a experto.
        Elige un tema y recorre el camino, nivel a nivel.
      </p>
    </section>

    {planos.map((plano) => (
      <section class="section plano" id={plano.id}>
        <div class="section-head">
          <div class="kicker">{plano.kicker}</div>
          <h2>{plano.titulo}</h2>
          <p>{plano.sub}</p>
        </div>

        {plano.cats.map(({ cat, tracks, escritos, porEscribir, lecciones, minutos }) => (
          <div class="categoria" style={`--cat-color:${cat.data.colorHex}`}>
            <div class="cat-head">
              <div class="cat-icon" style={`background:linear-gradient(135deg, ${cat.data.gradFrom}, ${cat.data.gradTo})`}>{cat.data.icono}</div>
              <div class="cat-meta">
                <h3>
                  {cat.data.nombre}
                  <span class="cat-badge">
                    {escritos.length > 0
                      ? `${escritos.length} ${escritos.length === 1 ? 'tema' : 'temas'} · ${lecciones} lecciones · ${Math.round(minutos / 60)} h`
                      : `${porEscribir.length} temas por escribir`}
                  </span>
                </h3>
                <p>{cat.data.descripcion}</p>
              </div>
            </div>
            <div class="cat-children">
              {tracks.map((t) => <TrackCard track={t} />)}
            </div>
          </div>
        ))}
      </section>
    ))}

    <footer class="footer">
      <p class="fmono">Nivel Dios · Hub de estudio</p>
      <p>Construido con Astro + MDX. Un tema, un camino, de cero a ∞.</p>
    </footer>
  </div>
</BaseLayout>
