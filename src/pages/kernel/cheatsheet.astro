---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'Módulos (LKM)', icon: '🧩', items: [
      { k: 'module_init(fn) / module_exit(fn)', d: 'Puntos de entrada/salida del módulo' },
      { k: 'printk(KERN_INFO ...) · pr_info()', d: 'Log del kernel (ver con dmesg)' },
      { k: 'MODULE_LICENSE("GPL")', d: 'Obligatorio (si no, tainted)' },
      { k: 'module_param(x, int, 0644)', d: 'Parámetro configurable (/sys)' },
      { k: 'insmod / rmmod / modprobe', d: 'Cargar / descargar módulos' },
      { k: 'lsmod · modinfo · dmesg', d: 'Inspeccionar módulos y logs' },
    ],
  },
  {
    cat: 'Memoria', icon: '🧠', items: [
      { k: 'kmalloc(n, GFP_KERNEL) / kfree', d: 'Reserva pequeña, físicamente contigua' },
      { k: 'kzalloc / kcalloc', d: 'Reserva puesta a cero' },
      { k: 'GFP_KERNEL vs GFP_ATOMIC', d: 'Puede dormir vs contexto atómico' },
      { k: 'alloc_pages(gfp, order)', d: 'Páginas del buddy allocator' },
      { k: 'vmalloc / vfree', d: 'Grande, virtualmente contiguo' },
      { k: 'kmem_cache_create/alloc/free', d: 'Cache de objetos (slab)' },
      { k: 'devm_kmalloc(dev, ...)', d: 'Memoria gestionada (auto-free)' },
    ],
  },
  {
    cat: 'Concurrencia', icon: '🔒', items: [
      { k: 'spin_lock / spin_unlock', d: 'Spinlock (no duerme)' },
      { k: 'spin_lock_irqsave(&l, flags)', d: 'Spinlock seguro ante IRQ' },
      { k: 'mutex_lock / mutex_unlock', d: 'Lock que puede dormir' },
      { k: 'atomic_t · atomic_inc/dec', d: 'Operaciones atómicas' },
      { k: 'rcu_read_lock · synchronize_rcu', d: 'RCU: lecturas lock-free' },
      { k: 'READ_ONCE / WRITE_ONCE · smp_mb', d: 'Barreras y accesos ordenados' },
    ],
  },
  {
    cat: 'Estructuras y macros', icon: '🧱', items: [
      { k: 'container_of(ptr, tipo, campo)', d: 'Del campo al struct contenedor' },
      { k: 'LIST_HEAD · list_add · list_for_each_entry', d: 'Listas intrusivas' },
      { k: 'ERR_PTR / PTR_ERR / IS_ERR', d: 'Errores codificados en punteros' },
      { k: 'likely() / unlikely()', d: 'Pistas al predictor de saltos' },
      { k: 'BUILD_BUG_ON(cond)', d: 'Fallar la compilación si cond' },
    ],
  },
  {
    cat: 'Drivers y dispositivos', icon: '📟', items: [
      { k: 'struct file_operations', d: 'Tabla open/read/write/ioctl' },
      { k: 'alloc_chrdev_region · cdev_add', d: 'Registrar char device' },
      { k: 'copy_to_user / copy_from_user', d: 'Cruzar la frontera con userspace' },
      { k: 'struct platform_driver · probe/remove', d: 'Driver de plataforma (device tree)' },
      { k: 'struct pci_driver · pci_enable_device', d: 'Driver PCI' },
      { k: 'request_threaded_irq(...)', d: 'Manejador de interrupción (moderno)' },
      { k: 'INIT_WORK · schedule_work', d: 'Diferir trabajo a un workqueue' },
    ],
  },
  {
    cat: 'VFS y block', icon: '🗄️', items: [
      { k: 'super_block · inode · dentry · file', d: 'Los cuatro objetos del VFS' },
      { k: 'register_filesystem · mount', d: 'Registrar un sistema de archivos' },
      { k: 'struct bio · submit_bio', d: 'Unidad de E/S de bloques' },
      { k: 'blk_mq_ops · queue_rq', d: 'Driver de bloques multi-cola' },
      { k: 'address_space · page cache', d: 'Caché de archivos en RAM' },
    ],
  },
  {
    cat: 'Red e I/O async', icon: '🌐', items: [
      { k: 'struct sk_buff', d: 'Un paquete de red' },
      { k: 'struct net_device · netdev_ops', d: 'Un interfaz de red' },
      { k: 'epoll_create1 / epoll_ctl / epoll_wait', d: 'E/S multiplexada O(1)' },
      { k: 'io_uring_setup · io_uring_enter', d: 'E/S por anillos (SQ/CQ)' },
      { k: 'io_uring_prep_read · io_uring_submit', d: 'liburing (completion-based)' },
      { k: 'XDP + eBPF', d: 'Procesar paquetes en el driver' },
    ],
  },
  {
    cat: 'Depuración y trazado', icon: '🔍', items: [
      { k: 'dmesg · /var/log/kern.log', d: 'Ver los mensajes del kernel' },
      { k: '/sys/kernel/tracing (ftrace)', d: 'Trazar funciones y eventos' },
      { k: 'perf record / report / stat', d: 'Perfilar el kernel' },
      { k: 'bpftrace -e ...', d: 'Observabilidad con eBPF (one-liners)' },
      { k: 'CONFIG_KASAN', d: 'Detectar corrupción de memoria' },
      { k: 'lockdep · CONFIG_PROVE_LOCKING', d: 'Detectar deadlocks' },
    ],
  },
  {
    cat: 'Build, config y QEMU', icon: '🔧', items: [
      { k: 'make menuconfig · .config', d: 'Configurar el kernel (y/m/n)' },
      { k: 'make -j$(nproc)', d: 'Compilar la imagen y módulos' },
      { k: 'obj-m += mod.o · M=$(PWD)', d: 'Makefile de módulo out-of-tree' },
      { k: 'qemu-system-x86_64 -kernel bzImage', d: 'Arrancar en VM (seguro)' },
      { k: 'qemu ... -s -S · gdb vmlinux', d: 'Depurar el kernel con gdb' },
      { k: 'scripts/checkpatch.pl · make C=1', d: 'Estilo (checkpatch) y sparse' },
    ],
  },
  {
    cat: 'Rust for Linux', icon: '🦀', items: [
      { k: 'module! { ... }', d: 'Declarar un módulo en Rust' },
      { k: 'impl kernel::Module', d: 'El tipo del módulo, con init' },
      { k: 'Result<T> · ?', d: 'Errores sin panics ni -errno' },
      { k: 'Arc · Mutex (crate kernel)', d: 'Concurrencia segura por tipos' },
      { k: 'Send / Sync', d: 'Data races imposibles en compilación' },
    ],
  },
  {
    cat: 'Contribuir', icon: '✉️', items: [
      { k: 'git format-patch -1', d: 'Generar el parche' },
      { k: 'scripts/get_maintainer.pl', d: 'A quién y a qué lista enviar' },
      { k: 'git send-email', d: 'Enviar el parche (texto plano)' },
      { k: 'Signed-off-by: · Fixes: · Cc: stable', d: 'Los tags obligatorios' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Kernel de Linux Nivel Dios" description="Referencia buscable del kernel de Linux: módulos, memoria, concurrencia, drivers, VFS, red, io_uring, depuración y Rust.">
  <header class="topbar">
    <span class="brand-mini">Kernel <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="kernel" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--yellow)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet del Kernel</h1>
          <p class="desc">Las APIs, comandos y herramientas del kernel en un solo sitio. Busca por función o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'kmalloc', 'spinlock', 'io_uring', 'ftrace'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
