---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    cat: 'pnpm', icon: '📦', items: [
      { k: 'pnpm install', d: 'Instalar (usa el store enlazado)' },
      { k: 'pnpm add pkg -D', d: 'Añadir devDependency' },
      { k: 'pnpm -r build', d: 'Ejecutar en todos los paquetes' },
      { k: 'pnpm --filter web dev', d: 'Ejecutar en un paquete' },
      { k: 'pnpm --filter ...web build', d: 'El paquete y sus dependencias' },
      { k: 'workspace:*', d: 'Dependencia interna del monorepo' },
      { k: 'catalog:', d: 'Versión compartida del catalog' },
      { k: 'pnpm install --frozen-lockfile', d: 'CI: fallar si el lock no coincide' },
    ],
  },
  {
    cat: 'package.json', icon: '📄', items: [
      { k: '"type": "module"', d: 'El paquete es ESM' },
      { k: '"exports": { ".": … }', d: 'Puntos de entrada públicos' },
      { k: '"sideEffects": false', d: 'Permite tree shaking agresivo' },
      { k: '"files": ["dist"]', d: 'Qué se publica' },
      { k: '"packageManager": "pnpm@11"', d: 'Fijar el gestor (corepack)' },
      { k: '^1.2.3 · ~1.2.3', d: 'Rango minor / patch' },
    ],
  },
  {
    cat: 'Vite', icon: '⚡', items: [
      { k: 'npm create vite@latest', d: 'Crear proyecto' },
      { k: 'vite · vite dev', d: 'Dev server (ESM, HMR)' },
      { k: 'vite build', d: 'Build de producción → dist/' },
      { k: 'vite preview', d: 'Previsualizar el build' },
      { k: 'defineConfig({ plugins: [] })', d: 'vite.config.ts' },
      { k: 'resolve.alias', d: 'Alias de imports' },
      { k: 'server.proxy', d: 'Proxy de API en dev' },
      { k: 'import.meta.env.PUBLIC_X', d: 'Variable de entorno' },
    ],
  },
  {
    cat: 'Bundler', icon: '🦀', items: [
      { k: 'Rolldown', d: 'Bundler en Rust (Vite 8, sobre Oxc)' },
      { k: 'Rollup', d: 'El modelo de plugins que heredó Vite' },
      { k: 'esbuild', d: 'Go, bundler+transform, optimizeDeps' },
      { k: 'oxlint · oxfmt', d: 'Linter/formatter en Rust (Oxc)' },
      { k: 'import("./x")', d: 'Split point (chunk bajo demanda)' },
      { k: 'manualChunks', d: 'Controlar el agrupado de chunks' },
      { k: '/* @__PURE__ */', d: 'Marca llamada sin efectos (tree shake)' },
    ],
  },
  {
    cat: 'Librerías', icon: '📚', items: [
      { k: 'build.lib', d: 'Vite en modo librería' },
      { k: 'tsup · unbuild · tsdown', d: 'Empaquetadores de librería' },
      { k: 'exports: { import, require, types }', d: 'Dual package + tipos' },
      { k: 'publint · attw', d: 'Verificar el empaquetado' },
      { k: 'npm publish --provenance', d: 'Publicar con procedencia firmada' },
      { k: 'npm publish --tag next', d: 'Prerelease sin mover latest' },
    ],
  },
  {
    cat: 'Monorepo · caché', icon: '🗄️', items: [
      { k: 'turbo run build', d: 'Ejecutar tareas con caché' },
      { k: 'turbo.json → dependsOn: ["^build"]', d: 'Deps primero' },
      { k: 'inputs / outputs', d: 'Base del hashing de la caché' },
      { k: 'turbo login · link', d: 'Activar remote caching (Vercel)' },
      { k: 'TURBO_TOKEN · TURBO_TEAM', d: 'Caché remota en CI' },
      { k: 'nx affected', d: 'Solo lo afectado por el cambio' },
      { k: 'nx-cloud · DTE', d: 'Caché remota + tareas distribuidas' },
    ],
  },
  {
    cat: 'Changesets', icon: '🦋', items: [
      { k: 'pnpm changeset', d: 'Declarar el impacto de un cambio' },
      { k: 'changeset version', d: 'Subir versiones + changelog' },
      { k: 'changeset publish', d: 'Publicar al registro' },
      { k: 'changesets/action', d: 'Release automatizado en CI' },
    ],
  },
  {
    cat: 'Producción', icon: '🚀', items: [
      { k: 'rollup-plugin-visualizer', d: 'Analizar el bundle (treemap)' },
      { k: 'size-limit', d: 'Presupuesto de tamaño en CI' },
      { k: 'Lighthouse CI', d: 'Auditar Web Vitals en cada PR' },
      { k: 'gzip · brotli', d: 'Compresión en el servidor' },
      { k: 'source maps', d: 'Depurar producción sin exponerlos' },
      { k: '[name].[hash].js', d: 'Cache-busting por contenido' },
    ],
  },
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Build & Producción" description="Referencia buscable del build frontend: pnpm, package.json, Vite, bundlers (Rolldown/Oxc), librerías, monorepos, caching y producción.">
  <header class="topbar">
    <span class="brand-mini">Build <b>& Producción</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="build" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--teal)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Build & Producción</h1>
          <p class="desc">El camino a producción entero en un sitio: pnpm, Vite, el bundler, librerías, monorepos y caching. Busca por comando o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'filter', 'exports', 'manualChunks', 'remote cache'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
