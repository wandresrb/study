---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "La arquitectura",
    "icon": "🔄",
    "items": [
      {
        "k": "Model",
        "d": "Todo el estado de la aplicación"
      },
      {
        "k": "Msg",
        "d": "Los mensajes que pueden ocurrir"
      },
      {
        "k": "update : Msg -> Model -> Model",
        "d": "Transición pura"
      },
      {
        "k": "view : Model -> Html Msg",
        "d": "Vista pura"
      },
      {
        "k": "Cmd Msg",
        "d": "Efecto descrito como dato"
      },
      {
        "k": "Sub Msg",
        "d": "Suscripción a eventos externos"
      }
    ]
  },
  {
    "cat": "Tipos",
    "icon": "🧬",
    "items": [
      {
        "k": "type alias Persona = { … }",
        "d": "Alias de record"
      },
      {
        "k": "type Estado = Cargando | Listo a",
        "d": "Custom type (unión)"
      },
      {
        "k": "case x of",
        "d": "Pattern matching exhaustivo"
      },
      {
        "k": "Maybe a",
        "d": "Just o Nothing (sin null)"
      },
      {
        "k": "Result e a",
        "d": "Ok o Err (sin excepciones)"
      },
      {
        "k": "{ modelo | campo = v }",
        "d": "Actualización inmutable de record"
      }
    ]
  },
  {
    "cat": "Funciones",
    "icon": "🧮",
    "items": [
      {
        "k": "|>",
        "d": "Pipe: encadenar de izquierda a derecha"
      },
      {
        "k": "<<  y  >>",
        "d": "Composición de funciones"
      },
      {
        "k": "List.map / filter / foldl",
        "d": "Orden superior sobre listas"
      },
      {
        "k": "Maybe.map / andThen",
        "d": "Transformar sin desenvolver"
      },
      {
        "k": "Maybe.withDefault v",
        "d": "Valor por defecto"
      }
    ]
  },
  {
    "cat": "Fronteras",
    "icon": "🚪",
    "items": [
      {
        "k": "Json.Decode.field \"n\" string",
        "d": "Decodificar JSON"
      },
      {
        "k": "Json.Decode.map2 / andThen",
        "d": "Combinar decoders"
      },
      {
        "k": "port enviar : Valor -> Cmd msg",
        "d": "Port de salida a JS"
      },
      {
        "k": "port recibir : (V -> msg) -> Sub msg",
        "d": "Port de entrada desde JS"
      },
      {
        "k": "flags",
        "d": "Configuración inicial al arrancar"
      }
    ]
  },
  {
    "cat": "App y tooling",
    "icon": "🛠️",
    "items": [
      {
        "k": "Browser.sandbox / element / application",
        "d": "Los programas de Elm"
      },
      {
        "k": "Url.Parser",
        "d": "De la URL a un tipo Route"
      },
      {
        "k": "Nav.pushUrl",
        "d": "Navegación programática"
      },
      {
        "k": "Html.lazy / Keyed",
        "d": "Optimizar el virtual DOM"
      },
      {
        "k": "elm make --optimize",
        "d": "Build de producción"
      },
      {
        "k": "elm-test / fuzz",
        "d": "Tests y property-based"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · The Elm Architecture" description="Elm y TEA en un sitio: Model, update, view, Cmd y Sub, tipos, decoders y ports.">
  <header class="topbar">
    <span class="brand-mini">The Elm <b>Architecture</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="elm" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--green)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de The Elm Architecture</h1>
          <p class="desc">Elm y TEA en un sitio: Model, update, view, Cmd y Sub, tipos, decoders y ports.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'update', 'Cmd', 'decoder', 'Maybe'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
