---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Section from '../../components/ui/Section.astro';
import Tile from '../../components/ui/Tile.astro';
import { getCategories, getConcepts } from '../../data/content';
import { iconoDe } from '../../lib/iconos';

const concepts = getConcepts();
const byCategory = getCategories()
  .map((category) => ({ category, own: concepts.filter((c) => c.category === category.id) }))
  .filter((g) => g.own.length > 0);
---
<LandingLayout
  search
  title="Conceptos · Centro de Estudios · wandres.dev"
  description="Los conceptos del núcleo, cada uno con los niveles que ya lo enseñan a través de los tracks."
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: 'Conceptos' }]}
>
  <section class="py-14 text-center">
    <h1 class="text-5xl/tight font-extrabold tracking-titular text-text text-balance">
      Los conceptos del núcleo
    </h1>
    <p class="mx-auto mt-4 max-w-medida text-lg text-subtext1">
      Un concepto no necesita track propio para existir en el mapa: estos {concepts.length} ya se
      enseñan a través de las lecciones escritas. Cada página es el índice de dónde.
    </p>
  </section>

  {byCategory.map(({ category, own }) => (
    <Section kicker="Conceptos" color={category.colorHex} title={category.name} lede={category.description}>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(14.5rem,100%),1fr))] gap-3.5">
        {own.map((c) => {
          const Icon = iconoDe(c.id);
          return (
            <Tile
              shape="compact"
              title={c.name}
              tags={[`${c.edges} niv`, `${c.tracksTeaching} tracks`]}
              color={category.colorHex}
              href={`/conceptos/${c.id}/`}
              logo={{ from: c.gradFrom, to: c.gradTo }}
            >
              <Fragment slot="glyph"><Icon class="ico" aria-hidden="true" /></Fragment>
            </Tile>
          );
        })}
      </div>
    </Section>
  ))}
</LandingLayout>
