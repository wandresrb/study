---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getTracks, getNiveles, leccionesDe } from '../data/contenido';
import Chip from '../components/Chip.astro';
import Ficha from '../components/Ficha.astro';

export async function getStaticPaths() {
  const tracks = await getTracks();
  return tracks
    .filter((t) => t.data.estado === 'disponible')
    .map((t) => ({ params: { track: t.id }, props: { entrada: t } }));
}

const { entrada } = Astro.props;
const trackId = entrada.id;
const track = entrada.data;
// `extras` (features y chips) vivía dentro de esta página: 56% del fichero y
// solo para 5 de 28 tracks. Ahora es un campo opcional del track.
const ex = track.extras ?? { features: [], chips: [] };

const all = await leccionesDe(trackId);
const firstOf = (lvl: number) => all.find((e) => e.data.level === lvl);
const total = all.length;
const nivelesConLecciones = (await getNiveles(trackId)).filter((n) => all.some((e) => e.data.level === n.id));

// El enlace a la cheatsheet no se declara: existe si existe la entrada.
const hoja = await getEntry('cheatsheets', trackId);
---
<BaseLayout buscador title={`${track.nombre} · Nivel Dios`} description={track.descripcion}>
  <div class="landing">
    <div class="nav-top">
      <a class="brand" href="/hub/">
        <Chip caja="logo" valor={track.logo} from={track.gradFrom} to={track.gradTo} marca={track.logoHexDark ?? track.logoHex} exacta={!!track.logoHexDark} />
        <span class="brand-text"><b>{track.nombre} · Nivel Dios</b><span>de cero a ∞</span></span>
      </a>
      <span class="spacer"></span>
      <nav>
        <a href="/hub/">← Temas</a>
        <a href="#camino">Camino</a>
        {hoja ? <a href={`/${trackId}/cheatsheet/`}>Cheatsheet</a> : null}
      </nav>
    </div>

    <section class="hero">
      <span class="eyebrow" style={`border-color:${track.colorHex}55`}>{track.subtitulo}</span>
      <h1>
        Domina {track.nombre}<br />
        hasta <span class="grad" style={`background:linear-gradient(120deg, ${track.gradFrom}, ${track.gradTo});-webkit-background-clip:text;background-clip:text;color:transparent`}>nivel dios</span>
      </h1>
      <p class="sub">{track.descripcion}</p>
      <div class="cta">
        {firstOf(nivelesConLecciones[0]?.id ?? 0) ? (
          <a class="btn btn-primary" href={`/guia/${firstOf(nivelesConLecciones[0].id)!.id}/`}
             style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>Empezar por el Nivel 0 →</a>
        ) : null}
        <a class="btn btn-ghost" href="#camino">Ver el camino completo</a>
      </div>
    </section>

    <section class="section" id="camino">
      <div class="section-head">
        <div class="kicker" style={`color:${track.colorHex}`}>La ruta</div>
        <h2>{nivelesConLecciones.length} niveles, de novato a dios</h2>
        <p>Cada nivel construye sobre el anterior. Sin saltos, sin huecos.</p>
      </div>
      <div class="path">
        {nivelesConLecciones.map((n) => {
          const first = firstOf(n.id);
          return (
            <Ficha
              enc="h3"
              titulo={n.nombre}
              subtitulo={`Nivel ${n.id} · ${n.subtitulo}`}
              descripcion={n.descripcion}
              etiquetas={n.tags}
              color={n.color}
              href={first ? `/guia/${first.id}/` : undefined}
              logo={{ valor: n.icono, from: n.color }}
            />
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="stats">
        <div class="stat"><b>{total}</b><span>lecciones</span></div>
        <div class="stat"><b>{nivelesConLecciones.length}</b><span>niveles</span></div>
        <div class="stat"><b>0→∞</b><span>de cero a dios</span></div>
      </div>
    </section>

    {ex.features.length ? (
      <section class="section">
        <div class="section-head">
          <div class="kicker" style={`color:${track.colorHex}`}>Qué vas a dominar</div>
          <h2>Todo lo que hace a un experto</h2>
        </div>
        <div class="features">
          {ex.features.map((f) => (
            <div class="feature">
              <div class="f-ic">{f.i}</div>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))}
        </div>
      </section>
    ) : null}

    {ex.chips.length ? (
      <section class="section">
        <div class="langs">
          {ex.chips.map((l) => (
            <span class="lang-chip"><span class="dot" style={`background:${l.c}`}></span>{l.n}</span>
          ))}
        </div>
      </section>
    ) : null}

    <section class="section">
      <div class="cta-final" style={`box-shadow:0 0 0 1px ${track.colorHex}33, 0 12px 40px -12px ${track.colorHex}44`}>
        <h2>¿Listo para dominar {track.nombre}?</h2>
        <p>Empieza por los fundamentos y sube nivel a nivel hasta el dominio total.</p>
        {firstOf(nivelesConLecciones[0]?.id ?? 0) ? (
          <a class="btn btn-primary" href={`/guia/${firstOf(nivelesConLecciones[0].id)!.id}/`}
             style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>Comenzar el camino →</a>
        ) : null}
      </div>
    </section>

    <footer class="footer">
      <p class="fmono">{track.nombre} · Nivel Dios</p>
      <p><a href="/hub/">← Volver a todos los temas</a></p>
    </footer>
  </div>
</BaseLayout>
