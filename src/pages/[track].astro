---
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Section from '../components/ui/Section.astro';
import Stat from '../components/ui/Stat.astro';
import { getTracks, getLevels, lessonsOf, hasCheatsheet } from '../data/content';
import Tile from '../components/ui/Tile.astro';

export function getStaticPaths() {
  return getTracks()
    .filter((t) => t.status === 'written')
    .map((t) => ({ params: { track: t.id }, props: { track: t } }));
}

const { track } = Astro.props;
const trackId = track.id;

const all = lessonsOf(trackId);
const firstOf = (idx: number) => all.find((l) => l.level === idx);
const total = all.length;
const levels = getLevels(trackId).filter((n) => all.some((l) => l.level === n.idx));

const sheet = hasCheatsheet(trackId);

const gradient = `linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`;

const goal = levels.at(-1)?.name.split(':')[0].trim() ?? 'el final del camino';
---
<LandingLayout
  search
  title={`${track.name} · Centro de Estudios · wandres.dev`}
  description={track.description}
  crumbs={[{ text: 'CS', href: '/cs/' }, { text: track.name }]}
>
    <section
      class="py-14 text-center"
      style={`--acento:${track.colorHex};--grad-a:${track.gradFrom};--grad-b:${track.gradTo}`}
    >
      <span class="inline-block rounded-full border border-(--acento)/35 px-3 py-1 text-xs tracking-versalita text-subtext0 uppercase">
        {track.subtitle}
      </span>

      <h1 class="mt-5 text-5xl/tight font-extrabold tracking-titular text-text text-balance">
        Domina {track.name}<br />
        hasta <span class="bg-linear-120 from-(--grad-a) to-(--grad-b) bg-clip-text text-transparent">{goal}</span>
      </h1>

      <p class="mx-auto mt-4 max-w-medida text-lg text-subtext1">{track.description}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {firstOf(levels[0]?.idx ?? 0) ? (
          <Button href={`/guide/${firstOf(levels[0].idx)!.id}/`} color={gradient}>
            Empezar por el Nivel 0 →
          </Button>
        ) : null}
        <Button href="#path" variant="ghost">Ver el camino completo</Button>
        {sheet ? <Button href={`/${trackId}/cheatsheet/`} variant="ghost">Cheatsheet</Button> : null}
      </div>

      <p id="track-progress" data-track={trackId} hidden class="mx-auto mt-5 text-sm text-overlay1">
        <span data-pct></span><a data-resume class="ml-2 text-subtext0 underline decoration-dotted underline-offset-4" href="#path"></a>
      </p>
    </section>

    <Section
      id="path"
      kicker="La ruta"
      color={track.colorHex}
      title={`${levels.length} niveles, de novato a dios`}
      lede="Cada nivel construye sobre el anterior. Sin saltos, sin huecos."
    >
      <div class="grid gap-3">
        {levels.map((n) => {
          const first = firstOf(n.idx);
          return (
            <Tile
              heading="h3"
              title={n.name}
              sr={`Nivel ${n.idx}`}
              subtitle={n.subtitle}
              description={n.description}
              tags={n.tags}
              color={n.color}
              href={first ? `/guide/${first.id}/` : undefined}
              logo={{ from: n.color }}
            >
              <Fragment slot="glyph">
                <span class="font-mono font-semibold tabular-nums text-[calc(var(--ico)*1px)]">
                  {n.digit ?? n.idx}
                </span>
              </Fragment>
            </Tile>
          );
        })}
      </div>
    </Section>

    <Section>
      <Stat
        items={[
          { value: String(total), label: 'lecciones' },
          { value: String(levels.length), label: 'niveles' },
          { value: '0→∞', label: 'de cero a dios' },
        ]}
      />
    </Section>

    {track.features.length ? (
      <Section kicker="Qué vas a dominar" color={track.colorHex} title="Todo lo que hace a un experto">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {track.features.map((f) => (
            <div class="d-card d-card-border border-borde bg-panel p-5 text-left">
              <div class="emoji text-2xl" aria-hidden="true">{f.icon}</div>
              <h3 class="mt-3 text-lg font-bold text-text">{f.title}</h3>
              <p class="mt-1.5 text-md text-subtext0">{f.description}</p>
            </div>
          ))}
        </div>
      </Section>
    ) : null}

    {track.chips.length ? (
      <Section>
        <div class="flex flex-wrap justify-center gap-2">
          {track.chips.map((c) => (
            <Badge variant="outline" color={c.color}>{c.label}</Badge>
          ))}
        </div>
      </Section>
    ) : null}

    <Section>
      <div
        class="rounded-xl border border-(--acento)/20 bg-panel px-6 py-10 text-center shadow-[0_12px_40px_-12px_var(--halo)]"
        style={`--acento:${track.colorHex};--halo:${track.colorHex}44`}
      >
        <h2 class="text-2xl font-extrabold tracking-titular text-text">¿Listo para dominar {track.name}?</h2>
        <p class="mx-auto mt-2 mb-6 max-w-medida text-md text-subtext1">
          Empieza por los fundamentos y sube nivel a nivel hasta el dominio total.
        </p>
        {firstOf(levels[0]?.idx ?? 0) ? (
          <Button href={`/guide/${firstOf(levels[0].idx)!.id}/`} color={gradient}>
            Comenzar el camino →
          </Button>
        ) : null}
      </div>
    </Section>
</LandingLayout>

<script>
  import { lessonIdOf, onChange, readSet } from '../lib/learner';

  interface LevelIndex { id: number; items: { u: string; t: string; n: string }[] }

  // «N % leído · reanudar en Nivel X»: hidden until there is progress. The
  // lesson list comes from the already-cached /nav/{track}.json.
  const paint = async () => {
    const box = document.getElementById('track-progress');
    const track = box?.dataset.track;
    if (!box || !track) return;

    const read = await readSet();
    if (!read.size) { box.hidden = true; return; }

    const levels: LevelIndex[] = await fetch(`/nav/${track}.json`)
      .then((r) => (r.ok ? r.json() : []))
      .catch(() => []);
    const all = levels.flatMap((n) => n.items.map((it) => ({ ...it, level: n.id })));
    if (!all.length) return;

    const done = all.filter((it) => read.has(lessonIdOf(it.u))).length;
    if (!done) { box.hidden = true; return; }

    const pct = box.querySelector<HTMLElement>('[data-pct]');
    const resume = box.querySelector<HTMLAnchorElement>('[data-resume]');
    if (!pct || !resume) return;

    const firstUnread = all.find((it) => !read.has(lessonIdOf(it.u)));
    pct.textContent = `${Math.round((done / all.length) * 100)} % leído (${done}/${all.length})`;
    if (firstUnread) {
      resume.href = firstUnread.u;
      resume.textContent = `reanudar en Nivel ${firstUnread.level}`;
      resume.hidden = false;
    } else {
      resume.hidden = true;
      pct.textContent = 'camino completo: 100 % leído';
    }
    box.hidden = false;
  };

  document.addEventListener('astro:page-load', () => void paint());
  onChange(() => void paint());
</script>
