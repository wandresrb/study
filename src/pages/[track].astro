---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TRACKS, getTrack } from '../data/tracks';

export async function getStaticPaths() {
  return TRACKS.filter((t) => t.estado === 'disponible').map((t) => ({ params: { track: t.id } }));
}

const { track: trackId } = Astro.params;
const track = getTrack(trackId as string);

const all = (await getCollection('guia'))
  .filter((e) => (e.data.subject ?? 'neovim') === track.id)
  .sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const firstOf = (lvl: number) => all.find((e) => e.data.level === lvl);
const total = all.length;
const nivelesConLecciones = track.niveles.filter((n) => all.some((e) => e.data.level === n.id));

// Contenido rico por track (features + chips)
const extras: Record<string, { features: { i: string; t: string; d: string }[]; chips: { n: string; c: string }[] }> = {
  neovim: {
    features: [
      { i: '⌨️', t: 'La gramática de Vim', d: 'Operadores + mociones + objetos de texto. Deja de memorizar atajos y empieza a "hablar" el idioma de la edición.' },
      { i: '🧠', t: 'LSP nativo 0.12', d: 'vim.lsp.enable, Mason, diagnósticos y code actions. El motor de un IDE moderno, sin la pesadez.' },
      { i: '⚡', t: 'blink.cmp', d: 'Autocompletado en Rust, fuzzy tolerante a typos y 0.5–4 ms por pulsación.' },
      { i: '🌳', t: 'Treesitter', d: 'Resaltado semántico, objetos de texto inteligentes y selección incremental.' },
      { i: '🪟', t: 'tmux + zellij', d: 'Multiplexores, navegación transparente entre paneles y sesionizadores.' },
      { i: '🤖', t: 'IA por capas', d: 'Copilot/Supermaven, Avante/CodeCompanion y Claude Code integrados en tu flujo.' },
      { i: '🦀', t: '4 stacks afinados', d: 'clangd, rustaceanvim, sourcekit-lsp y el trío React/Tailwind/TS.' },
      { i: '♻️', t: 'Automatización total', d: 'Macros, registros, quickfix, :g y :norm. Tareas repetitivas en una tecla.' },
    ],
    chips: [
      { n: 'C', c: '#89b4fa' }, { n: 'Rust', c: '#fab387' }, { n: 'Swift', c: '#f38ba8' },
      { n: 'React', c: '#89dceb' }, { n: 'TypeScript', c: '#89b4fa' }, { n: 'Tailwind', c: '#94e2d5' },
      { n: 'HTML', c: '#eba0ac' }, { n: 'CSS', c: '#b4befe' },
    ],
  },
  swift: {
    features: [
      { i: '🔤', t: 'Swift 6.3', d: 'El lenguaje moderno de Apple: opcionales, protocolos, genéricos y typed throws.' },
      { i: '🎨', t: 'SwiftUI declarativo', d: 'Construye interfaces con estado reactivo: describe el qué, no el cómo.' },
      { i: '👁️', t: '@Observable', d: 'El framework Observation: estado reactivo sin boilerplate, con @State como macro.' },
      { i: '🗄️', t: 'SwiftData', d: 'Persistencia con @Model y @Query: sin .xcdatamodeld ni NSManagedObject.' },
      { i: '⚡', t: 'Concurrencia Swift 6', d: 'async/await, actores y Sendable con concurrencia estricta que previene data races.' },
      { i: '🌐', t: 'Redes modernas', d: 'URLSession con async/await y Codable para consumir APIs sin dolor.' },
      { i: '🧪', t: 'Swift Testing', d: 'El nuevo framework de tests con @Test y #expect, más expresivo que XCTest.' },
      { i: '🚀', t: 'A la App Store', d: 'Arquitectura, firmas, TestFlight y publicación: de la idea a la tienda.' },
    ],
    chips: [
      { n: 'Swift 6.3', c: '#fab387' }, { n: 'SwiftUI', c: '#89b4fa' }, { n: 'SwiftData', c: '#a6e3a1' },
      { n: 'Observation', c: '#cba6f7' }, { n: 'Concurrency', c: '#f9e2af' }, { n: 'Xcode 26', c: '#89dceb' },
      { n: 'iOS 26', c: '#f5c2e7' }, { n: 'App Store', c: '#f38ba8' },
    ],
  },
  c23: {
    features: [
      { i: '🧠', t: 'Punteros y memoria', d: 'El concepto que define a C, la gestión manual del heap y las estrategias que escalan.' },
      { i: '✨', t: 'C23 moderno', d: 'constexpr, nullptr, typeof, _BitInt, #embed: el C de siempre, más afilado.' },
      { i: '🏗️', t: 'Build y linking', d: 'Meson, Make, bibliotecas .a/.so, el linker y el formato ELF por dentro.' },
      { i: '🔗', t: 'ABI', d: 'Las convenciones de llamada y la interfaz binaria que une el software compilado.' },
      { i: '📚', t: 'libc y freestanding', d: 'glibc vs musl, las syscalls, y el mundo sin libc: bare metal.' },
      { i: '🛡️', t: 'Sanitizers y fuzzing', d: 'ASan, UBSan, análisis estático y fuzzing: caza bugs antes de que ocurran.' },
      { i: '⚡', t: 'Concurrencia y bajo nivel', d: 'Atomics, el modelo de memoria, SIMD, caché y perf.' },
      { i: '🔱', t: 'Nivel PhD', d: 'Tu propia libc, un allocator desde cero, y cómo funciona un compilador.' },
    ],
    chips: [
      { n: 'gcc/clang', c: '#89b4fa' }, { n: 'C23', c: '#74c7ec' }, { n: 'Meson', c: '#a6e3a1' },
      { n: 'musl', c: '#94e2d5' }, { n: 'ASan', c: '#fab387' }, { n: 'ELF', c: '#f9e2af' },
      { n: 'freestanding', c: '#cba6f7' }, { n: 'UB', c: '#f38ba8' },
    ],
  },
  kernel: {
    features: [
      { i: '🐧', t: 'El C del kernel', d: 'GNU C freestanding, sin libc, con su propio universo de APIs y reglas.' },
      { i: '🔧', t: 'Kbuild y módulos', d: 'Configurar y compilar el kernel, y escribir módulos cargables (LKM).' },
      { i: '📟', t: 'Drivers y char devices', d: 'file_operations, el device model y hablar con el hardware.' },
      { i: '🔒', t: 'Concurrencia extrema', d: 'Spinlocks, mutexes, RCU y las barreras de memoria que escalan a miles de núcleos.' },
      { i: '🧠', t: 'Memoria del kernel', d: 'kmalloc, el slab allocator, páginas y memoria física.' },
      { i: '⚡', t: 'Interrupciones', d: 'IRQ handlers, softirqs, tasklets, workqueues y el planificador.' },
      { i: '🐞', t: 'Depuración', d: 'ftrace, KASAN, lockdep, kgdb: cazar bugs en el corazón del sistema.' },
      { i: '🦀', t: 'Rust for Linux', d: 'El nuevo lenguaje central del kernel: drivers seguros en Rust.' },
    ],
    chips: [
      { n: 'LKM', c: '#f9e2af' }, { n: 'Kbuild', c: '#fab387' }, { n: 'RCU', c: '#cba6f7' },
      { n: 'kmalloc', c: '#89b4fa' }, { n: 'IRQ', c: '#f38ba8' }, { n: 'ftrace', c: '#a6e3a1' },
      { n: 'Rust', c: '#eba0ac' }, { n: 'QEMU', c: '#94e2d5' },
    ],
  },
  rust: {
    features: [
      { i: '🦀', t: 'Ownership y borrowing', d: 'El sistema que garantiza seguridad de memoria sin recolector de basura.' },
      { i: '🧩', t: 'Traits y genéricos', d: 'Abstracción sin coste, el sistema de tipos más expresivo de los lenguajes de sistemas.' },
      { i: '⏳', t: 'Lifetimes', d: 'Cómo el borrow checker demuestra que tus referencias son válidas.' },
      { i: '⚡', t: 'Async (edición 2024)', d: 'async/await, futures, tokio y las async closures del edición 2024.' },
      { i: '🔓', t: 'Unsafe y FFI', d: 'Cuando necesitas bajar al metal: unsafe, punteros crudos e interop con C.' },
      { i: '🔩', t: 'no_std y embebido', d: 'Rust sin librería estándar: embebido, allocators y el kernel.' },
      { i: '🐞', t: 'Debugging y profiling', d: 'Las herramientas para depurar y optimizar Rust en producción.' },
      { i: '🔱', t: 'Metaprogramación', d: 'Macros y programación a nivel de tipos: el nivel PhD de Rust.' },
    ],
    chips: [
      { n: 'cargo', c: '#fab387' }, { n: 'Ownership', c: '#eba0ac' }, { n: 'traits', c: '#cba6f7' },
      { n: 'async', c: '#f9e2af' }, { n: 'no_std', c: '#89b4fa' }, { n: 'unsafe', c: '#f38ba8' },
      { n: 'edición 2024', c: '#a6e3a1' }, { n: 'tokio', c: '#94e2d5' },
    ],
  },
};
const ex = extras[track.id] ?? { features: [], chips: [] };
---
<BaseLayout title={`${track.nombre} · Nivel Dios`} description={track.descripcion}>
  <div class="landing">
    <div class="nav-top">
      <a class="brand" href="/">
        <span class="logo" style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>{track.logo}</span>
        <span class="brand-text"><b>{track.nombre} · Nivel Dios</b><span>de cero a ∞</span></span>
      </a>
      <span class="spacer"></span>
      <nav>
        <a href="/">← Temas</a>
        <a href="#camino">Camino</a>
        {track.ref.cheatsheet ? <a href={track.ref.cheatsheet}>Cheatsheet</a> : null}
      </nav>
    </div>

    <section class="hero">
      <span class="eyebrow" style={`border-color:${track.colorHex}55`}>{track.subtitulo}</span>
      <h1>
        Domina {track.nombre}<br />
        hasta <span class="grad" style={`background:linear-gradient(120deg, ${track.gradFrom}, ${track.gradTo});-webkit-background-clip:text;background-clip:text;color:transparent`}>nivel dios</span>
      </h1>
      <p class="sub">{track.descripcion}</p>
      <div class="cta">
        {firstOf(nivelesConLecciones[0]?.id ?? 0) ? (
          <a class="btn btn-primary" href={`/guia/${firstOf(nivelesConLecciones[0].id)!.id}/`}
             style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>Empezar por el Nivel 0 →</a>
        ) : null}
        <a class="btn btn-ghost" href="#camino">Ver el camino completo</a>
      </div>
    </section>

    <section class="section" id="camino">
      <div class="section-head">
        <div class="kicker" style={`color:${track.colorHex}`}>La ruta</div>
        <h2>{nivelesConLecciones.length} niveles, de novato a dios</h2>
        <p>Cada nivel construye sobre el anterior. Sin saltos, sin huecos.</p>
      </div>
      <div class="path">
        {nivelesConLecciones.map((n) => {
          const first = firstOf(n.id);
          return (
            <a class="path-card" href={first ? `/guia/${first.id}/` : '#'} style={`--lvl-color:${n.color}`}>
              <div class="p-lvl">{n.icono}</div>
              <div class="p-info">
                <h3>{n.nombre} <small>Nivel {n.id} · {n.subtitulo}</small></h3>
                <p>{n.descripcion}</p>
                <div class="tags">{n.tags.map((t) => <span>{t}</span>)}</div>
              </div>
              <div class="p-go">→</div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="stats">
        <div class="stat"><b>{total}</b><span>lecciones</span></div>
        <div class="stat"><b>{nivelesConLecciones.length}</b><span>niveles</span></div>
        <div class="stat"><b>0→∞</b><span>de cero a dios</span></div>
      </div>
    </section>

    {ex.features.length ? (
      <section class="section">
        <div class="section-head">
          <div class="kicker" style={`color:${track.colorHex}`}>Qué vas a dominar</div>
          <h2>Todo lo que hace a un experto</h2>
        </div>
        <div class="features">
          {ex.features.map((f) => (
            <div class="feature">
              <div class="f-ic">{f.i}</div>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          ))}
        </div>
      </section>
    ) : null}

    {ex.chips.length ? (
      <section class="section">
        <div class="langs">
          {ex.chips.map((l) => (
            <span class="lang-chip"><span class="dot" style={`background:${l.c}`}></span>{l.n}</span>
          ))}
        </div>
      </section>
    ) : null}

    <section class="section">
      <div class="cta-final" style={`box-shadow:0 0 0 1px ${track.colorHex}33, 0 12px 40px -12px ${track.colorHex}44`}>
        <h2>¿Listo para dominar {track.nombre}?</h2>
        <p>Empieza por los fundamentos y sube nivel a nivel hasta el dominio total.</p>
        {firstOf(nivelesConLecciones[0]?.id ?? 0) ? (
          <a class="btn btn-primary" href={`/guia/${firstOf(nivelesConLecciones[0].id)!.id}/`}
             style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>Comenzar el camino →</a>
        ) : null}
      </div>
    </section>

    <footer class="footer">
      <p class="fmono">{track.nombre} · Nivel Dios</p>
      <p><a href="/">← Volver a todos los temas</a></p>
    </footer>
  </div>
</BaseLayout>
