---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "Compose",
    "icon": "🎨",
    "items": [
      {
        "k": "@Composable fun Saludo()",
        "d": "Función que describe UI"
      },
      {
        "k": "Modifier.padding().clickable()",
        "d": "El orden de la cadena importa"
      },
      {
        "k": "Row · Column · Box",
        "d": "Contenedores básicos"
      },
      {
        "k": "LazyColumn { items(lista) { } }",
        "d": "Lista perezosa"
      },
      {
        "k": "key = { it.id }",
        "d": "Identidad estable en listas"
      },
      {
        "k": "Layout(content) { m, c -> }",
        "d": "Contenedor propio"
      },
      {
        "k": "AndroidView(factory = ...)",
        "d": "Meter una vista clásica"
      }
    ]
  },
  {
    "cat": "Estado y ciclo",
    "icon": "♻️",
    "items": [
      {
        "k": "remember { }",
        "d": "Recordar entre recomposiciones"
      },
      {
        "k": "rememberSaveable { }",
        "d": "Sobrevive a la muerte del proceso"
      },
      {
        "k": "collectAsStateWithLifecycle()",
        "d": "Consumir un StateFlow con seguridad"
      },
      {
        "k": "SavedStateHandle",
        "d": "Estado que sobrevive al proceso"
      },
      {
        "k": "repeatOnLifecycle(STARTED)",
        "d": "Recolectar solo en primer plano"
      },
      {
        "k": "LaunchedEffect(key) { }",
        "d": "Efecto ligado a la composición"
      }
    ]
  },
  {
    "cat": "Material 3 y adaptativo",
    "icon": "📐",
    "items": [
      {
        "k": "MaterialTheme(colorScheme, typography)",
        "d": "Tema de la app"
      },
      {
        "k": "dynamicDarkColorScheme(context)",
        "d": "Color dinámico del sistema"
      },
      {
        "k": "enableEdgeToEdge()",
        "d": "Obligatorio desde Android 16"
      },
      {
        "k": "WindowInsets.safeDrawing",
        "d": "No dibujar bajo las barras"
      },
      {
        "k": "currentWindowAdaptiveInfo()",
        "d": "Window size class"
      },
      {
        "k": "NavigationSuiteScaffold",
        "d": "Navegación que se adapta al tamaño"
      }
    ]
  },
  {
    "cat": "Navegación",
    "icon": "🧭",
    "items": [
      {
        "k": "NavHost(navController, startDestination)",
        "d": "El grafo"
      },
      {
        "k": "composable<Detalle> { }",
        "d": "Destino con tipo seguro"
      },
      {
        "k": "navController.navigate(Detalle(id))",
        "d": "Navegar con argumentos"
      },
      {
        "k": "popUpTo(Inicio) { inclusive = true }",
        "d": "Limpiar el back stack"
      },
      {
        "k": "launchSingleTop = true",
        "d": "No duplicar el destino"
      }
    ]
  },
  {
    "cat": "Datos",
    "icon": "🗄️",
    "items": [
      {
        "k": "@Entity data class Nota(...)",
        "d": "Room: tabla"
      },
      {
        "k": "@Query(\"SELECT * FROM nota\")",
        "d": "Consulta verificada en compilación"
      },
      {
        "k": "fun observar(): Flow<List<Nota>>",
        "d": "Room reactivo"
      },
      {
        "k": "@Transaction",
        "d": "Operación atómica"
      },
      {
        "k": "DataStore<Preferences>",
        "d": "Preferencias asíncronas"
      },
      {
        "k": "Pager(config) { PagingSource }",
        "d": "Paginación"
      },
      {
        "k": "RemoteMediator",
        "d": "Paginación offline-first"
      }
    ]
  },
  {
    "cat": "Red",
    "icon": "🌐",
    "items": [
      {
        "k": "@GET(\"notas\") suspend fun listar()",
        "d": "Retrofit"
      },
      {
        "k": "OkHttpClient.Builder().addInterceptor",
        "d": "Cabeceras y auth"
      },
      {
        "k": "@Serializable data class Dto(...)",
        "d": "kotlinx.serialization"
      },
      {
        "k": "HttpClient { install(ContentNegotiation) }",
        "d": "Ktor Client"
      }
    ]
  },
  {
    "cat": "Sistema",
    "icon": "⚙️",
    "items": [
      {
        "k": "WorkManager.enqueueUniqueWork(...)",
        "d": "Trabajo garantizado"
      },
      {
        "k": "Constraints.Builder().setRequiredNetworkType",
        "d": "Condiciones del trabajo"
      },
      {
        "k": "foregroundServiceType",
        "d": "Obligatorio declararlo"
      },
      {
        "k": "NotificationChannel(id, name, importance)",
        "d": "Canal de notificación"
      },
      {
        "k": "rememberLauncherForActivityResult",
        "d": "Permisos y resultados"
      },
      {
        "k": "intent-filter + assetlinks.json",
        "d": "App Links verificados"
      },
      {
        "k": "GlanceAppWidget",
        "d": "Widget escrito en Compose"
      }
    ]
  },
  {
    "cat": "Build y calidad",
    "icon": "🏗️",
    "items": [
      {
        "k": "libs.versions.toml",
        "d": "Version catalog"
      },
      {
        "k": "./gradlew assembleRelease",
        "d": "Build de producción"
      },
      {
        "k": "buildTypes { release { isMinifyEnabled } }",
        "d": "R8"
      },
      {
        "k": "baseline-prof.txt",
        "d": "Precompilar rutas críticas"
      },
      {
        "k": "composeTestRule.onNodeWithText(\"x\")",
        "d": "Test de UI"
      },
      {
        "k": "adb logcat -s MiTag",
        "d": "Logs filtrados"
      },
      {
        "k": "macrobenchmark",
        "d": "Medir arranque y scroll"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · Android" description="Referencia buscable de Android: Jetpack Compose, estado y ciclo de vida, Material 3, navegación, Room, red, sistema y build.">
  <header class="topbar">
    <span class="brand-mini">Android <b>Jetpack</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="android" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--green)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de Android</h1>
          <p class="desc">La plataforma entera en un sitio: Compose, estado, Material 3, datos, sistema y build. Busca por API o por lo que quieres hacer.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'LazyColumn', 'Room', 'WorkManager', 'insets'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
