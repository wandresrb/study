---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const cats = [
  {
    "cat": "El ciclo",
    "icon": "🔁",
    "items": [
      {
        "k": "Intent",
        "d": "La intención del usuario (entrada)"
      },
      {
        "k": "reduce",
        "d": "Función pura al siguiente estado"
      },
      {
        "k": "State (data class)",
        "d": "Estado inmutable único (salida)"
      },
      {
        "k": "SideEffect",
        "d": "Evento de una sola vez (no es estado)"
      },
      {
        "k": "state.copy(campo = v)",
        "d": "Producir la siguiente versión"
      }
    ]
  },
  {
    "cat": "Kotlin",
    "icon": "🤖",
    "items": [
      {
        "k": "data class",
        "d": "Estado inmutable con copy"
      },
      {
        "k": "sealed interface",
        "d": "Jerarquía cerrada de intents/efectos"
      },
      {
        "k": "when (intent) { … }",
        "d": "Exhaustivo, sin else"
      },
      {
        "k": "suspend fun",
        "d": "Función que puede pausarse"
      },
      {
        "k": "viewModelScope.launch { }",
        "d": "Corrutina ligada al ViewModel"
      }
    ]
  },
  {
    "cat": "Flow",
    "icon": "🌊",
    "items": [
      {
        "k": "MutableStateFlow(inicial)",
        "d": "Estado observable con valor actual"
      },
      {
        "k": "asStateFlow()",
        "d": "Exponer solo lectura"
      },
      {
        "k": "Channel / SharedFlow",
        "d": "Eventos de una sola vez"
      },
      {
        "k": "flow.map / filter / flatMapLatest",
        "d": "Operadores"
      },
      {
        "k": "stateIn(scope, started, initial)",
        "d": "De frío a caliente"
      }
    ]
  },
  {
    "cat": "Orbit",
    "icon": "🛰️",
    "items": [
      {
        "k": "ContainerHost<State, SideEffect>",
        "d": "La interfaz del ViewModel"
      },
      {
        "k": "container(EstadoInicial)",
        "d": "Crear el container"
      },
      {
        "k": "intent { … }",
        "d": "Bloque donde vive la lógica"
      },
      {
        "k": "reduce { state.copy(...) }",
        "d": "Mutación aislada y secuencial"
      },
      {
        "k": "postSideEffect(efecto)",
        "d": "Emitir un evento único"
      },
      {
        "k": "orbit-test",
        "d": "Afirmar la secuencia de estados"
      }
    ]
  },
  {
    "cat": "Compose",
    "icon": "🎨",
    "items": [
      {
        "k": "collectAsStateWithLifecycle()",
        "d": "Consumir el estado en la UI"
      },
      {
        "k": "LaunchedEffect(Unit) { }",
        "d": "Consumir side effects"
      },
      {
        "k": "@Immutable / @Stable",
        "d": "Ayudar al skipping de recomposición"
      },
      {
        "k": "ImmutableList",
        "d": "Colección estable (kotlinx)"
      },
      {
        "k": "state hoisting",
        "d": "Componibles sin estado propio"
      }
    ]
  }
];

const total = cats.reduce((n, c) => n + c.items.length, 0);
---
<BaseLayout title="Cheatsheet · MVI y Orbit" description="MVI en Kotlin y Android: intents, estado inmutable, side effects, Orbit, coroutines, Flow y Compose.">
  <header class="topbar">
    <span class="brand-mini">MVI <b>y Orbit</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>
  <div class="scrim" id="scrim"></div>

  <div class="app wide">
    <Sidebar subject="mvi" />
    <main class="main">
      <div class="content">
        <div class="lesson-head" style="margin-bottom:8px">
          <span class="lvl-tag" style="color:var(--teal)">⌘ REFERENCIA · {total} elementos</span>
          <h1>Cheatsheet de MVI y Orbit</h1>
          <p class="desc">MVI en Kotlin y Android: intents, estado inmutable, side effects, Orbit, coroutines, Flow y Compose.</p>
        </div>

        <div class="cheat-search">
          <input id="cheat-input" type="search" placeholder="Buscar: 'intent', 'reduce', 'StateFlow', 'container'…" aria-label="Buscar" />
          <div class="cheat-filters" id="cheat-filters">
            <button class="active" data-cat="all">Todos</button>
            {cats.map((c) => <button data-cat={c.cat}>{c.icon} {c.cat}</button>)}
          </div>
        </div>

        <div id="cheat-body">
          {cats.map((c) => (
            <section class="cheat-cat" data-cat={c.cat}>
              <h3>{c.icon} {c.cat} <span class="count">{c.items.length}</span></h3>
              <div class="cheat-grid">
                {c.items.map((it) => (
                  <div class="cheat-row" data-text={`${it.k} ${it.d}`.toLowerCase()}>
                    <span class="desc">{it.d}</span>
                    <span class="key">{it.k}</span>
                  </div>
                ))}
              </div>
            </section>
          ))}
          <div class="cheat-empty" id="cheat-empty" style="display:none">Sin resultados. Prueba otra búsqueda.</div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let activeCat = 'all';
    const apply = () => {
      const q = (input?.value ?? '').toLowerCase().trim();
      let anyVisible = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = activeCat === 'all' || sec.dataset.cat === activeCat;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const textOk = !q || (row.dataset.text ?? '').includes(q);
          const show = catOk && textOk;
          row.style.display = show ? '' : 'none';
          if (show) rows++;
        });
        sec.style.display = catOk && rows > 0 ? '' : 'none';
        if (catOk && rows > 0) anyVisible = true;
      });
      if (empty) empty.style.display = anyVisible ? 'none' : '';
    };
    input?.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        activeCat = b.getAttribute('data-cat') ?? 'all';
        apply();
      });
    });
  </script>
</BaseLayout>
