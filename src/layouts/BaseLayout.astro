---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import Cabecera from '../components/sitio/Cabecera.astro';
import PieDePagina from '../components/sitio/PieDePagina.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * El armazón del sitio. Se monta AQUÍ y no en cada página porque el problema
   * era justo ese: había tres cabeceras distintas, ninguna llevaba a las
   * demás, y las 5074 lecciones no tenían ni un enlace.
   *
   *   · `normal`   — cabecera pegajosa y pie. Casi todo.
   *   · `flotante` — la cabecera se posa sobre el lienzo sin ocupar sitio ni
   *                  capturar el ratón, y no hay pie. Solo la portada.
   *   · `propio`   — la página trae su armazón. Las lecciones, que llevan
   *                  barra lateral y su propia rejilla.
   */
  armazon?: 'normal' | 'flotante' | 'propio';
  /** Dónde estás. La marca no lo dice; esto sí. */
  miga?: { texto: string; href?: string }[];
  /** El buscador solo va dentro del hub, que es donde hay algo que buscar. */
  buscador?: boolean;
}

const {
  title,
  description = 'Domina Neovim de cero a nivel dios: C, Rust, Swift, frontend React/Tailwind, terminal, tmux/zellij, automatización e IA.',
  armazon = 'normal',
  miga = [],
  buscador = false,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Fuentes autohospedadas por Astro. `preload` en booleano precargaría
        TODOS los ficheros de la familia —6 pesos x 2 subsets—, justo lo que la
        doc pide evitar: "font preloading should be done sparingly". Se precarga
        solo el peso del cuerpo de texto. */}
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-jetbrains" />
    <ClientRouter />
  </head>
  <body>
    <div class="reading-progress" id="reading-progress"></div>

    {armazon !== 'propio' && <Cabecera variante={armazon === 'flotante' ? 'flotante' : 'normal'} miga={miga} buscador={buscador} />}

    <slot />

    {armazon === 'normal' && <PieDePagina />}

    <!-- Mermaid: fichero externo y cacheado. Comprueba por sí mismo si la
         página tiene diagramas antes de importar nada del CDN, y se reengancha
         en cada navegación de ClientRouter. -->
    <script is:inline type="module" src="/mermaid-init.js"></script>

    <!--
      Con <ClientRouter /> el documento se sustituye sin recargar, y los módulos
      NO se vuelven a ejecutar. Todo lo que toca el DOM tiene que colgarse de
      `astro:page-load`, que dispara en la carga inicial y tras cada transición.
      Sin esto, la barra de progreso apunta a un elemento muerto y los botones
      de copiar no aparecen a partir de la segunda lección.
    -->

    <!-- Barra de progreso de lectura -->
    <script>
      let bar: HTMLElement | null = null;
      const onScroll = () => {
        if (!bar) return;
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
      };
      // Los listeners van una sola vez sobre objetos que sobreviven a la
      // transición; lo que se renueva en cada página es la referencia al nodo.
      document.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      document.addEventListener('astro:page-load', () => {
        bar = document.getElementById('reading-progress');
        onScroll();
      });
    </script>

    <!-- Botón de copiar en cada bloque de código -->
    <script>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('pre.astro-code').forEach((pre) => {
          const el = pre as HTMLElement;
          // Idempotente: si la transición conservó el nodo, no dupliques.
          if (el.querySelector(':scope > .code-copy')) return;
          const btn = document.createElement('button');
          btn.className = 'code-copy';
          btn.type = 'button';
          btn.textContent = 'Copiar';
          btn.addEventListener('click', async () => {
            const code = el.querySelector('code');
            const text = code ? code.textContent ?? '' : el.textContent ?? '';
            try {
              await navigator.clipboard.writeText(text);
              btn.textContent = '¡Copiado!';
              btn.classList.add('ok');
              setTimeout(() => { btn.textContent = 'Copiar'; btn.classList.remove('ok'); }, 1500);
            } catch {
              btn.textContent = 'Error';
            }
          });
          el.appendChild(btn);
        });
      });
    </script>
  </body>
</html>
