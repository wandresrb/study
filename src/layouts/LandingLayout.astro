---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  crumbs?: { text: string; href?: string }[];
  search?: boolean;
}

const { title, description, crumbs = [], search = true } = Astro.props;
---
<BaseLayout title={title} description={description} crumbs={crumbs} search={search}>
  <main id="content" class="mx-auto w-full max-w-sitio p-6">
    <slot />
  </main>
</BaseLayout>
