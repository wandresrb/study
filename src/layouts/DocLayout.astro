---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/site/Sidebar.astro';
import Header from '../components/site/Header.astro';
import ReaderPrefs from '../components/site/ReaderPrefs.astro';

interface Props {
  title: string;
  description?: string;
  subject: string;
  current?: string;
  full?: boolean;
  crumbs?: { text: string; href?: string }[];
  element?: 'div' | 'article';
  reading?: boolean;
}

const {
  title,
  description,
  subject,
  current,
  full = false,
  crumbs = [],
  element = 'div',
  reading = false,
} = Astro.props;

const Content = element;
---
<BaseLayout chrome="own" title={title} description={description}>
  <div class="d-drawer lg:d-drawer-open">
    <input id="menu" type="checkbox" class="d-drawer-toggle" />

    <div class="d-drawer-content flex min-w-0 flex-col">
      <Header search crumbs={crumbs}>
        <Fragment slot="actions">
          {reading && <ReaderPrefs />}
          <label for="menu" class="d-btn d-btn-sm d-drawer-button lg:hidden" aria-label="Abrir menú">
            ☰
          </label>
        </Fragment>
      </Header>

      <main
        id="content"
        class:list={[
          'grid w-full min-w-0 gap-8 px-5 pt-12 pb-30 sm:px-10 xl:px-16',
          full ? 'max-w-doc' : 'max-w-doc xl:grid-cols-[minmax(0,var(--reading-width))_15rem]',
        ]}
      >
        <Content
          class:list={[
            'min-w-0',
            reading && 'text-(length:--reading-size)',
          ]}
        >
          <slot />
        </Content>

        <slot name="aside" />
      </main>
    </div>

    <div class="d-drawer-side z-80">
      <label for="menu" aria-label="Cerrar menú" class="d-drawer-overlay"></label>
      <Sidebar subject={subject} current={current} />
    </div>
  </div>
</BaseLayout>
