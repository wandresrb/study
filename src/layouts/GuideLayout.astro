---
import DocLayout from './DocLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Clock from '@lucide/astro/icons/clock';
import { conceptsTaughtBy, getTrack, levelOf, lessonsOf } from '../data/content';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'guide'>;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;

const subject = entry.data.subject;
const track = getTrack(subject);

const all = lessonsOf(subject);
const idx = all.findIndex((l) => l.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
const level = levelOf(subject, entry.data.level);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const taught = conceptsTaughtBy(subject, entry.data.level);
---

<DocLayout
  title={`${entry.data.title} · ${track.name} · wandres.dev`}
  description={entry.data.description}
  subject={subject}
  current={entry.id}
  element="article"
  reading
  crumbs={[
    { text: 'CS', href: '/cs/' },
    { text: track.name, href: `/${subject}/` },
  ]}
>
  <nav
    class="d-breadcrumbs mb-5 text-xs text-subtext0 [&_a]:inline-flex [&_a]:min-h-6 [&_a]:items-center"
    aria-label="Ruta"
  >
    <ul>
      <li><a href="/cs/">Temas</a></li>
      <li><a href={`/${subject}/`}>{track.name}</a></li>
      <li><span style={`color:${level.color}`}>Nivel {level.idx} · {level.name}</span></li>
      <li>{entry.data.title}</li>
    </ul>
  </nav>

  <PageHeader title={entry.data.title} lede={entry.data.description}>
    <div slot="meta" class="mt-3 flex flex-wrap items-center gap-4 text-xs text-subtext0">
      {
        entry.data.duration && (
          <span class="inline-flex items-center gap-1.5">
            <Clock class="size-3.5 shrink-0" aria-hidden="true" /> {entry.data.duration}
          </span>
        )
      }
      <button id="mark-read" type="button" data-lesson={entry.id} aria-pressed="false" class="d-btn d-btn-xs"
        >○ Marcar leída</button
      >
      {
        taught.length > 0 && (
          <span class="flex flex-wrap items-center gap-1.5">
            <span class="text-subtext0">enseña:</span>
            {taught.map((c) => (
              <a
                href={`/concepts/${c.id}/`}
                class="rounded-md border border-line bg-crust px-2 py-0.5 text-2xs text-subtext0 no-underline hover:border-accent hover:text-text"
              >
                {c.name}
              </a>
            ))}
          </span>
        )
      }
    </div>
  </PageHeader>

  <div class="prose max-w-none">
    <slot />
  </div>

  <nav class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="Lección anterior y siguiente">
    {
      prev ? (
        <a
          href={`/guide/${prev.id}/`}
          data-lesson={prev.id}
          data-pager-prev
          class="d-card d-card-border border-line bg-panel p-4 no-underline transition-transform hover:-translate-y-0.5 hover:border-accent hover:shadow-panel"
        >
          <span class="text-xs text-subtext0">
            ← Anterior{' '}
            <span data-read-tick hidden class="text-green" aria-hidden="true">
              ✓
            </span>
          </span>
          <span class="mt-1 font-bold text-text">{prev.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a
          href={`/guide/${next.id}/`}
          data-lesson={next.id}
          data-pager-next
          class="d-card d-card-border border-line bg-panel p-4 text-right no-underline transition-transform hover:-translate-y-0.5 hover:border-accent hover:shadow-panel"
        >
          <span class="text-xs text-subtext0">
            <span data-read-tick hidden class="text-green" aria-hidden="true">
              ✓
            </span>{' '}
            Siguiente →
          </span>
          <span class="mt-1 font-bold text-text">{next.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <aside
    slot="aside"
    class="sticky top-(--header-h) z-10 hidden max-h-[calc(100svh-var(--header-h))]
           self-start overflow-y-auto py-6 xl:block"
  >
    {
      toc.length > 0 && (
        <Fragment>
          <p class="mb-4 text-2xs tracking-smallcaps text-subtext0 uppercase">En esta lección</p>
          <ul class="d-menu w-full border-l border-line p-0 text-sm">
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'ml-3']}>
                <a
                  href={`#${h.slug}`}
                  class="rounded-none border-l-2 border-transparent py-1 text-subtext0 aria-[current=true]:border-mauve aria-[current=true]:text-mauve"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </Fragment>
      )
    }
  </aside>

  <script>
    import { isRead, toggleRead, onChange } from '../lib/learner';

    const paint = async () => {
      const btn = document.getElementById('mark-read') as HTMLButtonElement | null;
      if (btn?.dataset.lesson) {
        const read = await isRead(btn.dataset.lesson);
        btn.setAttribute('aria-pressed', String(read));
        btn.classList.toggle('d-btn-active', read);
        btn.textContent = read ? '✓ Leída' : '○ Marcar leída';
      }
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-lesson]')) {
        const tick = a.querySelector<HTMLElement>('[data-read-tick]');
        if (tick) tick.hidden = !(await isRead(a.dataset.lesson!));
      }
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('#mark-read');
      if (btn?.dataset.lesson) void toggleRead(btn.dataset.lesson);
    });

    // Keyboard-first, like the editor being taught: [ and ] page between lessons.
    // Never while typing, and never inside a drill — there they belong to vim.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '[' && e.key !== ']') return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const focused = document.activeElement;
      if (
        focused instanceof HTMLInputElement ||
        focused instanceof HTMLTextAreaElement ||
        focused?.closest('.cm-editor, [data-vim-exercise], [data-modemap]')
      )
        return;
      const target = document.querySelector<HTMLAnchorElement>(
        e.key === '[' ? '[data-pager-prev]' : '[data-pager-next]',
      );
      target?.click();
    });
    onChange(() => void paint());
    document.addEventListener('astro:page-load', () => void paint());

    let links: HTMLAnchorElement[] = [];
    let heads: HTMLElement[] = [];
    const spy = () => {
      let active = -1;
      heads.forEach((h, i) => {
        if (h.getBoundingClientRect().top < 140) active = i;
      });
      links.forEach((l, i) => {
        if (i === active) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    };
    document.addEventListener('scroll', spy, { passive: true });
    document.addEventListener('astro:page-load', () => {
      links = Array.from(document.querySelectorAll<HTMLAnchorElement>('aside[slot] a[href^="#"], aside a[href^="#"]'));
      heads = links
        .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
        .filter((x): x is HTMLElement => !!x);
      spy();
    });
  </script>
</DocLayout>
