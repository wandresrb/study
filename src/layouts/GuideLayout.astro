---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getTrack, nivelDe, leccionesDe } from '../data/contenido';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'guia'>; headings: MarkdownHeading[]; }
const { entry, headings } = Astro.props;

// `subject` es una referencia: Astro ya garantizó en build que el track existe.
const subject = entry.data.subject.id;
const track = (await getTrack(subject)).data;

const all = await leccionesDe(subject);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
const nivel = await nivelDe(subject, entry.data.level);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={`${entry.data.title} · ${track.nombre} Nivel Dios`} description={entry.data.description}>
  <header class="topbar">
    <span class="brand-mini">{track.nombre} <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>

  <div class="scrim" id="scrim"></div>

  <div class="app">
    <Sidebar subject={subject} current={entry.id} />

    <main class="main">
      <article class="content">
        <nav class="breadcrumb">
          <a href="/mapa/">Temas</a>
          <span class="sep">/</span>
          <a href={`/${subject}/`}>{track.nombre}</a>
          <span class="sep">/</span>
          <span style={`color:${nivel.color}`}>Nivel {nivel.id} · {nivel.nombre}</span>
          <span class="sep">/</span>
          <span>{entry.data.title}</span>
        </nav>

        <div class="lesson-head">
          <span class="lvl-tag" style={`color:${nivel.color}`}>
            <span class="lvl-dot" style={`width:16px;height:16px;background:${nivel.color};border-radius:5px`}></span>
            {nivel.nombre.toUpperCase()} · {nivel.subtitulo}
          </span>
          <h1>{entry.data.title}</h1>
          <p class="desc">{entry.data.description}</p>
          {entry.data.duracion ? (
            <div class="meta"><span>⏱ {entry.data.duracion}</span></div>
          ) : null}
        </div>

        <div class="prose">
          <slot />
        </div>

        <nav class="pager">
          {prev ? (
            <a class="prev" href={`/guia/${prev.id}/`}>
              <div class="dir">← Anterior</div>
              <div class="ttl">{prev.data.title}</div>
            </a>
          ) : <span class="empty"></span>}
          {next ? (
            <a class="next" href={`/guia/${next.id}/`}>
              <div class="dir">Siguiente →</div>
              <div class="ttl">{next.data.title}</div>
            </a>
          ) : <span class="empty"></span>}
        </nav>
      </article>
    </main>

    <aside class="toc">
      {toc.length ? (
        <Fragment>
          <div class="toc-head">En esta lección</div>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'h3' : 'h2'}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </Fragment>
      ) : null}
    </aside>
  </div>

  <script>
    // Scroll-spy del TOC (el menú móvil y el filtro los gestiona Sidebar).
    //
    // Con <ClientRouter /> los módulos solo se ejecutan una vez, así que las
    // referencias a nodos hay que renovarlas en cada navegación. Antes se
    // capturaban aquí arriba: a partir de la segunda lección el TOC apuntaba a
    // nodos desprendidos, el resaltado se congelaba y el listener de scroll
    // mantenía vivo el DOM entero de la primera página.
    let links: HTMLAnchorElement[] = [];
    let heads: HTMLElement[] = [];
    const spy = () => {
      let active = -1;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top < 140) active = i; });
      links.forEach((l, i) => l.classList.toggle('active', i === active));
    };
    // El listener va una sola vez sobre `document`, que sobrevive al swap.
    document.addEventListener('scroll', spy, { passive: true });
    document.addEventListener('astro:page-load', () => {
      links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
      heads = links
        .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
        .filter((x): x is HTMLElement => !!x);
      spy();
    });
  </script>
</BaseLayout>
