---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getTrack, nivelDe } from '../data/tracks';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'guia'>; headings: MarkdownHeading[]; }
const { entry, headings } = Astro.props;

const subject = entry.data.subject ?? 'neovim';
const track = getTrack(subject);

const all = (await getCollection('guia'))
  .filter((e) => (e.data.subject ?? 'neovim') === subject)
  .sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
const nivel = nivelDe(subject, entry.data.level);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={`${entry.data.title} · ${track.nombre} Nivel Dios`} description={entry.data.description}>
  <header class="topbar">
    <span class="brand-mini">{track.nombre} <b>Nivel Dios</b></span>
    <button class="menu-btn" id="menu-btn" aria-label="Abrir menú">☰ Menú</button>
  </header>

  <div class="scrim" id="scrim"></div>

  <div class="app">
    <Sidebar subject={subject} current={entry.id} />

    <main class="main">
      <article class="content">
        <nav class="breadcrumb">
          <a href="/">Temas</a>
          <span class="sep">/</span>
          <a href={`/${track.id}/`}>{track.nombre}</a>
          <span class="sep">/</span>
          <span style={`color:${nivel.color}`}>Nivel {nivel.id} · {nivel.nombre}</span>
          <span class="sep">/</span>
          <span>{entry.data.title}</span>
        </nav>

        <div class="lesson-head">
          <span class="lvl-tag" style={`color:${nivel.color}`}>
            <span class="lvl-dot" style={`width:16px;height:16px;background:${nivel.color};border-radius:5px`}></span>
            {nivel.nombre.toUpperCase()} · {nivel.subtitulo}
          </span>
          <h1>{entry.data.title}</h1>
          <p class="desc">{entry.data.description}</p>
          {entry.data.duracion ? (
            <div class="meta"><span>⏱ {entry.data.duracion}</span></div>
          ) : null}
        </div>

        <div class="prose">
          <slot />
        </div>

        <nav class="pager">
          {prev ? (
            <a class="prev" href={`/guia/${prev.id}/`}>
              <div class="dir">← Anterior</div>
              <div class="ttl">{prev.data.title}</div>
            </a>
          ) : <span class="empty"></span>}
          {next ? (
            <a class="next" href={`/guia/${next.id}/`}>
              <div class="dir">Siguiente →</div>
              <div class="ttl">{next.data.title}</div>
            </a>
          ) : <span class="empty"></span>}
        </nav>
      </article>
    </main>

    <aside class="toc">
      {toc.length ? (
        <Fragment>
          <div class="toc-head">En esta lección</div>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'h3' : 'h2'}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </Fragment>
      ) : null}
    </aside>
  </div>

  <script>
    // Scroll-spy del TOC (menú móvil y filtro los gestiona Sidebar)
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const heads = links
      .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
      .filter((x): x is HTMLElement => !!x);
    const spy = () => {
      let active = -1;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top < 140) active = i; });
      links.forEach((l, i) => l.classList.toggle('active', i === active));
    };
    document.addEventListener('scroll', spy, { passive: true });
    spy();
  </script>
</BaseLayout>
