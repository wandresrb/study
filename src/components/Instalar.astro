---
// Muestra la instalación de un plugin en las dos vías que conviven en Neovim 0.12:
// lazy.nvim (cuando quieres carga perezosa y un DSL de specs) y vim.pack (nativo,
// para lo que no necesita lazy loading). No son excluyentes: se usan juntas.
interface Props { repo: string; nota?: string; }
const { repo, nota } = Astro.props;
const uid = 'ins-' + Math.random().toString(36).slice(2, 9);
---
<div class="instalar" data-instalar>
  <div class="ins-head">
    <span class="ins-repo">{repo}</span>
    <div class="ins-tabs" role="tablist">
      <button class="ins-tab active" data-t="lazy" role="tab" id={`${uid}-l`}>lazy.nvim</button>
      <button class="ins-tab" data-t="pack" role="tab" id={`${uid}-p`}>vim.pack</button>
    </div>
  </div>
  <div class="ins-pane active" data-p="lazy"><slot name="lazy" /></div>
  <div class="ins-pane" data-p="pack"><slot name="pack" /></div>
  {nota ? <p class="ins-nota">{nota}</p> : null}
</div>

<style is:global>
  .instalar {
    border: 1px solid var(--surface1);
    border-radius: 12px;
    background: var(--mantle);
    margin: 20px 0;
    overflow: hidden;
  }
  .ins-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 8px 12px;
    background: var(--surface0);
    border-bottom: 1px solid var(--surface1);
    flex-wrap: wrap;
  }
  .ins-repo {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: .82rem; color: var(--subtext0);
  }
  .ins-tabs { display: flex; gap: 4px; }
  .ins-tab {
    font: inherit; font-size: .78rem; font-weight: 600;
    padding: 4px 12px; border-radius: 7px;
    border: 1px solid transparent; background: transparent;
    color: var(--subtext0); cursor: pointer; transition: .15s;
  }
  .ins-tab:hover { color: var(--text); background: var(--surface1); }
  .ins-tab.active {
    background: var(--base); color: var(--mauve);
    border-color: var(--surface1);
  }
  .ins-pane { display: none; padding: 0 12px; }
  .ins-pane.active { display: block; }
  .ins-pane > :global(pre) { margin: 12px 0; }
  .ins-nota {
    margin: 0; padding: 8px 12px 10px;
    font-size: .82rem; color: var(--subtext0);
    border-top: 1px solid var(--surface1);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-instalar]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('.ins-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const which = tab.dataset.t;
        box.querySelectorAll('.ins-tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        box.querySelectorAll<HTMLElement>('.ins-pane').forEach((p) => {
          p.classList.toggle('active', p.dataset.p === which);
        });
      });
    });
  });
</script>
