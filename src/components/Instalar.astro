---
// Instalación de un plugin en las dos vías que conviven en Neovim 0.12:
// lazy.nvim (carga perezosa + DSL de specs) y vim.pack (nativo).
//
// Si solo se pasa uno de los dos slots, NO se inventa el otro: se muestra
// una sola vía y el texto de `motivo` explica por qué la otra no aplica.
// Forzar siempre dos pestañas es lo que llevaba a ofrecer lazy.nvim para
// plugins cuyo único argumento a favor de lazy es imposible.
interface Props { repo: string; nota?: string; motivo?: string; }
const { repo, nota, motivo } = Astro.props;

const tieneLazy = Astro.slots.has('lazy');
const tienePack = Astro.slots.has('pack');
const ambas = tieneLazy && tienePack;
const unica = tieneLazy ? 'lazy.nvim' : 'vim.pack';
---
<div class="instalar" data-instalar>
  <div class="ins-head">
    <span class="ins-repo">{repo}</span>
    {ambas ? (
      <div class="ins-tabs" role="tablist">
        <button class="ins-tab active" data-t="lazy" role="tab">lazy.nvim</button>
        <button class="ins-tab" data-t="pack" role="tab">vim.pack</button>
      </div>
    ) : (
      <span class="ins-unica">solo {unica}</span>
    )}
  </div>

  {motivo ? <p class="ins-motivo">{motivo}</p> : null}

  {tieneLazy ? <div class:list={['ins-pane', { active: true }]} data-p="lazy"><slot name="lazy" /></div> : null}
  {tienePack ? <div class:list={['ins-pane', { active: !tieneLazy }]} data-p="pack"><slot name="pack" /></div> : null}

  {nota ? <p class="ins-nota">{nota}</p> : null}
</div>

<style is:global>
  .instalar {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    margin: 20px 0;
    overflow: hidden;
  }
  .ins-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 8px 12px;
    background: var(--surface0);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ins-repo {
    font-family: var(--font-mono);
    font-size: .82rem; color: var(--subtext0);
  }
  .ins-tabs { display: flex; gap: 4px; }
  .ins-tab {
    font: inherit; font-size: .78rem; font-weight: 600;
    padding: 4px 12px; border-radius: 7px;
    border: 1px solid transparent; background: transparent;
    color: var(--subtext0); cursor: pointer; transition: .15s;
  }
  .ins-tab:hover { color: var(--text); background: var(--surface1); }
  .ins-tab.active {
    background: var(--bg); color: var(--mauve);
    border-color: var(--border);
  }
  .ins-unica {
    font-family: var(--font-mono); font-size: .74rem; font-weight: 600;
    color: var(--peach); background: var(--bg);
    border: 1px solid var(--border); border-radius: 7px;
    padding: 3px 10px;
  }
  .ins-motivo {
    margin: 0; padding: 9px 12px;
    font-size: .84rem; color: var(--subtext1);
    border-bottom: 1px solid var(--border-soft);
    background: var(--panel);
  }
  .ins-pane { display: none; padding: 0 12px; }
  .ins-pane.active { display: block; }
  /* El bloque entero es is:global, así que `:global()` sobra: Astro no lo
     transforma y llega literal al CSS, donde el navegador descarta la regla. */
  .ins-pane > pre { margin: 12px 0; }
  .ins-nota {
    margin: 0; padding: 8px 12px 10px;
    font-size: .82rem; color: var(--subtext0);
    border-top: 1px solid var(--border-soft);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-instalar]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('.ins-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const which = tab.dataset.t;
        box.querySelectorAll('.ins-tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        box.querySelectorAll<HTMLElement>('.ins-pane').forEach((p) => {
          p.classList.toggle('active', p.dataset.p === which);
        });
      });
    });
  });
</script>
