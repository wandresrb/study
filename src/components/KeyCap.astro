---
interface Props { keys: string; sep?: string; }
const { keys, sep = ' ' } = Astro.props;
const parts = keys.trim().split(/\s+/);
---
<span class="kc-seq">
  {parts.map((p, i) => (
    <Fragment>
      {i > 0 && sep === '+' ? <span class="plus">+</span> : null}
      <kbd>{p}</kbd>
    </Fragment>
  ))}
</span>
