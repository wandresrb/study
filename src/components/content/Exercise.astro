---
// One exercise, three forms, chosen by what it is given.
//
// · `doc` + a goal (`goal` or `goalCursor`) → an emulated Neovim (CM6 +
//   @replit/codemirror-vim) where the reader really types, checked against the
//   goal buffer or cursor.
// · `code` + `tests` → an editor that runs in a Web Worker, checked by tests.
// · neither → the classic accordion, so the exercises not yet converted work.
//
// `solution` are the EXACT keys in vim notation (ci"adiós<Esc>): the «see
// solution» button replays them, and scripts/verify-drills.mjs contrasts them
// against a real nvim --headless.
import Accordion from '../ui/Accordion.astro';
import Badge from '../ui/Badge.astro';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Play from '@lucide/astro/icons/play';
import type { Language } from '../../lib/editor/languages';
import type { Test } from '../../lib/runtime/types';

interface Props {
  challenge?: string;
  /** the pretty keys shown as hint / textual solution */
  keys?: string;
  id?: string;
  // — vim form —
  doc?: string;
  cursor?: [number, number];
  goal?: string;
  goalCursor?: [number, number];
  solution?: string;
  budget?: number;
  setup?: string;
  // — code form —
  code?: string;
  language?: Language;
  tests?: Test[];
  title?: string;
  vim?: boolean;
  readOnly?: boolean;
}

const {
  challenge, keys, id, doc, cursor, goal, goalCursor, solution, budget, setup,
  code, language = 'js', tests = [], title, vim = false, readOnly = false,
} = Astro.props;

const isVim = doc !== undefined && (goal !== undefined || goalCursor !== undefined);
const isCode = code !== undefined;

const def = isVim ? { doc, cursor, goal, goalCursor, solution, budget, setup } : null;
const editor = isCode ? { doc: code, language, vim, readOnly, lineNumbers: true } : null;

// Only JS runs today. Anything else gets a highlighted editor and no run
// button until its runtime lands — better than a button that lies.
const runnable = language === 'js' || language === 'ts';

// Stable id for the learner store: a short hash of the content when not given.
const shortHash = (t: string) => {
  let h = 0x811c9dc5;
  for (let i = 0; i < t.length; i++) {
    h ^= t.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString(36);
};
const exerciseId =
  id ??
  (isVim ? `d-${shortHash(doc! + (goal ?? '') + challenge)}`
  : isCode ? `x-${shortHash(code! + tests.map((t) => t.call).join('|'))}`
  : undefined);
---

{
  isVim ? (
    <figure
      class="exercise my-6 overflow-hidden rounded-sm border border-teal/35 bg-teal/5 not-prose"
      data-vim-exercise
      data-id={exerciseId}
      data-challenge={challenge}
    >
      <figcaption class="flex items-start justify-between gap-3 p-4 pb-3">
        <p class="m-0 text-base text-text">
          <span class="mr-1.5"><Badge variant="soft" color="var(--teal)">EJERCICIO</Badge></span>
          {challenge}
        </p>
        <span data-state class="font-mono text-sm text-subtext0" title="estado">○</span>
      </figcaption>

      <div class="relative mx-4 overflow-hidden rounded-sm border border-line shadow-panel">
        <div class="flex items-center gap-1.5 border-b border-line bg-mantle px-3 py-1.5">
          <span class="size-2.5 rounded-full bg-red/70" />
          <span class="size-2.5 rounded-full bg-yellow/70" />
          <span class="size-2.5 rounded-full bg-green/70" />
          <span class="ml-2 font-mono text-2xs text-subtext0">nvim · ejercicio</span>
        </div>

        <div data-term class="min-h-24 bg-crust font-mono text-sm">
          {/* SSR: the doc before hydrating; the engine replaces it */}
          <pre class="m-0 px-9 py-3 text-subtext1">{doc}</pre>
        </div>

        <div class="flex items-center gap-2 border-t border-line bg-mantle px-3 py-1">
          <span
            data-mode
            data-value="normal"
            class="rounded-xs px-1.5 font-mono text-2xs font-bold tracking-smallcaps uppercase
                   data-[value=normal]:bg-mauve data-[value=normal]:text-crust
                   data-[value=insert]:bg-green data-[value=insert]:text-crust
                   data-[value=visual]:bg-peach data-[value=visual]:text-crust"
          >
            NORMAL
          </span>
          <span data-hud class="flex min-h-5 flex-1 flex-wrap items-center gap-1 overflow-hidden" />
        </div>

        {/* the veil: do not steal the keyboard until the reader asks for it */}
        <button
          data-veil
          type="button"
          class="absolute inset-0 grid cursor-pointer place-items-center bg-crust/60 backdrop-blur-[1px]
                 font-mono text-sm text-subtext1 transition-opacity duration-(--dur-2) hover:text-text"
        >
          <Play class="mr-1.5 inline size-3.5" aria-hidden="true" />practica aquí — teclado real
        </button>
      </div>

      <div class="flex items-center gap-2 p-4 pt-3">
        <button data-action="reset" type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono">
          <RotateCcw class="size-3.5" aria-hidden="true" />reiniciar
        </button>
        <button data-action="hint" type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono">
          <Lightbulb class="size-3.5" aria-hidden="true" />pista
        </button>
        <button data-action="solution" type="button" class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono">
          <Play class="size-3.5" aria-hidden="true" />ver solución
        </button>
        {budget && (
          <span class="ml-auto font-mono text-2xs text-subtext0" title="pulsaciones de la solución óptima">
            par: {budget}
          </span>
        )}
      </div>

      <p data-hint hidden class="mx-4 mb-3 mt-0 inline-block rounded-sm border border-line bg-crust px-3 py-2 font-mono text-base text-peach">
        {keys ?? solution}
      </p>

      <div data-why hidden class="border-t border-teal/20 px-4 py-3 text-sm text-subtext1 [&>p]:m-0">
        <slot />
      </div>

      <script is:inline type="application/json" set:html={JSON.stringify(def)} />
    </figure>
  ) : isCode ? (
    <figure
      class="exercise not-prose my-6 overflow-hidden rounded-sm border border-line bg-crust/60"
      data-run
      data-id={exerciseId}
      data-label={title ?? challenge}
      data-runnable={runnable ? '1' : undefined}
    >
      <figcaption class="flex items-center gap-3 border-b border-line px-3 py-1.5 font-mono text-2xs tracking-smallcaps text-subtext0 uppercase">
        <span>{title ?? challenge ?? (runnable ? 'ejecuta' : 'código')}</span>
        <span class="text-subtext0 normal-case">{language}</span>
        {tests.length > 0 && <span data-state class="font-mono text-sm text-subtext0 normal-case">○</span>}
        <span class="flex-1" />
        {runnable && (
          <button
            type="button"
            data-action="run"
            class="inline-flex cursor-pointer items-center gap-1.5 rounded border border-line px-2 py-0.5 font-mono text-2xs text-subtext0 normal-case transition-colors hover:border-surface1 hover:text-text"
          >
            <Play class="size-3.5" aria-hidden="true" />ejecutar
          </button>
        )}
        <button
          type="button"
          data-action="reset"
          class="inline-flex cursor-pointer items-center gap-1.5 rounded border border-line px-2 py-0.5 font-mono text-2xs text-subtext0 normal-case transition-colors hover:border-surface1 hover:text-text"
        >
          <RotateCcw class="size-3.5" aria-hidden="true" />reiniciar
        </button>
      </figcaption>

      <div data-editor>
        <div data-editor-slot><pre class="m-0 overflow-x-auto p-3 font-mono text-sm">{code}</pre></div>
        <script is:inline type="application/json" set:html={JSON.stringify(editor)} />
      </div>

      <output
        data-out
        hidden
        class="block max-h-56 overflow-y-auto border-t border-line bg-mantle px-3 py-2 font-mono text-2xs whitespace-pre-wrap text-subtext0"
      />

      {tests.length > 0 && (
        <div class="hidden border-t border-line px-3 py-2" data-tests>
          <script is:inline type="application/json" set:html={JSON.stringify(tests)} />
          <ul class="m-0 grid list-none gap-1 p-0 font-mono text-2xs" data-test-list />
        </div>
      )}

      <div data-why hidden class="border-t border-line px-3 py-2 text-sm text-subtext1 [&>p]:m-0">
        <slot />
      </div>
    </figure>
  ) : (
    <div class="exercise my-5 rounded-sm border border-teal/35 bg-teal/5 p-4">
      <p class="m-0 text-base text-text">
        <Badge variant="soft" color="var(--teal)">EJERCICIO</Badge>
        {challenge}
      </p>
      <Accordion
        title="Ver solución"
        class="min-h-0 text-teal [&>div>*+*]:mt-2.5 [&>div]:p-0 [&>summary]:min-h-0 [&>summary]:px-0 [&>summary]:pt-2 [&>summary]:font-mono [&>summary]:text-sm"
      >
        {keys && (
          <p class="mt-2 mb-1 inline-block rounded-sm border border-line bg-crust px-3 py-2 font-mono text-base text-peach">
            {keys}
          </p>
        )}
        <slot />
      </Accordion>
    </div>
  )
}

<script>
  import '../../lib/vim/mount';
  import '../../lib/runtime/run-mount';
</script>
