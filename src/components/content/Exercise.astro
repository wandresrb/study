---
// El drill en sus dos formas.
//
// Con `doc` y un objetivo (`objetivo` o `objetivoCursor`) es INTERACTIVO:
// un Neovim emulado (CM6 + @replit/codemirror-vim) donde el lector teclea de
// verdad y el drill verifica el buffer/cursor resultante contra el objetivo.
// Sin ellos, cae a la forma clásica de accordion — así los 100+ drills
// existentes siguen funcionando y se van convirtiendo lección a lección.
//
// La solución (`solucion`) son las teclas EXACTAS, en notación vim
// (ci"adiós<Esc>): el botón «ver solución» las reproduce animadas, y
// scripts/verify-drills.mjs las contrasta contra un nvim --headless real.
import Accordion from '../ui/Accordion.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  reto: string;
  /** las teclas "bonitas" que se muestran como pista/solución textual */
  teclas?: string;
  id?: string;
  doc?: string;
  cursor?: [number, number];
  objetivo?: string;
  objetivoCursor?: [number, number];
  solucion?: string;
  presupuesto?: number;
  preparacion?: string;
}

const { reto, teclas, id, doc, cursor, objetivo, objetivoCursor, solucion, presupuesto, preparacion } =
  Astro.props;

const interactivo = doc !== undefined && (objetivo !== undefined || objetivoCursor !== undefined);
const def = interactivo
  ? { doc, cursor, objetivo, objetivoCursor, solucion, presupuesto, preparacion }
  : null;

// id estable para el progreso: hash corto del contenido si no viene explícito
const hashCorto = (t: string) => {
  let h = 0x811c9dc5;
  for (let i = 0; i < t.length; i++) {
    h ^= t.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString(36);
};
const idDrill = id ?? (interactivo ? `d-${hashCorto(doc! + (objetivo ?? '') + reto)}` : undefined);
---

{
  interactivo ? (
    <figure
      class="drill my-6 overflow-hidden rounded-sm border border-teal/35 bg-teal/5 not-prose"
      data-vim-exercise
      data-id={idDrill}
      data-reto={reto}
    >
      <figcaption class="flex items-start justify-between gap-3 p-4 pb-3">
        <p class="m-0 text-base text-text">
          <span class="mr-1.5"><Badge variant="soft" color="var(--teal)">⛳ DRILL</Badge></span>
          {reto}
        </p>
        <span data-estado class="font-mono text-sm text-overlay0" title="estado">○</span>
      </figcaption>

      <div class="relative mx-4 overflow-hidden rounded-sm border border-borde shadow-panel">
        {/* barra de título del "terminal" */}
        <div class="flex items-center gap-1.5 border-b border-borde bg-mantle px-3 py-1.5">
          <span class="size-2.5 rounded-full bg-red/70" />
          <span class="size-2.5 rounded-full bg-yellow/70" />
          <span class="size-2.5 rounded-full bg-green/70" />
          <span class="ml-2 font-mono text-2xs text-overlay1">nvim · drill</span>
        </div>

        <div data-term class="min-h-24 bg-crust font-mono text-sm">
          {/* SSR: el doc visible antes de hidratar; el motor lo sustituye */}
          <pre class="m-0 px-9 py-3 text-subtext1">{doc}</pre>
        </div>

        {/* statusline: modo + HUD de pulsaciones */}
        <div class="flex items-center gap-2 border-t border-borde bg-mantle px-3 py-1">
          <span
            data-modo
            data-valor="normal"
            class="rounded-xs px-1.5 font-mono text-2xs font-bold tracking-versalita uppercase
                   data-[valor=normal]:bg-mauve data-[valor=normal]:text-crust
                   data-[valor=insert]:bg-green data-[valor=insert]:text-crust
                   data-[valor=visual]:bg-peach data-[valor=visual]:text-crust"
          >
            NORMAL
          </span>
          <span data-hud class="flex min-h-5 flex-1 flex-wrap items-center gap-1 overflow-hidden" />
        </div>

        {/* velo inicial: no robar el teclado hasta que el lector quiera */}
        <button
          data-velo
          type="button"
          class="absolute inset-0 grid cursor-pointer place-items-center bg-crust/60 backdrop-blur-[1px]
                 font-mono text-sm text-subtext1 transition-opacity duration-(--dur-2) hover:text-text"
        >
          ▶ practica aquí — teclado real
        </button>
      </div>

      <div class="flex items-center gap-2 p-4 pt-3">
        <button data-accion="reiniciar" type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">
          ↺ reiniciar
        </button>
        <button data-accion="pista" type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">
          ⌨ pista
        </button>
        <button data-accion="solucion" type="button" class="d-btn d-btn-xs d-btn-ghost font-mono">
          ▶ ver solución
        </button>
        {presupuesto && (
          <span class="ml-auto font-mono text-2xs text-overlay1" title="pulsaciones de la solución óptima">
            par: {presupuesto}
          </span>
        )}
      </div>

      <p data-pista hidden class="mx-4 mb-3 mt-0 inline-block rounded-sm border border-borde bg-crust px-3 py-2 font-mono text-base text-peach">
        {teclas ?? solucion}
      </p>

      <div data-explica hidden class="border-t border-teal/20 px-4 py-3 text-sm text-subtext1 [&>p]:m-0">
        <slot />
      </div>

      <script type="application/json" set:html={JSON.stringify(def)} />
    </figure>
  ) : (
    <div class="drill my-5 rounded-sm border border-teal/35 bg-teal/5 p-4">
      <p class="m-0 text-base text-text">
        <Badge variant="soft" color="var(--teal)">⛳ DRILL</Badge>
        {reto}
      </p>
      <Accordion
        title="Ver solución"
        class="min-h-0 text-teal [&>div>*+*]:mt-2.5 [&>div]:p-0 [&>summary]:min-h-0 [&>summary]:px-0 [&>summary]:pt-2 [&>summary]:font-mono [&>summary]:text-sm"
      >
        {teclas && (
          <p class="mt-2 mb-1 inline-block rounded-sm border border-borde bg-crust px-3 py-2 font-mono text-base text-peach">
            {teclas}
          </p>
        )}
        <slot />
      </Accordion>
    </div>
  )
}

<script>
  import '../../lib/vim/mount';
</script>
