---
import type { Language } from '../../lib/editor/languages';
import type { Test } from '../../lib/runtime/types';

interface Props {
  code: string;
  language?: Language;
  title?: string;
  tests?: Test[];
  /** Modal editing for readers who want it; off by default. */
  vim?: boolean;
  readOnly?: boolean;
}

const { code, language = 'js', title, tests = [], vim = false, readOnly = false } = Astro.props;

// Only JS runs today. Anything else gets a highlighted editor and no run button
// until its runtime lands — better than a button that lies.
const runnable = language === 'js' || language === 'ts';

const editor = { doc: code, language, vim, readOnly, lineNumbers: true };
---
<figure
  class="not-prose my-6 overflow-hidden rounded-sm border border-borde bg-crust/60"
  data-run
  data-runnable={runnable ? '1' : undefined}
>
  <figcaption
    class="flex items-center gap-3 border-b border-borde px-3 py-1.5 font-mono text-2xs tracking-versalita text-overlay1 uppercase"
  >
    <span>{title ?? (runnable ? 'ejecuta' : 'código')}</span>
    <span class="text-overlay0 normal-case">{language}</span>
    <span class="flex-1"></span>
    {
      runnable && (
        <button
          type="button"
          data-action="run"
          class="cursor-pointer rounded border border-borde px-2 py-0.5 font-mono text-2xs text-subtext0 normal-case transition-colors hover:border-surface1 hover:text-text"
        >
          ▶ ejecutar
        </button>
      )
    }
    <button
      type="button"
      data-action="reset"
      class="cursor-pointer rounded border border-borde px-2 py-0.5 font-mono text-2xs text-subtext0 normal-case transition-colors hover:border-surface1 hover:text-text"
    >
      ↻ reiniciar
    </button>
  </figcaption>

  <div data-editor>
    <div data-editor-slot><pre class="m-0 overflow-x-auto p-3 font-mono text-sm">{code}</pre></div>
    <script is:inline type="application/json" set:html={JSON.stringify(editor)} />
  </div>

  <output
    data-out
    hidden
    class="block max-h-56 overflow-y-auto border-t border-borde bg-mantle px-3 py-2 font-mono text-2xs whitespace-pre-wrap text-subtext0"
  ></output>

  {
    tests.length > 0 && (
      <div class="hidden border-t border-borde px-3 py-2" data-tests>
        <script is:inline type="application/json" set:html={JSON.stringify(tests)} />
        <ul class="m-0 grid list-none gap-1 p-0 font-mono text-2xs" data-test-list />
      </div>
    )
  }
</figure>

<script>
  import '../../lib/editor/mount';
  import '../../lib/runtime/run-mount';
</script>
