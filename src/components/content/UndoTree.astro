---
// El árbol de deshacer, VIVO: con el foco puesto, u / Ctrl-r recorren la rama
// actual y g- / g+ recorren el tiempo — y se ve por qué u nunca llega a la
// rama descartada. Es el ejemplo canónico de la lección 1.8, ejecutable.
//
// Familia «TreeView». El árbol es fijo a propósito: es EL ejemplo del texto.
const nodos = [
  { id: 0, t: '(vacío)', x: 330, y: 40 },
  { id: 1, t: 'hola mundo', x: 330, y: 130 },
  { id: 2, t: 'hola Neovim', x: 180, y: 220, rama: true },
  { id: 3, t: 'hola Vim', x: 480, y: 220 },
] as const;
// aristas padre → hijo
const aristas = [
  [0, 1],
  [1, 2],
  [1, 3],
] as const;
---

<figure
  class="undotree not-prose group/arbol my-6 rounded-sm border border-borde bg-crust/60 p-3 outline-none
         transition-colors duration-(--dur-2) focus-within:border-teal/60"
  data-undotree
  tabindex="0"
  aria-label="Árbol de deshacer interactivo: con el foco, pulsa u, Ctrl-r, g y luego menos, o g y luego más"
>
  <figcaption class="mb-1 flex items-baseline justify-between gap-3 px-1">
    <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">el árbol de deshacer</span>
    <span class="font-mono text-2xs text-overlay0 transition-opacity duration-(--dur-1) group-focus-within/arbol:opacity-0">
      haz clic y pulsa <kbd class="text-subtext1">u</kbd> <kbd class="text-subtext1">Ctrl-r</kbd>
      <kbd class="text-subtext1">g-</kbd> <kbd class="text-subtext1">g+</kbd>
    </span>
    <output data-aviso class="font-mono text-2xs text-peach opacity-0 transition-opacity duration-(--dur-1)"></output>
  </figcaption>

  <svg viewBox="0 0 660 270" class="block w-full" role="img">
    {aristas.map(([de, a]) => {
      const d = nodos[de];
      const h = nodos[a];
      return (
        <line
          x1={d.x} y1={d.y + 16} x2={h.x} y2={h.y - 16}
          stroke="var(--overlay0)" stroke-width="1.25"
          data-union={`${de}-${a}`}
          class="transition-[stroke] duration-(--dur-2)"
        />
      );
    })}
    {nodos.map((n) => (
      <g data-nodo={n.id} class="cursor-pointer">
        <rect
          x={n.x - 75} y={n.y - 16} width="150" height="32" rx="5"
          fill="var(--mantle)" stroke="var(--border)"
          class="transition-[fill,stroke] duration-(--dur-2)
                 [[data-actual]_&]:fill-(--teal) [[data-actual]_&]:stroke-(--teal)"
        />
        <text
          x={n.x} y={n.y + 4} text-anchor="middle"
          class="pointer-events-none font-mono text-[13px] transition-[fill] duration-(--dur-2)
                 fill-(--subtext1) [[data-actual]_&]:fill-(--crust)"
        >
          {n.t}
        </text>
        {n.rama && (
          <text x={n.x} y={n.y + 34} text-anchor="middle" class="fill-(--overlay0) font-mono text-[10px]">
            la rama que u no ve
          </text>
        )}
      </g>
    ))}
  </svg>

  <p class="m-0 mt-1 px-1 font-mono text-2xs text-overlay1">
    secuencia real: escribiste «hola mundo» → «hola Neovim» → <b class="text-subtext1">u</b> → escribiste «hola Vim»
  </p>
</figure>

<script>
  // La semántica de verdad: u/Ctrl-r por la RAMA activa; g-/g+ por el TIEMPO.
  // padre[], y la rama activa cambia al crear el nodo 3 (como en el editor).
  const PADRE = [-1, 0, 1, 1];
  const RAMA_ACTIVA = [0, 1, 3]; // el camino que u recorre tras el desvío

  const arrancarComponente = () => {
    for (const raiz of document.querySelectorAll<HTMLElement>('[data-undotree]:not([data-vivo])')) {
      raiz.dataset.vivo = '1';
      let actual = 3; // el estado final de la secuencia contada
      const aviso = raiz.querySelector<HTMLElement>('[data-aviso]')!;

      const pintar = () => {
        raiz.querySelectorAll('[data-actual]').forEach((n) => n.removeAttribute('data-actual'));
        raiz.querySelector(`[data-nodo="${actual}"]`)?.setAttribute('data-actual', '1');
      };
      const decir = (t: string) => {
        aviso.textContent = t;
        aviso.style.opacity = '1';
        setTimeout(() => (aviso.style.opacity = '0'), 1100);
      };
      pintar();

      let gPendiente = false;
      raiz.addEventListener('keydown', (ev) => {
        const k = ev.key;
        if (!['u', 'r', 'g', '-', '+'].includes(k) && !(k === 'r' && ev.ctrlKey)) return;
        ev.preventDefault();

        if (k === 'g') { gPendiente = true; return; }
        if (gPendiente && (k === '-' || k === '+')) {
          gPendiente = false;
          const siguiente = k === '-' ? actual - 1 : actual + 1;
          if (siguiente < 0 || siguiente > 3) return decir(k === '-' ? 'no hay más atrás' : 'no hay más adelante');
          actual = siguiente;
          decir(`g${k} → por el TIEMPO`);
          return pintar();
        }
        gPendiente = false;

        if (k === 'u') {
          if (actual === 0) return decir('nada que deshacer');
          const i = RAMA_ACTIVA.indexOf(actual);
          if (i > 0) { actual = RAMA_ACTIVA[i - 1]; decir('u → por la rama'); }
          else { actual = PADRE[actual]; decir('u → por la rama'); }
          if (actual === 1) decir('u NUNCA pasará por «hola Neovim»');
          return pintar();
        }
        if (k === 'r' && ev.ctrlKey) {
          const i = RAMA_ACTIVA.indexOf(actual);
          if (i === -1 || i === RAMA_ACTIVA.length - 1) return decir('Ctrl-r: nada que rehacer AQUÍ');
          actual = RAMA_ACTIVA[i + 1];
          decir('Ctrl-r → por la rama');
          return pintar();
        }
      });

      // y clicable, porque el árbol también se navega mirando
      raiz.addEventListener('click', (ev) => {
        const nodo = (ev.target as Element).closest<SVGGElement>('[data-nodo]');
        if (!nodo) return;
        actual = Number(nodo.dataset.nodo);
        pintar();
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
