---
// The undo tree, LIVE: with focus, u / Ctrl-r walk the current branch and
// g- / g+ walk time — showing why u never reaches the discarded branch. It is
// the canonical example of lesson 1.8, made executable.
//
// The tree is fixed on purpose: it is THE example the text talks about.
interface Node {
  id: number;
  t: string;
  x: number;
  y: number;
  /** the branch `u` never walks back through */
  branch?: boolean;
}
const nodes: Node[] = [
  { id: 0, t: '(vacío)', x: 330, y: 40 },
  { id: 1, t: 'hola mundo', x: 330, y: 130 },
  { id: 2, t: 'hola Neovim', x: 180, y: 220, branch: true },
  { id: 3, t: 'hola Vim', x: 480, y: 220 },
];
// parent → child edges
const edges = [
  [0, 1],
  [1, 2],
  [1, 3],
] as const;
---

<figure
  class="undotree not-prose group/arbol my-6 rounded-sm border border-line bg-crust/60 p-3 outline-none
         transition-colors duration-(--dur-2) focus-within:border-teal/60"
  data-undotree
  tabindex="0"
  aria-label="Árbol de deshacer interactivo: con el foco, pulsa u, Ctrl-r, g y luego menos, o g y luego más"
>
  <figcaption class="mb-1 flex items-baseline justify-between gap-3 px-1">
    <span class="font-mono text-2xs tracking-smallcaps text-overlay1 uppercase">el árbol de deshacer</span>
    <span class="font-mono text-2xs text-overlay0 transition-opacity duration-(--dur-1) group-focus-within/arbol:opacity-0">
      haz clic y pulsa <kbd class="text-subtext1">u</kbd> <kbd class="text-subtext1">Ctrl-r</kbd>
      <kbd class="text-subtext1">g-</kbd> <kbd class="text-subtext1">g+</kbd>
    </span>
    <output data-notice class="font-mono text-2xs text-peach opacity-0 transition-opacity duration-(--dur-1)"></output>
  </figcaption>

  <svg viewBox="0 0 660 270" class="block w-full" role="img">
    {edges.map(([de, a]) => {
      const d = nodes[de];
      const h = nodes[a];
      return (
        <line
          x1={d.x} y1={d.y + 16} x2={h.x} y2={h.y - 16}
          stroke="var(--overlay0)" stroke-width="1.25"
          data-join={`${de}-${a}`}
          class="transition-[stroke] duration-(--dur-2)"
        />
      );
    })}
    {nodes.map((n) => (
      <g data-node={n.id} class="cursor-pointer">
        <rect
          x={n.x - 75} y={n.y - 16} width="150" height="32" rx="5"
          fill="var(--mantle)" stroke="var(--line)"
          class="transition-[fill,stroke] duration-(--dur-2)
                 [[data-current]_&]:fill-(--teal) [[data-current]_&]:stroke-(--teal)"
        />
        <text
          x={n.x} y={n.y + 4} text-anchor="middle"
          class="pointer-events-none font-mono text-[13px] transition-[fill] duration-(--dur-2)
                 fill-(--subtext1) [[data-current]_&]:fill-(--crust)"
        >
          {n.t}
        </text>
        {n.branch && (
          <text x={n.x} y={n.y + 34} text-anchor="middle" class="fill-(--overlay0) font-mono text-[10px]">
            la rama que u no ve
          </text>
        )}
      </g>
    ))}
  </svg>

  <p class="m-0 mt-1 px-1 font-mono text-2xs text-overlay1">
    secuencia real: escribiste «hola mundo» → «hola Neovim» → <b class="text-subtext1">u</b> → escribiste «hola Vim»
  </p>
</figure>

<script>
  // La semántica de verdad: u/Ctrl-r por la RAMA activa; g-/g+ por el TIEMPO.
  // PARENT[], and the active branch changes when node 3 is created (as in the editor).
  const PARENT = [-1, 0, 1, 1];
  const ACTIVE_BRANCH = [0, 1, 3]; // el camino que u recorre tras el desvío

  const start = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-undotree]:not([data-live])')) {
      root.dataset.live = '1';
      let current = 3; // el state final de la secuencia contada
      const aviso = root.querySelector<HTMLElement>('[data-notice]')!;

      const paint = () => {
        root.querySelectorAll('[data-current]').forEach((n) => n.removeAttribute('data-current'));
        root.querySelector(`[data-node="${current}"]`)?.setAttribute('data-current', '1');
      };
      const say = (t: string) => {
        aviso.textContent = t;
        aviso.style.opacity = '1';
        setTimeout(() => (aviso.style.opacity = '0'), 1100);
      };
      paint();

      let gPendiente = false;
      root.addEventListener('keydown', (ev) => {
        const k = ev.key;
        if (!['u', 'r', 'g', '-', '+'].includes(k) && !(k === 'r' && ev.ctrlKey)) return;
        ev.preventDefault();

        if (k === 'g') { gPendiente = true; return; }
        if (gPendiente && (k === '-' || k === '+')) {
          gPendiente = false;
          const siguiente = k === '-' ? current - 1 : current + 1;
          if (siguiente < 0 || siguiente > 3) return say(k === '-' ? 'no hay más atrás' : 'no hay más adelante');
          current = siguiente;
          say(`g${k} → por el TIEMPO`);
          return paint();
        }
        gPendiente = false;

        if (k === 'u') {
          if (current === 0) return say('nada que deshacer');
          const i = ACTIVE_BRANCH.indexOf(current);
          if (i > 0) { current = ACTIVE_BRANCH[i - 1]; say('u → por la rama'); }
          else { current = PARENT[current]; say('u → por la rama'); }
          if (current === 1) say('u NUNCA pasará por «hola Neovim»');
          return paint();
        }
        if (k === 'r' && ev.ctrlKey) {
          const i = ACTIVE_BRANCH.indexOf(current);
          if (i === -1 || i === ACTIVE_BRANCH.length - 1) return say('Ctrl-r: nada que rehacer AQUÍ');
          current = ACTIVE_BRANCH[i + 1];
          say('Ctrl-r → por la rama');
          return paint();
        }
      });

      // y clicable, porque el árbol también se navega mirando
      root.addEventListener('click', (ev) => {
        const node = (ev.target as Element).closest<SVGGElement>('[data-node]');
        if (!node) return;
        current = Number(node.dataset.node);
        paint();
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
