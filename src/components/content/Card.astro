---
interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---
<div class="d-card d-card-border border-line bg-panel p-4.5 transition-transform hover:-translate-y-[3px] hover:border-surface1 hover:shadow-panel">
  {icon && <p class="emoji m-0 mb-2.5 text-2xl" aria-hidden="true">{icon}</p>}
  <h4 class="m-0 mb-1.5 text-base font-bold text-text">{title}</h4>
  <div class="text-md text-subtext0 [&>*+*]:mt-2 [&>p:first-child]:mt-0"><slot /></div>
</div>
