---
import { iconForEmoji } from '../../lib/card-icons';

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;

// The lessons pass an emoji; draw the matching Lucide glyph so the cards speak
// the same visual language as the rest of the site. Unmapped ones keep theirs.
const Icon = icon ? iconForEmoji(icon) : undefined;
---
<div class="d-card d-card-border border-borde bg-panel p-4.5 transition-transform hover:-translate-y-[3px] hover:border-surface1 hover:shadow-panel">
  {Icon && <Icon class="mb-2.5 size-6 text-subtext0" aria-hidden="true" />}
  {icon && !Icon && <p class="emoji m-0 mb-2.5 text-2xl" aria-hidden="true">{icon}</p>}
  <h3 class="m-0 mb-1.5 text-base font-bold text-text">{title}</h3>
  <div class="text-md text-subtext0 [&>*+*]:mt-2 [&>p:first-child]:mt-0"><slot /></div>
</div>
