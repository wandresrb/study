---
import Shapes from '@lucide/astro/icons/shapes';
import { iconForEmoji } from '../../lib/card-icons';

interface Props {
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;

// The lessons pass an emoji. It never reaches the page: mapped ones become their
// Lucide glyph, the rest fall back to a neutral one. No emoji renders anywhere.
const Icon = icon ? (iconForEmoji(icon) ?? Shapes) : undefined;
---

<div
  class="d-card d-card-border border-line bg-panel p-4.5 transition-transform hover:-translate-y-[3px] hover:border-surface1 hover:shadow-panel"
>
  {Icon && <Icon class="mb-2.5 size-6 text-subtext0" aria-hidden="true" />}
  <h3 class="m-0 mb-1.5 text-base font-bold text-text">{title}</h3>
  <div class="text-md text-subtext0 [&>*+*]:mt-2 [&>p:first-child]:mt-0"><slot /></div>
</div>
