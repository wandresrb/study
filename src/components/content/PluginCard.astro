---
import Badge from '../ui/Badge.astro';
import Puzzle from '@lucide/astro/icons/puzzle';
import { iconForEmoji } from '../../lib/card-icons';

interface Props {
  name: string;
  repo?: string;
  tag?: string;
  icon?: string;
}

const { name, repo, tag = 'plugin', icon } = Astro.props;

// Puzzle both as the default and as the fallback: an emoji never reaches the page.
const Icon = (icon ? iconForEmoji(icon) : undefined) ?? Puzzle;

const COLOR: Record<string, string> = {
  core: 'var(--mauve)',
  ai: 'var(--green)',
  opt: 'var(--blue)',
};
---

<div
  class="plugin d-card d-card-border my-2.5 grid grid-cols-[auto_1fr_auto] items-center gap-3.5 border-line bg-panel px-4 py-3.5 transition-colors hover:border-surface1"
>
  <span class="grid size-10 place-items-center rounded-md bg-surface0" aria-hidden="true">
    <Icon class="size-5 text-subtext0" />
  </span>

  <div class="min-w-0">
    <b class="font-mono text-base text-text">{name}</b>
    {repo && <span class="ml-2 font-mono text-xs text-subtext0">{repo}</span>}
    <div class="mt-1 text-md text-subtext0 [&>*+*]:mt-1.5"><slot /></div>
  </div>

  <Badge variant="soft" color={COLOR[tag]}>{tag}</Badge>
</div>
