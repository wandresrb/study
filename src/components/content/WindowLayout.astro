---
// Buffers, ventanas y pestañas: las tres capas, tocables. Al pasar por una
// ventana se ilumina SU buffer —y se ve que dos ventanas comparten uno, y que
// hay un buffer cargado que nadie muestra—. Sustituye al flowchart de 1.1.
//
// Familia «WindowLayout». El ejemplo es el del texto; fijo a propósito.
---

<figure class="windowlayout not-prose my-6 rounded-sm border border-borde bg-crust/60 p-4" data-windowlayout>
  <figcaption class="mb-3 px-1 font-mono text-2xs tracking-versalita text-overlay1 uppercase">
    tres capas — pasa el ratón por las ventanas
  </figcaption>

  <div class="grid gap-4 md:grid-cols-[3fr_2fr]">
    {/* pestaña 1: layout de trabajo */}
    <div class="grid gap-3">
      <section class="rounded-sm border border-borde bg-mantle/60 p-2" aria-label="Pestaña 1">
        <p class="m-0 mb-1.5 font-mono text-2xs text-overlay1">PESTAÑA 1 · el layout de trabajo</p>
        <div class="grid h-40 grid-cols-2 grid-rows-2 gap-1.5">
          <button type="button" data-ventana data-buffer="b1"
            class="row-span-2 rounded-xs border border-borde bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana A<br /><span class="text-overlay0">→ main.lua</span>
          </button>
          <button type="button" data-ventana data-buffer="b2"
            class="rounded-xs border border-borde bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana B<br /><span class="text-overlay0">→ main_spec.lua</span>
          </button>
          <button type="button" data-ventana data-buffer="b1"
            class="rounded-xs border border-borde bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana C<br /><span class="text-overlay0">→ main.lua <b class="text-teal">otra vez</b></span>
          </button>
        </div>
      </section>
      <section class="rounded-sm border border-borde bg-mantle/60 p-2" aria-label="Pestaña 2">
        <p class="m-0 mb-1.5 font-mono text-2xs text-overlay1">PESTAÑA 2 · el layout de documentación</p>
        <button type="button" data-ventana data-buffer="b3"
          class="h-14 w-full rounded-xs border border-borde bg-crust p-2 text-left font-mono text-2xs text-subtext1
                 transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
          Ventana D <span class="text-overlay0">→ README.md</span>
        </button>
      </section>
    </div>

    {/* los buffers: la capa de contenido */}
    <section class="rounded-sm border border-borde bg-mantle/60 p-2" aria-label="Buffers cargados">
      <p class="m-0 mb-1.5 font-mono text-2xs text-overlay1">BUFFERS · lo cargado en memoria</p>
      <ul class="m-0 grid list-none gap-1.5 p-0 font-mono text-2xs">
        {[
          ['b1', 'main.lua', 'lo muestran DOS ventanas'],
          ['b2', 'main_spec.lua', ''],
          ['b3', 'README.md', ''],
          ['b4', 'notas.md', 'oculto: sin ventana, y no ha perdido nada'],
        ].map(([id, nombre, nota]) => (
          <li
            data-buffer-caja={id}
            class="rounded-xs border border-borde bg-crust px-2 py-1.5 text-subtext1 transition-colors duration-(--dur-1)
                   data-[on]:border-green data-[on]:bg-green/10"
          >
            <b>{nombre}</b>
            {nota && <span class="block text-overlay0">{nota}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <p class="m-0 mt-2 px-1 text-2xs text-subtext0">
    Una <b>ventana</b> es una vista; un <b>buffer</b> es el contenido; una <b>pestaña</b> es una disposición
    de ventanas. Fíjate: A y C muestran el mismo buffer, y <code>notas.md</code> vive sin que lo muestre nadie.
  </p>
</figure>

<script>
  const arrancarComponente = () => {
    for (const raiz of document.querySelectorAll<HTMLElement>('[data-windowlayout]:not([data-vivo])')) {
      raiz.dataset.vivo = '1';
      const marcar = (id: string | null) => {
        raiz.querySelectorAll<HTMLElement>('[data-ventana]').forEach((v) =>
          v.toggleAttribute('data-on', id !== null && v.dataset.buffer === id),
        );
        raiz.querySelectorAll<HTMLElement>('[data-buffer-caja]').forEach((b) =>
          b.toggleAttribute('data-on', b.dataset.bufferCaja === id),
        );
      };
      raiz.addEventListener('pointerover', (ev) => {
        const v = (ev.target as HTMLElement).closest<HTMLElement>('[data-ventana], [data-buffer-caja]');
        marcar(v ? (v.dataset.buffer ?? v.dataset.bufferCaja ?? null) : null);
      });
      raiz.addEventListener('pointerleave', () => marcar(null));
      // en táctil, el toque equivale al hover
      raiz.addEventListener('click', (ev) => {
        const v = (ev.target as HTMLElement).closest<HTMLElement>('[data-ventana], [data-buffer-caja]');
        if (v) marcar(v.dataset.buffer ?? v.dataset.bufferCaja ?? null);
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
