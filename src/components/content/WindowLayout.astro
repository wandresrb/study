---
// Buffers, windows y pestañas: las tres capas, tocables. Al pasar por una
// window se ilumina SU buffer —y se ve que dos windows comparten uno, y que
// hay un buffer cargado que nadie muestra—. Sustituye al flowchart de 1.1.
//
// Familia «WindowLayout». El ejemplo es el del texto; fijo a propósito.
---

<figure class="windowlayout not-prose my-6 rounded-sm border border-line bg-crust/60 p-4" data-windowlayout>
  <figcaption class="mb-3 px-1 font-mono text-2xs tracking-smallcaps text-subtext0 uppercase">
    tres capas — pasa el ratón por las windows
  </figcaption>

  <div class="grid gap-4 md:grid-cols-[3fr_2fr]">
    {/* pestaña 1: layout de trabajo */}
    <div class="grid gap-3">
      <section class="rounded-sm border border-line bg-mantle/60 p-2" aria-label="Pestaña 1">
        <p class="m-0 mb-1.5 font-mono text-2xs text-subtext0">PESTAÑA 1 · el layout de trabajo</p>
        <div class="grid h-40 grid-cols-2 grid-rows-2 gap-1.5">
          <button type="button" data-window data-buffer="b1"
            class="row-span-2 rounded-xs border border-line bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana A<br /><span class="text-subtext0">→ main.lua</span>
          </button>
          <button type="button" data-window data-buffer="b2"
            class="rounded-xs border border-line bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana B<br /><span class="text-subtext0">→ main_spec.lua</span>
          </button>
          <button type="button" data-window data-buffer="b1"
            class="rounded-xs border border-line bg-crust p-2 text-left font-mono text-2xs text-subtext1
                   transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
            Ventana C<br /><span class="text-subtext0">→ main.lua <b class="text-teal">otra vez</b></span>
          </button>
        </div>
      </section>
      <section class="rounded-sm border border-line bg-mantle/60 p-2" aria-label="Pestaña 2">
        <p class="m-0 mb-1.5 font-mono text-2xs text-subtext0">PESTAÑA 2 · el layout de documentación</p>
        <button type="button" data-window data-buffer="b3"
          class="h-14 w-full rounded-xs border border-line bg-crust p-2 text-left font-mono text-2xs text-subtext1
                 transition-colors duration-(--dur-1) hover:border-green data-[on]:border-green data-[on]:shadow-[0_0_0_1px_var(--green)]">
          Ventana D <span class="text-subtext0">→ README.md</span>
        </button>
      </section>
    </div>

    {/* los buffers: la capa de contenido */}
    <section class="rounded-sm border border-line bg-mantle/60 p-2" aria-label="Buffers cargados">
      <p class="m-0 mb-1.5 font-mono text-2xs text-subtext0">BUFFERS · lo cargado en memoria</p>
      <ul class="m-0 grid list-none gap-1.5 p-0 font-mono text-2xs">
        {[
          ['b1', 'main.lua', 'lo muestran DOS windows'],
          ['b2', 'main_spec.lua', ''],
          ['b3', 'README.md', ''],
          ['b4', 'notas.md', 'oculto: sin window, y no ha perdido nada'],
        ].map(([id, nombre, nota]) => (
          <li
            data-buffer-box={id}
            class="rounded-xs border border-line bg-crust px-2 py-1.5 text-subtext1 transition-colors duration-(--dur-1)
                   data-[on]:border-green data-[on]:bg-green/10"
          >
            <b>{nombre}</b>
            {nota && <span class="block text-subtext0">{nota}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <p class="m-0 mt-2 px-1 text-2xs text-subtext0">
    Una <b>ventana</b> es una vista; un <b>buffer</b> es el contenido; una <b>pestaña</b> es una disposición
    de ventanas. Fíjate: A y C muestran el mismo buffer, y <code>notas.md</code> vive sin que lo muestre nadie.
  </p>
</figure>

<script>
  const start = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-windowlayout]:not([data-live])')) {
      root.dataset.live = '1';
      const mark = (id: string | null) => {
        root.querySelectorAll<HTMLElement>('[data-window]').forEach((v) =>
          v.toggleAttribute('data-on', id !== null && v.dataset.buffer === id),
        );
        root.querySelectorAll<HTMLElement>('[data-buffer-box]').forEach((b) =>
          b.toggleAttribute('data-on', b.dataset.bufferBox === id),
        );
      };
      root.addEventListener('pointerover', (ev) => {
        const v = (ev.target as HTMLElement).closest<HTMLElement>('[data-window], [data-buffer-box]');
        mark(v ? (v.dataset.buffer ?? v.dataset.bufferBox ?? null) : null);
      });
      root.addEventListener('pointerleave', () => mark(null));
      // on touch, a tap is the hover
      root.addEventListener('click', (ev) => {
        const v = (ev.target as HTMLElement).closest<HTMLElement>('[data-window], [data-buffer-box]');
        if (v) mark(v.dataset.buffer ?? v.dataset.bufferBox ?? null);
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
