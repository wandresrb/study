---
import Accordion from '../ui/Accordion.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  reto: string;
  teclas?: string;
}

const { reto, teclas } = Astro.props;
---
<div class="drill my-5 rounded-sm border border-teal/35 bg-teal/5 p-4">
  <p class="m-0 text-base text-text">
    <Badge variant="soft" color="var(--teal)">⛳ DRILL</Badge>
    {reto}
  </p>

  <Accordion
    title="Ver solución"
    class="min-h-0 text-teal [&>div>*+*]:mt-2.5 [&>div]:p-0 [&>summary]:min-h-0 [&>summary]:px-0 [&>summary]:pt-2 [&>summary]:font-mono [&>summary]:text-sm"
  >
    {teclas && (
      <p class="mt-2 mb-1 inline-block rounded-sm border border-borde bg-crust px-3 py-2 font-mono text-base text-peach">
        {teclas}
      </p>
    )}
    <slot />
  </Accordion>
</div>
