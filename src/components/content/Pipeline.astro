---
// La familia que sustituye a la mayoría de los flowcharts de Mermaid:
// grupos de pasos con un tono, opcionalmente un resultado común, y un
// recorrido animado paso a paso (botón ▶ o clic en cada paso).
//
//   <Pipeline
//     titulo="qué absorbió el núcleo"
//     resultado="una config de 8–10 plugins"
//     grupos={[
//       { titulo: 'entró en el núcleo', tono: 'green',
//         pasos: [{ t: 'gc comentar', d: '0.10' }, …] },
//       { titulo: 'sigue fuera', tono: 'peach', pasos: [...] },
//     ]} />
//
// HTML/CSS, no SVG: responsive gratis, tema gratis, y el layout no se calcula.
interface Paso {
  /** título del paso */
  t: string;
  /** detalle: se enseña al pulsar el paso */
  d?: string;
}
interface Grupo {
  titulo?: string;
  /** nombre de color Catppuccin: green, peach, blue, mauve, red, teal, yellow */
  tono?: string;
  pasos: Paso[];
  /** true = los pasos fluyen con flechas (secuencia); false = solo lista */
  secuencia?: boolean;
}
interface Props {
  titulo?: string;
  resultado?: string;
  grupos: Grupo[];
}
const { titulo, resultado, grupos } = Astro.props;
const algunDetalle = grupos.some((g) => g.pasos.some((p) => p.d));
---

<figure class="pipeline not-prose my-6 rounded-sm border border-borde bg-crust/60 p-4" data-pipeline>
  <figcaption class="mb-3 flex items-baseline justify-between">
    {titulo && <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">{titulo}</span>}
    <button
      data-recorrer
      type="button"
      class="d-btn d-btn-xs d-btn-ghost font-mono text-2xs"
      aria-label="Recorrer el diagrama paso a paso"
    >▶ recorrer</button>
  </figcaption>

  <div class={`grid gap-4 ${grupos.length > 1 ? 'md:grid-cols-2' : ''}`}>
    {grupos.map((g) => (
      <section
        class="rounded-sm border p-3"
        style={`border-color: color-mix(in srgb, var(--${g.tono ?? 'blue'}) 40%, transparent);
                background: color-mix(in srgb, var(--${g.tono ?? 'blue'}) 6%, transparent);
                --tono: var(--${g.tono ?? 'blue'})`}
      >
        {g.titulo && (
          <h4 class="m-0 mb-2 font-mono text-2xs font-bold tracking-versalita uppercase" style="color: var(--tono)">
            {g.titulo}
          </h4>
        )}
        <ol class="m-0 grid list-none gap-1.5 p-0">
          {g.pasos.map((p, i) => (
            <li class="grid">
              <button
                type="button"
                data-paso
                class="flex w-full items-baseline gap-2 rounded-xs border border-transparent bg-crust/70 px-2.5 py-1.5
                       text-left transition-all duration-(--dur-1)
                       hover:border-(--tono) data-[activo]:border-(--tono) data-[activo]:bg-crust
                       data-[activo]:shadow-[0_0_0_1px_var(--tono)]"
                aria-expanded={p.d ? 'false' : undefined}
              >
                <span class="font-mono text-2xs" style="color: var(--tono)">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 text-sm text-subtext1">{p.t}</span>
                {p.d && <span class="font-mono text-2xs text-overlay0">＋</span>}
              </button>
              {p.d && (
                <p data-detalle hidden class="m-0 border-l-2 py-1.5 pr-2 pl-4 text-2xs text-subtext0" style="border-color: var(--tono)">
                  {p.d}
                </p>
              )}
              {(g.secuencia ?? true) && i < g.pasos.length - 1 && (
                <span aria-hidden="true" class="py-0.5 pl-3 font-mono text-2xs leading-none text-overlay0">↓</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  {resultado && (
    <>
      <div aria-hidden="true" class="py-1 text-center font-mono text-sm text-overlay0">↓</div>
      <p class="m-0 rounded-sm border border-blue/50 bg-blue/10 px-3 py-2 text-center font-mono text-sm text-blue" data-resultado>
        {resultado}
      </p>
    </>
  )}
  {algunDetalle && (
    <p class="m-0 mt-2 text-right font-mono text-2xs text-overlay0">＋ = pulsa un paso para el detalle</p>
  )}
</figure>

<script>
  // Clic en un paso: detalle. ▶: recorrido con stagger. GSAP solo si recorre.
  const arrancarComponente = () => {
    for (const raiz of document.querySelectorAll<HTMLElement>('[data-pipeline]:not([data-vivo])')) {
      raiz.dataset.vivo = '1';

      raiz.addEventListener('click', (ev) => {
        const paso = (ev.target as HTMLElement).closest<HTMLElement>('[data-paso]');
        if (!paso) return;
        const activo = paso.toggleAttribute('data-activo');
        paso.setAttribute('aria-expanded', String(activo));
        const detalle = paso.parentElement?.querySelector('[data-detalle]');
        detalle?.toggleAttribute('hidden', !activo);
      });

      raiz.querySelector('[data-recorrer]')?.addEventListener('click', async () => {
        const pasos = [...raiz.querySelectorAll<HTMLElement>('[data-paso]')];
        const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
        for (const p of pasos) {
          p.setAttribute('data-activo', '1');
          p.parentElement?.querySelector('[data-detalle]')?.removeAttribute('hidden');
          if (!reducido) await new Promise((r) => setTimeout(r, 180));
        }
        const resultado = raiz.querySelector('[data-resultado]');
        if (resultado && !reducido) {
          const { gsap } = await import('gsap');
          gsap.fromTo(resultado, { scale: 0.97, opacity: 0.6 }, { scale: 1, opacity: 1, duration: 0.3, ease: 'back.out(2)' });
        }
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
