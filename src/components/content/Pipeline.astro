---
// The family that replaces most of Mermaid's flowcharts: groups of steps with a
// tone, an optional shared result, and a step-by-step walk (the ▶ button or a
// click on any step).
//
//   <Pipeline
//     title="qué absorbió el núcleo"
//     result="una config de 8–10 plugins"
//     groups={[
//       { title: 'entró en el núcleo', tone: 'green',
//         steps: [{ t: 'gc comentar', d: '0.10' }, …] },
//       { title: 'sigue fuera', tone: 'peach', steps: [...] },
//     ]} />
//
// HTML/CSS, not SVG: responsive for free, theme for free, no layout to compute.
import Play from '@lucide/astro/icons/play';

interface Step {
  /** the step title */
  t: string;
  /** detail: shown when the step is clicked */
  d?: string;
}
interface Group {
  title?: string;
  /** accent token name: green, peach, blue, mauve, red, teal, yellow */
  tone?: string;
  steps: Step[];
  /** true = the steps flow with arrows (a sequence); false = just a list */
  sequence?: boolean;
}
interface Props {
  title?: string;
  result?: string;
  groups: Group[];
}
const { title, result, groups } = Astro.props;
const anyDetail = groups.some((g) => g.steps.some((p) => p.d));
---

<figure class="pipeline not-prose my-6 rounded-sm border border-line bg-crust/60 p-4" data-pipeline>
  <figcaption class="mb-3 flex items-baseline justify-between">
    {title && <span class="font-mono text-2xs tracking-smallcaps text-subtext0 uppercase">{title}</span>}
    <button
      data-walk
      type="button"
      class="d-btn d-btn-xs d-btn-ghost gap-1.5 font-mono text-2xs"
      aria-label="Recorrer el diagrama paso a paso"><Play class="size-3" aria-hidden="true" />recorrer</button
    >
  </figcaption>

  <div class={`grid gap-4 ${groups.length > 1 ? 'md:grid-cols-2' : ''}`}>
    {
      groups.map((g) => (
        <section
          class="rounded-sm border p-3"
          style={`border-color: color-mix(in srgb, var(--${g.tone ?? 'blue'}) 40%, transparent);
                background: color-mix(in srgb, var(--${g.tone ?? 'blue'}) 6%, transparent);
                --tone: var(--${g.tone ?? 'blue'})`}
        >
          {g.title && (
            <h3 class="m-0 mb-2 font-mono text-2xs font-bold tracking-smallcaps uppercase" style="color: var(--tone)">
              {g.title}
            </h3>
          )}
          <ol class="m-0 grid list-none gap-1.5 p-0">
            {g.steps.map((p, i) => (
              <li class="grid">
                <button
                  type="button"
                  data-step
                  class="flex w-full items-baseline gap-2 rounded-xs border border-transparent bg-crust/70 px-2.5 py-1.5
                       text-left transition-all duration-(--dur-1)
                       hover:border-(--tone) data-[active]:border-(--tone) data-[active]:bg-crust
                       data-[active]:shadow-[0_0_0_1px_var(--tone)]"
                  aria-expanded={p.d ? 'false' : undefined}
                >
                  <span class="font-mono text-2xs" style="color: var(--tone)">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex-1 text-sm text-subtext1">{p.t}</span>
                  {p.d && <span class="font-mono text-2xs text-subtext0">＋</span>}
                </button>
                {p.d && (
                  <p
                    data-detail
                    hidden
                    class="m-0 border-l-2 py-1.5 pr-2 pl-4 text-2xs text-subtext0"
                    style="border-color: var(--tone)"
                  >
                    {p.d}
                  </p>
                )}
                {(g.sequence ?? true) && i < g.steps.length - 1 && (
                  <span aria-hidden="true" class="py-0.5 pl-3 font-mono text-2xs leading-none text-subtext0">
                    ↓
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  {
    result && (
      <>
        <div aria-hidden="true" class="py-1 text-center font-mono text-sm text-subtext0">
          ↓
        </div>
        <p
          class="m-0 rounded-sm border border-blue/50 bg-blue/10 px-3 py-2 text-center font-mono text-sm text-blue"
          data-result
        >
          {result}
        </p>
      </>
    )
  }
  {anyDetail && <p class="m-0 mt-2 text-right font-mono text-2xs text-subtext0">＋ = pulsa un paso para el detalle</p>}
</figure>

<script>
  // Click on a step: its detail. ▶: a staggered walk. GSAP only when walking.
  const start = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-pipeline]:not([data-live])')) {
      root.dataset.live = '1';

      root.addEventListener('click', (ev) => {
        const step = (ev.target as HTMLElement).closest<HTMLElement>('[data-step]');
        if (!step) return;
        const active = step.toggleAttribute('data-active');
        step.setAttribute('aria-expanded', String(active));
        step.parentElement?.querySelector('[data-detail]')?.toggleAttribute('hidden', !active);
      });

      root.querySelector('[data-walk]')?.addEventListener('click', async () => {
        const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        for (const s of steps) {
          s.setAttribute('data-active', '1');
          s.parentElement?.querySelector('[data-detail]')?.removeAttribute('hidden');
          if (!reduced) await new Promise((r) => setTimeout(r, 180));
        }
        const result = root.querySelector('[data-result]');
        if (result && !reduced) {
          const { gsap } = await import('gsap');
          gsap.fromTo(
            result,
            { scale: 0.97, opacity: 0.6 },
            { scale: 1, opacity: 1, duration: 0.3, ease: 'back.out(2)' },
          );
        }
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
