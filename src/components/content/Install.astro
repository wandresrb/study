---
import Badge from '../ui/Badge.astro';

interface Props {
  repo: string;
  nota?: string;
  motivo?: string;
}

const { repo, nota, motivo } = Astro.props;

const hasLazy = Astro.slots.has('lazy');
const hasPack = Astro.slots.has('pack');
const both = hasLazy && hasPack;
const only = hasLazy ? 'lazy.nvim' : 'vim.pack';

const group = `ins-${repo.replace(/[^a-zA-Z0-9]/g, '-')}`;
---

<div class="d-card d-card-border instalar my-5 border-line bg-mantle">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface0 px-3 py-2">
    <span class="font-mono text-sm text-subtext0">{repo}</span>
    {
      !both && (
        <Badge variant="outline" color="var(--peach)">
          solo {only}
        </Badge>
      )
    }
  </div>

  {motivo && <p class="m-0 border-b border-line-soft bg-panel px-3 py-2 text-sm text-subtext1">{motivo}</p>}

  {
    both ? (
      <div class="d-tabs d-tabs-box m-3">
        <input class="d-tab" type="radio" name={group} aria-label="lazy.nvim" checked />
        <div class="d-tab-content">
          <slot name="lazy" />
        </div>

        <input class="d-tab" type="radio" name={group} aria-label="vim.pack" />
        <div class="d-tab-content">
          <slot name="pack" />
        </div>
      </div>
    ) : (
      <div class="px-3">
        <slot name="lazy" />
        <slot name="pack" />
      </div>
    )
  }

  {nota && <p class="m-0 border-t border-line-soft px-3 pt-2 pb-3 text-sm text-subtext0">{nota}</p>}
</div>
