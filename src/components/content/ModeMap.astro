---
// La máquina de estados de los modos, VIVA. Sustituye al stateDiagram de
// Mermaid: en vez de mirar el grafo, lo pulsas — con el foco puesto, cada
// tecla real (i, v, V, :, R, Esc, d…) ilumina la transición y mueve el estado.
//
// Es la familia «ModeMap»: bespoke a propósito. El mapa de modos es UNO en
// todo el curso; parametrizarlo sería generalizar lo que no varía.
interface Props {
  /** resalta un subconjunto (p. ej. solo Normal↔Insertar en lecciones tempranas) */
  destacar?: string[];
}
const { destacar } = Astro.props;

// disposición fija, pensada: Normal en el centro, lo frecuente cerca
const nodos = [
  { id: 'normal', n: 'NORMAL', x: 320, y: 170, w: 110, color: 'var(--mauve)' },
  { id: 'insert', n: 'INSERTAR', x: 320, y: 40, w: 110, color: 'var(--green)' },
  { id: 'visual', n: 'VISUAL', x: 90, y: 170, w: 100, color: 'var(--peach)' },
  { id: 'cmd', n: 'COMANDO', x: 320, y: 300, w: 110, color: 'var(--blue)' },
  { id: 'op', n: 'OPERADOR·PEND', x: 555, y: 170, w: 130, color: 'var(--yellow)' },
  { id: 'replace', n: 'REEMPLAZO', x: 90, y: 40, w: 110, color: 'var(--red)' },
] as const;

const aristas = [
  { de: 'normal', a: 'insert', t: 'i a o I A O', id: 'n-i' },
  { de: 'insert', a: 'normal', t: 'Esc', id: 'i-n' },
  { de: 'normal', a: 'visual', t: 'v V Ctrl-v', id: 'n-v' },
  { de: 'visual', a: 'normal', t: 'Esc', id: 'v-n' },
  { de: 'normal', a: 'cmd', t: ': / ?', id: 'n-c' },
  { de: 'cmd', a: 'normal', t: 'Enter · Esc', id: 'c-n' },
  { de: 'normal', a: 'op', t: 'd c y g', id: 'n-o' },
  { de: 'op', a: 'normal', t: 'moción · Esc', id: 'o-n' },
  { de: 'normal', a: 'replace', t: 'R', id: 'n-r' },
  { de: 'replace', a: 'normal', t: 'Esc', id: 'r-n' },
] as const;

const nodo = (id: string) => nodos.find((n) => n.id === id)!;
const atenuado = (id: string) => destacar && !destacar.includes(id);
---

<figure
  class="modemap not-prose group/mapa my-6 rounded-sm border border-borde bg-crust/60 p-3 outline-none
         transition-colors duration-(--dur-2) focus-within:border-mauve/60"
  data-modemap
  tabindex="0"
  aria-label="Mapa de modos interactivo: con el foco puesto, pulsa i, v, V, dos puntos, R, d o Escape para recorrerlo"
>
  <figcaption class="mb-1 flex items-baseline justify-between px-1">
    <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">los modos</span>
    <span class="font-mono text-2xs text-overlay0 transition-opacity duration-(--dur-1) group-focus-within/mapa:opacity-0">
      haz clic y pulsa <kbd class="text-subtext1">i</kbd> <kbd class="text-subtext1">v</kbd>
      <kbd class="text-subtext1">:</kbd> <kbd class="text-subtext1">d</kbd> <kbd class="text-subtext1">Esc</kbd>
    </span>
    <output data-ultima class="font-mono text-2xs text-peach opacity-0 transition-opacity duration-(--dur-1)"></output>
  </figcaption>

  <svg viewBox="0 0 660 350" class="block w-full" role="img">
    <defs>
      <marker id="punta" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--overlay0)"></path>
      </marker>
    </defs>

    {aristas.map((a) => {
      const d = nodo(a.de);
      const h = nodo(a.a);
      // curva leve para que ida y vuelta no se pisen
      const mx = (d.x + h.x) / 2 + (d.y === h.y ? 0 : d.x < h.x ? 0 : 0);
      const off = a.de === 'normal' ? -14 : 14;
      const perp = d.x === h.x ? `${d.x + off} ${(d.y + h.y) / 2}` : `${mx} ${(d.y + h.y) / 2 + off}`;
      return (
        <g data-arista={a.id} class={atenuado(a.de) || atenuado(a.a) ? 'opacity-25' : ''}>
          <path
            d={`M ${d.x} ${d.y} Q ${perp} ${h.x} ${h.y}`}
            fill="none"
            stroke="var(--overlay0)"
            stroke-width="1.25"
            marker-end="url(#punta)"
            class="transition-[stroke,stroke-width] duration-(--dur-2) [[data-viva]_&]:stroke-(--peach) [[data-viva]_&]:stroke-2"
          />
          <text
            x={d.x === h.x ? d.x + (a.de === 'normal' ? -20 : 20) : mx}
            y={d.x === h.x ? (d.y + h.y) / 2 : (d.y + h.y) / 2 + (a.de === 'normal' ? -20 : 26)}
            text-anchor="middle"
            class="fill-(--overlay1) font-mono text-[11px] transition-[fill] duration-(--dur-2) [[data-viva]_&]:fill-(--peach)"
          >
            {a.t}
          </text>
        </g>
      );
    })}

    {nodos.map((n) => (
      <g data-nodo={n.id} class={atenuado(n.id) ? 'opacity-25' : ''} style={`--c:${n.color}`}>
        <rect
          x={n.x - n.w / 2}
          y={n.y - 17}
          width={n.w}
          height={34}
          rx="4"
          fill="var(--mantle)"
          stroke="var(--border)"
          class="transition-[stroke,fill,filter] duration-(--dur-2)
                 [[data-actual]_&]:fill-(--c) [[data-actual]_&]:stroke-(--c)"
        />
        <text
          x={n.x}
          y={n.y + 4}
          text-anchor="middle"
          class="fill-(--subtext1) font-mono text-xs font-bold transition-[fill] duration-(--dur-2) [[data-actual]_&]:fill-(--crust)"
        >
          {n.n}
        </text>
      </g>
    ))}
  </svg>
</figure>

<script>
  // Máquina de estados real: (modo, tecla) → modo. Delegación idempotente.
  const TRANSICIONES: Record<string, Record<string, [string, string]>> = {
    normal: {
      i: ['insert', 'n-i'], a: ['insert', 'n-i'], o: ['insert', 'n-i'],
      I: ['insert', 'n-i'], A: ['insert', 'n-i'], O: ['insert', 'n-i'],
      v: ['visual', 'n-v'], V: ['visual', 'n-v'],
      ':': ['cmd', 'n-c'], '/': ['cmd', 'n-c'], '?': ['cmd', 'n-c'],
      d: ['op', 'n-o'], c: ['op', 'n-o'], y: ['op', 'n-o'], g: ['op', 'n-o'],
      R: ['replace', 'n-r'],
    },
    insert: { Escape: ['normal', 'i-n'] },
    visual: { Escape: ['normal', 'v-n'] },
    cmd: { Escape: ['normal', 'c-n'], Enter: ['normal', 'c-n'] },
    replace: { Escape: ['normal', 'r-n'] },
    op: { Escape: ['normal', 'o-n'], w: ['normal', 'o-n'], i: ['normal', 'o-n'], $: ['normal', 'o-n'] },
  };

  const arrancarComponente = () => {
    for (const mapa of document.querySelectorAll<HTMLElement>('[data-modemap]:not([data-vivo])')) {
      mapa.dataset.vivo = '1';
      let modo = 'normal';
      const salida = mapa.querySelector<HTMLElement>('[data-ultima]')!;
      const pintar = () => {
        mapa.querySelectorAll('[data-actual]').forEach((n) => n.removeAttribute('data-actual'));
        mapa.querySelector(`[data-nodo="${modo}"]`)?.setAttribute('data-actual', '1');
      };
      pintar();

      mapa.addEventListener('keydown', (ev) => {
        const salto = TRANSICIONES[modo]?.[ev.key];
        if (!salto) return;
        ev.preventDefault();
        const [siguiente, arista] = salto;
        modo = siguiente;
        salida.textContent = ev.key === 'Escape' ? 'Esc' : ev.key;
        salida.style.opacity = '1';
        pintar();
        mapa.querySelectorAll('[data-viva]').forEach((a) => a.removeAttribute('data-viva'));
        const viva = mapa.querySelector(`[data-arista="${arista}"]`);
        viva?.setAttribute('data-viva', '1');
        setTimeout(() => {
          viva?.removeAttribute('data-viva');
          salida.style.opacity = '0';
        }, 700);
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
