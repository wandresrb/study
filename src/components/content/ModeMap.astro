---
// La máquina de estados de los modos, VIVA. Sustituye al stateDiagram de
// Mermaid: en vez de mirar el grafo, lo pulsas — con el foco puesto, cada
// tecla real (i, v, V, :, R, Esc, d…) ilumina la transición y mueve el state.
//
// Es la familia «ModeMap»: bespoke a propósito. El mapa de modos es UNO en
// todo el curso; parametrizarlo sería generalizar lo que no varía.
interface Props {
  /** resalta un subconjunto (p. ej. solo Normal↔Insertar en lecciones tempranas) */
  highlight?: string[];
}
const { highlight } = Astro.props;

// disposición fija, pensada: Normal en el centro, lo frecuente cerca
const nodes = [
  { id: 'normal', n: 'NORMAL', x: 320, y: 170, w: 110, color: 'var(--mauve)' },
  { id: 'insert', n: 'INSERTAR', x: 320, y: 40, w: 110, color: 'var(--green)' },
  { id: 'visual', n: 'VISUAL', x: 90, y: 170, w: 100, color: 'var(--peach)' },
  { id: 'cmd', n: 'COMANDO', x: 320, y: 300, w: 110, color: 'var(--blue)' },
  { id: 'op', n: 'OPERADOR·PEND', x: 555, y: 170, w: 130, color: 'var(--yellow)' },
  { id: 'replace', n: 'REEMPLAZO', x: 90, y: 40, w: 110, color: 'var(--red)' },
] as const;

const edges = [
  { de: 'normal', a: 'insert', t: 'i a o I A O', id: 'n-i' },
  { de: 'insert', a: 'normal', t: 'Esc', id: 'i-n' },
  { de: 'normal', a: 'visual', t: 'v V Ctrl-v', id: 'n-v' },
  { de: 'visual', a: 'normal', t: 'Esc', id: 'v-n' },
  { de: 'normal', a: 'cmd', t: ': / ?', id: 'n-c' },
  { de: 'cmd', a: 'normal', t: 'Enter · Esc', id: 'c-n' },
  { de: 'normal', a: 'op', t: 'd c y g', id: 'n-o' },
  { de: 'op', a: 'normal', t: 'moción · Esc', id: 'o-n' },
  { de: 'normal', a: 'replace', t: 'R', id: 'n-r' },
  { de: 'replace', a: 'normal', t: 'Esc', id: 'r-n' },
] as const;

const node = (id: string) => nodes.find((n) => n.id === id)!;
const atenuado = (id: string) => highlight && !highlight.includes(id);

// Geometría honesta: cada edge sale del BORDE de su rectángulo y entra por
// el borde del destino, en un carril paralelo (+9/-9 sobre la perpendicular)
// para que ida y vuelta no se pisen. La etiqueta vive al lado de su carril.
function edge(a: (typeof edges)[number]) {
  const d = node(a.de);
  const h = node(a.a);
  const dx = h.x - d.x;
  const dy = h.y - d.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  // perpendicular; el carril de ida va a un lado y el de vuelta al otro
  const px = -uy;
  const py = ux;
  const off = 9;
  // distancia hasta salir del rectángulo (w×34) en la dirección de la edge
  const salida = (n: (typeof nodes)[number]) =>
    Math.min(
      Math.abs(ux) > 0.01 ? (n.w / 2 + 7) / Math.abs(ux) : Infinity,
      Math.abs(uy) > 0.01 ? 24 / Math.abs(uy) : Infinity,
    );
  const t0 = salida(d);
  const t1 = salida(h);
  const x1 = d.x + ux * t0 + px * off;
  const y1 = d.y + uy * t0 + py * off;
  const x2 = h.x - ux * t1 + px * off;
  const y2 = h.y - uy * t1 + py * off;
  // etiqueta: centrada en el carril, empujada hacia fuera
  const et = 15;
  const lx = (x1 + x2) / 2 + px * et;
  const ly = (y1 + y2) / 2 + py * et + 3;
  const anchor = px > 0.3 ? 'start' : px < -0.3 ? 'end' : 'middle';
  return { x1, y1, x2, y2, lx, ly, anchor };
}
---

<figure
  class="modemap not-prose group/mapa my-6 rounded-sm border border-line bg-crust/60 p-3 outline-none
         transition-colors duration-(--dur-2) focus-within:border-mauve/60"
  data-modemap
  tabindex="0"
  aria-label="Mapa de modos interactivo: con el foco puesto, pulsa i, v, V, dos puntos, R, d o Escape para recorrerlo"
>
  <figcaption class="mb-1 flex items-baseline justify-between px-1">
    <span class="font-mono text-2xs tracking-smallcaps text-overlay1 uppercase">los modos</span>
    <span class="font-mono text-2xs text-overlay0 transition-opacity duration-(--dur-1) group-focus-within/mapa:opacity-0">
      haz clic y pulsa <kbd class="text-subtext1">i</kbd> <kbd class="text-subtext1">v</kbd>
      <kbd class="text-subtext1">:</kbd> <kbd class="text-subtext1">d</kbd> <kbd class="text-subtext1">Esc</kbd>
    </span>
    <output data-last class="font-mono text-2xs text-peach opacity-0 transition-opacity duration-(--dur-1)"></output>
  </figcaption>

  <svg viewBox="0 0 660 350" class="block w-full" role="img">
    <defs>
      <marker id="punta" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--overlay0)"></path>
      </marker>
    </defs>

    {edges.map((a) => {
      const g = edge(a);
      return (
        <g data-edge={a.id} class={atenuado(a.de) || atenuado(a.a) ? 'opacity-25' : ''}>
          <line
            x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2}
            stroke="var(--overlay0)"
            stroke-width="1.25"
            marker-end="url(#punta)"
            class="transition-[stroke,stroke-width] duration-(--dur-2) [[data-lit]_&]:stroke-(--peach) [[data-lit]_&]:stroke-2"
          />
          <text
            x={g.lx} y={g.ly}
            text-anchor={g.anchor}
            class="fill-(--overlay1) font-mono text-[11px] transition-[fill] duration-(--dur-2) [[data-lit]_&]:fill-(--peach)"
          >
            {a.t}
          </text>
        </g>
      );
    })}

    {nodes.map((n) => (
      <g data-node={n.id} class={atenuado(n.id) ? 'opacity-25' : ''} style={`--c:${n.color}`}>
        <rect
          x={n.x - n.w / 2}
          y={n.y - 17}
          width={n.w}
          height={34}
          rx="4"
          fill="var(--mantle)"
          stroke="var(--line)"
          class="transition-[stroke,fill,filter] duration-(--dur-2)
                 [[data-current]_&]:fill-(--c) [[data-current]_&]:stroke-(--c)"
        />
        <text
          x={n.x}
          y={n.y + 4}
          text-anchor="middle"
          class="fill-(--subtext1) font-mono text-xs font-bold transition-[fill] duration-(--dur-2) [[data-current]_&]:fill-(--crust)"
        >
          {n.n}
        </text>
      </g>
    ))}
  </svg>
</figure>

<script>
  // Máquina de estados real: (mode, tecla) → mode. Delegación idempotente.
  const TRANSICIONES: Record<string, Record<string, [string, string]>> = {
    normal: {
      i: ['insert', 'n-i'], a: ['insert', 'n-i'], o: ['insert', 'n-i'],
      I: ['insert', 'n-i'], A: ['insert', 'n-i'], O: ['insert', 'n-i'],
      v: ['visual', 'n-v'], V: ['visual', 'n-v'],
      ':': ['cmd', 'n-c'], '/': ['cmd', 'n-c'], '?': ['cmd', 'n-c'],
      d: ['op', 'n-o'], c: ['op', 'n-o'], y: ['op', 'n-o'], g: ['op', 'n-o'],
      R: ['replace', 'n-r'],
    },
    insert: { Escape: ['normal', 'i-n'] },
    visual: { Escape: ['normal', 'v-n'] },
    cmd: { Escape: ['normal', 'c-n'], Enter: ['normal', 'c-n'] },
    replace: { Escape: ['normal', 'r-n'] },
    op: { Escape: ['normal', 'o-n'], w: ['normal', 'o-n'], i: ['normal', 'o-n'], $: ['normal', 'o-n'] },
  };

  const start = () => {
    for (const mapa of document.querySelectorAll<HTMLElement>('[data-modemap]:not([data-live])')) {
      mapa.dataset.live = '1';
      let mode = 'normal';
      const salida = mapa.querySelector<HTMLElement>('[data-last]')!;
      const paint = () => {
        mapa.querySelectorAll('[data-current]').forEach((n) => n.removeAttribute('data-current'));
        mapa.querySelector(`[data-node="${mode}"]`)?.setAttribute('data-current', '1');
      };
      paint();

      mapa.addEventListener('keydown', (ev) => {
        const salto = TRANSICIONES[mode]?.[ev.key];
        if (!salto) return;
        ev.preventDefault();
        const [siguiente, edge] = salto;
        mode = siguiente;
        salida.textContent = ev.key === 'Escape' ? 'Esc' : ev.key;
        salida.style.opacity = '1';
        paint();
        mapa.querySelectorAll('[data-lit]').forEach((a) => a.removeAttribute('data-lit'));
        const viva = mapa.querySelector(`[data-edge="${edge}"]`);
        viva?.setAttribute('data-lit', '1');
        setTimeout(() => {
          viva?.removeAttribute('data-lit');
          salida.style.opacity = '0';
        }, 700);
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
