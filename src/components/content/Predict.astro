---
// La cadencia Brilliant: predecir antes de ver. Una pregunta con opciones
// cuyos distractores son los errores reales, y feedback ESPECÍFICO del error
// elegido — nunca un «incorrecto» a secas.
//
//   <Predict pregunta="¿Qué borra dw con el cursor en la p de puerta?"
//     opciones={[
//       { t: "puerta y el espacio", ok: true,  x: "w es exclusiva: para antes de la r y arrastra el separador." },
//       { t: "puerta, sin el espacio",         x: "Eso sería de: e es inclusiva y respeta el espacio." },
//     ]} />
//
// El contenido del slot (opcional) se revela al acertar: úsalo para el
// «compruébalo» que conecta con el drill siguiente.
import Badge from '../ui/Badge.astro';

interface Opcion {
  /** texto de la opción */
  t: string;
  /** la correcta */
  ok?: boolean;
  /** feedback específico de ESTA opción */
  x: string;
}

interface Props {
  pregunta: string;
  opciones: Opcion[];
}

const { pregunta, opciones } = Astro.props;
---

<div class="predict my-6 rounded-sm border border-mauve/35 bg-mauve/5 p-4 not-prose" data-predict>
  <p class="m-0 mb-3 text-base text-text">
    <span class="mr-1.5"><Badge variant="soft" color="var(--mauve)">🔮 PREDICE</Badge></span>
    {pregunta}
  </p>

  <div class="grid gap-2">
    {
      opciones.map((op) => (
        <button
          type="button"
          data-opcion
          data-ok={op.ok ? '1' : undefined}
          class="group d-btn d-btn-block h-auto min-h-0 flex-wrap justify-start border-borde bg-crust/60 px-3 py-2
                 text-left font-normal normal-case transition-colors duration-(--dur-1)
                 hover:border-mauve/60 data-[elegida]:pointer-events-none
                 data-[elegida]:data-[ok]:border-green data-[elegida]:data-[ok]:bg-green/10
                 data-[elegida]:not-data-[ok]:border-red/70 data-[elegida]:not-data-[ok]:bg-red/10"
        >
          <span class="font-mono text-2xs text-overlay1 group-data-[elegida]:group-data-[ok]:text-green group-data-[elegida]:not-group-data-[ok]:text-red">
            ●
          </span>
          <span class="min-w-0 flex-1 basis-0 text-sm text-subtext1">{op.t}</span>
          <span data-porque hidden class="block w-full pl-5 pt-1 text-2xs text-subtext0">
            {op.x}
          </span>
        </button>
      ))
    }
  </div>

  <div data-despues hidden class="mt-3 border-t border-mauve/20 pt-3 text-sm text-subtext1 [&>p]:m-0">
    <slot />
  </div>
</div>

<script>
  // Idempotente y delegado: un solo listener para todos los Predict de la
  // página, registrado una vez aunque ClientRouter reuse el módulo.
  const YA = 'data-predict-activo';
  const arrancarComponente = () => {
    for (const raiz of document.querySelectorAll(`[data-predict]:not([${YA}])`)) {
      raiz.setAttribute(YA, '1');
      raiz.addEventListener('click', (ev) => {
        const boton = (ev.target as HTMLElement).closest<HTMLElement>('[data-opcion]');
        if (!boton || boton.dataset.elegida) return;
        boton.dataset.elegida = '1';
        boton.querySelector('[data-porque]')?.removeAttribute('hidden');
        if (boton.dataset.ok) {
          // acertó: se revelan todos los porqués y el «después»
          for (const b of raiz.querySelectorAll<HTMLElement>('[data-opcion]')) {
            b.dataset.elegida ||= '';
            b.style.pointerEvents = 'none';
          }
          raiz.querySelector('[data-despues]')?.removeAttribute('hidden');
        }
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
