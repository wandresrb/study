---
// The Brilliant cadence: predict before you see. A question whose distractors
// are the real mistakes, with feedback SPECIFIC to the option chosen — never a
// bare «wrong».
//
//   <Predict question="¿Qué borra dw con el cursor en la p de puerta?"
//     options={[
//       { t: "puerta y el espacio", ok: true,  x: "w es exclusiva: para antes de la r y arrastra el separador." },
//       { t: "puerta, sin el espacio",         x: "Eso sería de: e es inclusiva y respeta el espacio." },
//     ]} />
//
// The slot (optional) is revealed on a correct answer: use it for the
// «check it» that leads into the next exercise.
import Badge from '../ui/Badge.astro';

interface Option {
  /** the option text */
  t: string;
  /** the right one */
  ok?: boolean;
  /** feedback specific to THIS option */
  x: string;
}

interface Props {
  question: string;
  options: Option[];
}

const { question, options } = Astro.props;
---

<div class="predict my-6 rounded-sm border border-mauve/35 bg-mauve/5 p-4 not-prose" data-predict>
  <p class="m-0 mb-3 text-base text-text">
    <span class="mr-1.5"><Badge variant="soft" color="var(--mauve)">PREDICE</Badge></span>
    {question}
  </p>

  <div class="grid gap-2">
    {
      options.map((op) => (
        <button
          type="button"
          data-option
          data-ok={op.ok ? '1' : undefined}
          class="group d-btn d-btn-block h-auto min-h-0 flex-wrap justify-start border-borde bg-crust/60 px-3 py-2
                 text-left font-normal normal-case transition-colors duration-(--dur-1)
                 hover:border-mauve/60 data-[chosen]:pointer-events-none
                 data-[chosen]:data-[ok]:border-green data-[chosen]:data-[ok]:bg-green/10
                 data-[chosen]:not-data-[ok]:border-red/70 data-[chosen]:not-data-[ok]:bg-red/10"
        >
          <span class="font-mono text-2xs text-overlay1 group-data-[chosen]:group-data-[ok]:text-green group-data-[chosen]:not-group-data-[ok]:text-red">
            ●
          </span>
          <span class="min-w-0 flex-1 basis-0 text-sm text-subtext1">{op.t}</span>
          <span data-why hidden class="block w-full pl-5 pt-1 text-2xs text-subtext0">
            {op.x}
          </span>
        </button>
      ))
    }
  </div>

  <div data-after hidden class="mt-3 border-t border-mauve/20 pt-3 text-sm text-subtext1 [&>p]:m-0">
    <slot />
  </div>
</div>

<script>
  // Idempotent and delegated: one listener per Predict on the page, registered
  // once even though ClientRouter reuses the module.
  const DONE = 'data-predict-live';
  const start = () => {
    for (const root of document.querySelectorAll(`[data-predict]:not([${DONE}])`)) {
      root.setAttribute(DONE, '1');
      root.addEventListener('click', (ev) => {
        const button = (ev.target as HTMLElement).closest<HTMLElement>('[data-option]');
        if (!button || button.dataset.chosen) return;
        button.dataset.chosen = '1';
        button.querySelector('[data-why]')?.removeAttribute('hidden');
        if (button.dataset.ok) {
          // right: every reason and the «after» are revealed
          for (const b of root.querySelectorAll<HTMLElement>('[data-option]')) {
            b.dataset.chosen ||= '';
            b.style.pointerEvents = 'none';
          }
          root.querySelector('[data-after]')?.removeAttribute('hidden');
        }
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
