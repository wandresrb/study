---
// La anatomía de una frase de Vim: [conteo] [operador] [complemento], con
// ejemplos que se recorren y cada pieza explicada al tocarla. Sustituye al
// diagrama estático de la gramática: la fórmula ES el contenido.
//
// Familia «CommandAnatomy».
interface Ejemplo {
  /** las tres piezas: conteo (puede ser ''), operador, complemento */
  partes: [string, string, string];
  /** qué hace la frase completa */
  lee: string;
}
interface Props {
  ejemplos?: Ejemplo[];
}
const { ejemplos = [
  { partes: ['', 'd', 'w'], lee: 'borra hasta la palabra siguiente' },
  { partes: ['', 'c', 'i"'], lee: 'cambia el interior de las comillas' },
  { partes: ['2', 'd', 'ap'], lee: 'borra dos párrafos con su hueco' },
  { partes: ['', 'g~', 'iw'], lee: 'invierte mayúsculas de la palabra' },
  { partes: ['3', '>', 'j'], lee: 'indenta tres líneas hacia abajo' },
  { partes: ['', '!', 'ip'], lee: 'pasa el párrafo por un programa externo' },
] } = Astro.props;

const roles = [
  ['conteo', 'var(--sky)', 'multiplica: es opcional y se combina'],
  ['operador', 'var(--yellow)', 'el verbo: QUÉ hacer'],
  ['complemento', 'var(--green)', 'moción u objeto de texto: SOBRE QUÉ'],
] as const;
---

<figure class="commandanatomy not-prose my-6 rounded-sm border border-borde bg-crust/60 p-4" data-anatomia>
  <figcaption class="mb-3 flex items-baseline justify-between px-1">
    <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">la fórmula, desmontada</span>
    <button data-otro type="button" class="d-btn d-btn-xs d-btn-ghost font-mono text-2xs">↻ otro ejemplo</button>
  </figcaption>

  <div class="flex items-center justify-center gap-2 py-3 font-mono">
    {roles.map(([rol, color], i) => (
      <span
        data-pieza={i}
        title={roles[i][2]}
        class="grid min-w-16 place-items-center rounded-sm border-2 px-4 py-3 text-2xl transition-transform duration-(--dur-1) hover:-translate-y-0.5"
        style={`border-color:${color}; color:${color}; background: color-mix(in srgb, ${color} 8%, transparent)`}
      >
        <span data-valor>{ejemplos[0].partes[i] || '·'}</span>
        <span class="mt-1 text-2xs tracking-versalita uppercase opacity-70">{rol}</span>
      </span>
    ))}
    <span class="mx-1 text-2xl text-overlay0">=</span>
    <output data-lectura class="max-w-52 text-sm text-subtext1">{ejemplos[0].lee}</output>
  </div>

  <p class="m-0 px-1 text-center font-mono text-2xs text-overlay0">
    cualquier verbo × cualquier complemento: la tabla no se memoriza, se deduce
  </p>

  <script type="application/json" set:html={JSON.stringify(ejemplos)} />
</figure>

<script>
  const arrancarComponente = () => {
    for (const raiz of document.querySelectorAll<HTMLElement>('[data-anatomia]:not([data-vivo])')) {
      raiz.dataset.vivo = '1';
      const ejemplos = JSON.parse(raiz.querySelector('script')!.textContent!) as {
        partes: [string, string, string];
        lee: string;
      }[];
      let i = 0;
      const pintar = async () => {
        const e = ejemplos[i];
        raiz.querySelectorAll<HTMLElement>('[data-pieza]').forEach((p, j) => {
          p.querySelector('[data-valor]')!.textContent = e.partes[j] || '·';
        });
        raiz.querySelector('[data-lectura]')!.textContent = e.lee;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const { gsap } = await import('gsap');
          gsap.fromTo(
            raiz.querySelectorAll('[data-pieza], [data-lectura]'),
            { y: 4, opacity: 0.4 },
            { y: 0, opacity: 1, duration: 0.22, stagger: 0.05, ease: 'power2.out' },
          );
        }
      };
      raiz.querySelector('[data-otro]')?.addEventListener('click', () => {
        i = (i + 1) % ejemplos.length;
        void pintar();
      });
    }
  };
  if (document.readyState !== 'loading') arrancarComponente();
  else document.addEventListener('DOMContentLoaded', arrancarComponente, { once: true });
  document.addEventListener('astro:page-load', arrancarComponente);
</script>
