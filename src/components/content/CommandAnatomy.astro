---
// La anatomía de una frase de Vim: [conteo] [operador] [complemento], con
// examples you can step through, each piece explained on tap. Replaces the
// diagrama estático de la gramática: la fórmula ES el contenido.
//
// Familia «CommandAnatomy».
interface Ejemplo {
  /** las tres piezas: conteo (puede ser ''), operador, complemento */
  parts: [string, string, string];
  /** qué hace la frase completa */
  reads: string;
}
interface Props {
  examples?: Ejemplo[];
}
const { examples = [
  { parts: ['', 'd', 'w'], reads: 'borra hasta la palabra siguiente' },
  { parts: ['', 'c', 'i"'], reads: 'cambia el interior de las comillas' },
  { parts: ['2', 'd', 'ap'], reads: 'borra dos párrafos con su hueco' },
  { parts: ['', 'g~', 'iw'], reads: 'invierte mayúsculas de la palabra' },
  { parts: ['3', '>', 'j'], reads: 'indenta tres líneas hacia abajo' },
  { parts: ['', '!', 'ip'], reads: 'pasa el párrafo por un programa externo' },
] } = Astro.props;

const roles = [
  ['conteo', 'var(--sky)', 'multiplica: es opcional y se combina'],
  ['operador', 'var(--yellow)', 'el verbo: QUÉ hacer'],
  ['complemento', 'var(--green)', 'moción u objeto de texto: SOBRE QUÉ'],
] as const;
---

<figure class="commandanatomy not-prose my-6 rounded-sm border border-borde bg-crust/60 p-4" data-anatomy>
  <figcaption class="mb-3 flex items-baseline justify-between px-1">
    <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">la fórmula, desmontada</span>
    <button data-next type="button" class="d-btn d-btn-xs d-btn-ghost font-mono text-2xs">↻ otro ejemplo</button>
  </figcaption>

  <div class="flex flex-wrap items-center justify-center gap-2.5 py-3 font-mono">
    {roles.map(([rol, color], i) => (
      <span
        data-piece={i}
        title={roles[i][2]}
        class="grid min-w-28 place-items-center rounded-sm border-2 px-4 pt-3 pb-2 transition-transform duration-(--dur-1) hover:-translate-y-0.5"
        style={`border-color:${color}; color:${color}; background: color-mix(in srgb, ${color} 8%, transparent)`}
      >
        <span data-value class="text-2xl leading-none">{examples[0].parts[i] || '·'}</span>
        <span class="mt-2 text-[9px] tracking-[0.14em] whitespace-nowrap uppercase opacity-70">{rol}</span>
      </span>
    ))}
    <span class="flex items-center gap-2.5">
      <span class="text-2xl text-overlay0">=</span>
      <output data-reading class="max-w-56 text-sm leading-snug text-subtext1">{examples[0].reads}</output>
    </span>
  </div>

  <p class="m-0 px-1 text-center font-mono text-2xs text-overlay0">
    cualquier verbo × cualquier complemento: la tabla no se memoriza, se deduce
  </p>

  <script is:inline type="application/json" set:html={JSON.stringify(examples)} />
</figure>

<script>
  const start = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-anatomy]:not([data-live])')) {
      root.dataset.live = '1';
      const examples = JSON.parse(root.querySelector('script')!.textContent!) as {
        parts: [string, string, string];
        reads: string;
      }[];
      let i = 0;
      const paint = async () => {
        const e = examples[i];
        root.querySelectorAll<HTMLElement>('[data-piece]').forEach((p, j) => {
          p.querySelector('[data-value]')!.textContent = e.parts[j] || '·';
        });
        root.querySelector('[data-reading]')!.textContent = e.reads;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const { gsap } = await import('gsap');
          gsap.fromTo(
            root.querySelectorAll('[data-piece], [data-reading]'),
            { y: 4, opacity: 0.4 },
            { y: 0, opacity: 1, duration: 0.22, stagger: 0.05, ease: 'power2.out' },
          );
        }
      };
      root.querySelector('[data-next]')?.addEventListener('click', () => {
        i = (i + 1) % examples.length;
        void paint();
      });
    }
  };
  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
  document.addEventListener('astro:page-load', start);
</script>
