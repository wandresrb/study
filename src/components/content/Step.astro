---
interface Props {
  num?: string | number;
  title?: string;
}

const { num, title } = Astro.props;
---

<div class="paso grid grid-cols-[auto_1fr] items-start gap-4 border-b border-line-soft py-3.5 last:border-b-0">
  {
    num != null && (
      <span class="grid size-8 place-items-center rounded-sm bg-linear-to-br from-pink to-mauve font-mono text-base font-extrabold text-crust">
        {num}
      </span>
    )
  }

  <div class="min-w-0 [&>*+*]:mt-2">
    {title && <p class="m-0 font-bold text-text">{title}</p>}
    <slot />
  </div>
</div>
