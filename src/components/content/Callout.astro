---
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Info from '@lucide/astro/icons/info';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import OctagonAlert from '@lucide/astro/icons/octagon-alert';
import NotebookPen from '@lucide/astro/icons/notebook-pen';
import Crown from '@lucide/astro/icons/crown';

interface Props {
  type?: 'tip' | 'info' | 'warn' | 'danger' | 'note' | 'dios';
  title?: string;
}

const { type = 'info', title } = Astro.props;

// Lucide, not emoji: the self-hosted fonts carry no emoji, so a glyph here is
// tofu on Linux — and the icon should follow the theme like everything else.
const KIND = {
  tip: { icon: Lightbulb, label: 'Tip', cls: 'd-alert-success' },
  info: { icon: Info, label: 'Nota', cls: 'd-alert-info' },
  warn: { icon: TriangleAlert, label: 'Cuidado', cls: 'd-alert-warning' },
  danger: { icon: OctagonAlert, label: 'Importante', cls: 'd-alert-error' },
  note: { icon: NotebookPen, label: 'Apunte', cls: 'd-alert-info' },
  dios: { icon: Crown, label: 'Nivel Dios', cls: 'callout-dios' },
} as const;

const { icon: Icon, label, cls } = KIND[type] ?? KIND.info;
const t = title ?? label;
---
<div
  class:list={['d-alert d-alert-soft callout my-6 items-start gap-3 text-left', cls]}
  role="note"
>
  <Icon class="size-5 shrink-0 self-start" aria-hidden="true" />
  <div class="min-w-0">
    {t && <p class="m-0 font-bold text-text">{t}</p>}
    <div class="[&>*+*]:mt-2.5 [&_code]:text-[0.85em] [&_li]:text-md [&_p]:text-md"><slot /></div>
  </div>
</div>
