---
interface Props {
  type?: 'tip' | 'info' | 'warn' | 'danger' | 'note' | 'dios';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const TIPO = {
  tip: { icono: '💡', titulo: 'Tip', clase: 'd-alert-success' },
  info: { icono: 'ℹ️', titulo: 'Nota', clase: 'd-alert-info' },
  warn: { icono: '⚠️', titulo: 'Cuidado', clase: 'd-alert-warning' },
  danger: { icono: '🛑', titulo: 'Importante', clase: 'd-alert-error' },
  note: { icono: '📝', titulo: 'Apunte', clase: 'd-alert-info' },
  dios: { icono: '👑', titulo: 'Nivel Dios', clase: 'callout-dios' },
} as const;

const { icono, titulo, clase } = TIPO[type] ?? TIPO.info;
const t = title ?? titulo;
---
<div
  class:list={['d-alert d-alert-soft callout my-6 items-start gap-3 text-left', clase]}
  role="note"
>
  <span class="emoji shrink-0 self-start text-xl" aria-hidden="true">{icono}</span>
  <div class="min-w-0">
    {t && <p class="m-0 font-bold text-text">{t}</p>}
    <div class="[&>*+*]:mt-2.5 [&_code]:text-[0.85em] [&_li]:text-md [&_p]:text-md"><slot /></div>
  </div>
</div>
