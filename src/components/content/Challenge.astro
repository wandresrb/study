---
import Swords from '@lucide/astro/icons/swords';

interface Props {
  title?: string;
}

const { title = 'Reto práctico' } = Astro.props;
---
<div class="reto d-alert d-alert-soft d-alert-warning d-alert-vertical my-6 items-start gap-2 border-dashed text-left" role="note">
  <p class="m-0 flex items-center gap-2 text-sm font-bold tracking-smallcaps text-peach uppercase">
    <Swords class="size-4 shrink-0" aria-hidden="true" /> {title}
  </p>
  <div class="text-base text-subtext1 [&>*+*]:mt-2.5"><slot /></div>
</div>
