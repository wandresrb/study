---
interface Props {
  keys: string;
  sep?: string;
}

const { keys, sep = ' ' } = Astro.props;
const parts = keys.trim().split(/\s+/);
---

<span class="inline-flex items-baseline gap-1 align-baseline">
  {
    parts.map((p, i) => (
      <Fragment>
        {i > 0 && sep === '+' ? <span class="font-mono text-2xs text-subtext0">+</span> : null}
        <kbd class="d-kbd d-kbd-sm">{p}</kbd>
      </Fragment>
    ))
  }
</span>
