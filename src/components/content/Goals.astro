---
interface Props {
  title?: string;
}

const { title = 'Al terminar esta lección sabrás' } = Astro.props;
---
<div class="objetivos d-alert d-alert-soft d-alert-info d-alert-vertical mb-2 items-start gap-2.5 text-left" role="note">
  <p class="m-0 font-mono text-xs tracking-versalita text-blue uppercase">
    <span class="emoji" aria-hidden="true">🎯</span> {title}
  </p>
  <div class="**:[ul]:m-0 **:[ul]:grid **:[ul]:gap-2 **:[ul]:p-0 **:[li]:ml-4 **:[li]:text-base **:[li]:text-subtext1 **:[li]:marker:text-blue **:[li]:marker:content-['◆__']">
    <slot />
  </div>
</div>
