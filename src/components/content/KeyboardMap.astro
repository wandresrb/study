---
// Un teclado con las keys coloreadas por papel. Sustituye a las tablas de
// «qué tecla hace qué» y al Mermaid de zonas: se VE dónde viven los
// operadores, qué está libre y qué es intocable. Hover = detalle.
//
//   <KeyboardMap
//     title="el presupuesto de keys"
//     roles={{ operador: 'var(--yellow)', intocable: 'var(--red)' }}
//     keys={{ d: ['operador', 'delete'], h: ['intocable', 'izquierda'] }} />
interface Props {
  title?: string;
  /** rol → color (var(--...)) mostrado en la leyenda */
  roles: Record<string, string>;
  /** tecla → [rol, descripción para el hover] */
  keys: Record<string, [string, string]>;
}
const { title, roles, keys } = Astro.props;

const rows = [
  ['`', '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='],
  ['q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']'],
  ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', "'"],
  ['z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.', '/'],
];
// sangría de cada row, en unidades de tecla
const sangria = [0, 0.5, 0.75, 1.25];
const U = 44; // lado de una tecla en el viewBox
const ANCHO = 13.6 * U;
---

<figure class="keyboardmap not-prose my-6 rounded-sm border border-line bg-crust/60 p-3">
  {title && (
    <figcaption class="mb-2 px-1 font-mono text-2xs tracking-smallcaps text-overlay1 uppercase">
      {title}
    </figcaption>
  )}

  <svg viewBox={`0 0 ${ANCHO} ${4 * U + 12}`} class="block w-full" role="img" aria-label={title}>
    {rows.map((row, f) =>
      row.map((k, i) => {
        const info = keys[k];
        const color = info ? roles[info[0]] : undefined;
        const x = (sangria[f] + i) * U + 4;
        const y = f * U + 4;
        return (
          <g class="group">
            <rect
              x={x}
              y={y}
              width={U - 7}
              height={U - 7}
              rx="5"
              fill={color ? `color-mix(in srgb, ${color} 22%, var(--mantle))` : 'var(--mantle)'}
              stroke={color ?? 'var(--line)'}
              stroke-width={color ? 1.5 : 1}
              class="transition-transform duration-(--dur-1) group-hover:-translate-y-0.5"
            />
            <text
              x={x + (U - 7) / 2}
              y={y + (U - 7) / 2 + 5}
              text-anchor="middle"
              class="pointer-events-none font-mono text-[15px]"
              fill={color ?? 'var(--overlay1)'}
            >
              {k}
            </text>
            {info && <title>{`${k} — ${info[1]}`}</title>}
          </g>
        );
      }),
    )}
  </svg>

  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 px-1">
    {Object.entries(roles).map(([rol, color]) => (
      <span class="inline-flex items-center gap-1.5 font-mono text-2xs text-subtext0">
        <span class="size-2.5 rounded-xs border" style={`background:color-mix(in srgb, ${color} 22%, var(--mantle)); border-color:${color}`} />
        {rol}
      </span>
    ))}
  </div>
</figure>
