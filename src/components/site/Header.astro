---
import { getTracks, getCategories } from '../../data/content';
import Chip from '../ui/Chip.astro';
import Infinity from '@lucide/astro/icons/infinity';
import Palette from './Palette.tsx';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  variant?: 'normal' | 'floating';
  crumbs?: { text: string; href?: string }[];
  search?: boolean;
}

// `search` defaults to on: the palette also owns the ⌘K listener, so a header
// without it leaves the page with no way to open the search at all.
const { variant = 'normal', crumbs = [], search = true } = Astro.props;

const LINKS = [
  { href: '/cs/', text: 'Centro de Estudios' },
  { href: '/concepts/', text: 'Conceptos' },
  { href: '/about/', text: 'Sobre mí' },
];

const entries: [string, string, string][] = [
      ...getCategories().map((c) => [c.name, 'categoría', `/cs/#cat-${c.id}`] as [string, string, string]),
      ...getTracks()
        .filter((t) => t.status === 'written')
        .map((t) => [t.name, 'tema', `/${t.id}/`] as [string, string, string]),
    ]

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));

const base =
  variant === 'floating'
    ? 'pointer-events-none fixed inset-x-0 top-0 z-30'
    : '';
---
<header class={`${base} sticky top-0 z-30 border-b border-line bg-base/15 backdrop-blur-[10px] [&_a]:pointer-events-auto [&_button]:pointer-events-auto`}>
  <div class="mx-auto flex h-(--header-h) w-full max-w-site items-center gap-3 px-4 sm:gap-5 sm:px-10">
    <a
      class="inline-flex shrink-0 items-center gap-2.5 font-semibold tracking-snug text-text no-underline"
      href="/"
    >
      <Chip box="size-[1.9rem] rounded-lg [--ico:15] [--ico-hair:1.5]" from="var(--mauve)" to="var(--blue)">
        <Infinity class="ico" aria-hidden="true" />
      </Chip>
      <span>wandres.dev</span>
    </a>

    {
      crumbs.length > 0 && (
        <nav aria-label="Ruta" class="hidden min-w-0 items-center gap-2 font-mono text-sm md:flex">
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true" class="text-surface1">
                /
              </span>
              {c.href ? (
                <a class="truncate text-overlay1 no-underline hover:text-text" href={c.href}>
                  {c.text}
                </a>
              ) : (
                <span class="truncate text-subtext0">{c.text}</span>
              )}
            </>
          ))}
        </nav>
      )
    }
    <span class="flex-1"></span>

    <nav aria-label="Secciones" class="hidden items-center gap-1 sm:flex">
      {
        LINKS.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 font-mono text-sm text-subtext0 no-underline transition-colors hover:text-text aria-[current=page]:bg-surface0/60 aria-[current=page]:text-text"
          >
            {l.text}
          </a>
        ))
      }
    </nav>
    <slot name="actions" />
    {search && <Palette client:idle entries={entries} />}
    <ThemeSwitch />
  </div>
</header>
