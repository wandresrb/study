---
import Tile from '../ui/Tile.astro';
import { lessonsOf } from '../../data/content';
import type { Track } from '../../data/content';
import { iconoDe } from '../../lib/iconos';

interface Props {
  track: Track;
  color: string;
}

const { track, color } = Astro.props;
const Icon = iconoDe(track.id);

const lessons = lessonsOf(track.id);
const levels = new Set(lessons.map((l) => l.level)).size;
const hours = Math.round(lessons.reduce((a, l) => a + l.minutes, 0) / 60);
---
<Tile
  shape="compact"
  title={track.name}
  subtitle={track.subtitle}
  description={track.description}
  tags={[`${levels} niv`, `${lessons.length} lecc`, `${hours} h`]}
  color={color}
  logo={{ from: color }}
  href={`/${track.id}/`}
>
  <Fragment slot="glyph">
    <Icon class="ico" aria-hidden="true" />
  </Fragment>
</Tile>
