---
const SIZES = [
  ['0.95rem', 'Pequeño', 'text-2xs'],
  ['1.05rem', 'Normal', 'text-sm'],
  ['1.18rem', 'Grande', 'text-lg'],
  ['1.32rem', 'Enorme', 'text-xl'],
] as const;

const WIDTHS = [
  ['30rem', '55'],
  ['38rem', '70'],
  ['46rem', '85'],
  ['65rem', 'Todo'],
] as const;
---
<details class="d-dropdown d-dropdown-end reader-menu">
  <summary class="d-btn d-btn-sm font-mono" aria-label="Preferencias de lectura">Aa</summary>

  <div class="d-dropdown-content z-60 grid w-66 gap-3.5 rounded-lg border border-borde bg-mantle p-3.5 shadow-panel">
    <fieldset class="m-0 border-0 p-0">
      <legend class="p-0 pb-2 text-2xs tracking-versalita text-subtext0 uppercase">
        Tamaño
      </legend>
      <div class="d-join grid grid-flow-col" data-pref="size">
        {SIZES.map(([v, label, cls]) => (
          <button
            type="button"
            class:list={['d-btn d-btn-sm d-join-item', cls]}
            data-v={v}
            title={label}
          >A</button>
        ))}
      </div>
    </fieldset>

    <fieldset class="m-0 border-0 p-0">
      <legend class="p-0 pb-2 text-2xs tracking-versalita text-subtext0 uppercase">
        Ancho <span class="tracking-normal text-subtext0 normal-case">caracteres por línea</span>
      </legend>
      <div class="d-join grid grid-flow-col" data-pref="width">
        {WIDTHS.map(([v, label]) => (
          <button type="button" class="d-btn d-btn-sm d-join-item font-mono" data-v={v}>{label}</button>
        ))}
      </div>
    </fieldset>

    <p class="m-0 text-xs text-subtext0">
      La tipografía clásica pide entre 45 y 75 caracteres por línea.
    </p>
  </div>
</details>

<script>
  const PREFS = { size: '--reading-size', width: '--reading-width' } as const;
  type Pref = keyof typeof PREFS;

  const mark = () => {
    const root = document.documentElement;
    for (const pref of Object.keys(PREFS) as Pref[]) {
      // The computed one, not the inline: on a first visit the inline is empty
      // and nothing got marked.
      const current = getComputedStyle(root).getPropertyValue(PREFS[pref]).trim();
      document.querySelectorAll<HTMLButtonElement>(`[data-pref="${pref}"] button`).forEach((b) => {
        const active = b.dataset.v === current;
        b.setAttribute('aria-pressed', String(active));
        // Filled, not `d-btn-active`: on a dark palette that state is 5% black
        // over the resting 2%, and one of four options has to be unmistakable.
        b.classList.toggle('d-btn-primary', active);
      });
    }
  };

  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-pref] button');
    if (b?.dataset.v) {
      const pref = b.parentElement?.dataset.pref as Pref | undefined;
      if (pref) {
        document.documentElement.style.setProperty(PREFS[pref], b.dataset.v);
        try {
          localStorage.setItem(`reading:${pref}`, b.dataset.v);
        } catch {
        }
        mark();
      }
      return;
    }
    const menu = document.querySelector<HTMLDetailsElement>('.reader-menu[open]');
    if (menu && !menu.contains(e.target as Node)) menu.open = false;
  });

  document.addEventListener('astro:page-load', mark);
</script>
