---
import Shapes from '@lucide/astro/icons/shapes';

import type { Cheatsheet } from '../../data/content';
import { iconForEmoji } from '../../lib/card-icons';

interface Props {
  sheet: Cheatsheet;
}

const { placeholder, cats } = Astro.props.sheet;

// The seed stores an emoji per category; it never reaches the page (same deal
// as <Card>): it resolves to its Lucide glyph, or a neutral one.
const iconFor = (icon: string) => iconForEmoji(icon) ?? Shapes;
---

<div class="sticky top-0 z-5 mb-2 bg-linear-to-b from-base-100 from-70% to-transparent py-4">
  <input id="cheat-input" type="search" placeholder={placeholder} aria-label="Buscar" class="d-input w-full" />
  <div id="cheat-filters" class="d-filter mt-3 flex flex-wrap gap-2">
    <button type="button" class="d-btn d-btn-xs d-btn-active" data-cat="all">Todos</button>
    {
      cats.map((c) => {
        const Icon = iconFor(c.icon);
        return (
          <button type="button" class="d-btn d-btn-xs" data-cat={c.name}>
            <Icon class="size-3" aria-hidden="true" /> {c.name}
          </button>
        );
      })
    }
  </div>
</div>

<div id="cheat-body">
  {
    cats.map((c) => {
      const Icon = iconFor(c.icon);
      return (
        <section class="cheat-cat my-7" data-cat={c.name}>
          <h2 class="mb-3 flex items-center gap-2.5 text-base font-semibold text-mauve">
            <Icon class="size-4" aria-hidden="true" /> {c.name}
            <span class="d-badge d-badge-sm d-badge-neutral">{c.items.length}</span>
          </h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(19rem,100%),1fr))] gap-2">
            {c.items.map((it) => (
              <div
                class="cheat-row flex items-center justify-between gap-3 rounded-sm border border-line bg-panel px-3.5 py-2.5"
                data-text={`${it.keys} ${it.action}`.toLowerCase()}
              >
                <span class="text-md text-subtext1">{it.action}</span>
                <kbd class="d-kbd d-kbd-sm shrink-0 text-peach">{it.keys}</kbd>
              </div>
            ))}
          </div>
        </section>
      );
    })
  }
  <div id="cheat-empty" hidden class="p-15 text-center text-subtext0">Sin resultados. Prueba otra búsqueda.</div>
</div>

<script>
  import { fold } from '../../lib/fold';

  document.addEventListener('astro:page-load', () => {
    const input = document.getElementById('cheat-input') as HTMLInputElement | null;
    if (!input) return;
    const filters = document.getElementById('cheat-filters');
    const empty = document.getElementById('cheat-empty');
    let category = 'all';

    const apply = () => {
      const q = fold(input.value).trim();
      let any = false;
      document.querySelectorAll<HTMLElement>('.cheat-cat').forEach((sec) => {
        const catOk = category === 'all' || sec.dataset.cat === category;
        let rows = 0;
        sec.querySelectorAll<HTMLElement>('.cheat-row').forEach((row) => {
          const match = catOk && (!q || fold(row.dataset.text ?? '').includes(q));
          row.hidden = !match;
          if (match) rows++;
        });
        sec.hidden = !(catOk && rows > 0);
        if (catOk && rows > 0) any = true;
      });
      if (empty) empty.hidden = any;
    };

    input.addEventListener('input', apply);
    filters?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach((x) => x.classList.remove('d-btn-active'));
        b.classList.add('d-btn-active');
        category = b.dataset.cat ?? 'all';
        apply();
      });
    });
  });
</script>
