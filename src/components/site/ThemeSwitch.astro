---
import PaletteIcon from '@lucide/astro/icons/palette';
import { THEMES } from '../../lib/themes';
---
<details class="d-dropdown d-dropdown-end theme-menu">
  <summary
    class="inline-flex shrink-0 cursor-pointer list-none items-center rounded-full border border-line
           bg-crust/60 p-2 text-subtext0 transition-colors
           hover:border-surface1 hover:text-text [&::-webkit-details-marker]:hidden"
    aria-label="Cambiar tema"
    title="Cambiar tema"
  >
    <PaletteIcon class="size-4" aria-hidden="true" />
  </summary>

  <div
    role="menu"
    class="d-dropdown-content z-60 mt-2 grid w-44 gap-0.5 rounded-lg border border-line bg-mantle p-1.5 shadow-panel"
  >
    <p class="m-0 px-2 pt-0.5 pb-1.5 text-2xs tracking-smallcaps text-subtext0 uppercase">
      Tema
    </p>
    {
      THEMES.map(({ id, name }) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-set={id}
          class="group flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-left
                 text-sm text-subtext0 transition-colors hover:bg-surface0/70 hover:text-text
                 aria-[checked=true]:bg-surface0/70 aria-[checked=true]:text-text"
        >
          <span
            aria-hidden="true"
            class="size-1.5 shrink-0 rounded-full bg-mauve opacity-0 group-aria-[checked=true]:opacity-100"
          />
          {name}
        </button>
      ))
    }
  </div>
</details>

<script>
  import { DEFAULT_THEME, isTheme } from '../../lib/themes';

  const mark = () => {
    const now = document.documentElement.dataset.theme ?? DEFAULT_THEME;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeSet === now));
    });
  };

  // Delegated on document and registered once: the header is re-rendered on
  // every navigation, so rewiring per page would stack listeners.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-theme-set]');
    const theme = b?.dataset.themeSet;
    if (isTheme(theme)) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* private mode: the switch still applies for this page */
      }
      document.documentElement.dataset.theme = theme;
      mark();
      document.querySelector<HTMLDetailsElement>('.theme-menu[open]')?.removeAttribute('open');
      return;
    }
    const menu = document.querySelector<HTMLDetailsElement>('.theme-menu[open]');
    if (menu && !menu.contains(e.target as Node)) menu.open = false;
  });

  document.addEventListener('astro:page-load', mark);
</script>
