---
import { getTrack, getLevels, lessonsOf, hasCheatsheet } from '../../data/content';
import Chip from '../ui/Chip.astro';
import { iconOf } from '../../lib/icons';

interface Props {
  subject: string;
  current?: string;
}

const { subject, current } = Astro.props;
const track = getTrack(subject);

const all = lessonsOf(subject);
const byLevel = getLevels(subject)
  .map((level) => ({ level, items: all.filter((l) => l.level === level.idx) }))
  .filter((g) => g.items.length > 0);

const openLevel = current
  ? (all.find((l) => l.id === current)?.level ?? byLevel[0]?.level.idx)
  : byLevel[0]?.level.idx;

const Icon = iconOf(subject);

const refs = { ...track.ref, ...(hasCheatsheet(subject) ? { cheatsheet: `/${subject}/cheatsheet/` } : {}) };
---
<aside
  id="sidebar"
  data-track={subject}
  transition:persist={`nav-${subject}`}
  class="h-svh w-80 overflow-y-auto border-r border-borde bg-linear-to-b from-crust/60 to-mantle/20 px-4 pt-5 pb-15"
>
  <a href="/cs/" class="ml-2 font-mono text-xs text-overlay1 no-underline hover:text-text">
    ← Todos los temas
  </a>

  <a href={`/${subject}/`} class="mt-2 flex items-center gap-3 px-2 pb-4 no-underline">
    <Chip box="size-10 rounded-md [--ico:20] [--ico-hair:1.9]" from={track.gradFrom} to={track.gradTo}>
      <Icon class="ico" aria-hidden="true" />
    </Chip>
    <span class="leading-tight">
      <b class="block text-lg text-text tracking-ajustado">{track.name}</b>
      <span class="font-mono text-2xs tracking-versalita text-overlay1 uppercase">de cero a ∞</span>
    </span>
  </a>

  <input
    id="side-search"
    type="search"
    placeholder="Filtrar lecciones…"
    aria-label="Filtrar lecciones"
    class="d-input d-input-sm mb-4 w-full font-mono"
  />

  <ul class="w-full">
    {byLevel.map(({ level, items }) => (
      <li>
        <details class="group" data-level={level.idx} open={level.idx === openLevel}>
          <summary class="nav-row nav-level">
            <span class="sr-only">Nivel {level.idx}: </span>
            <span aria-hidden="true" class="nav-num nav-num-level">{level.idx}</span>
            <span class="nav-title-level">{level.name}</span>
          </summary>

          <ul data-links>
            {level.idx === openLevel &&
              items.map((it) => (
                <li>
                  <a
                    href={`/guide/${it.id}/`}
                    aria-current={it.id === current ? 'page' : undefined}
                    data-title={it.title.toLowerCase()}
                    class="nav-row nav-lesson"
                  >
                    <span aria-hidden="true" class="nav-num">{it.position}</span>
                    <span class="nav-title">{it.title}</span>
                    <span data-read-tick hidden class="text-green" aria-hidden="true">✓</span>
                  </a>
                </li>
              ))}
          </ul>
        </details>
      </li>
    ))}
  </ul>

  <template id="nav-item">
    <li>
      <a class="nav-row nav-lesson">
        <span aria-hidden="true" class="nav-num"></span>
        <span class="nav-title"></span>
        <span data-read-tick hidden class="text-green" aria-hidden="true">✓</span>
      </a>
    </li>
  </template>

  <div class="mt-6 border-t border-borde px-3 pt-4 font-mono text-xs text-overlay1">
    {refs.cheatsheet && <a href={refs.cheatsheet} class="text-overlay2"><span aria-hidden="true">⌘</span> Cheatsheet</a>}
    {refs.config && <Fragment> · <a href={refs.config} class="text-overlay2">init.lua</a></Fragment>}
    {refs.resources && <Fragment><br /><a href={refs.resources} class="text-overlay2"><span class="emoji" aria-hidden="true">📚</span> Recursos</a></Fragment>}
  </div>
</aside>

<script>
  import { fold } from '../../lib/fold';
  import { lessonIdOf, onChange, readSet } from '../../lib/learner';

  interface LessonLink { u: string; t: string; n: string }
  interface LevelIndex { id: number; items: LessonLink[] }

  let read = new Set<string>();

  const applyTicks = () => {
    document.querySelectorAll<HTMLAnchorElement>('#sidebar [data-links] a').forEach((a) => {
      const tick = a.querySelector<HTMLElement>('[data-read-tick]');
      if (tick) tick.hidden = !read.has(lessonIdOf(a.href));
    });
  };

  const refreshTicks = async () => {
    read = await readSet();
    applyTicks();
  };

  onChange(() => void refreshTicks());

  const indexes = new Map<string, Promise<LevelIndex[]>>();

  const indexOf = (track: string) => {
    let p = indexes.get(track);
    if (!p) {
      p = fetch(`/nav/${track}.json`)
        .then((r) => (r.ok ? r.json() : []))
        .catch(() => [] as LevelIndex[]);
      indexes.set(track, p);
    }
    return p;
  };

  const here = () => location.pathname.replace(/\/$/, '');

  const fill = async (group: HTMLDetailsElement) => {
    const ul = group.querySelector('[data-links]');
    if (!ul || ul.children.length) return;
    const track = group.closest<HTMLElement>('#sidebar')?.dataset.track;
    const level = Number(group.dataset.level);
    if (!track) return;

    const items = (await indexOf(track)).find((n) => n.id === level)?.items ?? [];
    if (!items.length) return;

    const template = document.getElementById('nav-item') as HTMLTemplateElement | null;
    if (!template) return;

    const fragment = document.createDocumentFragment();
    for (const it of items) {
      const row = template.content.cloneNode(true) as DocumentFragment;
      const a = row.querySelector('a')!;
      const [num, title] = row.querySelectorAll('span');
      a.href = it.u;
      a.dataset.title = it.t.toLowerCase();
      if (it.u.replace(/\/$/, '') === here()) a.setAttribute('aria-current', 'page');
      num.textContent = it.n;
      title.textContent = it.t;
      fragment.append(row);
    }
    ul.append(fragment);
    applyTicks();
  };

  document.addEventListener(
    'toggle',
    (e) => {
      const g = e.target as HTMLElement | null;
      if (g instanceof HTMLDetailsElement && g.dataset.level !== undefined && g.open) {
        void fill(g);
      }
    },
    true,
  );

  document.addEventListener('input', async (e) => {
    const t = e.target as HTMLElement | null;
    if (!(t instanceof HTMLInputElement) || t.id !== 'side-search') return;
    const q = fold(t.value).trim();

    if (q) {
      await Promise.all(
        Array.from(document.querySelectorAll<HTMLDetailsElement>('#sidebar [data-level]')).map(fill),
      );
    }

    document.querySelectorAll<HTMLDetailsElement>('#sidebar [data-level]').forEach((g) => {
      let visible = 0;
      g.querySelectorAll<HTMLElement>('[data-links] li').forEach((li) => {
        const title = fold(li.querySelector('a')?.getAttribute('data-title') ?? '');
        const ok = !q || title.includes(q);
        li.hidden = !ok;
        if (ok) visible++;
      });
      const box = g.closest('li');
      if (box) box.hidden = !!q && !visible;
      if (q) g.open = visible > 0;
    });
  });

  let sidebarScroll = 0;
  document.addEventListener('astro:before-swap', () => {
    sidebarScroll = document.getElementById('sidebar')?.scrollTop ?? 0;
  });
  document.addEventListener('astro:after-swap', () => {
    const sb = document.getElementById('sidebar');
    if (sb) sb.scrollTop = sidebarScroll;
  });

  document.addEventListener('astro:page-load', async () => {
    void refreshTicks();

    const menu = document.getElementById('menu') as HTMLInputElement | null;
    if (menu) menu.checked = false;

    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    const track = sidebar.dataset.track;
    if (!track) return;

    const level = (await indexOf(track)).find((n) =>
      n.items.some((it) => it.u.replace(/\/$/, '') === here()),
    );
    const group = level && sidebar.querySelector<HTMLDetailsElement>(`[data-level="${level.id}"]`);
    if (group) {
      group.open = true;
      await fill(group);
    }

    sidebar.querySelectorAll<HTMLAnchorElement>('[data-links] a').forEach((a) => {
      if (new URL(a.href).pathname.replace(/\/$/, '') === here()) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  });
</script>
