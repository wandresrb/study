---
import Chip from '../ui/Chip.astro';
import Infinity from '@lucide/astro/icons/infinity';

const LINKS = [
  { href: '/cs/', text: 'Centro de Estudios' },
  { href: '/concepts/', text: 'Conceptos' },
  { href: '/resources/', text: 'Recursos' },
  { href: '/config/', text: 'Mi configuración' },
  { href: '/about/', text: 'Sobre mí' },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto w-full max-w-site px-4 sm:px-10 flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <a class="inline-flex items-center gap-2.5 font-semibold text-text no-underline" href="/">
        <Chip box="size-[1.6rem] rounded-md ico-sm" from="var(--mauve)" to="var(--blue)">
          <Infinity class="ico" aria-hidden="true" />
        </Chip>
        <span>wandres.dev</span>
      </a>
      <p class="mt-2 max-w-short text-sm text-subtext0">
        Un centro de estudios de ciencias de la computación: de los fundamentos a saber aplicarlos.
      </p>
    </div>

    <nav aria-label="Pie" class="flex flex-col gap-2 sm:items-end">
      {
        LINKS.map((e) => (
          <a
            href={e.href}
            class="inline-flex min-h-6 items-center text-sm text-subtext0 no-underline transition-colors hover:text-text"
          >
            {e.text}
          </a>
        ))
      }
    </nav>
  </div>

  <p class="mx-auto w-full max-w-site px-4 sm:px-10 m-0 pb-8 text-xs text-subtext0">© {year} wandres.dev</p>
</footer>
