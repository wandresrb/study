---
import type { Beat } from '../../home/journey/types';
import BeatSection from './Beat.astro';
import Gate from './figures/Gate.astro';
import Probe from './figures/Probe.astro';

interface Props {
  beats: Beat[];
  from: number;
}

const { beats, from } = Astro.props;
---

{/* The machine sticks while its beats scroll over it: one scene, two stations. */}
<div data-board-block class="relative">
  <div class="pointer-events-none sticky top-0 h-svh">
    <div
      data-scene="hardware"
      aria-hidden="true"
      class="absolute inset-0 opacity-0 transition-opacity duration-[900ms] ease-soft"
    >
    </div>

    {/* the scrim keeps the beat text readable over the busiest frames */}
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 h-2/3 bg-linear-to-b from-base-100/85 via-base-100/35 to-transparent"
    >
    </div>

    {
      beats.map((b) =>
        b.figure.kind === 'board' && b.figure.pins ? (
          <div data-pins-for={b.id} hidden class="absolute inset-0 text-2xs">
            {b.figure.pins.map((p) => (
              <span
                data-pin
                class:list={[
                  'absolute flex items-center gap-2 whitespace-nowrap text-text',
                  p.from === 'left' ? 'flex-row-reverse' : '',
                ]}
                style={p.from === 'left' ? `right:${100 - p.x}%;top:${p.y}%` : `left:${p.x}%;top:${p.y}%`}
              >
                <span class="h-px w-10 bg-text/35" />
                <span class="text-green">+</span>
                <span>{p.label}</span>
              </span>
            ))}
          </div>
        ) : null,
      )
    }

    {/* the instrument for this station, docked clear of the four corners */}
    {
      beats.map((b) =>
        b.figure.kind === 'board' && b.figure.panel ? (
          <div
            data-panel-for={b.id}
            hidden
            class="absolute top-1/2 right-4 -translate-y-1/2 sm:right-8 max-md:top-auto max-md:bottom-24 max-md:translate-y-0"
          >
            {b.figure.panel === 'probe' && <Probe />}
            {b.figure.panel === 'gate' && <Gate />}
          </div>
        ) : null,
      )
    }
  </div>

  <div class="relative -mt-[100svh]">
    {beats.map((b, i) => <BeatSection beat={b} index={from + i} />)}
  </div>
</div>
