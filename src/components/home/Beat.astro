---
import type { Beat } from '../../home/journey/types';
import { LAYERS } from '../../home/journey/layers';

interface Props {
  beat: Beat;
  index: number;
}

const { beat, index } = Astro.props;
const layer = LAYERS.find((l) => l.id === beat.layer);
const board = beat.figure.kind === 'board';
const number = String(index).padStart(2, '0');
// The closing map is the one figure that takes the whole width.
const wide = beat.figure.kind === 'graph';
---

<section
  data-beat={beat.id}
  data-index={index}
  data-layer={beat.layer}
  data-layer-title={layer?.title}
  data-kind={beat.figure.kind}
  data-hint={beat.hint}
  data-pushes={beat.pushes ? '' : undefined}
  class:list={['relative', board ? 'min-h-[200svh]' : 'grid min-h-svh content-center']}
>
  <div
    class:list={[
      'mx-auto w-full max-w-site px-4 sm:px-10',
      board
        ? 'sticky top-0 grid h-svh content-start pt-[calc(var(--header-h)+5.5rem)]'
        : 'pt-[calc(var(--header-h)+4rem)] pb-28',
    ]}
  >
    <header class="max-w-medida">
      <p class="m-0 text-2xs tracking-smallcaps text-subtext0 uppercase">
        {number} · {beat.kicker}
      </p>
      <h2 class="mt-1.5 text-2xl font-extrabold tracking-headline text-balance sm:text-3xl">
        {beat.title}
      </h2>
      <p class="mt-2.5 text-md text-subtext0 text-pretty">{beat.lede}</p>
    </header>

    {
      !board && (
        <div class="mt-7 -mx-4 grid place-items-center overflow-x-auto px-4 sm:mx-0 sm:px-0">
          <div
            class:list={[
              'w-full [&>svg]:mx-auto [&>svg]:max-h-[62svh] [&>svg]:w-full',
              wide ? '' : 'max-w-[82rem] max-sm:w-[42rem]',
            ]}
          >
            <slot />
          </div>
        </div>
      )
    }
  </div>
</section>
