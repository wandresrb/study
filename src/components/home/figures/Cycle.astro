---
import type { CycleFigure } from '../../../home/journey/types';
import { inkOf, VIEW } from '../../../home/journey/tones';

interface Props {
  spec: CycleFigure;
}

const { spec } = Astro.props;

const CX = VIEW.w / 2;
const CY = 275;
const R = 178;
const ARC = 104;
const BOX = { w: 196, h: 66 };

const n = spec.steps.length;
const angleOf = (i: number) => (-90 + (i * 360) / n) * (Math.PI / 180);
const pointOf = (i: number, r: number) => ({
  x: CX + Math.cos(angleOf(i)) * r,
  y: CY + Math.sin(angleOf(i)) * r,
});

const steps = spec.steps.map((s, i) => {
  const c = pointOf(i, R);
  const from = pointOf(i, ARC);
  const to = pointOf((i + 1) % n, ARC);
  const tangent = (angleOf((i + 1) % n) * 180) / Math.PI + 90;
  return { ...s, c, arc: `M ${from.x} ${from.y} A ${ARC} ${ARC} 0 0 1 ${to.x} ${to.y}`, to, tangent };
});
---

<svg
  data-fig
  data-kind="cycle"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label={`${spec.center}: ${spec.steps.map((s) => s.label).join(' → ')}`}
>
  <circle
    cx={CX}
    cy={CY}
    r={ARC}
    fill="none"
    stroke="currentColor"
    stroke-opacity="0.14"
    stroke-dasharray="4 6"
    class="text-subtext0"></circle>

  <g class="text-mauve">
    <text x={CX} y={CY - 2} font-size="19" text-anchor="middle" fill="currentColor">{spec.center}</text>
    {
      spec.centerSub && (
        <text x={CX} y={CY + 20} font-size="11.5" text-anchor="middle" fill="currentColor" fill-opacity="0.6">
          {spec.centerSub}
        </text>
      )
    }
  </g>

  {
    steps.map((s) => (
      <g class="text-subtext0">
        <path data-edge d={s.arc} fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
        <polygon
          data-arrow
          points="0,-4 9,0 0,4"
          fill="currentColor"
          fill-opacity="0.6"
          transform={`translate(${s.to.x} ${s.to.y}) rotate(${s.tangent})`}
        />
      </g>
    ))
  }

  {
    steps.map((s) => (
      <g data-node data-step class={inkOf(s.tone, 'ink')}>
        <rect
          x={s.c.x - BOX.w / 2}
          y={s.c.y - BOX.h / 2}
          width={BOX.w}
          height={BOX.h}
          rx="8"
          fill="currentColor"
          fill-opacity="0.1"
          stroke="currentColor"
          stroke-opacity="0.55"
        />
        <text x={s.c.x} y={s.c.y - 2} font-size="17" text-anchor="middle" fill="currentColor">
          {s.label}
        </text>
        {s.sub && (
          <text x={s.c.x} y={s.c.y + 18} font-size="11.5" text-anchor="middle" fill="currentColor" fill-opacity="0.6">
            {s.sub}
          </text>
        )}
      </g>
    ))
  }
</svg>
