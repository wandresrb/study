---
import { VIEW } from '../../../home/journey/tones';

/**
 * What a clock is *for*: capture. D changes whenever it likes; the flip-flop
 * only looks on the rising edge, and Q holds that value until the next one.
 * Drawn as a logic analyser — crisp, no phosphor — so it cannot be mistaken
 * for the oscilloscope two stations earlier.
 */
const CYCLES = 6;
const X0 = 300;
const P = 108;
const edgeX = (i: number) => X0 + i * P;

const lane = { clk: 168, d: 292, q: 408 };
const HI = 30;

const clk = Array.from({ length: CYCLES + 1 }, (_, i) => {
  const a = edgeX(i);
  return `${i === 0 ? `M ${a - 34} ${lane.clk + HI} L ${a} ${lane.clk + HI}` : ''} L ${a} ${lane.clk} L ${a + P / 2} ${lane.clk} L ${a + P / 2} ${lane.clk + HI} L ${a + P} ${lane.clk + HI}`;
}).join(' ');

// D moves whenever the world moves — including a glitch nobody will ever see.
const D_STEPS: [number, number][] = [
  [0, 0],
  [0.42, 1],
  [1.2, 0],
  [1.75, 1],
  [3.35, 0],
  [4.15, 1],
  [5.4, 0],
];
const valueAt = (t: number) => {
  let v = 0;
  for (const [at, value] of D_STEPS) if (t >= at) v = value;
  return v;
};

const wave = (steps: [number, number][], y: number) => {
  let d = `M ${edgeX(0) - 34} ${y + (steps[0][1] ? 0 : HI)}`;
  let prev = steps[0][1];
  for (const [t, v] of steps.slice(1)) {
    const x = edgeX(t);
    d += ` L ${x} ${y + (prev ? 0 : HI)} L ${x} ${y + (v ? 0 : HI)}`;
    prev = v;
  }
  d += ` L ${edgeX(CYCLES) + 34} ${y + (prev ? 0 : HI)}`;
  return d;
};

// Q only ever changes just after an edge: it is the sampled value, held.
const qSteps: [number, number][] = [[0, valueAt(0)]];
for (let i = 1; i <= CYCLES; i++) qSteps.push([i, valueAt(i)]);

const samples = Array.from({ length: CYCLES + 1 }, (_, i) => ({ i, x: edgeX(i), v: valueAt(i) }));
---

<svg
  data-fig
  data-kind="timing"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label="La celda copia el dato en el flanco de reloj y lo mantiene hasta el siguiente"
>
  {/* the flip-flop: the smallest piece of memory there is */}
  <g class="text-mauve">
    <rect
      x="66"
      y="230"
      width="150"
      height="150"
      rx="6"
      fill="url(#grad-plate)"
      stroke="currentColor"
      stroke-opacity="0.6"
      filter="url(#fx-inner)"></rect>
    <text x="141" y="288" font-size="15" text-anchor="middle" fill="currentColor">1 bit</text>
    <text x="141" y="306" font-size="12" text-anchor="middle" fill="currentColor" fill-opacity="0.85">de memoria</text>
    <text x="84" y="266" font-size="13" fill="currentColor" fill-opacity="0.8">D</text>
    <text x="198" y="266" font-size="13" text-anchor="end" fill="currentColor" fill-opacity="0.8">Q</text>
    {/* the wedge that says «only on the edge» */}
    <path d="M 66 336 L 84 346 L 66 356" fill="none" stroke="currentColor" stroke-width="1.8"></path>
    <text x="96" y="351" font-size="11" fill="currentColor" fill-opacity="0.6">clk</text>
  </g>

  <g class="text-subtext0">
    <path
      d="M 40 262 H 66 M 216 262 H 262 M 40 346 H 66"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-opacity="0.4"
      fill="none"></path>
  </g>

  {/* every rising edge, and the window where D must hold still */}
  {
    samples.map((s) => (
      <g>
        <line
          data-edge-tick
          x1={s.x}
          y1="140"
          x2={s.x}
          y2="452"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="3 6"
          stroke-opacity="0.45"
          class="text-teal"
        />
        <rect
          data-window
          x={s.x - 16}
          y={lane.d - 12}
          width="28"
          height={HI + 24}
          rx="3"
          fill="currentColor"
          fill-opacity="0.1"
          stroke="currentColor"
          stroke-opacity="0.35"
          stroke-dasharray="2 3"
          class="text-peach"
        />
      </g>
    ))
  }

  <text x="262" y={lane.clk + 12} font-size="13" text-anchor="end" class="text-teal" fill="currentColor"
    >clk</text
  >
  <path data-wave data-draw d={clk} fill="none" stroke="currentColor" stroke-width="1.8" class="text-teal"></path>

  <text x="262" y={lane.d + 12} font-size="13" text-anchor="end" class="text-blue" fill="currentColor">D</text
  >
  <path
    data-wave
    data-draw
    d={wave(D_STEPS, lane.d)}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    class="text-blue"></path>

  <text x="262" y={lane.q + 12} font-size="13" text-anchor="end" class="text-green" fill="currentColor"
    >Q</text
  >
  <path
    data-wave
    data-draw
    d={wave(qSteps, lane.q)}
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    class="text-green"></path>

  {/* what the flip-flop actually took, edge by edge */}
  {
    samples.map((s) => (
      <g data-capture={s.i} class={s.v ? 'text-green' : 'text-subtext0'}>
        <circle cx={s.x} cy={lane.d + (s.v ? 0 : HI)} r="4.5" fill="currentColor" />
        <line
          x1={s.x}
          y1={lane.d + (s.v ? 0 : HI)}
          x2={s.x}
          y2={lane.q + (s.v ? 0 : HI)}
          stroke="currentColor"
          stroke-width="1.4"
          stroke-dasharray="2 4"
          stroke-opacity="0.7"
        />
        <circle cx={s.x} cy={lane.q + (s.v ? 0 : HI)} r="4.5" fill="currentColor" />
      </g>
    ))
  }

  <text
    x={edgeX(1.5)}
    y="120"
    font-size="11.5"
    text-anchor="middle"
    class="text-peach"
    fill="currentColor"
    fill-opacity="0.8"
  >
    ventana de setup y hold
  </text>

  <g class="text-red">
    <text x={edgeX(1.45)} y={lane.d - 24} font-size="11.5" text-anchor="middle" fill="currentColor" fill-opacity="0.9">
      D cambió aquí y volvió: nadie se enteró
    </text>
  </g>

  <text
    x={VIEW.w / 2}
    y="514"
    font-size="12"
    text-anchor="middle"
    class="text-subtext0"
    fill="currentColor"
    fill-opacity="0.75"
  >
    en cada flanco, Q copia lo que valga D — y lo sostiene hasta el flanco siguiente
  </text>
</svg>
