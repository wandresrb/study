---
import { VIEW } from '../../../home/journey/tones';

/**
 * One real instruction going round the loop: `add x1, x2, x3` encoded as an
 * actual RISC-V R-type word, split into its actual fields, feeding the actual
 * register file and ALU. Not four boxes in a ring.
 */
const WORD = [
  { bits: '0000000', name: 'funct7', span: 7, tone: 'text-subtext0' },
  { bits: '00011', name: 'rs2 · x3', span: 5, tone: 'text-blue' },
  { bits: '00010', name: 'rs1 · x2', span: 5, tone: 'text-blue' },
  { bits: '000', name: 'funct3', span: 3, tone: 'text-subtext0' },
  { bits: '00001', name: 'rd · x1', span: 5, tone: 'text-green' },
  { bits: '0110011', name: 'opcode · OP', span: 7, tone: 'text-mauve' },
];

const IR = { x: 250, y: 126, w: 710, h: 46 };
let cursor = IR.x;
const fields = WORD.map((f) => {
  const w = (f.span / 32) * IR.w;
  const seg = { ...f, x: cursor, w };
  cursor += w;
  return seg;
});

const MEM = [
  { addr: '0x400014', code: 'lw   x2, 0(x5)' },
  { addr: '0x400018', code: 'add  x1, x2, x3', live: true },
  { addr: '0x40001c', code: 'sw   x1, 4(x5)' },
  { addr: '0x400020', code: 'jal  x0, loop' },
];

const REGS = [
  { name: 'x1', value: '0x0000', tone: 'text-green' },
  { name: 'x2', value: '0x002A', tone: 'text-blue' },
  { name: 'x3', value: '0x0007', tone: 'text-blue' },
];

const ALU = 'M 634 268 L 754 300 L 754 372 L 634 404 L 634 350 L 650 336 L 634 322 Z';
---

<svg
  data-fig
  data-kind="datapath"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label="El camino de datos: buscar la instrucción, decodificar sus campos, operar en la ALU y escribir el resultado"
>
  {/* ── 1 · the program counter says where to look ───────────────────────── */}
  <g data-stage="fetch" class="text-peach">
    <rect
      x="40"
      y="126"
      width="168"
      height="46"
      rx="6"
      fill="url(#grad-plate)"
      stroke="currentColor"
      stroke-opacity="0.6"
      filter="url(#fx-inner)"></rect>
    <text x="56" y="155" font-size="12" fill="currentColor" fill-opacity="0.7">PC</text>
    <text x="192" y="155" font-size="13" text-anchor="end" fill="currentColor">0x400018</text>
    <text x="40" y="112" font-size="10.5" letter-spacing="1.6" fill="currentColor" fill-opacity="0.6">1 · BUSCAR</text>
  </g>

  {/* memory: the instruction lives at that address, next to its neighbours */}
  <g class="text-subtext0">
    <rect
      x="40"
      y="196"
      width="168"
      height={MEM.length * 40 + 12}
      rx="6"
      fill="currentColor"
      fill-opacity="0.04"
      stroke="currentColor"
      stroke-opacity="0.28"></rect>
    {
      MEM.map((m, i) => (
        <g data-mem-row={m.live ? 'live' : undefined} class={m.live ? 'text-peach' : 'text-subtext0'}>
          {m.live && (
            <rect x="46" y={202 + i * 40} width="156" height="34" rx="4" fill="currentColor" fill-opacity="0.14" />
          )}
          <text x="56" y={224 + i * 40} font-size="10.5" fill="currentColor" fill-opacity="0.55">
            {m.addr}
          </text>
          <text x="56" y={238 + i * 40} font-size="11.5" fill="currentColor" fill-opacity={m.live ? 1 : 0.7}>
            {m.code}
          </text>
        </g>
      ))
    }
  </g>

  <path
    data-bus
    d="M 208 149 H 232 V 232 H 208"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-opacity="0.4"
    class="text-peach"></path>
  <path
    data-bus
    d="M 208 219 H 240 V 149 H 250"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-opacity="0.7"
    class="text-peach"></path>

  {/* ── 2 · the word, split into the fields the hardware really reads ────── */}
  <text
    x={IR.x}
    y="112"
    font-size="10.5"
    letter-spacing="1.6"
    class="text-subtext0"
    fill="currentColor"
    fill-opacity="0.6"
  >
    2 · DECODIFICAR · 32 BITS, SEIS CAMPOS
  </text>
  {
    fields.map((f) => (
      <g data-field class={f.tone}>
        <rect
          x={f.x}
          y={IR.y}
          width={f.w}
          height={IR.h}
          fill="url(#grad-plate)"
          stroke="currentColor"
          stroke-opacity="0.55"
        />
        <text
          x={f.x + f.w / 2}
          y={IR.y + 29}
          font-size={f.span > 4 ? 13 : 11}
          text-anchor="middle"
          fill="currentColor"
          letter-spacing="1.2"
        >
          {f.bits}
        </text>
        <text
          x={f.x + f.w / 2}
          y={IR.y + 64}
          font-size="10.5"
          text-anchor="middle"
          fill="currentColor"
          fill-opacity="0.65"
        >
          {f.name}
        </text>
      </g>
    ))
  }

  {/* the fields fan out to whoever needs them */}
  <g class="text-blue">
    <path
      data-bus
      d="M 405 208 V 250 H 300 V 286"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-opacity="0.45"></path>
    <path
      data-bus
      d="M 560 208 V 236 H 300 V 286"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-opacity="0.45"></path>
  </g>
  <path
    data-bus
    d="M 794 208 V 246 H 694 V 262"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-opacity="0.45"
    class="text-green"></path>
  <path
    data-bus
    d="M 905 208 V 226 H 560 V 300 H 634"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-opacity="0.4"
    class="text-mauve"></path>

  {/* ── 3 · the register file, holding what the operands mean ───────────── */}
  <g data-stage="regs" class="text-blue">
    <text
      x="250"
      y="284"
      font-size="10.5"
      letter-spacing="1.6"
      class="text-subtext0"
      fill="currentColor"
      fill-opacity="0.6"
    >
      3 · LEER REGISTROS
    </text>
    <rect
      x="250"
      y="296"
      width="220"
      height={REGS.length * 40 + 12}
      rx="6"
      fill="currentColor"
      fill-opacity="0.05"
      stroke="currentColor"
      stroke-opacity="0.35"></rect>
    {
      REGS.map((r, i) => (
        <g class={r.tone}>
          <text x="266" y={326 + i * 40} font-size="13" fill="currentColor" fill-opacity="0.8">
            {r.name}
          </text>
          <text data-reg={r.name} x="454" y={326 + i * 40} font-size="13" text-anchor="end" fill="currentColor">
            {r.value}
          </text>
        </g>
      ))
    }
  </g>

  <path
    data-bus
    d="M 470 336 H 560 V 300 H 634"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-opacity="0.6"
    class="text-blue"></path>
  <path
    data-bus
    d="M 470 376 H 600 V 356 H 634"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-opacity="0.6"
    class="text-blue"></path>

  {/* ── 4 · the ALU, drawn as the shape it has been for fifty years ─────── */}
  <g data-stage="alu" class="text-mauve">
    <text
      x="634"
      y="252"
      font-size="10.5"
      letter-spacing="1.6"
      class="text-subtext0"
      fill="currentColor"
      fill-opacity="0.6"
    >
      4 · OPERAR
    </text>
    <path d={ALU} fill="url(#grad-plate)" stroke="currentColor" stroke-opacity="0.65" filter="url(#fx-inner)"></path>
    <text x="700" y="342" font-size="15" text-anchor="middle" fill="currentColor">ALU</text>
    <text x="700" y="362" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.6">suma</text>
  </g>

  {/* ── 5 · the result goes back where rd said ─────────────────────────── */}
  <g class="text-green">
    <path
      data-bus
      d="M 754 336 H 830 V 464 H 360 V 428"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-opacity="0.6"></path>
    <text
      x="846"
      y="332"
      font-size="10.5"
      letter-spacing="1.6"
      class="text-subtext0"
      fill="currentColor"
      fill-opacity="0.6"
    >
      5 · ESCRIBIR
    </text>
    <text data-result x="846" y="352" font-size="14" fill="currentColor">0x0031</text>
    <text x="600" y="480" font-size="11" text-anchor="middle" fill="currentColor" fill-opacity="0.6">
      el resultado entra en x1, el registro que pedía rd
    </text>
  </g>

  {/* and the counter moves on: the loop closes */}
  <g class="text-peach">
    <path
      data-bus
      d="M 124 172 V 500 H 40 V 149"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-opacity="0.35"
      stroke-dasharray="5 5"></path>
    <text x="150" y="504" font-size="11" fill="currentColor" fill-opacity="0.6">PC + 4 · la siguiente</text>
  </g>

  <text
    x={VIEW.w / 2}
    y="542"
    font-size="12"
    text-anchor="middle"
    class="text-subtext0"
    fill="currentColor"
    fill-opacity="0.75"
  >
    esto ocurre miles de millones de veces por segundo, y no sabe qué es un programa
  </text>
</svg>
