---
import type { MorphFigure } from '../../../home/journey/types';
import { inkOf, VIEW } from '../../../home/journey/tones';

interface Props {
  spec: MorphFigure;
}

const { spec } = Astro.props;

const MARGIN = 34;
const GAP = 30;
const n = spec.stages.length;
const W = (VIEW.w - MARGIN * 2 - GAP * (n - 1)) / n;
const TOP = 92;
const H = 340;
---

<svg
  data-fig
  data-kind="morph"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label={spec.stages.map((s) => s.label).join(' → ')}
>
  {
    spec.stages.map((stage, i) => {
      const x = MARGIN + i * (W + GAP);
      return (
        <g data-node class={inkOf(stage.tone, 'ink')}>
          <text x={x} y={TOP - 18} font-size="11.5" fill="currentColor" fill-opacity="0.7" letter-spacing="1.6">
            {stage.label.toUpperCase()}
          </text>
          <rect
            x={x}
            y={TOP}
            width={W}
            height={H}
            rx="8"
            fill="currentColor"
            fill-opacity="0.07"
            stroke="currentColor"
            stroke-opacity="0.4"
          />
          {stage.lines.map((raw, k) => {
            const accent = raw.startsWith('>');
            const text = accent ? raw.slice(1) : raw;
            return (
              <text
                data-morph-line
                x={x + 16}
                y={TOP + 34 + k * 26}
                font-size="13"
                fill="currentColor"
                fill-opacity={accent ? 1 : 0.62}
              >
                {text}
              </text>
            );
          })}
          {i < n - 1 && (
            <polygon
              data-arrow
              points="0,-6 12,0 0,6"
              fill="currentColor"
              fill-opacity="0.5"
              transform={`translate(${x + W + GAP / 2 - 6} ${TOP + H / 2})`}
            />
          )}
        </g>
      );
    })
  }
</svg>
