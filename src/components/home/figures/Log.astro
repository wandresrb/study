---
import type { LogFigure } from '../../../home/journey/types';
import { inkOf } from '../../../home/journey/tones';

interface Props {
  spec: LogFigure;
}

const { spec } = Astro.props;
---

<div data-fig data-kind="log" class="grid w-full gap-x-10 gap-y-8 font-mono lg:grid-cols-[1.15fr_0.85fr]">
  <div class="min-w-0">
    <p class="m-0 text-2xs tracking-smallcaps text-subtext0 uppercase">{spec.title}</p>
    <div class="mt-3 grid gap-1 text-xs/relaxed">
      {
        spec.lines.map((l) => (
          <div
            data-line
            data-gap={l.gap ?? 0}
            data-scramble={l.scramble ? '' : undefined}
            data-lights={l.lights}
            class={`break-words ${inkOf(l.tone, 'muted')}`}
          >
            {l.text}
          </div>
        ))
      }
      <div data-log-cursor class="mt-1 text-green">
        <b class="inline-block h-[1em] w-[0.5em] translate-y-[0.15em] animate-blink bg-green"></b>
      </div>
    </div>
  </div>

  {
    spec.xray && (
      <div class="grid content-start gap-6">
        {spec.xray.map((item) => (
          <div data-xray={item.id} class={inkOf(item.tone, 'muted')}>
            <p class="m-0 text-2xs tracking-smallcaps text-subtext0 uppercase">{item.label}</p>
            {item.cells ? (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {Array.from({ length: item.cells }).map(() => (
                  <span data-cell class="size-4 rounded-xs border border-current opacity-25 transition-opacity" />
                ))}
              </div>
            ) : (
              <div class="mt-2 h-4 w-full overflow-hidden rounded-xs border border-current/50">
                <i data-barfill class="block h-full w-0 bg-current opacity-45" />
              </div>
            )}
          </div>
        ))}
      </div>
    )
  }
</div>
