---
// The instrument for the gate station: the NAND those four transistors make,
// and the table it obeys. State lives in src/home/gate.ts and drives both this
// panel and the magnified transistor in the scene.
const W = 470;
const H = 360;
---

<div
  data-gate-panel
  class="pointer-events-none w-[min(30rem,42vw)] rounded-md border border-overlay1/60 bg-mantle/85 p-4 shadow-lg backdrop-blur-sm"
>
  <p class="m-0 text-2xs tracking-smallcaps text-subtext0 uppercase">puerta nand · cuatro transistores</p>

  <div class="pointer-events-auto mt-2 flex items-center gap-2">
    <button
      data-gate-in="a"
      type="button"
      class="flex cursor-pointer items-center gap-2 rounded-sm border border-overlay1/70 px-3 py-1 text-xs text-text transition-colors hover:bg-surface0 focus-visible:bg-surface0"
    >
      A <span data-gate-val="a" class="font-mono text-green">1</span>
    </button>
    <button
      data-gate-in="b"
      type="button"
      class="flex cursor-pointer items-center gap-2 rounded-sm border border-overlay1/70 px-3 py-1 text-xs text-text transition-colors hover:bg-surface0 focus-visible:bg-surface0"
    >
      B <span data-gate-val="b" class="font-mono text-green">1</span>
    </button>
    <span class="ml-auto text-2xs text-subtext0">o pulsa a · b</span>
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 h-auto w-full" role="img" aria-label="Esquema de una puerta NAND CMOS">
    <defs>
      {/* One MOSFET, traced once: the plate is the gate, the three segments the channel. */}
      <symbol id="sym-nmos" viewBox="0 0 60 60">
        <path
          d="M 4 30 H 26 M 26 18 V 42"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.9"></path>
        <path
          d="M 34 18 V 24 M 34 27 V 33 M 34 36 V 42"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"></path>
        <path d="M 34 21 H 46 V 4 M 34 39 H 46 V 56" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      </symbol>

      <symbol id="sym-pmos" viewBox="0 0 60 60">
        <path d="M 4 30 H 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.9"></path>
        <circle cx="18" cy="30" r="4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.9"
        ></circle>
        <path d="M 22 30 H 26 M 26 18 V 42" fill="none" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.9"
        ></path>
        <path
          d="M 34 18 V 24 M 34 27 V 33 M 34 36 V 42"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"></path>
        <path d="M 34 21 H 46 V 4 M 34 39 H 46 V 56" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      </symbol>
    </defs>

    {/* the supply rail and the ground rail: where the two paths lead */}
    <g data-wire="vdd" class="text-subtext0">
      <path d="M 60 40 H 184" fill="none" stroke="currentColor" stroke-width="1.8"></path>
      <path d="M 104 40 V 64 M 184 40 V 64" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      <text x="54" y="44" font-size="11" text-anchor="end" fill="currentColor">1,2 V</text>
    </g>

    <g data-wire="gnd" class="text-peach">
      <path d="M 144 286 V 310" fill="none" stroke="currentColor" stroke-width="1.6"></path>
      <path
        d="M 122 310 H 166 M 129 316 H 159 M 136 322 H 152"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"></path>
    </g>

    {/* the two that pull the output up, side by side */}
    <use data-mos="pa" href="#sym-pmos" x="70" y="60" width="60" height="60" class="text-subtext0"></use>
    <use data-mos="pb" href="#sym-pmos" x="150" y="60" width="60" height="60" class="text-subtext0"></use>
    <g data-wire="up" class="text-subtext0">
      <path d="M 104 116 V 140 M 184 116 V 140" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </g>

    {/* the two that pull it down, one after the other */}
    <use data-mos="na" href="#sym-nmos" x="110" y="160" width="60" height="60" class="text-peach"></use>
    <use data-mos="nb" href="#sym-nmos" x="110" y="230" width="60" height="60" class="text-peach"></use>
    <g data-wire="down" class="text-peach">
      <path d="M 144 140 V 164 M 144 216 V 234" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </g>

    {/* the output node */}
    <g data-wire="out" class="text-peach">
      <path d="M 104 140 H 268" fill="none" stroke="currentColor" stroke-width="1.8"></path>
      <circle cx="144" cy="140" r="3" fill="currentColor"></circle>
    </g>
    <text x="276" y="136" font-size="12" fill="currentColor" class="text-subtext0">S</text>
    <text data-gate-out x="276" y="156" font-size="20" fill="currentColor" class="text-subtext0">0</text>

    {/* what drives each gate */}
    <g class="text-blue">
      <path d="M 44 90 V 190 M 44 90 H 74 M 44 190 H 114" fill="none" stroke="currentColor" stroke-width="1.4"
      ></path>
      <text x="36" y="94" font-size="12" text-anchor="end" fill="currentColor">A</text>
    </g>
    <g class="text-mauve">
      <path d="M 24 76 V 260 M 24 76 H 154 V 90 M 24 260 H 114" fill="none" stroke="currentColor" stroke-width="1.4"
      ></path>
      <text x="16" y="80" font-size="12" text-anchor="end" fill="currentColor">B</text>
    </g>

    {/* which one is hanging over the board */}
    <g class="text-peach">
      <path d="M 176 190 H 214" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3"></path>
      <text x="220" y="194" font-size="11" fill="currentColor">el ampliado</text>
    </g>

    {/* the table it obeys */}
    <g class="text-subtext0">
      <text x="330" y="52" font-size="11" fill="currentColor" fill-opacity="0.7">A</text>
      <text x="366" y="52" font-size="11" fill="currentColor" fill-opacity="0.7">B</text>
      <text x="410" y="52" font-size="11" fill="currentColor" fill-opacity="0.7">S</text>
      <path d="M 322 60 H 424" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.4"></path>
    </g>
    <g data-row="00">
      <rect x="318" y="66" width="110" height="26" rx="3" fill="currentColor" fill-opacity="0" class="text-peach"
      ></rect>
      <text x="330" y="84" font-size="13" fill="currentColor" class="text-subtext0">0</text>
      <text x="366" y="84" font-size="13" fill="currentColor" class="text-subtext0">0</text>
      <text x="410" y="84" font-size="13" fill="currentColor" class="text-subtext0">1</text>
    </g>
    <g data-row="01">
      <rect x="318" y="96" width="110" height="26" rx="3" fill="currentColor" fill-opacity="0" class="text-peach"
      ></rect>
      <text x="330" y="114" font-size="13" fill="currentColor" class="text-subtext0">0</text>
      <text x="366" y="114" font-size="13" fill="currentColor" class="text-subtext0">1</text>
      <text x="410" y="114" font-size="13" fill="currentColor" class="text-subtext0">1</text>
    </g>
    <g data-row="10">
      <rect x="318" y="126" width="110" height="26" rx="3" fill="currentColor" fill-opacity="0" class="text-peach"
      ></rect>
      <text x="330" y="144" font-size="13" fill="currentColor" class="text-subtext0">1</text>
      <text x="366" y="144" font-size="13" fill="currentColor" class="text-subtext0">0</text>
      <text x="410" y="144" font-size="13" fill="currentColor" class="text-subtext0">1</text>
    </g>
    <g data-row="11">
      <rect x="318" y="156" width="110" height="26" rx="3" fill="currentColor" fill-opacity="0.16" class="text-peach"
      ></rect>
      <text x="330" y="174" font-size="13" fill="currentColor" class="text-subtext0">1</text>
      <text x="366" y="174" font-size="13" fill="currentColor" class="text-subtext0">1</text>
      <text x="410" y="174" font-size="13" fill="currentColor" class="text-subtext0">0</text>
    </g>

    <text x="318" y="222" font-size="11" fill="currentColor" class="text-subtext0">solo con las dos entradas</text>
    <text x="318" y="238" font-size="11" fill="currentColor" class="text-subtext0">a 1 la salida cae a 0</text>
  </svg>
</div>
