---
import { VIEW } from '../../../home/journey/tones';

// Everything here is traced: the package and its silicon on the left, a DDR5 module
// on the right, and the traces that join them. The repeated parts — cores, DRAM
// packages, contacts, SRAM cells — are <use> and <pattern>, drawn once.

const DIE = { x: 62, y: 132, w: 316, h: 278 };
const DIMM = { x: 566, y: 217, w: 420, h: 108 };

// the module outline: rounded top, latch notches on both flanks, key notch below
const dimmOutline = `
  M ${DIMM.x + 4} ${DIMM.y}
  H ${DIMM.x + DIMM.w - 4} A 4 4 0 0 1 ${DIMM.x + DIMM.w} ${DIMM.y + 4}
  V ${DIMM.y + 58} A 10 10 0 0 1 ${DIMM.x + DIMM.w} ${DIMM.y + 78}
  V ${DIMM.y + DIMM.h}
  H ${DIMM.x + 190} V ${DIMM.y + 86} H ${DIMM.x + 176} V ${DIMM.y + DIMM.h}
  H ${DIMM.x}
  V ${DIMM.y + 78} A 10 10 0 0 1 ${DIMM.x} ${DIMM.y + 58}
  V ${DIMM.y + 4} A 4 4 0 0 1 ${DIMM.x + 4} ${DIMM.y} Z
`;
---

<svg
  data-fig
  data-kind="hierarchy"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label="El procesador y un módulo de memoria: una línea de 64 bytes viaja de la RAM a la caché del núcleo"
>
  {/* ── the package: substrate, silicon, contact ring ─────────────────────── */}
  <g class="text-subtext0">
    <rect
      x={DIE.x - 14}
      y={DIE.y - 14}
      width={DIE.w + 28}
      height={DIE.h + 28}
      rx="10"
      fill="#101119"
      stroke="currentColor"
      stroke-opacity="0.35"></rect>
    {/* the contact ring lives on the rim, not across the whole face */}
    <g fill="url(#pat-pads)">
      <rect x={DIE.x} y={DIE.y} width={DIE.w} height="15"></rect>
      <rect x={DIE.x} y={DIE.y + DIE.h - 15} width={DIE.w} height="15"></rect>
      <rect x={DIE.x} y={DIE.y + 15} width="15" height={DIE.h - 30}></rect>
      <rect x={DIE.x + DIE.w - 15} y={DIE.y + 15} width="15" height={DIE.h - 30}></rect>
    </g>
    <rect
      x={DIE.x + 15}
      y={DIE.y + 15}
      width={DIE.w - 30}
      height={DIE.h - 30}
      fill="#15161f"
      stroke="currentColor"
      stroke-opacity="0.25"></rect>
    <text
      x={DIE.x - 14}
      y={DIE.y - 48}
      font-size="11"
      letter-spacing="1.7"
      fill="currentColor"
      fill-opacity="0.65"
    >
      EL PROCESADOR
    </text>
  </g>

  {/* the six cores, one tile drawn and instanced */}
  <g class="text-blue">
    <use href="#part-core" x="90" y="152" width="122" height="58"></use>
    <use href="#part-core" x="228" y="152" width="122" height="58"></use>
    <use href="#part-core" x="90" y="216" width="122" height="58"></use>
    <use href="#part-core" x="228" y="216" width="122" height="58"></use>
    <use href="#part-core" x="90" y="280" width="122" height="58"></use>
    <use href="#part-core" x="228" y="280" width="122" height="58"></use>
  </g>

  {/* the one core we are following, called out from outside the drawing */}
  <g data-core="0" class="text-green">
    <rect x="88" y="150" width="126" height="62" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.9"></rect>
    <path d="M 151 150 V 122" stroke="currentColor" stroke-width="1" stroke-opacity="0.5" fill="none"></path>
    <text x="151" y="114" font-size="11" text-anchor="middle" fill="currentColor">
      núcleo 0 · sus registros, su L1 y su L2
    </text>
  </g>

  {/* the shared L3, a band of SRAM the whole chip leans on */}
  <g data-l3 class="text-mauve">
    <rect x="90" y="354" width="260" height="22" fill="url(#pat-sram)"></rect>
    <rect x="90" y="354" width="260" height="22" fill="none" stroke="currentColor" stroke-opacity="0.6"></rect>
    <path d="M 220 376 V 424" stroke="currentColor" stroke-width="1" stroke-opacity="0.5" fill="none"></path>
    <text x="220" y="440" font-size="11" text-anchor="middle" fill="currentColor">
      L3 · 32 MB, compartida por los seis
    </text>
  </g>

  {/* ── the traces out to the module ───────────────────────────────────────── */}
  <g class="text-subtext0" data-traces>
    <path
      d={`M ${DIE.x + DIE.w + 14} 264 H ${DIMM.x + 40}`}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-opacity="0.4"></path>
    <path
      d={`M ${DIE.x + DIE.w + 14} 276 H ${DIMM.x + 40}`}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-opacity="0.4"></path>
    <text x="500" y="256" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5"
      >DDR5</text
    >
  </g>
  <g data-live-trace class="text-peach" opacity="0">
    <path
      d={`M ${DIMM.x + 40} 264 H ${DIE.x + DIE.w + 14}`}
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      filter="url(#fx-glow)"></path>
  </g>

  {/* ── the module ────────────────────────────────────────────────────────── */}
  <g class="text-subtext0">
    <path d={dimmOutline} fill="#171922" stroke="currentColor" stroke-opacity="0.45"></path>
    <rect x={DIMM.x + 8} y={DIMM.y + 86} width="168" height="22" fill="url(#pat-fingers)"></rect>
    <rect x={DIMM.x + 190} y={DIMM.y + 86} width="222" height="22" fill="url(#pat-fingers)"></rect>
    <text
      x={DIMM.x}
      y={DIMM.y - 12}
      font-size="11"
      letter-spacing="1.7"
      fill="currentColor"
      fill-opacity="0.6"
    >
      LA MEMORIA · 32 GB DDR5
    </text>
  </g>

  <g data-dram>
    <use href="#part-dram" x={DIMM.x + 20} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 70} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 120} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 170} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 220} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 270} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 320} y={DIMM.y + 20} width="44" height="26"></use>
    <use href="#part-dram" x={DIMM.x + 370} y={DIMM.y + 20} width="30" height="26"></use>
  </g>
  <rect x={DIMM.x + 372} y={DIMM.y + 56} width="20" height="14" rx="2" fill="#15161d" stroke="#3a3c4a"></rect>

  {/* the 64 bytes that travel, drawn as the strip they are */}
  <g data-line class="text-peach" opacity="0">
    <rect
      x={DIMM.x + 18}
      y={DIMM.y + 54}
      width="192"
      height="18"
      rx="3"
      fill="currentColor"
      fill-opacity="0.22"
      stroke="currentColor"
      stroke-opacity="0.7"></rect>
    <text x={DIMM.x + 114} y={DIMM.y + 67} font-size="10.5" text-anchor="middle" fill="currentColor">
      64 bytes · una línea
    </text>
  </g>

  <text
    x={VIEW.w / 2}
    y="478"
    font-size="12"
    text-anchor="middle"
    class="text-subtext0"
    fill="currentColor"
    fill-opacity="0.75"
  >
    de la memoria nunca viene un dato suelto: viene la línea entera de 64 bytes
  </text>
</svg>
