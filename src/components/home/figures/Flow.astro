---
import type { FlowFigure } from '../../../home/journey/types';
import { boxOf, connect, inkOf, route, VIEW } from '../../../home/journey/tones';

interface Props {
  spec: FlowFigure;
}

const { spec } = Astro.props;

const at = (id: string) => {
  const node = spec.nodes.find((n) => n.id === id);
  if (!node) throw new Error(`Flow figure: edge points at "${id}", which is not a node.`);
  return boxOf(node);
};

const links = spec.edges.map((e) => ({ ...e, link: connect(at(e.from), at(e.to)) }));
const travel = spec.travel && spec.travel.length > 1 ? route(spec.travel.map(at)) : null;

// The frame hugs its contents: every flow gets the same air, never a tall gap.
const tops = [...spec.nodes.map((n) => n.y), ...(spec.bands?.map((b) => b.y) ?? [])];
const bottoms = [...spec.nodes.map((n) => n.y + (n.h ?? 64)), ...(spec.bands?.map((b) => b.y + b.h) ?? [])];
const top = Math.min(...tops) - 46;
const height = Math.max(...bottoms) + 46 - top;
---

<svg
  data-fig
  data-kind="flow"
  viewBox={`0 ${top} ${VIEW.w} ${height}`}
  class="h-auto w-full"
  role="img"
  aria-label={spec.nodes.map((n) => n.label).join(' → ')}
>
  {
    spec.bands?.map((b) => (
      <g class={inkOf(b.tone)} data-band>
        <rect
          x="16"
          y={b.y}
          width={VIEW.w - 32}
          height={b.h}
          rx="10"
          fill="currentColor"
          fill-opacity="0.05"
          stroke="currentColor"
          stroke-opacity="0.25"
          stroke-dasharray="6 5"
        />
        <text x="34" y={b.y + 22} font-size="12" fill="currentColor" fill-opacity="0.75">
          {b.label}
        </text>
      </g>
    ))
  }

  {
    links.map((e) => (
      <g class="text-subtext0">
        <path
          data-edge
          d={e.link.d}
          fill="none"
          stroke="currentColor"
          stroke-opacity="0.5"
          stroke-width="1.5"
          stroke-dasharray={e.dashed ? '5 5' : undefined}
        />
        <polygon
          data-arrow
          points="0,-4 9,0 0,4"
          fill="currentColor"
          fill-opacity="0.6"
          transform={`translate(${e.link.tip[0]} ${e.link.tip[1]}) rotate(${e.link.angle})`}
        />
        {e.label && (
          <text
            data-edge-label
            x={e.link.mid[0]}
            y={e.link.mid[1] - 9}
            font-size="12"
            text-anchor="middle"
            fill="currentColor"
            fill-opacity="0.85"
          >
            {e.label}
          </text>
        )}
      </g>
    ))
  }

  {
    spec.nodes.map((n) => {
      const b = boxOf(n);
      return (
        <g data-node class={inkOf(n.tone, 'ink')}>
          <rect
            x={b.x}
            y={b.y}
            width={b.w}
            height={b.h}
            rx="8"
            fill="currentColor"
            fill-opacity="0.1"
            stroke="currentColor"
            stroke-opacity="0.55"
          />
          <text
            x={b.x + b.w / 2}
            y={n.sub ? b.y + 27 : b.y + b.h / 2 + 6}
            font-size="16"
            text-anchor="middle"
            fill="currentColor"
          >
            {n.label}
          </text>
          {n.sub && (
            <text
              x={b.x + b.w / 2}
              y={b.y + 47}
              font-size="11.5"
              text-anchor="middle"
              fill="currentColor"
              fill-opacity="0.6"
            >
              {n.sub}
            </text>
          )}
        </g>
      );
    })
  }

  {
    travel && (
      <>
        <path data-travel-path d={travel} fill="none" stroke="none" />
        <g data-travel class="text-green" opacity="0">
          <circle r="7" fill="currentColor" />
          <circle r="13" fill="currentColor" fill-opacity="0.22" />
          {spec.travelLabel && (
            <text x="0" y="-30" font-size="11.5" text-anchor="middle" fill="currentColor">
              {spec.travelLabel}
            </text>
          )}
        </g>
      </>
    )
  }
</svg>
