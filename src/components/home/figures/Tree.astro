---
import type { TreeFigure, TreeNode } from '../../../home/journey/types';
import { inkOf, VIEW } from '../../../home/journey/tones';

interface Props {
  spec: TreeFigure;
}

const { spec } = Astro.props;

interface Row {
  node: TreeNode;
  depth: number;
  parent: number;
}

const rows: Row[] = [];
const walk = (node: TreeNode, depth: number, parent: number) => {
  const index = rows.push({ node, depth, parent }) - 1;
  for (const child of node.children ?? []) walk(child, depth + 1, index);
};
walk(spec.root, 0, -1);

const TOP = 70;
const STEP = 56;
const INDENT = 52;
const xOf = (depth: number) => 70 + depth * INDENT;
const yOf = (i: number) => TOP + i * STEP;
---

<svg
  data-fig
  data-kind="tree"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label={rows.map((r) => r.node.label).join(', ')}
>
  {
    rows.map((r, i) =>
      r.parent >= 0 ? (
        <path
          data-edge
          d={`M ${xOf(r.depth - 1) + 6} ${yOf(r.parent) + 12} V ${yOf(i) - 5} h ${INDENT - 24}`}
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="text-subtext0"
          stroke-opacity="0.4"
        />
      ) : null,
    )
  }

  {
    rows.map((r, i) => (
      <g data-node class={inkOf(r.node.tone, 'ink')}>
        <circle cx={xOf(r.depth) + 6} cy={yOf(i) - 5} r="4.5" fill="currentColor" />
        <text x={xOf(r.depth) + 22} y={yOf(i)} font-size="17" fill="currentColor">
          {r.node.label}
        </text>
        {r.node.sub && (
          <text
            x={xOf(r.depth) + 32 + r.node.label.length * 9.4}
            y={yOf(i)}
            font-size="12"
            fill="currentColor"
            fill-opacity="0.55"
          >
            {r.node.sub}
          </text>
        )}
      </g>
    ))
  }

  {
    spec.caption && (
      <text
        data-caption
        x={VIEW.w / 2}
        y={VIEW.h - 26}
        font-size="12.5"
        text-anchor="middle"
        class="text-subtext0"
        fill="currentColor"
        fill-opacity="0.75"
      >
        {spec.caption}
      </text>
    )
  }
</svg>
