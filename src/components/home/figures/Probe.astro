---
import { BITS, HIGH, penBits, penTrace } from '../../../lib/probe-signal';

// The instrument docked beside the machine: what the needle on the copper reads.
// It is served with a screenful already drawn, and src/home/probe.ts takes the
// pen over from there — with no script, or no motion, the reading still holds.
const W = 460;
const H = 300;
const PLOT = { x: 46, y: 34, w: 396, h: 150 };
const THRESHOLD = PLOT.y + PLOT.h * (1 - 0.9 / HIGH);

const volts = penTrace(0);
const yOf = (v: number) => Math.min(PLOT.y + PLOT.h + 4, Math.max(PLOT.y - 4, PLOT.y + PLOT.h * (1 - v / HIGH)));
const wave = volts
  .map((v, i) => `${(PLOT.x + (PLOT.w * i) / (volts.length - 1)).toFixed(1)},${yOf(v).toFixed(1)}`)
  .join(' ');
const latched = penBits(0);
const gap = PLOT.w / BITS.length;
---

<div
  data-probe-panel
  class="pointer-events-none w-[min(30rem,42vw)] rounded-md border border-overlay1/60 bg-mantle/85 p-4 shadow-lg backdrop-blur-sm"
>
  <p class="m-0 flex items-baseline justify-between text-2xs tracking-smallcaps text-subtext0 uppercase">
    <span>sonda · pista cpu → memoria</span>
    <span class="font-mono text-peach">2 GS/s</span>
  </p>

  <svg
    viewBox={`0 0 ${W} ${H}`}
    data-plot={`${PLOT.x},${PLOT.y},${PLOT.w},${PLOT.h}`}
    class="mt-2 h-auto w-full"
    role="img" aria-label="Tensión medida en la pista de cobre">
    {/* the screen */}
    <rect
      x={PLOT.x}
      y={PLOT.y}
      width={PLOT.w}
      height={PLOT.h}
      fill="#0b0d14"
      stroke="currentColor"
      stroke-opacity="0.25"
      class="text-subtext0"></rect>
    <rect x={PLOT.x} y={PLOT.y} width={PLOT.w} height={PLOT.h} fill="url(#pat-grid-fine)" class="text-subtext0"></rect>

    {/* what the machine calls the line between 0 and 1 */}
    <line
      x1={PLOT.x}
      y1={THRESHOLD}
      x2={PLOT.x + PLOT.w}
      y2={THRESHOLD}
      stroke="currentColor"
      stroke-width="1"
      stroke-dasharray="5 5"
      stroke-opacity="0.8"
      class="text-red"></line>
    <text x={PLOT.x + 6} y={THRESHOLD - 7} font-size="10.5" fill="currentColor" class="text-red">umbral · 0,9 V</text>

    <text x={PLOT.x - 8} y={PLOT.y + 10} font-size="10" text-anchor="end" fill="currentColor" class="text-subtext0"
      >1,2 V</text
    >
    <text
      x={PLOT.x - 8}
      y={PLOT.y + PLOT.h - 2}
      font-size="10"
      text-anchor="end"
      fill="currentColor"
      class="text-subtext0">0 V</text
    >

    {/* the pen: written every frame, oldest sample on the left */}
    <polyline
      data-probe-wave
      points={wave}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
      filter="url(#fx-glow)"
      class="text-peach"></polyline>

    {/* where the needle sits: the newest sample, always at the right edge */}
    <line
      x1={PLOT.x + PLOT.w}
      y1={PLOT.y - 6}
      x2={PLOT.x + PLOT.w}
      y2={PLOT.y + PLOT.h + 6}
      stroke="currentColor"
      stroke-width="1"
      stroke-opacity="0.5"
      class="text-teal"></line>
    <text
      x={PLOT.x + PLOT.w}
      y={PLOT.y - 12}
      font-size="10"
      text-anchor="end"
      fill="currentColor"
      class="text-teal">la punta</text
    >

    <text x={PLOT.x} y={PLOT.y + PLOT.h + 20} font-size="10.5" fill="currentColor" class="text-subtext0"
      >hace 6 ns</text
    >
    <text
      x={PLOT.x + PLOT.w}
      y={PLOT.y + PLOT.h + 20}
      font-size="10.5"
      text-anchor="end"
      fill="currentColor"
      class="text-subtext0">ahora</text
    >

    {/* the same signal after the comparator: the byte, as the machine has it */}
    <text x={PLOT.x} y={PLOT.y + PLOT.h + 52} font-size="10.5" fill="currentColor" class="text-subtext0"
      >lo que entra en el registro</text
    >
    <g data-probe-bits class="text-subtext0">
      {
        latched.map((bit, i) => (
          <text
            x={PLOT.x + gap * (i + 0.5)}
            y={PLOT.y + PLOT.h + 78}
            font-size="22"
            text-anchor="middle"
            fill="currentColor"
            class={bit ? 'text-green' : 'text-subtext0'}
          >
            {bit}
          </text>
        ))
      }
    </g>
  </svg>
</div>
