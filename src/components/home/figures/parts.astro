---
// The drawn parts of the machine. Each silhouette is traced by hand once and
// instanced with <use>; the repeated textures (contacts, SRAM cells, pads) are
// <pattern>. Nothing here is generated by a loop.
---

<svg aria-hidden="true" focusable="false" width="0" height="0" class="absolute">
  <defs>
    {/* the gold contact fingers along a module's edge */}
    <pattern id="pat-fingers" width="9" height="20" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="5.5" height="20" rx="1" fill="#c8a34a" fill-opacity="0.85"></rect>
    </pattern>

    {/* an SRAM array reads as cells with a sense-amp band under them */}
    <pattern id="pat-sram" width="8" height="8" patternUnits="userSpaceOnUse">
      <rect x="0.9" y="0.9" width="6.2" height="6.2" rx="0.8" fill="currentColor" fill-opacity="0.14"></rect>
    </pattern>

    {/* the bond pads that ring the silicon */}
    <pattern id="pat-pads" width="12" height="12" patternUnits="userSpaceOnUse">
      <rect x="3" y="3" width="6" height="6" rx="1" fill="currentColor" fill-opacity="0.3"></rect>
    </pattern>

    {
      /*
      One DRAM package: a plastic body with a chamfered corner, the pin-1 dot,
      and a sliver of light along the top edge so it does not read as a box.
    */
    }
    <symbol id="part-dram" viewBox="0 0 62 34">
      <path
        d="M 6 0 H 62 V 28 A 6 6 0 0 1 56 34 H 0 V 6 A 6 6 0 0 1 6 0 Z"
        fill="#15161d"
        stroke="#3a3c4a"
        stroke-width="1"></path>
      <path d="M 6 1.4 H 60.6" stroke="#5b5e70" stroke-width="1" stroke-opacity="0.55"></path>
      <circle cx="8.5" cy="27" r="2.2" fill="#5b5e70" fill-opacity="0.8"></circle>
      <path d="M 12 12 H 50 M 12 18 H 42" stroke="#4a4d5c" stroke-width="1.4" stroke-opacity="0.5"></path>
    </symbol>

    {
      /*
      One core tile as it looks on a floorplan: the execution block, the
      register file as a dense stripe, and its own L1 and L2 banks.
    */
    }
    <symbol id="part-core" viewBox="0 0 120 60">
      <rect
        x="0.6"
        y="0.6"
        width="118.8"
        height="58.8"
        rx="2.5"
        fill="currentColor"
        fill-opacity="0.05"
        stroke="currentColor"
        stroke-opacity="0.4"></rect>
      <rect x="6" y="6" width="42" height="26" rx="1.5" fill="currentColor" fill-opacity="0.12"></rect>
      <path d="M 10 12 H 44 M 10 18 H 38 M 10 24 H 42" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.35"
      ></path>
      <rect x="6" y="36" width="42" height="18" rx="1.5" fill="currentColor" fill-opacity="0.08"></rect>
      <path
        d="M 9 40 V 50 M 13 40 V 50 M 17 40 V 50 M 21 40 V 50 M 25 40 V 50 M 29 40 V 50 M 33 40 V 50 M 37 40 V 50 M 41 40 V 50 M 45 40 V 50"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-opacity="0.4"></path>
      <rect x="54" y="6" width="60" height="22" rx="1.5" fill="url(#pat-sram)"></rect>
      <rect x="54" y="6" width="60" height="22" rx="1.5" fill="none" stroke="currentColor" stroke-opacity="0.3"></rect>
      <rect x="54" y="32" width="60" height="22" rx="1.5" fill="url(#pat-sram)"></rect>
      <rect x="54" y="32" width="60" height="22" rx="1.5" fill="none" stroke="currentColor" stroke-opacity="0.3"></rect>
    </symbol>
  </defs>
</svg>
