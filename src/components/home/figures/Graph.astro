---
import { getCategories, getTracks, getUnlocks, lessonsOf } from '../../../data/content';

const categories = getCategories();
const order = new Map(categories.map((c, i) => [c.id, i]));

const nodes = getTracks().map((t) => ({
  id: t.id,
  name: t.name,
  color: t.colorHex,
  status: t.status,
  cat: order.get(t.category) ?? 0,
  lessons: lessonsOf(t.id).length,
  href: t.status === 'written' ? `/${t.id}/` : t.status === 'indexed' ? `/concepts/${t.id}/` : '',
}));

const index = new Map(nodes.map((n, i) => [n.id, i]));
const edges = getUnlocks()
  .map(([a, b]) => [index.get(a), index.get(b)])
  .filter((e): e is [number, number] => e[0] !== undefined && e[1] !== undefined);

const data = { groups: categories.length, nodes, edges };
---

<div data-fig data-kind="graph" class="relative h-[56svh] w-full">
  <canvas data-graph class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <div
    data-graph-tip
    hidden
    class="pointer-events-none absolute z-2 rounded-sm border border-line bg-panel px-2.5 py-1 text-2xs text-text shadow-panel"
  >
  </div>
  <script is:inline type="application/json" data-graph-data set:html={JSON.stringify(data)} />
  <ul class="sr-only">
    {nodes.map((n) => <li>{n.href ? <a href={n.href}>{n.name}</a> : n.name}</li>)}
  </ul>
</div>
