---
import type { BarsFigure } from '../../../home/journey/types';
import { inkOf, VIEW } from '../../../home/journey/tones';

interface Props {
  spec: BarsFigure;
}

const { spec } = Astro.props;

const LEFT = 40;
const TRACK = { x: 220, w: 660 };
const TOP = 80;
const step = Math.min(64, (VIEW.h - TOP - 90) / Math.max(1, spec.rows.length));
---

<svg
  data-fig
  data-kind="bars"
  viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
  class="h-auto w-full"
  role="img"
  aria-label={spec.rows.map((r) => `${r.label} ${r.note ?? ''}`).join(', ')}
>
  {
    spec.rows.map((row, i) => {
      const y = TOP + i * step;
      let x = TRACK.x;
      return (
        <g>
          <text x={LEFT} y={y + 21} font-size="14" class="text-text" fill="currentColor">
            {row.label}
          </text>
          {row.segments.map((s) => {
            const w = Math.max(2, s.w * TRACK.w);
            const seg = (
              <g data-bar class={inkOf(s.tone, 'muted')} data-x={x} data-w={w}>
                <rect
                  x={x}
                  y={y}
                  width={w}
                  height="28"
                  rx="4"
                  fill="currentColor"
                  fill-opacity={s.hollow ? 0 : 0.28}
                  stroke="currentColor"
                  stroke-opacity={s.hollow ? 0.3 : 0.65}
                  stroke-dasharray={s.hollow ? '5 5' : undefined}
                />
                {s.label && w > 54 && (
                  <text
                    x={x + w / 2}
                    y={y + 19}
                    font-size="12"
                    text-anchor="middle"
                    fill="currentColor"
                    fill-opacity="0.9"
                  >
                    {s.label}
                  </text>
                )}
              </g>
            );
            x += w;
            return seg;
          })}
          {row.note && (
            <text
              x={TRACK.x + TRACK.w + 16}
              y={y + 20}
              font-size="12"
              class="text-subtext0"
              fill="currentColor"
              fill-opacity="0.8"
            >
              {row.note}
            </text>
          )}
        </g>
      );
    })
  }

  {
    spec.scale && (
      <text
        data-caption
        x={VIEW.w / 2}
        y={VIEW.h - 28}
        font-size="12.5"
        text-anchor="middle"
        class="text-subtext0"
        fill="currentColor"
        fill-opacity="0.75"
      >
        {spec.scale}
      </text>
    )
  }
</svg>
