---
import { SPANS } from '../../home/script';

interface Props {
  id: string;
  scene: string;
}

const { id, scene } = Astro.props;
---
<section
  id={id}
  data-layer
  style={`--spans:${SPANS}`}
  class="relative min-h-[calc((1+var(--spans,1))*100svh)] motion-reduce:min-h-auto"
>
  <div
    class="sticky top-0 grid h-svh content-center px-6 pt-24 pb-16 sm:px-[8vw] lg:px-28
           max-lg:content-start
           motion-reduce:static motion-reduce:h-auto motion-reduce:min-h-svh"
  >
    <div
      data-scene={scene}
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-0 scale-104 overflow-hidden opacity-0
             transition-[opacity,scale] duration-[620ms] ease-suave
             [html[data-fase=corriendo]_&]:scale-100 [html[data-fase=corriendo]_&]:opacity-100"
    ></div>

    <aside
      class="absolute z-4 grid content-center gap-4
             max-lg:inset-x-4 max-lg:bottom-[5vh] max-lg:translate-none
             lg:top-1/2 lg:right-[clamp(1.5rem,4vw,3rem)] lg:w-[min(31rem,42%)] lg:-translate-y-1/2"
    >
      <slot />
    </aside>
  </div>
</section>
