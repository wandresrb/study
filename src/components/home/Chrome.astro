---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Eject from '@lucide/astro/icons/eject';

import { getTotals, getTracks } from '../../data/content';
import { BEATS } from '../../home/journey/beats';
import { LAYERS } from '../../home/journey/layers';

const totals = getTotals();
const hours = Math.round(totals.minutes / 60);

// One address per frame, drawn once at build: the stack the machine builds.
const ADDR: Record<string, string> = Object.fromEntries(
  LAYERS.map((l, i) => [
    l.id,
    `0x7ff${(0xc + (i % 4)).toString(16)}${((i * 0x5deece6d + 0x2f19) >>> 0).toString(16).padStart(8, '0').slice(0, 8)}`,
  ]),
);

const byId = new Map(getTracks().map((t) => [t.id, t]));
const hrefOf = (id: string) => {
  const t = byId.get(id);
  if (!t) return '';
  if (t.status === 'written') return `/${t.id}/`;
  if (t.status === 'indexed') return `/concepts/${t.id}/`;
  return '';
};
---

{/* The four corners and the rail: the only chrome the journey has. */}
<div
  data-chrome
  aria-hidden="false"
  class="pointer-events-none fixed inset-0 z-20 text-2xs
         [&_a]:pointer-events-auto [&_button]:pointer-events-auto"
>
  {/* top left · where you are */}
  <div class="absolute top-[calc(var(--header-h)+1rem)] left-4 sm:left-8">
    <p class="m-0 tracking-smallcaps text-subtext0 uppercase">
      <span data-chrome-layer>la materia</span>
    </p>
    <p class="m-0 mt-0.5 text-subtext0/70">
      <span data-chrome-index>00</span> / {BEATS.length - 1}
    </p>
  </div>

  {/* top right · the manifesto, then the stack it becomes */}
  <div class="absolute top-[calc(var(--header-h)+1rem)] right-4 max-w-[15rem] text-right sm:right-8">
    <div data-chrome-manifesto>
      <p class="m-0 tracking-smallcaps text-subtext0/70 uppercase">manifiesto</p>
      <p class="mt-1.5 mb-0 text-text">
        Los frameworks caducan.<br />Los fundamentos no.
      </p>
      <p class="mt-1.5 mb-0 hidden text-subtext0/70 sm:block">
        {totals.tracks} territorios · {totals.lessons.toLocaleString('es')} lecciones<br />
        {hours.toLocaleString('es')} horas de estudio
      </p>
    </div>

    {/* The stack, as it was: an address, the layer, and the pop that unwinds it.
        The only mono in the chrome — it is machine state, not prose. */}
    <div data-chrome-stack hidden class="grid gap-1.5 font-mono">
      <p class="m-0 tracking-smallcaps text-subtext0/70 uppercase">la pila</p>
      <ol class="m-0 grid list-none gap-1 p-0">
        {
          LAYERS.map((l) => (
            <li
              data-frame={l.id}
              hidden
              class="flex items-center gap-3 rounded-sm border border-overlay1/70 bg-mantle/80 px-2.5 py-1.5 text-left"
            >
              <span class="text-2xs text-subtext0/70">{ADDR[l.id]}</span>
              <span data-frame-name class="tracking-smallcaps text-text">
                {l.id}
              </span>
              <button
                data-pop={l.id}
                type="button"
                hidden
                class="ml-auto flex cursor-pointer items-center gap-1 rounded-full border border-mauve/55 bg-mauve/12 px-2 py-0.5 text-2xs text-mauve transition-colors hover:bg-mauve/25 focus-visible:bg-mauve/25"
              >
                <Eject class="size-2.5" aria-hidden="true" />
                pop
              </button>
            </li>
          ))
        }
      </ol>
      <p class="m-0 text-2xs text-mauve">
        sp · len <span data-chrome-len>0</span> · cap {LAYERS.length}
      </p>
    </div>
  </div>

  {/* bottom left · what you can do here */}
  <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-8">
    <p data-chrome-hint class="m-0 text-subtext0">baja para montar la máquina</p>
    <p class="m-0 mt-1 hidden text-subtext0/50 sm:block">j · k · navegar</p>
  </div>

  {/* bottom right · where to study it */}
  <div class="absolute right-4 bottom-4 max-w-[min(24rem,60vw)] text-right sm:right-8 sm:bottom-6">
    <div data-chrome-chips class="hidden flex-wrap justify-end gap-1.5 sm:flex">
      {
        BEATS.map((b) => (
          <span data-chips-for={b.id} hidden class="contents">
            {b.chips?.map((id) => {
              const track = byId.get(id);
              if (!track) return null;
              const href = hrefOf(id);
              return href ? (
                <a
                  href={href}
                  class="rounded-full border border-blue/40 px-2 py-0.5 text-blue transition-colors hover:bg-blue/15 focus-visible:bg-blue/15"
                >
                  {track.name}
                </a>
              ) : (
                <span class="rounded-full border border-line px-2 py-0.5 text-subtext0/60" title="Por escribir">
                  {track.name}
                </span>
              );
            })}
          </span>
        ))
      }
    </div>
    <a
      href="/cs/"
      class="mt-2 inline-flex items-center gap-1.5 rounded-sm border border-green/45 bg-green/12 px-3 py-1 text-green transition-colors hover:bg-green/22 focus-visible:bg-green/22"
    >
      empieza a estudiar
      <ArrowRight class="size-3" aria-hidden="true" />
    </a>
  </div>

</div>
