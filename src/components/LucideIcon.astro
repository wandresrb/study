---
// src/components/IconoLucide.astro
import * as LucideIcons from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, ...props } = Astro.props;

// Buscamos el componente dentro del mapa de Lucide usando el nombre en texto
const IconComponent = LucideIcons[name as keyof typeof LucideIcons];

// TODO: Remplazar lucide con lucide astro
---

{IconComponent ? <IconComponent {...props} /> : <span>Ícono no encontrado</span>}
