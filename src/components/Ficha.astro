---
import Chip from './Chip.astro';

interface Props {
  titulo: string;
  /** El color de la ficha: pinta el rail, el aro, el subtítulo y la flecha. */
  color: string;
  logo: { valor: string; from: string; to?: string; marca?: string; exacta?: boolean };
  /** Sin `href` no es un enlace: se emite un div y no hay hover. */
  href?: string;
  /** `ancha` es la fila del camino de niveles y del 404; `compacta`, la rejilla del hub. */
  forma?: 'ancha' | 'compacta';
  subtitulo?: string;
  descripcion?: string;
  etiquetas?: string[];
  atenuada?: boolean;
  enc?: 'h3' | 'h4';
}

const {
  titulo,
  color,
  logo,
  href,
  forma = 'ancha',
  subtitulo,
  descripcion,
  etiquetas = [],
  atenuada = false,
  enc = 'h4',
} = Astro.props;

const Caja = href ? 'a' : 'div';
const Titulo = enc;
const ancha = forma === 'ancha';

const caja = [
  'group relative grid items-center overflow-hidden rounded-[18px] border border-borde bg-panel no-underline',
  'transition-[transform,border-color,box-shadow] duration-[250ms] ease-suave',
  "before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-[var(--lvl-color)] before:content-['']",
  ancha
    ? 'grid-cols-[auto_1fr_auto] gap-[22px] px-[26px] py-6 max-[900px]:grid-cols-[auto_1fr]'
    : 'grid-cols-[auto_1fr] grid-rows-[auto_auto] gap-3 gap-y-2.5 px-4 py-3.5',
  href && !atenuada
    ? 'hover:-translate-y-1 hover:border-[var(--lvl-color)] hover:shadow-panel'
    : '',
  atenuada ? 'cursor-default opacity-[0.62]' : '',
].join(' ');

// La geometría de la ficha de icono es cosa de la Ficha, no de quien la llama.
const cajaChip = [
  ancha ? 'size-16 rounded-2xl [--ico:32] [--ico-hair:2.5]' : 'size-[38px] rounded-[11px] [--ico:19] [--ico-hair:1.85]',
  '[--num-peso:600] group-hover:[--chip-tint:18%]',
].join(' ');

const clasesEtiquetas = ancha ? 'mt-3 flex flex-wrap gap-[7px]' : 'col-span-full flex flex-wrap gap-[7px]';
const clasesEtiqueta =
  'rounded-md border border-borde bg-crust px-[9px] py-[3px] font-mono text-[0.68rem] text-subtext0';
---

<Caja class={caja} href={href} style={`--lvl-color:${color}`}>
  <Chip caja={cajaChip} {...logo} />

  <div class="min-w-0">
    <Titulo
      class={
        ancha
          ? 'flex flex-wrap items-baseline gap-3 text-[1.35rem] font-extrabold text-white'
          : 'text-[0.94rem] font-extrabold text-white'
      }
    >
      {titulo}
      {ancha && subtitulo && (
        <small class="font-mono text-[0.78rem] font-semibold text-[var(--lvl-color)]">{subtitulo}</small>
      )}
    </Titulo>

    {ancha && descripcion && (
      <p class="mt-1.5 max-w-[60ch] text-[0.96rem] text-subtext0">{descripcion}</p>
    )}

    {ancha && etiquetas.length > 0 && (
      <div class={clasesEtiquetas}>
        {etiquetas.map((e) => <span class={clasesEtiqueta}>{e}</span>)}
      </div>
    )}
  </div>

  {ancha && href && <div class="text-2xl text-[var(--lvl-color)] max-[900px]:hidden">→</div>}

  {!ancha && etiquetas.length > 0 && (
    <div class={clasesEtiquetas}>
      {etiquetas.map((e) => <span class={clasesEtiqueta}>{e}</span>)}
    </div>
  )}
</Caja>

<style>
  /* `a:hover { text-decoration: underline }` de global.css no está en capas, así
     que le gana a la utilidad `no-underline`. Esto sí le gana, por
     especificidad: el scope de Astro añade una clase. */
  a:hover { text-decoration: none; }
</style>
