---
import Icon from './Icon.astro';
import { esCifra, FORMATO } from '../data/iconos';

interface Props {
  /** Lo que se pinta: una cifra ("12") o un nombre de icono ("lucide:cpu"). */
  valor: string;
  /** Clase de la caja, que es la que fija --ico y el tamaño: `logo`, `lvl-dot`, `p-lvl`, `cat-icon`. */
  caja: string;
  /** Extremos del degradado del aro. Si solo hay uno, el aro sale plano. */
  from: string;
  to?: string;
  /** Hex oficial de la marca. `exacta` cuando ya viene elegido para fondo oscuro. */
  marca?: string;
  exacta?: boolean;
}

const { valor, caja, from, to, marca, exacta = false } = Astro.props;

// `--chip-to` solo cuando de verdad hay degradado: su valor por defecto en CSS
// ya es --chip-from, y repetirlo costaba unos 25 bytes por ficha en fichas que
// se repiten hasta 58 veces por página.
const estilo = [
  `--chip-from:${from}`,
  to && to !== from ? `--chip-to:${to}` : '',
  marca ? `--marca:${marca}` : '',
].filter(Boolean).join(';');
---
{/*
  Decorativo SIEMPRE: los ocho sitios del piloto llevan su nombre en texto al
  lado, así que el piloto no necesita ni un `role="img"`. Si algún día hace
  falta uno informativo será explícito en la llamada, no un descuido aquí.
*/}
<span
  class={`chip ${caja}`}
  style={estilo}
  data-marca={marca ? (exacta ? 'exacta' : '') : undefined}
  aria-hidden="true"
>
  {esCifra(valor)
    ? <span class="num">{valor}</span>
    : FORMATO.test(valor)
      ? <Icon name={valor} />
      : /* Red de seguridad de la migración: un valor sin migrar (un emoji) cae
           aquí y se pinta centrado en la ficha correcta en vez de romper la
           página. El schema es quien impide que llegue a producción. */
        <span class="num emoji">{valor}</span>}
</span>
