---
interface Props { type?: string; title?: string; }
const { type = 'info', title } = Astro.props;
const icons: Record<string, string> = { tip: '💡', info: 'ℹ️', warn: '⚠️', danger: '🛑', note: '📝' };
const titles: Record<string, string> = { tip: 'Tip', info: 'Nota', warn: 'Cuidado', danger: 'Importante',  note: 'Apunte' };
const ic = icons[type] ?? icons.info;
const t = title ?? titles[type] ?? '';
---
<div class={`callout ${type}`}>
  <div class="ic">{ic}</div>
  <div class="body">
    {t ? <div class="c-title">{t}</div> : null}
    <slot />
  </div>
</div>
