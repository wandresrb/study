---
interface Props { reto: string; teclas?: string; }
const { reto, teclas } = Astro.props;
---
<div class="drill">
  <div class="drill-q"><span class="drill-tag">⛳ DRILL</span> {reto}</div>
  <details class="drill-sol">
    <summary>Ver solución</summary>
    <div class="drill-body">
      {teclas ? <div class="drill-keys">{teclas}</div> : null}
      <slot />
    </div>
  </details>
</div>
