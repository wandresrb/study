---
import Chip from './Chip.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  /** Nombre de icono (`lucide:sigma`), no un emoji. */
  icono: string;
  color: string;
  gradFrom: string;
  gradTo: string;
  /** La línea de cifras que va junto al nombre. */
  resumen: string;
  abierta?: boolean;
}

const { id, nombre, descripcion, icono, color, gradFrom, gradTo, resumen, abierta = true } = Astro.props;

// La caja: contorno punteado y rail vertical en el color de la categoría. Un
// contorno cerrado y no un hueco ni un filete, porque las líneas más fuertes
// de la página son los bordes de las fichas y cualquier cosa más floja que un
// contorno se lee como un único campo de tarjetas.
const caja = [
  'categoria group relative mt-6 overflow-hidden rounded-[22px] border border-dashed border-borde p-[26px]',
  "before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-[var(--cat-color)] before:opacity-[0.45] before:content-['']",
  'scroll-mt-32',
].join(' ');

// 8% de tinte en vez del 12% de las fichas de tema: la cabecera de categoría
// es deliberadamente sorda, y se apaga tocando el suelo, no la tinta.
const cajaChip =
  'size-[60px] rounded-2xl [--ico:30] [--ico-hair:2.3] [--chip-tint:8%] [--num-peso:600] shadow-[inset_0_1px_0_rgba(205,214,244,0.05)]';
---

<details open={abierta} id={`cat-${id}`} class={caja} style={`--cat-color:${color}`}>
  <summary
    class="flex cursor-pointer list-none items-center gap-[18px] [&::-webkit-details-marker]:hidden"
  >
    <Chip caja={cajaChip} valor={icono} from={gradFrom} to={gradTo} />

    <div class="min-w-0 flex-1">
      <h3 class="flex flex-wrap items-center gap-3 text-[1.3rem] font-extrabold text-subtext1">
        {nombre}
        <span class="font-mono text-[0.72rem] font-normal text-overlay1">{resumen}</span>
      </h3>
      <p class="mt-1 max-w-[70ch] text-[0.96rem]/[1.6] text-subtext0 text-pretty">{descripcion}</p>
    </div>

    <Icon name="lucide:chevron-down" class="galon" />
  </summary>

  {/* El min() no es adorno: auto-fill respeta el mínimo de minmax aunque el
      contenedor sea más estrecho, así que un minmax(230px, …) pelado desborda
      por la derecha bajo ~300px de viewport. */}
  <div class="mt-5 grid gap-[14px] [grid-template-columns:repeat(auto-fill,minmax(min(230px,100%),1fr))]">
    <slot />
  </div>
</details>

<style>
  /* `svg { height: auto }` del reset no está en capas, así que ninguna utilidad
     de Tailwind puede dimensionar el galón. Dos clases contra un elemento sí. */
  summary .galon {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    color: var(--overlay0);
    transition: transform 0.2s var(--ease), color 0.2s;
  }
  summary:hover .galon { color: var(--text); }
  details[open] > summary .galon { transform: rotate(180deg); }
</style>
