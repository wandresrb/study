---
import { resolver } from '../data/iconos';

interface Props {
  /** `lucide:cpu` o `simple-icons:rust`. Revienta en build si no existe. */
  name: string;
  class?: string;
  /**
   * Sin `label` el icono es decorativo y se marca `aria-hidden`: en los ocho
   * sitios del piloto el nombre ya está en el texto de al lado, y anunciarlo
   * dos veces solo alarga el recorrido del lector de pantalla. Con `label`
   * pasa a ser contenido: `role="img"` + `aria-label`.
   */
  label?: string;
}

const { name, class: clase = 'ico', label } = Astro.props;
const { body, viewBox, modo } = resolver(name);
---
{/*
  Sin `xmlns`: solo hace falta en un documento XML suelto, y aquí el SVG va
  incrustado en HTML. Son 34 bytes por icono, unos 500 KB entre las 5074
  páginas a tres iconos cada una.

  Sin `fill` ni `stroke` en la raíz: los cuerpos ya los traen. Lucide pinta
  `fill="none" stroke="currentColor" stroke-width="2"` y simple-icons
  `fill="currentColor"`. Fijar cualquiera de los dos aquí rompería el otro set.
  El `stroke-width` sí se sobreescribe desde CSS, que es donde vive la escala.

  `focusable="false"` no es opcional: en algunos motores un SVG entra en el
  orden de tabulación por defecto, y estos son decorativos.
*/}
<svg
  class={clase}
  viewBox={viewBox}
  data-modo={modo}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>
