---
/**
 * El pie. Es la otra mitad de arreglar la navegación: quien llega al final de
 * una lección tiene que poder ir a algún sitio que no sea el botón de atrás.
 */

import Chip from '../Chip.astro';

const ENLACES = [
  { href: '/hub/', texto: 'Todos los temas' },
  { href: '/recursos/', texto: 'Recursos' },
  { href: '/config/', texto: 'Mi configuración' },
  { href: '/about/', texto: 'Sobre mí' },
];

const anyo = new Date().getFullYear();
---

<footer class="mt-24 border-t border-borde">
  <div
    class="mx-auto flex max-w-[1500px] flex-col gap-6 px-4 py-10 sm:flex-row sm:items-start sm:justify-between sm:px-10"
  >
    <div>
      <a class="inline-flex items-center gap-2.5 font-semibold text-text no-underline" href="/">
        {/* La misma ficha que arriba, una talla menos. 13 en 26 es la
            proporción que ya usa `.lvl-dot`, que es la caja pequeña del sitio. */}
        <Chip
          caja="size-[1.6rem] rounded-md [--ico:13] [--ico-hair:1.3]"
          valor="lucide:infinity"
          from="var(--mauve)"
          to="var(--blue)"
        />
        <span>wandres.dev</span>
      </a>
      <p class="mt-2 max-w-[44ch] text-[0.84rem] text-overlay1">
        Guías interactivas para dominar tecnología de cero a nivel dios.
      </p>
    </div>

    <nav aria-label="Pie" class="flex flex-col gap-2 sm:items-end">
      {
        ENLACES.map((e) => (
          <a
            href={e.href}
            class="font-mono text-[0.82rem] text-subtext0 no-underline transition-colors hover:text-text"
          >
            {e.texto}
          </a>
        ))
      }
    </nav>
  </div>

  <p class="m-0 px-4 pb-8 font-mono text-[0.72rem] text-overlay0 sm:px-10">© {anyo} wandres.dev</p>
</footer>
