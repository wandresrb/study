---
/**
 * La cabecera del sitio. UNA, para todo.
 *
 * Antes había tres distintas y ninguna conectaba nada: la portada llevaba a
 * `/hub/`, el hub llevaba a sí mismo —la marca enlazaba a `/hub/`— y las
 * 5074 lecciones no tenían ni un solo enlace, solo el nombre del track y un
 * botón de menú. De ahí la sensación de estar en dos sitios distintos: es que
 * literalmente lo eran.
 *
 * Reglas que arreglan eso:
 *
 *   · la marca es SIEMPRE `wandres.dev` y SIEMPRE va a `/`;
 *   · la miga dice dónde estás, que es lo que la marca no debe hacer;
 *   · los mismos enlaces en todas partes, incluidas las lecciones.
 */

import { getCollection } from 'astro:content';

import { getTracks } from '../../data/contenido';
import Chip from '../Chip.astro';
import Paleta from './Paleta.tsx';

interface Props {
  /**
   * `flotante` se posa sobre el lienzo de la portada sin ocupar sitio ni
   * capturar el ratón. El resto de páginas usan `normal`, que empuja al
   * contenido.
   */
  variante?: 'normal' | 'flotante';
  /** Dónde estás. La marca no lo dice; esto sí. */
  miga?: { texto: string; href?: string }[];
  /**
   * El buscador solo tiene sentido DENTRO del hub: es donde hay algo que
   * buscar. En la portada y en «sobre mí» sería un control que no lleva a
   * ningún sitio relacionado con lo que estás mirando.
   */
  buscador?: boolean;
}

const { variante = 'normal', miga = [], buscador = false } = Astro.props;

/**
 * Tres destinos y punto.
 *
 * `/` es el sitio en sí —la portada— y ya lo cubre la marca, así que no se
 * repite como enlace. Recursos y la configuración viven DENTRO del hub, no al
 * mismo nivel que él: sacarlos arriba hacía una barra de cuatro cosas que no
 * eran hermanas.
 */
const ENLACES = [
  { href: '/hub/', texto: 'Hub de estudio' },
  { href: '/about/', texto: 'Sobre mí' },
];

/**
 * Lo que busca la paleta: CATEGORÍAS y TEMAS, no lecciones.
 *
 * Antes indexaba las 5074 lecciones — 164 KB que había que descargar aparte— y
 * el resultado era peor: buscabas «matemáticas» o «neovim» y no salía nada,
 * porque ninguna de las dos cosas es el título de una lección. Lo que la gente
 * busca para navegar es el sitio al que quiere ir.
 *
 * Son 12 categorías y 59 temas: setenta y una filas. Van INCRUSTADAS en el
 * HTML, así que no hay fichero que pedir ni espera al abrir la paleta.
 */
const [cats, tracks] = buscador
  ? await Promise.all([getCollection('categorias'), getTracks()])
  : [[], []];

const entradas = [
  ...cats.map((c) => [c.data.nombre, 'categoría', `/hub/#cat-${c.id}`] as const),
  ...tracks
    .filter((t) => t.data.estado === 'disponible')
    .map((t) => [t.data.nombre, 'tema', `/${t.id}/`] as const),
].map((e) => [e[0], e[1], e[2]] as [string, string, string]);

const ruta = Astro.url.pathname;
const activo = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href));

const base =
  variante === 'flotante'
    ? 'pointer-events-none fixed inset-x-0 top-0 z-30'
    : '';
---

<header class={`${base} sticky top-0 z-30 border-b border-borde bg-base/15 backdrop-blur-[10px] [&_a]:pointer-events-auto [&_button]:pointer-events-auto`}>
  <div class="mx-auto flex max-w-375 items-center gap-3 px-4 py-3 sm:gap-5 sm:px-10">
    <a
      class="inline-flex shrink-0 items-center gap-2.5 font-semibold tracking-[-0.01em] text-text no-underline"
      href="/"
    >
      {/*
        La misma ficha que el resto del sitio: placa oscura, aro de degradado y
        tinta de color. Era el último `∞` que quedaba pintado al revés —glifo
        --crust sobre losa de degradado—, y estaba en la barra de las 5136
        páginas, así que era el sitio donde más se notaba la incoherencia.

        La caja va en utilidades y no en una clase de global.css porque esta
        cabecera no reusa nada de `.brand`: `--ico` es la mitad del lado, igual
        proporción que `.brand .logo` (20 en 40).
      */}
      <Chip
        caja="size-[1.9rem] rounded-lg [--ico:15] [--ico-hair:1.5]"
        valor="lucide:infinity"
        from="var(--mauve)"
        to="var(--blue)"
      />
      <span>wandres.dev</span>
    </a>

    {
      miga.length > 0 && (
        <nav aria-label="Ruta" class="hidden min-w-0 items-center gap-2 font-mono text-[0.78rem] md:flex">
          {miga.map((m) => (
            <>
              <span aria-hidden="true" class="text-surface1">
                /
              </span>
              {m.href ? (
                <a class="truncate text-overlay1 no-underline hover:text-text" href={m.href}>
                  {m.texto}
                </a>
              ) : (
                <span class="truncate text-subtext0">{m.texto}</span>
              )}
            </>
          ))}
        </nav>
      )
    }

    <span class="flex-1"></span>

    <nav aria-label="Secciones" class="hidden items-center gap-1 sm:flex">
      {
        ENLACES.map((e) => (
          <a
            href={e.href}
            aria-current={activo(e.href) ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 font-mono text-[0.82rem] text-subtext0 no-underline transition-colors hover:text-text aria-[current=page]:bg-surface0/60 aria-[current=page]:text-text"
          >
            {e.texto}
          </a>
        ))
      }
    </nav>

    {/* Sitio para controles propios de la página: hoy el botón de menú de las
        lecciones, que abre la barra lateral en móvil. */}
    <slot name="acciones" />

    {buscador && <Paleta client:idle entradas={entradas} />}
  </div>
</header>
