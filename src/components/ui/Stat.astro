---
interface Props {
  items: { value: string; label: string; foot?: string }[];
  class?: string;
}

const { items, class: extra = '' } = Astro.props;
---
<div class:list={['d-stats w-full border border-borde bg-panel', extra]}>
  {items.map((d) => (
    <div class="d-stat place-items-center text-center">
      <div class="d-stat-value bg-linear-to-r from-mauve to-blue bg-clip-text font-mono text-transparent">
        {d.value}
      </div>
      <div class="d-stat-title text-md text-subtext0">{d.label}</div>
      {d.foot && <div class="d-stat-desc text-overlay1">{d.foot}</div>}
    </div>
  ))}
</div>
