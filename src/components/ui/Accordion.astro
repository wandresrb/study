---
interface Props {
  title?: string;
  open?: boolean;
  marker?: 'arrow' | 'plus' | 'none';
  class?: string;
}

const { title, open = false, marker = 'arrow', class: extra = '' } = Astro.props;

const MARKER = { arrow: 'd-collapse-arrow', plus: 'd-collapse-plus', none: '' } as const;
---

<details class:list={['d-collapse', MARKER[marker], extra]} open={open}>
  <summary class="d-collapse-title font-medium">
    {title}<slot name="title" />
  </summary>
  <div class="d-collapse-content">
    <slot />
  </div>
</details>
