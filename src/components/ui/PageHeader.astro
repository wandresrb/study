---
interface Props {
  title: string;
  lede?: string;
  class?: string;
}

const { title, lede, class: extra = '' } = Astro.props;
---
<header class:list={['mb-8', extra]}>
  <h1 class="text-4xl font-extrabold tracking-headline text-text">{title}</h1>

  {lede && <p class="mt-3 max-w-measure text-lg text-subtext1">{lede}</p>}

  <slot name="meta" />
</header>
