---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'soft' | 'link';
  size?: 'sm' | 'md' | 'lg';
  color?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  color,
  type = 'button',
  class: extra = '',
  ...rest
} = Astro.props;

const VARIANT = {
  primary: 'd-btn-primary',
  ghost: 'd-btn-ghost',
  soft: 'd-btn-soft',
  link: 'd-btn-link',
} as const;

const SIZE = { sm: 'd-btn-sm', md: '', lg: 'd-btn-lg' } as const;

const classes = ['d-btn', VARIANT[variant], SIZE[size], extra].filter(Boolean).join(' ');

const style =
  color && variant === 'primary'
    ? `background:${color};border-color:transparent`
    : undefined;

const Tag = href ? 'a' : 'button';
---
<Tag
  class={classes}
  style={style}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />
</Tag>
