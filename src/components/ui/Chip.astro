---
interface Props {
  box: string;
  from: string;
  to?: string;
}

const { box, from, to } = Astro.props;

const style = [`--chip-from:${from}`, to && to !== from ? `--chip-to:${to}` : ''].filter(Boolean).join(';');
---

<span class:list={['chip', box]} style={style} aria-hidden="true">
  <slot />
</span>
