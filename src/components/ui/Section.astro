---
interface Props {
  id?: string;
  title?: string;
  kicker?: string;
  color?: string;
  lede?: string;
  centered?: boolean;
  class?: string;
}

const { id, title, kicker, color, lede, centered = true, class: extra = '' } = Astro.props;
---

<section id={id} class:list={['my-16 first:mt-0', extra]} style={color ? `--accent:${color}` : undefined}>
  {
    (title || kicker) && (
      <div class:list={['mb-8', centered ? 'text-center' : 'text-left']}>
        {kicker && <p class="m-0 text-xs tracking-smallcaps text-(--accent,--color-mauve) uppercase">{kicker}</p>}
        {title && <h2 class="mt-2 text-3xl font-extrabold tracking-headline text-text">{title}</h2>}
        {lede && <p class:list={['mt-3 max-w-measure text-md text-subtext1', centered && 'mx-auto']}>{lede}</p>}
      </div>
    )
  }
  <slot />
</section>
