---
import Chip from './Chip.astro';

interface Props {
  title: string;
  color: string;
  logo: { from: string; to?: string };
  href?: string;
  shape?: 'wide' | 'compact';
  subtitle?: string;
  description?: string;
  tags?: string[];
  dimmed?: boolean;
  heading?: 'h3' | 'h4';
  sr?: string;
}

const {
  title,
  color,
  logo,
  href,
  shape = 'wide',
  subtitle,
  description,
  tags = [],
  dimmed = false,
  heading = 'h4',
  sr,
} = Astro.props;

const Box = href ? 'a' : 'div';
const Heading = heading;
const wide = shape === 'wide';

const box = [
  'group relative grid items-center overflow-hidden rounded-[18px] border border-borde bg-panel no-underline',
  'transition-[transform,border-color,box-shadow] duration-[250ms] ease-suave',
  "before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-[var(--lvl-color)] before:content-['']",
  wide
    ? 'grid-cols-[auto_1fr_auto] gap-[22px] px-[26px] py-6 max-[900px]:grid-cols-[auto_1fr]'
    : 'grid-cols-[auto_1fr] grid-rows-[auto_auto] gap-3 gap-y-2.5 px-4 py-3.5',
  href && !dimmed
    ? 'hover:-translate-y-1 hover:border-[var(--lvl-color)] hover:shadow-panel'
    : '',
  dimmed ? 'cursor-default opacity-[0.62]' : '',
].join(' ');

const chipBox = [
  wide ? 'size-16 rounded-2xl ico-lg' : 'size-[38px] rounded-[11px] ico-md',
  '[--num-peso:600] group-hover:[--chip-tint:18%]',
].join(' ');

// The level colour stays on the rail and the number: on a 14px subtitle it lands
// between 3.36:1 and 4.34:1 depending on where the cyclic palette falls.
const tagsClass = wide ? 'mt-3 flex flex-wrap gap-[7px]' : 'col-span-full flex flex-wrap gap-[7px]';
const tagClass =
  'rounded-md border border-borde bg-crust px-[9px] py-[3px] text-2xs text-subtext0';
---
<Box class={box} href={href} style={`--lvl-color:${color}`}>
  <Chip box={chipBox} {...logo}>
    <slot name="glyph" />
  </Chip>

  <div class="min-w-0">
    <Heading
      class={
        wide
          ? 'flex flex-wrap items-baseline gap-3 text-2xl font-extrabold text-text'
          : 'text-base font-extrabold text-text'
      }
    >
      {sr && <span class="sr-only">{sr}: </span>}
      {title}
      {wide && subtitle && (
        <small class="text-sm font-semibold text-subtext0">{subtitle}</small>
      )}
    </Heading>

    {wide && description && (
      <p class="mt-1.5 max-w-medida text-base text-subtext0">{description}</p>
    )}

    {wide && tags.length > 0 && (
      <div class={tagsClass}>
        {tags.map((t) => <span class={tagClass}>{t}</span>)}
      </div>
    )}
  </div>

  {wide && href && <div class="text-2xl text-[var(--lvl-color)] max-[900px]:hidden">→</div>}

  {!wide && tags.length > 0 && (
    <div class={tagsClass}>
      {tags.map((t) => <span class={tagClass}>{t}</span>)}
    </div>
  )}
</Box>
