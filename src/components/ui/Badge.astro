---
interface Props {
  variant?: 'neutral' | 'brand' | 'soft' | 'outline';
  size?: 'xs' | 'sm' | 'md';
  color?: string;
  class?: string;
}

const { variant = 'neutral', size = 'sm', color, class: extra = '' } = Astro.props;

const VARIANT = {
  neutral: 'd-badge-neutral',
  brand: 'd-badge-primary',
  soft: 'd-badge-soft',
  outline: 'd-badge-outline',
} as const;

const SIZE = { xs: 'd-badge-xs', sm: 'd-badge-sm', md: '' } as const;

const classes = ['d-badge', VARIANT[variant], SIZE[size], 'font-mono', extra]
  .filter(Boolean)
  .join(' ');

const style = color ? `color:${color};border-color:${color}55` : undefined;
---
<span class={classes} style={style}><slot /></span>
