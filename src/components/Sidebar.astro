---
import { getEntry } from 'astro:content';
import { getTrack, getNiveles, leccionesDe } from '../data/contenido';

interface Props { subject: string; current?: string; }
const { subject, current } = Astro.props;
const entrada = await getTrack(subject);
const track = entrada.data;

const all = await leccionesDe(subject);
const byLevel = (await getNiveles(subject))
  .map((n) => ({ nivel: n, items: all.filter((e) => e.data.level === n.id) }))
  .filter((g) => g.items.length > 0);

// El enlace a la cheatsheet ya no se declara en los datos: existe si existe
// la entrada en la colección.
const hoja = await getEntry('cheatsheets', subject);
const refs = { ...track.ref, ...(hoja ? { cheatsheet: `/${subject}/cheatsheet/` } : {}) };
---
{/*
  La barra lateral es el 64% del HTML de cada lección: el índice completo del
  track, hasta 280 enlaces, repetido en todas sus páginas. Persistirla evita
  reconstruir esos nodos en cada navegación y —lo que más se nota— conserva su
  posición de scroll y el filtro de búsqueda, que hoy se pierden al cambiar de
  lección dentro de un índice de doscientos elementos.

  El valor lleva el track: Astro empareja por el valor del atributo, así que
  dentro de un track persiste y al saltar a otro no encuentra pareja y se
  sustituye por el índice correcto.
*/}
<aside class="sidebar" id="sidebar" transition:persist={`nav-${subject}`}>
  <a class="hub-back" href="/">← Todos los temas</a>

  <a class="brand" href={`/${subject}/`}>
    <span class="logo" style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>{track.logo}</span>
    <span class="brand-text"><b>{track.nombre}</b><span>de cero a ∞</span></span>
  </a>

  <input
    class="side-search"
    id="side-search"
    type="search"
    placeholder="Filtrar lecciones…"
    aria-label="Filtrar lecciones"
  />

  {byLevel.map(({ nivel, items }) => (
    <div class="nav-group" data-level={nivel.id}>
      <div class="nav-group-head">
        <span class="lvl-dot" style={`background:${nivel.color}`}>{nivel.icono}</span>
        <span class="lvl-meta"><b>Nivel {nivel.id} · {nivel.nombre}</b><span>{nivel.subtitulo}</span></span>
      </div>
      <ul class="nav-links">
        {items.map((it) => (
          <li>
            <a
              href={`/guia/${it.id}/`}
              aria-current={it.id === current ? 'page' : undefined}
              data-title={it.data.title.toLowerCase()}
            >
              <span class="num">{it.data.icon}</span>{it.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="sidebar-foot">
    {refs.cheatsheet ? <a href={refs.cheatsheet}>⌘ Cheatsheet</a> : null}
    {refs.config ? <Fragment> · <a href={refs.config}>init.lua</a></Fragment> : null}
    {refs.recursos ? <Fragment><br /><a href={refs.recursos}>📚 Recursos</a></Fragment> : null}
  </div>
</aside>

<script>
  // Al persistir el <aside>, sus nodos SOBREVIVEN a la navegación. Eso rompe el
  // patrón de "recablear en astro:page-load": el input de búsqueda seguiría
  // siendo el mismo elemento y acumularía un listener por cada página visitada.
  //
  // Por eso los listeners van delegados en `document`, que se registra una sola
  // vez y no depende de qué nodos sobrevivan.
  const plano = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  document.addEventListener('input', (e) => {
    const t = e.target as HTMLElement | null;
    if (!(t instanceof HTMLInputElement) || t.id !== 'side-search') return;
    const q = plano(t.value).trim();
    document.querySelectorAll<HTMLElement>('.nav-links li').forEach((li) => {
      const titulo = plano(li.querySelector('a')?.getAttribute('data-title') ?? '');
      li.style.display = !q || titulo.includes(q) ? '' : 'none';
    });
  });

  const abrir = (open: boolean) => {
    document.getElementById('sidebar')?.classList.toggle('open', open);
    document.getElementById('scrim')?.classList.toggle('show', open);
  };
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null;
    if (t?.closest('#menu-btn')) abrir(!document.getElementById('sidebar')?.classList.contains('open'));
    else if (t?.closest('#scrim')) abrir(false);
  });

  // El `aria-current` se pinta en el servidor con la lección de ESA página. Si
  // el aside persiste, se quedaría marcando la lección anterior: hay que
  // repintarlo en cada navegación.
  document.addEventListener('astro:page-load', () => {
    const aqui = location.pathname.replace(/\/$/, '');
    document.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((a) => {
      const suyo = new URL(a.href).pathname.replace(/\/$/, '');
      if (suyo === aqui) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    abrir(false); // cerrar el menú móvil al cambiar de lección
  });
</script>
