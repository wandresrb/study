---
import { getCollection } from 'astro:content';
import { getTrack } from '../data/tracks';

interface Props { subject: string; current?: string; }
const { subject, current } = Astro.props;
const track = getTrack(subject);

const all = (await getCollection('guia'))
  .filter((e) => (e.data.subject ?? 'neovim') === subject)
  .sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);

const byLevel = track.niveles
  .map((n) => ({ nivel: n, items: all.filter((e) => e.data.level === n.id) }))
  .filter((g) => g.items.length > 0);

const refs = track.ref;
---
<aside class="sidebar" id="sidebar">
  <a class="hub-back" href="/">← Todos los temas</a>

  <a class="brand" href={`/${track.id}/`}>
    <span class="logo" style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>{track.logo}</span>
    <span class="brand-text"><b>{track.nombre}</b><span>de cero a ∞</span></span>
  </a>

  <input
    class="side-search"
    id="side-search"
    type="search"
    placeholder="Filtrar lecciones…"
    aria-label="Filtrar lecciones"
  />

  {byLevel.map(({ nivel, items }) => (
    <div class="nav-group" data-level={nivel.id}>
      <div class="nav-group-head">
        <span class="lvl-dot" style={`background:${nivel.color}`}>{nivel.icono}</span>
        <span class="lvl-meta"><b>Nivel {nivel.id} · {nivel.nombre}</b><span>{nivel.subtitulo}</span></span>
      </div>
      <ul class="nav-links">
        {items.map((it) => (
          <li>
            <a
              href={`/guia/${it.id}/`}
              aria-current={it.id === current ? 'page' : undefined}
              data-title={it.data.title.toLowerCase()}
            >
              <span class="num">{it.data.icon}</span>{it.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="sidebar-foot">
    {refs.cheatsheet ? <a href={refs.cheatsheet}>⌘ Cheatsheet</a> : null}
    {refs.config ? <Fragment> · <a href={refs.config}>init.lua</a></Fragment> : null}
    {refs.recursos ? <Fragment><br /><a href={refs.recursos}>📚 Recursos</a></Fragment> : null}
  </div>
</aside>

<script>
  const search = document.getElementById('side-search') as HTMLInputElement | null;
  search?.addEventListener('input', () => {
    const q = search.value.toLowerCase().trim();
    document.querySelectorAll<HTMLElement>('.nav-links li').forEach((li) => {
      const t = li.querySelector('a')?.getAttribute('data-title') ?? '';
      li.style.display = !q || t.includes(q) ? '' : 'none';
    });
  });

  const sb = document.getElementById('sidebar');
  const scrim = document.getElementById('scrim');
  const btn = document.getElementById('menu-btn');
  const toggle = (open: boolean) => {
    sb?.classList.toggle('open', open);
    scrim?.classList.toggle('show', open);
  };
  btn?.addEventListener('click', () => toggle(!sb?.classList.contains('open')));
  scrim?.addEventListener('click', () => toggle(false));
</script>
