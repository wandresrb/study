---
import { getCollection } from 'astro:content';
import type { Track } from '../data/tracks';

interface Props { track: Track; }
const { track } = Astro.props;
const all = await getCollection('guia');
const count = all.filter((e) => (e.data.subject ?? 'neovim') === track.id).length;
---
{track.estado === 'disponible' ? (
  <a class="path-card" href={`/${track.id}/`} style={`--lvl-color:${track.colorHex}`}>
    <div class="p-lvl" style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>{track.logo}</div>
    <div class="p-info">
      <h3>{track.nombre} <small>{track.subtitulo}</small></h3>
      <p>{track.descripcion}</p>
      <div class="tags">
        <span>{track.niveles.length} niveles</span>
        <span>{count} lecciones</span>
      </div>
    </div>
    <div class="p-go">→</div>
  </a>
) : (
  <div class="path-card is-soon" style={`--lvl-color:${track.colorHex}`}>
    <div class="p-lvl" style={`background:linear-gradient(135deg, ${track.gradFrom}, ${track.gradTo})`}>{track.logo}</div>
    <div class="p-info">
      <h3>{track.nombre} <small>{track.subtitulo}</small></h3>
      <p>{track.descripcion}</p>
      <div class="tags"><span>Próximamente</span></div>
    </div>
  </div>
)}
