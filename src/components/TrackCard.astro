---
import { leccionesDe, minutosDe } from '../data/contenido';
import type { Track } from '../data/contenido';
import Chip from './Chip.astro';

interface Props { track: Track }
const { track } = Astro.props;
const t = track.data;

const lecciones = t.estado === 'disponible' ? await leccionesDe(track.id) : [];
// Niveles CON lecciones, no los declarados en el temario: antes la portada
// contaba los declarados y la página del track los que tienen contenido, así
// que Lua salía con 30 aquí y 22 allí.
const niveles = new Set(lecciones.map((e) => e.data.level)).size;
// Las horas son el dato que faltaba para poder decidir: 291 lecciones de
// Local-First son 93 h y 65 de Motores de Reactividad son 18, y en la tarjeta
// se veían casi iguales.
const horas = Math.round(lecciones.reduce((a, l) => a + minutosDe(l.data.duracion), 0) / 60);
---
{/* Los chips cuelgan de .path-card, no de .p-info: en la rejilla del mapa la
    ficha mide 230px y el bloque de texto se queda en 120, donde tres chips se
    apilan en tres líneas. Como hermanos pueden ocupar el ancho completo. Por lo
    mismo van abreviados: "411 lecciones" no entra, "411 lecc" sí. */}
{t.estado === 'disponible' ? (
  <a class="path-card" href={`/${track.id}/`} style={`--lvl-color:${t.colorHex}`}>
    <Chip caja="p-lvl" valor={t.logo} from={t.gradFrom} to={t.gradTo} marca={t.logoHexDark ?? t.logoHex} exacta={!!t.logoHexDark} />
    <div class="p-info">
      <h4>{t.nombre} <small>{t.subtitulo}</small></h4>
      <p>{t.descripcion}</p>
    </div>
    <div class="tags">
      <span>{niveles} niv</span>
      <span>{lecciones.length} lecc</span>
      <span>{horas} h</span>
    </div>
  </a>
) : (
  <div class="path-card is-soon" style={`--lvl-color:${t.colorHex}`}>
    <Chip caja="p-lvl" valor={t.logo} from={t.gradFrom} to={t.gradTo} marca={t.logoHexDark ?? t.logoHex} exacta={!!t.logoHexDark} />
    <div class="p-info">
      <h4>{t.nombre} <small>{t.subtitulo}</small></h4>
      <p>{t.descripcion}</p>
    </div>
    <div class="tags"><span>Por escribir</span></div>
  </div>
)}
