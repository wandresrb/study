---
import { leccionesDe } from '../data/contenido';
import type { Track } from '../data/contenido';

interface Props { track: Track }
const { track } = Astro.props;
const t = track.data;

const lecciones = await leccionesDe(track.id);
// Niveles CON lecciones, no los declarados en el temario. Antes la portada
// contaba los declarados y la página del track los que tienen contenido, así
// que Lua salía con 30 aquí y 22 allí.
const nivelesConLecciones = new Set(lecciones.map((e) => e.data.level)).size;
---
{t.estado === 'disponible' ? (
  <a class="path-card" href={`/${track.id}/`} style={`--lvl-color:${t.colorHex}`}>
    <div class="p-lvl" style={`background:linear-gradient(135deg, ${t.gradFrom}, ${t.gradTo})`}>{t.logo}</div>
    <div class="p-info">
      <h3>{t.nombre} <small>{t.subtitulo}</small></h3>
      <p>{t.descripcion}</p>
      <div class="tags">
        <span>{nivelesConLecciones} niveles</span>
        <span>{lecciones.length} lecciones</span>
      </div>
    </div>
    <div class="p-go">→</div>
  </a>
) : (
  <div class="path-card is-soon" style={`--lvl-color:${t.colorHex}`}>
    <div class="p-lvl" style={`background:linear-gradient(135deg, ${t.gradFrom}, ${t.gradTo})`}>{t.logo}</div>
    <div class="p-info">
      <h3>{t.nombre} <small>{t.subtitulo}</small></h3>
      <p>{t.descripcion}</p>
      <div class="tags"><span>Próximamente</span></div>
    </div>
  </div>
)}
