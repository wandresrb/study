---
interface Props { name: string; repo?: string; tag?: string; icon?: string; }
const { name, repo, tag = 'plugin', icon = '🧩' } = Astro.props;
const tagClass = ['core', 'ai', 'opt'].includes(tag) ? tag : '';
---
<div class="plugin">
  <div class="p-ic">{icon}</div>
  <div class="p-main">
    <b>{name}</b>
    {repo ? <span class="repo">{repo}</span> : null}
    <p><slot /></p>
  </div>
  <span class={`p-tag ${tagClass}`}>{tag}</span>
</div>
