{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wandres",
  "compatibility_date": "2026-08-05",
  // Sitio 100% estatico: no hay `main`, solo se sirven los archivos que
  // `astro build` deja en dist/. Sin Worker de por medio, sin coste de CPU.
  "assets": {
    "directory": "./dist",
    // Sin esto, el 404.html que genera Astro no se sirve nunca: Cloudflare
    // devuelve su propia respuesta vacia.
    "not_found_handling": "404-page"
  }
}
